# bin/fyers/historical_prices: download fyers's historical candles into fyers.price_history, working the queue.
#
#     systemctl --user enable --now fyers-historical-prices.service
#     bin/fyers/historical_prices --status
#
# A unit of its own rather than fyers@historical_prices.service, because it paces differently from the feeds: the worker
# exits 0 when the queue is drained or only backing off, so it is restarted ten minutes later rather than at once, and
# at low priority. Run only one: the queue is not locked between workers. Seed new instruments with
# `bin/fyers/historical_prices --seed-only` after a new master.

[Unit]
Description=Historical candle download for fyers
PartOf=fyers.target
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=fyers-historical-prices
# Fyers refuses more than a handful of requests a second per app, and every Fyers script checks its session with a
# request as it starts - at boot, or when fyers.target starts, eleven of them at once. That burst was refused, and a
# login one script then attempted spoiled another's auth code. A random wait of up to thirty seconds spreads them out.
ExecStartPre=/bin/sh -c 'sleep $$(shuf -i 0-30 -n 1)'
ExecStart=%h/Projects/unified_broker_interface/bin/fyers/historical_prices
Restart=always
RestartSec=600
# Exit 2 is a failed first login or a bad argument; the morning login timer is the remedy, not a restart loop.
RestartPreventExitStatus=2
TimeoutStopSec=120
Nice=10
IOSchedulingClass=idle
CPUWeight=20

[Install]
WantedBy=fyers.target
