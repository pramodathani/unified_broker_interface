# One bin/fyers/instruments/ script that keeps running: fyers-instruments@websocket_quotes.service runs the websocket
# quote feed into Redis, and fyers-instruments@store_quotes_to_db.service runs the persister that drains that stream
# into fyers.ticks. Both fit, because each one logs in by itself, logs in again when its token is refused, and exits
# non-zero only when it cannot recover. The rest of the folder is not run through this template: daily_feed is a
# once-a-day download that unified-mapping.service runs, and price_history paces itself differently and has its
# own fyers-historical-prices.service.
#
#     systemctl --user enable --now fyers-instruments@websocket_quotes.service
#     journalctl --user -u fyers-instruments@websocket_quotes -f

[Unit]
Description=fyers instruments %i
PartOf=fyers.target
Wants=network-online.target
After=network-online.target
# Never give up restarting: a broker outage can outlast any start limit, and each script paces its own logins.
StartLimitIntervalSec=0

[Service]
Type=simple
# Python block-buffers stdout when it is not a terminal; without this the journal stays empty.
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=fyers-instruments-%i
# Fyers refuses more than a handful of requests a second per app, and every Fyers script checks its session with a
# request as it starts - at boot, or when fyers.target starts, eleven of them at once. Such a burst is refused, and a
# login one script then attempts can spoil another's auth code. A random wait of up to thirty seconds spreads them out.
ExecStartPre=/bin/sh -c 'sleep $$(shuf -i 0-30 -n 1)'
ExecStart=%h/Projects/unified_broker_interface/bin/fyers/instruments/%i
Restart=always
RestartSec=15
# Exit 2 is a bad argument or configuration - nothing to subscribe to, say - which a restart cannot fix.
RestartPreventExitStatus=2
TimeoutStopSec=60

[Install]
WantedBy=fyers.target
