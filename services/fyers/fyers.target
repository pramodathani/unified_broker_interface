# Everything that runs fyers's bin/fyers/ scripts. Enabling it starts them at boot; stopping it stops them all.
#
# Install - link every unit in this folder, then enable the target, the login timer and the scripts:
#
#     systemctl --user link ~/Projects/unified_broker_interface/services/fyers/*
#     systemctl --user daemon-reload
#     systemctl --user enable --now fyers.target fyers-login.timer \
#         fyers@quotes.service fyers@order_updates.service fyers@persist_ticks.service fyers@persist_orders.service fyers@orders.service fyers@trades.service fyers@positions.service fyers@holdings.service fyers@funds.service fyers@user-profile.service fyers@persist_positions.service fyers-historical-prices.service

[Unit]
Description=fyers scripts

[Install]
WantedBy=default.target
