# Everything that runs wisdom_capital's bin/wisdom_capital/ scripts. Enabling it starts them at boot; stopping it stops them all.
#
# Install - link every unit in this folder, then enable the target, the login timer and the scripts:
#
#     systemctl --user link ~/Projects/unified_broker_interface/services/wisdom_capital/*
#     systemctl --user daemon-reload
#     systemctl --user enable --now wisdom_capital.target wisdom_capital-login.timer \
#         wisdom_capital-instruments@websocket_quotes.service wisdom_capital-instruments@store_quotes_to_db.service \
#         wisdom_capital-orders@websocket_order_details.service wisdom_capital-orders@store_orders_to_db.service wisdom_capital-orders@api_order_details.service wisdom_capital-orders@api_trade_details.service \
#         wisdom_capital-portfolio@positions.service wisdom_capital-portfolio@holdings.service wisdom_capital-portfolio@funds.service wisdom_capital-portfolio@store_positions_to_db.service \
#         wisdom_capital-user@details.service \
#         wisdom_capital-historical-prices.service

[Unit]
Description=wisdom_capital scripts

[Install]
WantedBy=default.target
