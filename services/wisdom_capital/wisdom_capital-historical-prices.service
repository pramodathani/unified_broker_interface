# bin/wisdom_capital/historical_prices: download wisdom_capital's historical candles into wisdom_capital.price_history, working the queue.
#
#     systemctl --user enable --now wisdom_capital-historical-prices.service
#     bin/wisdom_capital/historical_prices --status
#
# A unit of its own rather than wisdom_capital@historical_prices.service, because it paces differently from the feeds:
# the worker exits 0 when the queue is drained or only backing off, so it is restarted ten minutes later rather than at
# once, and at low priority. Run only one: the queue is not locked between workers. Seed new instruments with
# `bin/wisdom_capital/historical_prices --seed-only` after a new master.

[Unit]
Description=Historical candle download for wisdom_capital
PartOf=wisdom_capital.target
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=wisdom_capital-historical-prices
ExecStart=%h/Projects/unified_broker_interface/bin/wisdom_capital/historical_prices
Restart=always
RestartSec=600
# Exit 2 is a failed first login or a bad argument; the morning login timer is the remedy, not a restart loop.
RestartPreventExitStatus=2
TimeoutStopSec=120
Nice=10
IOSchedulingClass=idle
CPUWeight=20

[Install]
WantedBy=wisdom_capital.target
