# Log wisdom_capital in with bin/wisdom_capital/login. Driven by wisdom_capital-login.timer.
#
#     systemctl --user start wisdom_capital-login          # log in now
#     journalctl --user -u wisdom_capital-login
#
# The bin/wisdom_capital/ scripts read the current token on every connect and
# request, so nothing has to be restarted after a login - it only has to happen ahead of the market.
#
# Tried up to three times. bin/wisdom_capital/login exits non-zero when the login fails or the session it produced does not
# answer an authenticated request, and Restart=on-failure runs it again after RestartSec. StartLimitBurst counts the
# first attempt, so three starts inside the interval is the first try and two retries. Every attempt writes
# wisdom_capital:session:status.

[Unit]
Description=Log the wisdom_capital broker in
PartOf=wisdom_capital.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=wisdom_capital-login
ExecStart=%h/Projects/unified_broker_interface/bin/wisdom_capital/login
Restart=on-failure
RestartSec=2min
# Zerodha and Shoonya log in by driving a headless Chrome and waiting on a TOTP.
TimeoutStartSec=300
# Deliberately no PrivateTmp, ProtectHome or NoNewPrivileges: Chrome needs a writable home and /dev/shm.
