# bin/indmoney/instruments/price_history: download indmoney's historical candles into indmoney.price_history, working the queue.
#
#     systemctl --user enable --now indmoney-historical-prices.service
#     bin/indmoney/instruments/price_history --status
#
# A unit of its own rather than indmoney-instruments@price_history.service, because it paces differently from the feeds: the
# worker exits 0 when the queue is drained or only backing off, so it is restarted ten minutes later rather than at
# once, and at low priority. Run only one: the queue is not locked between workers. Seed new instruments with
# `bin/indmoney/instruments/price_history --seed-only` after a new master.
#
# The `ExecStartPre` waits for Redis before the worker starts. After a reboot the units start while Redis is still
# reading its saved dataset from disk, it refuses every command until it has finished, and a first login that cannot
# read the stored token exits 2. Every exit is now retried ten minutes later, exit 2 included.

[Unit]
Description=Historical candle download for indmoney
PartOf=indmoney.target
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=indmoney-historical-prices
# Redis refuses commands while it reads its saved dataset back after a restart, so the worker waits for it rather than
# meeting the refusal in its first login. Returns at once when Redis is already serving.
ExecStartPre=%h/Projects/unified_broker_interface/bin/wait-for-redis
ExecStart=%h/Projects/unified_broker_interface/bin/indmoney/instruments/price_history
# Restarts on every exit, exit 2 included: ten minutes is slow enough that a real misconfiguration shows as an obvious
# slow loop in the journal, and a first login that failed because a store was not ready yet gets another go.
Restart=always
RestartSec=600
# Outlasts the wait for Redis above, which gives up after five minutes.
TimeoutStartSec=420
TimeoutStopSec=120
Nice=10
IOSchedulingClass=idle
CPUWeight=20

[Install]
WantedBy=indmoney.target
