# Everything that runs indmoney's bin/indmoney/ scripts. Enabling it starts them at boot; stopping it stops them all.
#
# Install - link every unit in this folder, then enable the target, the login timer and the scripts:
#
#     systemctl --user link ~/Projects/unified_broker_interface/services/indmoney/*
#     systemctl --user daemon-reload
#     systemctl --user enable --now indmoney.target indmoney-login.timer \
#         indmoney-instruments@websocket_quotes.service indmoney-instruments@store_quotes_to_db.service \
#         indmoney-orders@websocket_order_details.service indmoney-orders@store_orders_to_db.service indmoney-orders@api_order_details.service indmoney-orders@api_trade_details.service \
#         indmoney-portfolio@positions.service indmoney-portfolio@holdings.service indmoney-portfolio@funds.service \
#         indmoney-user@details.service \
#         indmoney-historical-prices.service

[Unit]
Description=indmoney scripts

[Install]
WantedBy=default.target
