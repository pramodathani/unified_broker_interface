# Log indmoney in with bin/indmoney/session/connect. Driven by indmoney-login.timer.
#
#     systemctl --user start indmoney-login          # log in now
#     journalctl --user -u indmoney-login
#
# The bin/indmoney/ scripts read the current token on every connect and
# request, so nothing has to be restarted after a login - it only has to happen ahead of the market.
#
# Tried up to three times. bin/indmoney/session/connect exits non-zero when the login fails or the session it produced does not
# answer an authenticated request, and Restart=on-failure runs it again after RestartSec. StartLimitBurst counts the
# first attempt, so three starts inside the interval is the first try and two retries. Every attempt writes
# indmoney:session:status.

[Unit]
Description=Log the indmoney broker in
PartOf=indmoney.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=indmoney-login
ExecStart=%h/Projects/unified_broker_interface/bin/indmoney/session/connect
Restart=on-failure
RestartSec=2min
# Zerodha and Shoonya log in by driving a headless Chrome and waiting on a TOTP.
TimeoutStartSec=300
# Deliberately no PrivateTmp, ProtectHome or NoNewPrivileges: Chrome needs a writable home and /dev/shm.
