# When to log indmoney in each morning.
#
# 07:00 IST every day, weekends included, is before the 07:45 instrument download and the 09:00 pre-open, and well
# clear of MCX's 23:30 close.

[Unit]
Description=Daily login for indmoney
PartOf=indmoney.target

[Timer]
# The timezone is stated so the schedule survives a change to the machine's timezone.
OnCalendar=*-*-* 07:00 Asia/Kolkata
AccuracySec=1s
# Nine brokers log in with a TOTP, and Zerodha and Shoonya through a headless Chrome; half an hour of jitter keeps the
# ten logins from firing in the same second, and still lands every one before the 07:45 instrument download.
RandomizedDelaySec=1800
# A machine that was off at 07:00 needs no catch-up: the first script to find its token refused logs in then.
Persistent=false
Unit=indmoney-login.service

[Install]
WantedBy=timers.target
