# Everything that runs flattrade's bin/flattrade/ scripts. Enabling it starts them at boot; stopping it stops them all.
#
# Install - link every unit in this folder, then enable the target, the login timer and the scripts:
#
#     systemctl --user link ~/Projects/unified_broker_interface/services/flattrade/*
#     systemctl --user daemon-reload
#     systemctl --user enable --now flattrade.target flattrade-login.timer \
#         flattrade-orders@websocket_order_details.service flattrade-orders@store_orders_to_db.service \
#         flattrade-orders@api_order_details.service flattrade-orders@api_trade_details.service \
#         flattrade-portfolio@positions.service flattrade-portfolio@holdings.service flattrade-portfolio@funds.service \
#         flattrade-user@details.service \
#         flattrade-historical-prices.service
#
# The quote feed is left out: Flattrade permits one websocket per session and the order update feed holds it, so
# enabling flattrade-instruments@websocket_quotes.service beside
# flattrade-orders@websocket_order_details.service would knock one of them off. unified.broker_quote_capacities gives
# Flattrade no quote sockets, so the allocation gives its instruments to other brokers.

[Unit]
Description=flattrade scripts

[Install]
WantedBy=default.target
