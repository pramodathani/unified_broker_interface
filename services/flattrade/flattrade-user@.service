# The one bin/flattrade/user/ script that keeps running: flattrade-user@details.service runs
# bin/flattrade/user/details, which polls the broker's profile. It fits the template because it logs in by itself,
# logs in again when its token is refused, and exits non-zero only when it cannot recover.
#
#     systemctl --user enable --now flattrade-user@details.service
#     journalctl --user -u flattrade-user@details -f

[Unit]
Description=flattrade user %i
PartOf=flattrade.target
Wants=network-online.target
After=network-online.target
# Never give up restarting: a broker outage can outlast any start limit, and each script paces its own logins.
StartLimitIntervalSec=0

[Service]
Type=simple
# Python block-buffers stdout when it is not a terminal; without this the journal stays empty.
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=flattrade-user-%i
ExecStart=%h/Projects/unified_broker_interface/bin/flattrade/user/%i
Restart=always
RestartSec=15
# Exit 2 is a bad argument or configuration - nothing to subscribe to, say - which a restart cannot fix.
RestartPreventExitStatus=2
TimeoutStopSec=60

[Install]
WantedBy=flattrade.target
