# Everything that runs shoonya's bin/shoonya/ scripts. Enabling it starts them at boot; stopping it stops them all.
#
# Install - link every unit in this folder, then enable the target, the login timer and the scripts:
#
#     systemctl --user link ~/Projects/unified_broker_interface/services/shoonya/*
#     systemctl --user daemon-reload
#     systemctl --user enable --now shoonya.target shoonya-login.timer \
#         shoonya-instruments@websocket_quotes.service shoonya-instruments@store_quotes_to_db.service \
#         shoonya-orders@websocket_order_details.service shoonya-orders@store_orders_to_db.service shoonya-orders@api_order_details.service shoonya-orders@api_trade_details.service \
#         shoonya-portfolio@positions.service shoonya-portfolio@holdings.service shoonya-portfolio@funds.service \
#         shoonya-user@details.service \
#         shoonya-historical-prices.service

[Unit]
Description=shoonya scripts

[Install]
WantedBy=default.target
