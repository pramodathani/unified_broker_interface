# When to log shoonya in each morning.
#
# 07:12 IST every day, weekends included. The ten brokers log in at fixed times two minutes apart, in alphabetical
# order from Dhan at 07:00 to Zerodha at 07:18, so no two logins start together. Each slot is before the 07:45
# instrument download and the 09:00 pre-open, even after two retries, and well clear of MCX's 23:30 close.

[Unit]
Description=Daily login for shoonya
PartOf=shoonya.target

[Timer]
# The timezone is stated so the schedule survives a change to the machine's timezone.
OnCalendar=*-*-* 07:12 Asia/Kolkata
AccuracySec=1s
# A machine that was off at 07:00 needs no catch-up: the first script to find its token refused logs in then.
Persistent=false
Unit=shoonya-login.service

[Install]
WantedBy=timers.target
