# Everything that runs dhan's bin/dhan/ scripts. Enabling it starts them at boot; stopping it stops them all.
#
# Install - link every unit in this folder, then enable the target, the login timer and the scripts:
#
#     systemctl --user link ~/Projects/unified_broker_interface/services/dhan/*
#     systemctl --user daemon-reload
#     systemctl --user enable --now dhan.target dhan-login.timer \
#         dhan-instruments@websocket_quotes.service dhan-instruments@store_quotes_to_db.service \
#         dhan-orders@websocket_order_details.service dhan-orders@store_orders_to_db.service dhan-orders@api_order_details.service dhan-orders@api_trade_details.service \
#         dhan-portfolio@positions.service dhan-portfolio@holdings.service dhan-portfolio@funds.service \
#         dhan-user@details.service \
#         dhan-historical-prices.service

[Unit]
Description=dhan scripts

[Install]
WantedBy=default.target
