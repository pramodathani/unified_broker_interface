# Everything that runs dhan's bin/dhan/ scripts. Enabling it starts them at boot; stopping it stops them all.
#
# Install - link every unit in this folder, then enable the target, the login timer and the scripts:
#
#     systemctl --user link ~/Projects/unified_broker_interface/services/dhan/*
#     systemctl --user daemon-reload
#     systemctl --user enable --now dhan.target dhan-login.timer \
#         dhan@quotes.service dhan@order_updates.service dhan@persist_ticks.service dhan@persist_orders.service dhan@orders.service dhan@trades.service dhan@positions.service dhan@holdings.service dhan@funds.service dhan@user-profile.service dhan-historical-prices.service

[Unit]
Description=dhan scripts

[Install]
WantedBy=default.target
