# One bin/groww/instruments/ script that keeps running: groww-instruments@websocket_quotes.service runs the websocket
# quote feed into Redis, and groww-instruments@store_quotes_to_db.service runs the persister that drains that stream
# into groww.ticks. Both fit, because each one logs in by itself, logs in again when its token is refused, and exits
# non-zero only when it cannot recover. The rest of the folder is not run through this template: daily_feed is a
# once-a-day download that unified-mapping.service runs.
#
#     systemctl --user enable --now groww-instruments@websocket_quotes.service
#     journalctl --user -u groww-instruments@websocket_quotes -f

[Unit]
Description=groww instruments %i
PartOf=groww.target
Wants=network-online.target
After=network-online.target
# Never give up restarting: a broker outage can outlast any start limit, and each script paces its own logins.
StartLimitIntervalSec=0

[Service]
Type=simple
# Python block-buffers stdout when it is not a terminal; without this the journal stays empty.
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=groww-instruments-%i
ExecStart=%h/Projects/unified_broker_interface/bin/groww/instruments/%i
Restart=always
RestartSec=15
# Exit 2 is a bad argument or configuration - nothing to subscribe to, say - which a restart cannot fix.
RestartPreventExitStatus=2
TimeoutStopSec=60

[Install]
WantedBy=groww.target
