# When to log groww in each morning.
#
# 08:15 IST is after the overnight token expiry and the 07:45 instrument download, before the 09:00 pre-open, and well
# clear of MCX's 23:30 close.

[Unit]
Description=Daily login for groww
PartOf=groww.target

[Timer]
# The timezone is stated so the schedule survives a change to the machine's timezone.
OnCalendar=Mon..Fri 08:15 Asia/Kolkata
AccuracySec=1s
# Nine brokers log in with a TOTP, and Zerodha and Shoonya through a headless Chrome; half an hour of jitter keeps the
# ten logins from firing in the same second, and still lands every one before 09:00.
RandomizedDelaySec=1800
# A machine that was off at 08:15 needs no catch-up: the first script to find its token refused logs in then.
Persistent=false
Unit=groww-login.service

[Install]
WantedBy=timers.target
