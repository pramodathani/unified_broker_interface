# When the nightly unified price history check runs.
#
# 00:00 IST every day: once MCX's evening session has closed (23:30, or 23:55 while the United States is on standard
# time), so no market is open while it reads, and two hours before the 02:00 price job, which waits for it.
# Persistent=false, so a machine that was off at midnight does not run the check at boot, which could be during market hours.

[Unit]
Description=Nightly unified price history check
PartOf=unified.target

[Timer]
OnCalendar=*-*-* 00:00 Asia/Kolkata
AccuracySec=1min
Persistent=false
Unit=unified-prices-verify.service

[Install]
WantedBy=timers.target
