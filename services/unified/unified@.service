# One bin/unified/ script that keeps running: unified@quotes.service runs bin/unified/quotes, unified@user-profile.service
# runs bin/unified/user-profile. The combiners, the quote and update streams and the persisters all fit: each reads only
# Redis and the database, and retries a store that cannot be reached rather than exiting.
#
#     systemctl --user enable --now unified@quotes.service
#     journalctl --user -u unified@quotes -f

[Unit]
Description=Unified %i
PartOf=unified.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=unified-%i
ExecStart=%h/Projects/unified_broker_interface/bin/unified/%i
Restart=always
RestartSec=15
RestartPreventExitStatus=2
TimeoutStopSec=60

[Install]
WantedBy=unified.target
