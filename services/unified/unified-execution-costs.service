# The nightly execution cost measurement: bin/unified/orders/execution_costs reads the order engine's event log and the
# stored ticks, works out what every filled leg cost beyond brokerage, and writes one row per leg to
# unified.order_execution_costs. Then bin/unified/orders/latency_calibration turns the last 20 days of that table into
# each broker's latency cost and answer time in unified.broker_order_costs; it runs second so it always reads tonight's
# rows, and does not run if the measurement failed. Then bin/unified/orders/store_daily_orders saves every broker's
# orders of the day from unified:orders:orders to unified.daily_orders before Redis drops them at 06:00, and last
# bin/unified/orders/stop_slippage follows every protective stop that fired to the fill that closed its position,
# using those saved orders, and writes unified.stop_slippage. None of them calls a broker. Driven by
# unified-execution-costs.timer.
#
#     systemctl --user start unified-execution-costs        # run all four now
#     bin/unified/orders/execution_costs --dry-run           # see the measurement without writing it
#     bin/unified/orders/latency_calibration --dry-run       # see the latency figures without writing them
#     bin/unified/orders/store_daily_orders --dry-run        # see the day's orders without saving them
#     bin/unified/orders/stop_slippage --dry-run             # see the stop slippage without writing it

[Unit]
Description=Nightly order execution cost measurement
PartOf=unified.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=unified-execution-costs
ExecStart=%h/Projects/unified_broker_interface/bin/unified/orders/execution_costs
ExecStart=%h/Projects/unified_broker_interface/bin/unified/orders/latency_calibration
ExecStart=%h/Projects/unified_broker_interface/bin/unified/orders/store_daily_orders
ExecStart=%h/Projects/unified_broker_interface/bin/unified/orders/stop_slippage
TimeoutStartSec=10min
Nice=10
