# The daily instrument job: download every broker's instrument master, then map them into the unified tables and cache.
# Driven by unified-instruments.timer.
#
#     systemctl --user start unified-instruments      # run it now
#     journalctl --user -u unified-instruments
#
# Each download is prefixed with `-`, so one broker's file not arriving does not cost the other nine their mapping -
# bin/unified/map_instruments skips a broker with no rows stored for the date. Stoxkart is among them: its master is public and needs no login. The mapping's own exit status is the unit's.

[Unit]
Description=Daily instrument download and unified mapping
PartOf=unified.target
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=unified-instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/dhan/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/zerodha/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/flattrade/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/shoonya/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/fyers/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/indmoney/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/wisdom_capital/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/groww/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/kotak/instruments
ExecStart=-%h/Projects/unified_broker_interface/bin/stoxkart/instruments
ExecStart=%h/Projects/unified_broker_interface/bin/unified/map_instruments
# Ten downloads of up to 120 MB each, then a full mapping of every broker - about three quarters of an hour.
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
CPUWeight=20
