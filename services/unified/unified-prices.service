# The nightly unified price history update: bin/unified/instruments/price_history daily, which runs load, corrections, load,
# factors --stale-days 14 and a load of each intraday interval. Its check, verify, runs before it at midnight from
# unified-prices-verify.service. Driven by unified-prices.timer.
#
#     systemctl --user start unified-prices           # run it now
#     bin/unified/instruments/price_history status

[Unit]
Description=Unified price history and adjustment factors
PartOf=unified.target
Wants=network-online.target
# A start waits for a running instrument job or price check to finish: the history loads against a finished mapping, and
# two price_history runs at once deadlock on the DDL each applies when it starts. Ordering applies to a job already
# running, not only to one started in the same transaction.
After=network-online.target unified-mapping.service unified-prices-verify.service

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=unified-prices
ExecStart=%h/Projects/unified_broker_interface/bin/unified/instruments/price_history daily
# The first factors run over every instrument is thousands of Yahoo requests at about one a second, and the intraday
# loads follow. Six hours from 02:00 ends it by 08:00, before the 08:25 feed restarts and the 09:00 pre-open.
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
CPUWeight=20
