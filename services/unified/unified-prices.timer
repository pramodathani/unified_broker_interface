# When the unified price history update runs.
#
# 02:00 IST every day: every market has closed (MCX by 23:55 at the latest), and the price check that starts at 00:00 has
# usually finished; if it has not, the job waits for it. The job takes three hours or more, so at 08:30, where it used to
# run, it read the database into market hours and slowed the live tick writers. The brokers' candle downloaders work
# their queues all day, so the job loads whatever has arrived by 02:00 and the rest the next night.
# Persistent=false, so a machine that was off at 02:00 does not run the job at boot, which could be during market hours.

[Unit]
Description=Nightly unified price history update
PartOf=unified.target

[Timer]
OnCalendar=*-*-* 02:00 Asia/Kolkata
AccuracySec=1min
Persistent=false
Unit=unified-prices.service

[Install]
WantedBy=timers.target
