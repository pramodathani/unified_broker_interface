# When the database check runs.
#
# Once a minute, from 30 seconds after the timer starts, whether the last run succeeded or failed.

[Unit]
Description=Start any stopped database container, every minute
PartOf=databases.target

[Timer]
OnActiveSec=30s
OnUnitInactiveSec=1min
AccuracySec=5s
Unit=databases.service

[Install]
WantedBy=timers.target
