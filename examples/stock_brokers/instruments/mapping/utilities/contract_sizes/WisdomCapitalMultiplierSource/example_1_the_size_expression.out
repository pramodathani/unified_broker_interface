Name: wisdom_capital_multiplier
Broker: wisdom_capital
Token column: exchangeinstrumentid
Exchange column: exchangesegment
Trusted exchange labels: ['MCXFO', 'NSECO']
Size expression: (CASE WHEN raw."multiplier"::text ~ '^-?[0-9]+(\.[0-9]+)?$' THEN raw."multiplier"::text::numeric END)
Query:
SELECT m.instrument_id::text AS instrument_id, (CASE WHEN raw."multiplier"::text ~ '^-?[0-9]+(\.[0-9]+)?$' THEN raw."multiplier"::text::numeric END) AS units FROM unified.broker_mappings m JOIN unified.instruments i ON i.instrument_id = m.instrument_id JOIN wisdom_capital.instruments raw ON raw."exchangeinstrumentid"::text = m.broker_token AND raw.download_date = m.mapping_date WHERE m.broker = :broker AND m.mapping_date = :mapping_date AND i.segment = ANY(:segments) AND (i.expiry_date IS NULL OR i.expiry_date >= :mapping_date) AND raw."exchangesegment"::text = ANY(:exchanges)
