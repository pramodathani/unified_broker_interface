Name: shoonya_lot_size_times_multiplier
Broker: shoonya
Token column: token
Exchange column: exchange
Trusted exchange labels: ['CDS']
Size expression: ((CASE WHEN raw."lotsize"::text ~ '^-?[0-9]+(\.[0-9]+)?$' THEN raw."lotsize"::text::numeric END) * (CASE WHEN raw."multiplier"::text ~ '^-?[0-9]+(\.[0-9]+)?$' THEN raw."multiplier"::text::numeric END))
Query:
SELECT m.instrument_id::text AS instrument_id, ((CASE WHEN raw."lotsize"::text ~ '^-?[0-9]+(\.[0-9]+)?$' THEN raw."lotsize"::text::numeric END) * (CASE WHEN raw."multiplier"::text ~ '^-?[0-9]+(\.[0-9]+)?$' THEN raw."multiplier"::text::numeric END)) AS units FROM unified.broker_mappings m JOIN unified.instruments i ON i.instrument_id = m.instrument_id JOIN shoonya.instruments raw ON raw."token"::text = m.broker_token AND raw.download_date = m.mapping_date WHERE m.broker = :broker AND m.mapping_date = :mapping_date AND i.segment = ANY(:segments) AND (i.expiry_date IS NULL OR i.expiry_date >= :mapping_date) AND raw."exchange"::text = ANY(:exchanges)
