#!/usr/bin/env python3
"""
Poll the INDmoney funds every half second and write them to the Redis key `indmoney:portfolio:funds`.

    bin/indmoney/portfolio/funds
    redis-cli GET indmoney:portfolio:funds

Calls `GET https://api.indstocks.com/funds` through `INDMoneyAPI`, which logs in first if the stored session
is dead. Each response - `timestamp`, `status`, `code` and INDstocks' funds under `data`: `sod_balance`
(the start of day cash), `pledge_received`, `withdrawal_balance`, `funds_added`, `funds_withdrawn`,
`realized_pnl`, `unrealized_pnl`, and `detailed_avl_balance`, the balance by product (`eq_cnc`, `eq_mis`,
`eq_mtf`, `future`, `option_buy`, `option_sell`, `comm_option_buy`) - is written as one JSON string with
SET, replacing the one before. INDstocks states no single available figure.

Runs until Ctrl+C. A dead session (a refusal naming the access token, asking to re-authenticate, or
unauthorized) is logged in again before the next request; any other failed poll is logged and leaves
`indmoney:portfolio:funds` unchanged. Exits 1 when the first login, or a login after the session died,
fails. Reads only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

FUNDS_URL = "https://api.indstocks.com/funds"
REDIS_KEY = "indmoney:portfolio:funds"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

# What INDstocks says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("access_token", "re-authenticate", "unauthorized")

def is_authentication_error(exception):
    """Whether INDstocks refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the funds and write them to indmoney:portfolio:funds every half second, until interrupted."""
    from stock_brokers.api.indmoney import INDMoneyAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("indmoney.funds")
    report = PollReporter(logger)
    cache = get_cache()
    try:
        indmoney = INDMoneyAPI()
    except Exception as exception:
        logger.error(f"Could not log in to INDmoney: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                funds = indmoney.get(url=FUNDS_URL, timeout=TIMEOUT_SECONDS)
                cache.set(REDIS_KEY, json.dumps(funds))
                data = funds.get('data') if isinstance(funds.get('data'), dict) else {}
                report.info(f"Wrote funds (start of day balance {data.get('sod_balance')}) to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"INDmoney session expired, logging in again: {exception}")
                    indmoney = INDMoneyAPI()
                else:
                    report.error(f"Funds poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
