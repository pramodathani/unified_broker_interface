#!/usr/bin/env python3
"""
Poll the INDmoney holdings every minute and write them to the Redis key `indmoney:portfolio:holdings`.

    bin/indmoney/portfolio/holdings
    redis-cli GET indmoney:portfolio:holdings

Calls `GET https://api.indstocks.com/portfolio/holdings` through `INDMoneyAPI`, which logs in first if the
stored session is dead. Each response - `timestamp`, `status`, `code` and INDstocks' holdings list under
`data`, one row per holding with `security_id` (NSE's), `isin`, `symbol`, `total_qty`, `dp_qty`, `t1_qty`,
`used_qty` (pledged) and `avg_price`, and no exchange or price - is written as one JSON string with SET,
replacing the one before. INDstocks answers an account holding nothing with `null` or `{}`, which is
written as `[]`.

Runs until Ctrl+C. A dead session (a refusal naming the access token, asking to re-authenticate, or
unauthorized) is logged in again before the next request; any other failed poll is logged and leaves
`indmoney:portfolio:holdings` unchanged. Exits 1 when the first login, or a login after the session died,
fails. Reads only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

HOLDINGS_URL = "https://api.indstocks.com/portfolio/holdings"
REDIS_KEY = "indmoney:portfolio:holdings"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10

# What INDstocks says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("access_token", "re-authenticate", "unauthorized")

def is_authentication_error(exception):
    """Whether INDstocks refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the holdings and write them to indmoney:portfolio:holdings every minute, until interrupted."""
    from stock_brokers.api.indmoney import INDMoneyAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("indmoney.holdings")
    cache = get_cache()
    try:
        indmoney = INDMoneyAPI()
    except Exception as exception:
        logger.error(f"Could not log in to INDmoney: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                holdings = indmoney.get(url=HOLDINGS_URL, timeout=TIMEOUT_SECONDS)
                if holdings.get('data') in (None, {}):
                    holdings['data'] = []
                cache.set(REDIS_KEY, json.dumps(holdings))
                data = holdings['data']
                logger.info(f"Wrote {len(data) if isinstance(data, list) else 0} holdings to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"INDmoney session expired, logging in again: {exception}")
                    indmoney = INDMoneyAPI()
                else:
                    logger.error(f"Holdings poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
