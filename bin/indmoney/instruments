#!/usr/bin/env python3
"""
Download INDmoney's instrument master, append today's snapshot to `indmoney.instruments`, and store it in Redis as
`indmoney:instruments:master` with `indmoney:instruments:meta` beside it.

    bin/indmoney/instruments
    bin/indmoney/instruments --bootstrap          # replace today's stored snapshot in the table

    redis-cli HGET indmoney:instruments:master NSE:E:2885
    redis-cli GET indmoney:instruments:meta

**The download** is INDstocks' instrument master, which unlike every other broker's is not public: three CSV files -
`equity`, `fno` and `index` - from `GET https://api.indstocks.com/market/instruments?source=<file>`, each behind an
`Authorization` header carrying the access token. The script logs in with `INDMoneyAPI` first, which generates a new
token when the stored one is dead, and hands that token to `IndMoneyInstruments`; should the download still find no
usable token, it logs in through `INDMoneyAPI` again. The files are fetched once and used for both stores.

**The table** is written by `IndMoneyInstruments.ingest`: column names normalized to snake_case, whitespace
stripped, empty artifact columns dropped, `NSETEST` placeholder rows dropped, duplicates on
`(exch, segment, security_id)` dropped, `download_date` added, and the rows appended to `indmoney.instruments`. A
date already stored is skipped unless `--bootstrap` is given, and a row count more than ten percent off the earlier
days' average is reported.

**Redis** gets the same cleaned rows, whether or not the table already had today's:

- `indmoney:instruments:master`, a hash with one field per instrument, `EXCH:SEGMENT:SECURITY_ID` as the files spell
  them (`NSE:E:2885`, `NSE:D:68777`) - the table's own natural key. An index's segment is the index's own name. The
  value is the row as a JSON array in column order, with `null` for a value INDstocks left blank or `NA`; the column
  names are stored once in the meta key rather than in every row. `bin/indmoney/quotes` reads its instrument names
  from here.
- `indmoney:instruments:meta`, a JSON object: `download_date`, `rows`, `columns` (the order the arrays follow),
  `source_last_modified` (always null: the files sit behind a login and are not probed a second time) and
  `written_at`.

The hash is built under `indmoney:instruments:master:staging` and swapped in at the end, so a reader sees either
yesterday's complete hash or today's, never one half-written; the previous hash is unlinked in the background rather
than freed inline.

Exits 0 when both the table and Redis were written (or the table already held today's snapshot), and 1 when the
login, the download, the table write or the Redis write failed, saying which.
"""

import sys
import json
import argparse
from datetime import date, datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

MASTER_KEY = "indmoney:instruments:master"
STAGING_KEY = "indmoney:instruments:master:staging"
PREVIOUS_KEY = "indmoney:instruments:master:previous"
META_KEY = "indmoney:instruments:meta"

KEY_COLUMNS = ("exch", "segment", "security_id")
FIELDS_PER_BATCH = 5000

def downloader():
    """
    An IndMoneyInstruments that authenticates through INDMoneyAPI and downloads once, so the table write and Redis
    share one fetch.
    """
    from stock_brokers.api.indmoney import INDMoneyAPI
    from stock_brokers.instruments.indmoney import IndMoneyInstruments

    def current_token(indmoney):
        """The access token in force for an INDMoneyAPI, which may be one another process has just obtained."""
        return (indmoney._current_login() or {}).get('access_token')

    class DirectLoginIndMoneyInstruments(IndMoneyInstruments):
        """IndMoneyInstruments that logs in through INDMoneyAPI and keeps the frame it downloaded."""

        _frame = None

        def establish_session(self):
            """Log in through INDMoneyAPI, which generates a new token when the stored one is refused."""
            try:
                return current_token(INDMoneyAPI())
            except Exception as exception:
                print(f"indmoney: could not log in for the instrument download: {type(exception).__name__}: {exception}")
                return None

        def download(self):
            if self._frame is None:
                self._frame = super().download()
            return self._frame.copy()

    return DirectLoginIndMoneyInstruments(access_token=current_token(INDMoneyAPI()))

def cleaned(ingester):
    """
    The downloaded rows cleaned exactly as `ingest` cleans them before the table write.

    - `ingester` is the IndMoneyInstruments that downloaded the files.
    """
    frame = ingester.download()
    for step in (ingester.normalize_columns, ingester.strip_whitespace, ingester.drop_unnamed_columns,
                 ingester.drop_garbage_rows, ingester.dedupe):
        frame = step(frame)
    return frame

def write_redis(cache, frame, download_date, logger):
    """
    Build the instrument hash under a staging key, then swap it and the meta in together.

    - `cache` is the Redis client.
    - `frame` is the cleaned instrument rows.
    - `download_date` is the snapshot's date.
    - `logger` is where progress is reported.
    """
    columns = list(frame.columns)
    key_positions = [columns.index(column) for column in KEY_COLUMNS]
    # Blank and "NA" arrive as NaN, which is not JSON; NaN is the one value unequal to itself.
    rows = [[None if value != value else value for value in row] for row in frame.itertuples(index=False, name=None)]

    cache.unlink(STAGING_KEY)
    for start in range(0, len(rows), FIELDS_PER_BATCH):
        batch = rows[start:start + FIELDS_PER_BATCH]
        cache.hset(STAGING_KEY, mapping={":".join(str(row[position]) for position in key_positions): json.dumps(row)
                                         for row in batch})
    stored = cache.hlen(STAGING_KEY)

    meta = {"download_date": str(download_date), "rows": stored, "columns": columns, "source_last_modified": None,
            "written_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")}

    # Renaming onto an existing key frees the old value inline, which for a hash this size can stall Redis,
    # so the old hash is moved aside and unlinked, which frees it in the background.
    pipeline = cache.pipeline(transaction=True)
    if cache.exists(MASTER_KEY):
        pipeline.rename(MASTER_KEY, PREVIOUS_KEY)
    pipeline.rename(STAGING_KEY, MASTER_KEY)
    pipeline.set(META_KEY, json.dumps(meta))
    pipeline.unlink(PREVIOUS_KEY)
    pipeline.execute()

    if stored != len(rows):
        logger.warning(f"{len(rows)} row(s) produced {stored} field(s): some rows share an EXCH:SEGMENT:SECURITY_ID.")
    logger.info(f"Wrote {stored} instrument(s) to {MASTER_KEY} and the meta to {META_KEY}.")

def main():
    """Download INDmoney's instrument master into indmoney.instruments and Redis."""
    parser = argparse.ArgumentParser(description="Download INDmoney's instrument master into indmoney.instruments and Redis.")
    parser.add_argument("--bootstrap", action="store_true",
                        help="replace today's stored snapshot in the table instead of skipping")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("indmoney.instruments")
    download_date = date.today()

    try:
        ingester = downloader()
    except Exception as exception:
        logger.error(f"Could not log in to INDmoney: {type(exception).__name__}: {exception}")
        return 1

    try:
        frame = cleaned(ingester)
    except Exception as exception:
        logger.error(f"Could not download INDmoney's instrument master: {type(exception).__name__}: {exception}")
        return 1
    logger.info(f"Downloaded {len(frame)} instrument(s) for {download_date}.")

    failures = []
    try:
        rows = ingester.ingest(download_date=download_date, bootstrap=arguments.bootstrap)
        if rows:
            ingester.check_row_count_deviation(download_date)
    except Exception as exception:
        failures.append("table")
        logger.error(f"Could not write indmoney.instruments: {type(exception).__name__}: {exception}")

    try:
        write_redis(get_cache(), frame, download_date, logger)
    except Exception as exception:
        failures.append("Redis")
        logger.error(f"Could not write {MASTER_KEY}: {type(exception).__name__}: {exception}")

    if failures:
        logger.error(f"Failed: {' and '.join(failures)}.")
        return 1
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
