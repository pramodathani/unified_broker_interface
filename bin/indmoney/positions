#!/usr/bin/env python3
"""
Poll the INDmoney positions every half second and merge them into the Redis hash `indmoney:portfolio:positions`.

    bin/indmoney/positions
    redis-cli HGETALL indmoney:portfolio:positions
    redis-cli HGET indmoney:portfolio:positions NSE:2885:INTRADAY

Calls `GET https://api.indstocks.com/portfolio/positions` through `INDMoneyAPI`, which logs in first if the stored
session is dead. A flat account answers `[]`, `null` or `{}`, which writes nothing.

**One key for positions.** `indmoney:portfolio:positions` is a hash with one field per position, keyed
`exchange:security_id:product` - one position per instrument and product, with `segment` standing in when a row has
no `exchange`. Every value is

    {"observed_at": <epoch>, "source": "rest", "position": <normalized position>, "data": <INDstocks' own row>}

with the same shape the brokers that also stream positions over a websocket use, so a reader handles every broker
alike. INDstocks streams no positions, so this poller is the one writer; the merge rule below is there so a second
writer could share the key. `position` has `id`, `instrument_token`, `tradingsymbol`, `exchange`, `segment`, `product`,
`quantity`, `buy_quantity`, `sell_quantity`, `buy_price`, `sell_price`, `buy_value`, `sell_value`, `average_price`,
`last_price`, `realized_pnl`, `unrealized_pnl`, `pnl`, `multiplier`, `lot_size`, `day_or_net` and `updated_at`.

INDstocks publishes no positions schema and no position has been seen, so the fields read are an unconfirmed reading,
the likeliest of any broker's to need correcting once a real position arrives:

| field | from INDstocks |
| --- | --- |
| `id` | `exchange:symbol` |
| `instrument_token`, `tradingsymbol` | `security_id`, `symbol` or `trading_symbol` |
| `exchange`, `segment` | `exchange` (else `segment`), `segment` |
| `product` | `product` on the shared vocabulary (`CNC`, `MIS`, `NRML`...) |
| `quantity`, `buy_quantity`, `sell_quantity` | `net_qty`, `buy_qty`, `sell_qty` |
| `buy_value`, `sell_value` | `buy_value`, `sell_value` |
| `buy_price`, `sell_price` | value divided by quantity, as INDstocks reports values rather than averages |
| `last_price` | `last_price` or `ltp` |
| `realized_pnl`, `unrealized_pnl`, `pnl` | `realized_pnl`, `unrealized_pnl`, and their sum |

No average price, multiplier, lot size, day or net view, or update time is known, so those are null.

**Which write wins.** A row from this poller replaces an entry only when that entry was observed before this poll's
request was sent, so an entry from a newer writer is never overwritten by an older snapshot. The check and the write
run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00. A position INDstocks
stops listing during the day is not removed before then.

Runs until Ctrl+C. A dead session (a refusal naming the access token, asking to re-authenticate, or unauthorized) is
logged in again before the next request; any other failed poll is logged and leaves the hash unchanged. Exits 1 when
the first login, or a login after the session died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

POSITIONS_URL = "https://api.indstocks.com/portfolio/positions"
REDIS_KEY = "indmoney:portfolio:positions"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "indmoney:portfolio:positions:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

# What INDstocks says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("access_token", "re-authenticate", "unauthorized")

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def first(data, *names):
    """
    The first present value among several spellings of a field, or None.

    - `data` is the row.
    - `names` are the spellings to try, in order.
    """
    for name in names:
        if present(data.get(name)) is not None:
            return data[name]
    return None

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def position_key(row):
    """
    The hash field for an INDstocks position row, `exchange:security_id:product`, or None when it lacks one of them.

    - `row` is one row of `GET /portfolio/positions`.
    """
    if not isinstance(row, dict):
        return None
    parts = [text(first(row, 'exchange', 'segment')), text(row.get('security_id')), text(row.get('product'))]
    return ":".join(parts) if all(parts) else None

def position_from_row(row):
    """
    An INDstocks position row as a normalized position.

    - `row` is one row of `GET /portfolio/positions`.
    """
    exchange, symbol = text(first(row, 'exchange', 'segment')), text(first(row, 'symbol', 'trading_symbol'))
    buy_quantity, sell_quantity = number(row.get('buy_qty'), int), number(row.get('sell_qty'), int)
    buy_value, sell_value = number(row.get('buy_value')), number(row.get('sell_value'))
    realized, unrealized = number(row.get('realized_pnl')), number(row.get('unrealized_pnl'))
    return {
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('security_id')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "segment": text(row.get('segment')),
        "product": normalize(present(row.get('product')), PRODUCTS),
        "quantity": number(row.get('net_qty'), int),
        "buy_quantity": buy_quantity,
        "sell_quantity": sell_quantity,
        "buy_price": buy_value / buy_quantity if buy_value is not None and buy_quantity else None,
        "sell_price": sell_value / sell_quantity if sell_value is not None and sell_quantity else None,
        "buy_value": buy_value,
        "sell_value": sell_value,
        "average_price": None,
        "last_price": number(first(row, 'last_price', 'ltp')),
        "realized_pnl": realized,
        "unrealized_pnl": unrealized,
        "pnl": realized + unrealized if realized is not None and unrealized is not None else None,
        "multiplier": None,
        "lot_size": None,
        "day_or_net": None,
        "updated_at": None,
    }

def is_authentication_error(exception):
    """Whether INDstocks refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the positions and merge them into indmoney:portfolio:positions every half second, until interrupted."""
    from stock_brokers.api.indmoney import INDMoneyAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("indmoney.positions")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        indmoney = INDMoneyAPI()
    except Exception as exception:
        logger.error(f"Could not log in to INDmoney: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = indmoney.get(url=POSITIONS_URL, timeout=TIMEOUT_SECONDS)
                rows = response.get('data') if isinstance(response.get('data'), list) else []
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    field = position_key(row)
                    if field is not None:
                        arguments += [field, json.dumps({"observed_at": requested_at, "source": "rest",
                                                         "position": position_from_row(row), "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} position(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"INDmoney session expired, logging in again: {exception}")
                    indmoney = INDMoneyAPI()
                else:
                    report.error(f"Positions poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
