#!/usr/bin/env python3
"""
Poll the day's INDmoney order book every half second and merge it into the Redis hash `indmoney:orders:orders`.

    bin/indmoney/orders
    redis-cli HGETALL indmoney:orders:orders
    redis-cli HGET indmoney:orders:orders <order id>

Calls `GET https://api.indstocks.com/order-book` through `INDMoneyAPI`, which logs in first if the stored session is
dead. A row carries `id`, `exch_order_id`, `status`, `security_id`, `name` (the company, not a trading symbol),
`exchange`, `segment`, `txn_type`, `product`, `order_type`, `validity`, `requested_qty`, `traded_qty`,
`requested_price`, `traded_price`, `sl_trigger_price`, `created_at`, `updated_at` and `remarks`. INDstocks answers an
empty book with `null`, which writes nothing.

**One key for orders.** `indmoney:orders:orders` is a hash keyed by order id, written by two scripts: this poller, and
`bin/indmoney/order_updates`, which merges each order update from INDstocks' websocket into the same hash. Every value
is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "order": <normalized order>, "data": <INDstocks' own payload>}

`order` has the same fields whichever script wrote it - `order_id`, `exchange_order_id`, `parent_order_id`, `status`,
`status_message`, `id`, `instrument_token`, `tradingsymbol`, `exchange`, `transaction_type`, `product`, `order_type`,
`validity`, `quantity`, `filled_quantity`, `pending_quantity`, `cancelled_quantity`, `disclosed_quantity`, `price`,
`trigger_price`, `average_price`, `order_timestamp`, `exchange_timestamp` and `tag` - because INDstocks' order book
and its order update stream name the same things differently:

| field | order book (`bin/indmoney/orders`) | order update (`bin/indmoney/order_updates`) |
| --- | --- | --- |
| `order_id` | `id` | `order_id` or `orderId` |
| `exchange_order_id` | `exch_order_id` | `exchange_order_id` or `exch_order_id` |
| `status` | `status` | `order_status` or `status` |
| `id` | `exchange:security_id` | `exchange:security_id` |
| `instrument_token`, `exchange` | `security_id`, `exchange` | `security_id`, `exchange` |
| `tradingsymbol` | null - the book names the company, not the symbol | `trading_symbol`, `tradingsymbol` or `symbol` |
| `transaction_type`, `product`, `order_type`, `validity` | `txn_type`, `product`, `order_type`, `validity` | the same, or `transaction_type`/`side`, `product_type`, `price_type`, `time_in_force` |
| `quantity`, `filled_quantity` | `requested_qty`, `traded_qty` | `quantity` or `qty`, `filled_quantity` or `filled_qty` |
| `pending_quantity` | `requested_qty` less `traded_qty` | `remaining_quantity`, or quantity less filled |
| `price`, `trigger_price`, `average_price` | `requested_price`, `sl_trigger_price`, `traded_price` | `price`, `trigger_price`, `average_price` (or `limit_price`, `stop_price`, `avg_price`) |
| `order_timestamp`, `exchange_timestamp` | `created_at`, `updated_at` | `order_timestamp`, `exchange_timestamp`, else the message's `timestamp` |
| `status_message` | null - the book carries none | `status_message`, `rejection_reason` or `message` |
| `cancelled_quantity`, `disclosed_quantity` | null - the book carries neither | `cancelled_quantity`, `disclosed_quantity` |
| `parent_order_id` | null | `parent_order_id` |
| `tag` | `remarks` | `tag` or `remarks` |

`id` is `exchange:security_id` rather than `exchange:tradingsymbol` because the order book has no trading symbol, and
the two writers must agree. Status, side, product, order type and validity are on the shared vocabulary (`PENDING`,
`OPEN`, `COMPLETE`, `CANCELLED`, `REJECTED`, `EXPIRED` for status). An epoch time is an instant and text is IST wall
clock; both are written as ISO timestamps with the IST offset.

**The same order on both sides.** The hash key is the order id both writers see. INDstocks answers a placement with
`order_id`, and its order book lists that same order under `id` - the modify and cancel requests the project sends take
`order_id` from the book's `id` - while the update stream reports it as `order_id`.

**Which write wins.** A websocket update always replaces its order's entry. A row from this poller replaces an entry
only when that entry was observed before this poll's request was sent, so an update that arrived while the request
was in flight is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and
the write run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00, so yesterday's orders
remain readable overnight and the first poll of the day starts a fresh hash. An order is never removed before then:
one the websocket has just reported may not be in the order book yet.

Runs until Ctrl+C. A dead session (a refusal naming the access token, asking to re-authenticate, or unauthorized) is
logged in again before the next request; any other failed poll is logged and leaves the hash unchanged. Exits 1 when
the first login, or a login after the session died, fails. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_URL = "https://api.indstocks.com/order-book"
REDIS_KEY = "indmoney:orders:orders"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "indmoney:orders:orders:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

# What INDstocks says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("access_token", "re-authenticate", "unauthorized")

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
    "BUY": "BUY", "B": "BUY", "1": "BUY", "BUY ORDER": "BUY",
    "SELL": "SELL", "S": "SELL", "-1": "SELL", "2": "SELL", "SELL ORDER": "SELL",
}
PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}
ORDER_TYPES = {
    "MARKET": "MARKET", "MKT": "MARKET", "MKT ORDER": "MARKET", "2": "MARKET",
    "LIMIT": "LIMIT", "LMT": "LIMIT", "L": "LIMIT", "1": "LIMIT",
    "SL": "SL", "SL-LMT": "SL", "STOPLIMIT": "SL", "SL LIMIT": "SL", "4": "SL",
    "SL-M": "SL-M", "SL-MKT": "SL-M", "STOPMARKET": "SL-M", "SL MARKET": "SL-M", "3": "SL-M", "SL M": "SL-M",
    "SLM": "SL-M", "STOP LOSS": "SL", "STOP LOSS MARKET": "SL-M",
}
VALIDITIES = {
    "DAY": "DAY", "EOS": "DAY", "0": "DAY", "IOC": "IOC", "IMMEDIATE": "IOC", "1": "IOC",
    "GTT": "GTT", "GTC": "GTC", "GTD": "GTD",
}
STATUSES = {
    "PENDING": "PENDING", "TRANSIT": "PENDING", "VALIDATION PENDING": "PENDING", "PUT ORDER REQ RECEIVED": "PENDING",
    "TRIGGER PENDING": "PENDING", "AMO REQ RECEIVED": "PENDING", "PENDINGNEW": "PENDING", "O-PENDING": "PENDING",
    "MODIFY AMO REQ RECEIVED": "PENDING", "AFTER MARKET ORDER REQ RECEIVED": "PENDING", "AMO PENDING": "PENDING",
    "MODIFY AFTER MARKET ORDER REQ RECEIVED": "PENDING", "QUEUED": "PENDING", "PROCESSING": "PENDING",
    "SL-PENDING": "PENDING",
    "OPEN": "OPEN", "OPEN PENDING": "OPEN", "NEW": "OPEN", "REPLACED": "OPEN", "ACKED": "OPEN", "APPROVED": "OPEN",
    "MODIFICATION REQUESTED": "OPEN", "MODIFIED": "OPEN", "MODIFY VALIDATION PENDING": "OPEN", "MODIFY PENDING": "OPEN",
    "PARTIALLY FILLED": "OPEN", "PARTIALLY EXECUTED": "OPEN", "PLACED": "OPEN", "PART TRADED": "OPEN",
    "PARTIALLYFILLED": "OPEN", "PENDINGREPLACE": "OPEN", "CONFIRMED": "OPEN", "PARTIALLY TRADED": "OPEN",
    "INITIATED": "OPEN",
    "COMPLETE": "COMPLETE", "COMPLETED": "COMPLETE", "TRADED": "COMPLETE", "FILLED": "COMPLETE",
    "EXECUTED": "COMPLETE", "FULLY EXECUTED": "COMPLETE", "DELIVERY AWAITED": "COMPLETE", "SUCCESS": "COMPLETE",
    "CANCELLED": "CANCELLED", "CANCELED": "CANCELLED", "CANCEL": "CANCELLED", "CANCEL PENDING": "CANCELLED",
    "CANCELLATION REQUESTED": "CANCELLED", "PENDINGCANCEL": "CANCELLED", "CANCELLED AFTER MARKET ORDER": "CANCELLED",
    "AMO CANCELLED": "CANCELLED", "PARTIALLY FILLED - CANCELLED": "CANCELLED",
    "REJECTED": "REJECTED", "REJECT": "REJECTED", "FAILED": "REJECTED", "ABORTED": "REJECTED",
    "EXPIRED": "EXPIRED", "PARTIALLY FILLED - EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def first(data, *names):
    """
    The first present value among several spellings of a field, or None.

    - `data` is the row or message.
    - `names` are the spellings to try, in order.
    """
    for name in names:
        if present(data.get(name)) is not None:
            return data[name]
    return None

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def order_timestamp(value):
    """
    An INDstocks order time as an ISO timestamp with the IST offset, or None.

    An epoch - milliseconds above 10^11, seconds below - is an instant; text is read as IST wall clock. Both are written
    with the IST offset, so the same moment reads the same from either writer. A placeholder year before 1971 reads as
    None.

    - `value` is the time as INDstocks sent it.
    """
    value = present(value)
    if value is None:
        return None
    epoch = number(value)
    if epoch is not None:
        if epoch <= 0:
            return None
        try:
            return datetime.fromtimestamp(epoch / 1000 if epoch > 1e11 else epoch, tz=INDIA).isoformat()
        except (OverflowError, OSError, ValueError):
            return None
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%d/%m/%Y %H:%M:%S", "%d-%b-%Y %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            moment = datetime.strptime(str(value).strip()[:19], fmt)
        except ValueError:
            continue
        return None if moment.year < 1971 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_book(row):
    """
    An INDstocks order-book row as a normalized order, or None when it has no order id.

    - `row` is one row of `GET /order-book`.
    """
    if not isinstance(row, dict) or text(row.get('id')) is None:
        return None
    exchange, security_id = text(row.get('exchange')), text(row.get('security_id'))
    quantity, filled = number(row.get('requested_qty'), int), number(row.get('traded_qty'), int)
    return {
        "order_id": text(row.get('id')),
        "exchange_order_id": text(row.get('exch_order_id')),
        "parent_order_id": None,
        "status": normalize(present(row.get('status')), STATUSES),
        "status_message": None,
        "id": f"{exchange}:{security_id}" if exchange and security_id else None,
        "instrument_token": security_id,
        "tradingsymbol": None,
        "exchange": exchange,
        "transaction_type": normalize(present(row.get('txn_type')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('product')), PRODUCTS),
        "order_type": normalize(present(row.get('order_type')), ORDER_TYPES),
        "validity": normalize(present(row.get('validity')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": (quantity - (filled or 0)) if quantity is not None else None,
        "cancelled_quantity": None,
        "disclosed_quantity": None,
        "price": number(row.get('requested_price')),
        "trigger_price": number(row.get('sl_trigger_price')),
        "average_price": number(row.get('traded_price')),
        "order_timestamp": order_timestamp(row.get('created_at')),
        "exchange_timestamp": order_timestamp(row.get('updated_at')),
        "tag": text(row.get('remarks')),
    }

def is_authentication_error(exception):
    """Whether INDstocks refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the order book and merge it into indmoney:orders:orders every half second, until interrupted."""
    from stock_brokers.api.indmoney import INDMoneyAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("indmoney.orders")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        indmoney = INDMoneyAPI()
    except Exception as exception:
        logger.error(f"Could not log in to INDmoney: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = indmoney.get(url=ORDERS_URL, timeout=TIMEOUT_SECONDS)
                rows = response.get('data') if isinstance(response.get('data'), list) else []
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    order = order_from_book(row)
                    if order is not None:
                        arguments += [order["order_id"], json.dumps({"observed_at": requested_at, "source": "rest",
                                                                     "order": order, "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} order(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"INDmoney session expired, logging in again: {exception}")
                    indmoney = INDMoneyAPI()
                else:
                    report.error(f"Orders poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
