#!/usr/bin/env python3
"""
Stream INDmoney (INDstocks) order updates over a websocket and merge them into the Redis hash `indmoney:orders:orders`,
and keep streaming until stopped.

    bin/indmoney/orders/websocket_order_details
    redis-cli HGETALL indmoney:orders:orders
    redis-cli HGET indmoney:orders:orders <order id>

The connection and the login are `IndmoneyOrderUpdatesSocket` and `IndmoneySession` in
`stock_brokers/websockets/indmoney.py`, whose module docstring describes the handshake and the messages at
`wss://ws-order-updates.indstocks.com/api/v1/ws/trades`. This script runs the socket and turns the orders it hands
over into the Redis writes below, so it needs no other feed process or key.

**The stream.** The access token travels as an `Authorization` header in the websocket handshake, with the api key
as `x-api-key`. Nothing arrives until the socket asks, so on opening it sends `{"action": "subscribe", "mode":
"order_update"}`. From then on every change to an order arrives as a JSON message whose `type` is `order`, with the
order's fields at the top level of the message - INDstocks documents `order_id`, `order_status`,
`filled_quantity`, `remaining_quantity`, `average_price` and a millisecond `timestamp`, and a real order carries more
(`exchange_order_id`, `trading_symbol`, `exchange`, `security_id`, `txn_type`, `product`, `order_type`, `validity`,
`quantity`, `price`, `trigger_price`, `remarks`). A nested `data` object is accepted too, in case the shape is richer
than documented.

**The key.** `indmoney:orders:orders` is the one hash for INDmoney's orders, keyed by order id and shared with
`bin/indmoney/orders/api_order_details`, which merges the polled order book into it. Each update is written as
`{"observed_at": <epoch received>, "source": "websocket", "order": <normalized order>, "data": <order>}`, with
INDstocks' order exactly as sent in `data` (the nested `data` object when the message has one) and the same normalized
`order` the poller builds from an order-book row - see `bin/indmoney/orders/api_order_details` for its fields and which side supplies
each. `id` is `exchange:security_id` on both sides, because the order book carries no trading symbol. A websocket
update always replaces its order's entry; a polled row replaces it only when the entry was observed before the poll's
request was sent. The hash expires at 06:00 IST, moved to the next 06:00 by every write.

**The persistence stream.** Every update is also appended, in arrival order, to the Redis Stream
`indmoney:order-updates:stream` as an `update` field holding the same JSON, which `bin/indmoney/orders/store_orders_to_db`
writes to `indmoney.order_updates` - so the history the hash overwrites is kept there. Capped at about 20,000
entries.

**Positions.** INDstocks streams orders only, so nothing is written for positions.

**Sessions.** A dead token fails the handshake itself - INDstocks answers 401, 403 or 513 - so a refused handshake,
or a socket that fails to open six times running, is taken as a dead session: it logs in again before
reconnecting, without checking whether another process has already replaced the token. The token is read afresh on every connect, so a login made by any process is
picked up. A reconnect otherwise backs off from 1 to 60 seconds. Updates arrive only when an order changes, so a
quiet socket is not a broken one.

Exits 0 when stopped with Ctrl+C or SIGTERM, and 1 when a login fails or the socket is still refused after logging
in again. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import signal
import threading
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_KEY = "indmoney:orders:orders"

# Every update is also appended here for bin/indmoney/orders/store_orders_to_db, which reads it with a consumer group.
STREAM_KEY = "indmoney:order-updates:stream"
STREAM_MAX_LENGTH = 20000

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
