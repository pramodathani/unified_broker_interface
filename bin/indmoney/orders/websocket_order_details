def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def first(data, *names):
    """
    The first present value among several spellings of a field, or None.

    - `data` is the row or message.
    - `names` are the spellings to try, in order.
    """
    for name in names:
        if present(data.get(name)) is not None:
            return data[name]
    return None

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def order_timestamp(value):
    """
    An INDstocks order time as an ISO timestamp with the IST offset, or None.

    An epoch - milliseconds above 10^11, seconds below - is an instant; text is read as IST wall clock. Both are written
    with the IST offset, so the same moment reads the same from either writer. A placeholder year before 1971 reads as
    None.

    - `value` is the time as INDstocks sent it.
    """
    value = present(value)
    if value is None:
        return None
    epoch = number(value)
    if epoch is not None:
        if epoch <= 0:
            return None
        try:
            return datetime.fromtimestamp(epoch / 1000 if epoch > 1e11 else epoch, tz=INDIA).isoformat()
        except (OverflowError, OSError, ValueError):
            return None
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%d/%m/%Y %H:%M:%S", "%d-%b-%Y %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            moment = datetime.strptime(str(value).strip()[:19], fmt)
        except ValueError:
            continue
        return None if moment.year < 1971 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_update(data):
    """
    An INDstocks order update as a normalized order, or None when it has no order id.

    - `data` is the order: the message itself, or its nested `data` object.
    """
    if not isinstance(data, dict) or text(first(data, 'order_id', 'orderId')) is None:
        return None
    exchange, security_id = text(first(data, 'exchange', 'exchange_segment')), text(first(data, 'security_id', 'token'))
    quantity = number(first(data, 'quantity', 'qty', 'order_quantity'), int)
    filled = number(first(data, 'filled_quantity', 'filled_qty', 'executed_quantity'), int)
    pending = number(first(data, 'remaining_quantity', 'pending_quantity', 'unfilled_quantity'), int)
    if pending is None and quantity is not None:
        pending = quantity - (filled or 0)
    return {
        "order_id": text(first(data, 'order_id', 'orderId')),
        "exchange_order_id": text(first(data, 'exchange_order_id', 'exch_order_id')),
        "parent_order_id": text(first(data, 'parent_order_id')),
        "status": normalize(first(data, 'order_status', 'status'), STATUSES),
        # Not `remarks`: that is the tag the order was placed with, which the order book reports as `remarks` too.
        "status_message": text(first(data, 'status_message', 'rejection_reason', 'message')),
        "id": f"{exchange}:{security_id}" if exchange and security_id else None,
        "instrument_token": security_id,
        "tradingsymbol": text(first(data, 'trading_symbol', 'tradingsymbol', 'symbol')),
        "exchange": exchange,
        "transaction_type": normalize(first(data, 'txn_type', 'transaction_type', 'side'), TRANSACTION_TYPES),
        "product": normalize(first(data, 'product', 'product_type'), PRODUCTS),
        "order_type": normalize(first(data, 'order_type', 'price_type'), ORDER_TYPES),
        "validity": normalize(first(data, 'validity', 'time_in_force'), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": number(first(data, 'cancelled_quantity'), int),
        "disclosed_quantity": number(first(data, 'disclosed_quantity'), int),
        "price": number(first(data, 'price', 'limit_price')),
        "trigger_price": number(first(data, 'trigger_price', 'stop_price')),
        "average_price": number(first(data, 'average_price', 'avg_price')),
        "order_timestamp": order_timestamp(first(data, 'order_timestamp', 'timestamp')),
        "exchange_timestamp": order_timestamp(first(data, 'exchange_timestamp', 'timestamp')),
        "tag": text(first(data, 'tag', 'remarks')),
    }


class IndmoneyOrderUpdatesStore:
    """
    Where the order updates socket's orders are written: the merged orders hash and the persistence stream.
    """

    def __init__(self, cache, logger):
        """
        Registers the merge script on the Redis client the updates are written to.

        Args:
            cache (redis.Redis): The Redis client.
            logger (logging.Logger): Where writes are reported.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache
        self._merge = cache.register_script(MERGE_SCRIPT)
        self._logger = logger

    def write_updates(self, orders, received_at):
        """
        Merges one message's orders into the orders hash, keyed by order id, and appends each to the stream.

        The hash keeps each order's latest state.
        The stream keeps every transition, even two of one order in the same message, in the shape `bin/indmoney/orders/store_orders_to_db` reads.
        An order the normalizer cannot read is skipped without a log line, as it always was.

        Args:
            orders (list): The message's orders, exactly as INDstocks sent them.
            received_at (datetime): When the message was received, as a naive India wall clock time.

        Returns:
            None: This method returns nothing.
        """
        received = received_at.strftime("%Y-%m-%d %H:%M:%S.%f")
        observed_at = received_at.timestamp()
        merged = []
        appended = []
        for data in orders:
            order = order_from_update(data)
            if order is None:
                continue
            merged.append(order["order_id"])
            merged.append(json.dumps({"observed_at": observed_at, "source": "websocket", "order": order, "data": data}))
            appended.append(json.dumps({"timestamp": received, "data": data}))
        if merged:
            self._merge(keys=[ORDERS_KEY], args=[next_reset(), "websocket", repr(observed_at)] + merged)
            pipeline = self._cache.pipeline(transaction=False)
            for update in appended:
                pipeline.xadd(STREAM_KEY, {"update": update}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()
            self._logger.info(f"Merged {len(appended)} order update(s) into {ORDERS_KEY}: {', '.join(merged[0::2])}")

def main():
    """Stream INDmoney order updates into indmoney:orders:orders until stopped."""
    from stock_brokers.websockets.indmoney import IndmoneyOrderUpdatesSocket, IndmoneySession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("indmoney.websocket_order_details")
    try:
        session = IndmoneySession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to INDmoney: {type(exception).__name__}: {exception}")
        return 1
    store = IndmoneyOrderUpdatesStore(get_cache(), logger)
    socket = IndmoneyOrderUpdatesSocket(session, store.write_updates, logger)

    # Installed before the thread starts: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing the connection.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the order updates feed.")
        socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    thread = threading.Thread(target=socket.run_forever, name="indmoney_order_updates", daemon=True)
    logger.info("Starting the order updates feed.")
    thread.start()

    # Block in the main thread so the signal handlers above can run.
    while thread.is_alive():
        thread.join(timeout=1)

    if socket.gave_up:
        return 1
    logger.info("Order updates feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
