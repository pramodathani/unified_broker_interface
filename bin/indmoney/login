#!/usr/bin/env python3
"""
Log in to the INDmoney (INDstocks) API by constructing `INDMoneyAPI`, confirm the session works, and record
the outcome in the Redis key `indmoney:session:status`.

    bin/indmoney/login
    redis-cli GET indmoney:session:status

`INDMoneyAPI()` probes `GET /user/profile` with the stored token and only generates a new one - from the
MPIN and a TOTP, through `POST /generate/token` - when that probe fails. A new token is written to MongoDB
and to the Redis `last_login` hash, where every other process picks it up. The profile is then fetched once
more, so a success means a session that has actually been used, not just a constructor that returned.

`indmoney:session:status` holds one JSON object, replaced on every run:

    {"status": "success", "access-token": "<token>", "last_login": "2026-09-14 08:30:02"}
    {"status": "failure", "access-token": null, "last_login": "2026-09-14 08:30:02"}

On success `last_login` is when the token in force was issued, which is earlier than this run when the
stored session was still good. On failure it is when this attempt was made.

Exits 0 when the session works and 1 when the login, the check or the Redis write fails, so a systemd
unit can retry on failure. Logs in to a live broker account. Reads only - it places no orders.
"""

import sys
import json
from datetime import datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

PROFILE_URL = "https://api.indstocks.com/user/profile"
REDIS_KEY = "indmoney:session:status"
TIMEOUT_SECONDS = 10

def main():
    """Construct INDMoneyAPI, which logs in when the stored session is dead, confirm it, and record the outcome."""
    from stock_brokers.api.indmoney import INDMoneyAPI
    from utilities.configurations import get_cache

    try:
        indmoney = INDMoneyAPI()
        indmoney.get(url=PROFILE_URL, timeout=TIMEOUT_SECONDS)
        login = indmoney._last_login or {}
        record = {'status': 'success', 'access-token': login.get('access_token'), 'last_login': login.get('last_login')}
        print(f"indmoney ok logged in at {record['last_login']}")
    except Exception as exception:
        record = {'status': 'failure', 'access-token': None, 'last_login': datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
        print(f"indmoney FAILED {type(exception).__name__}: {exception}", file=sys.stderr)

    try:
        get_cache().set(REDIS_KEY, json.dumps(record))
    except Exception as exception:
        print(f"indmoney could not write {REDIS_KEY}: {type(exception).__name__}: {exception}", file=sys.stderr)
        return 1

    return 0 if record['status'] == 'success' else 1

if __name__ == "__main__":
    raise SystemExit(main())
