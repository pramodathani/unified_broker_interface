#!/usr/bin/env python3
"""
Download INDmoney's historical candles into `indmoney.price_history`, working a resumable queue until stopped.

    bin/indmoney/historical_prices --seed           # register every instrument and interval, then work
    bin/indmoney/historical_prices                  # work the queue until stopped or drained
    bin/indmoney/historical_prices --seed-only      # register new series and exit
    bin/indmoney/historical_prices --status         # how far it has got
    bin/indmoney/historical_prices --deadline-seconds 21600

Built on `IndMoneyCandles`, with one difference: every login - at startup and after INDstocks refuses the
session - goes straight through `INDMoneyAPI`, which logs in when the stored token is dead, rather than through
the shared session helper `stock_brokers.api.utilities.session.ensure_session`.

**Seeding** reads the latest row per instrument from `indmoney.instruments` (filled by `bin/indmoney/instruments`) and
registers one row per instrument and interval in `indmoney.price_history_progress`, leaving existing rows alone, so
seeding again after a new instrument master adds only what is new. An instrument is identified by its scrip code, a
prefix and INDstocks' security id joined by an underscore - `NSE_2885` for NSE cash, `BSE_500325` for BSE cash,
`NSE_40000001` for an index, `NFO_68777` for an NSE derivative. The prefix comes from the segment, not the exchange
column: a derivative asked for as `NSE_` is accepted and answers nothing. BSE derivatives are left out, since every
prefix tried for them is refused. The intervals are the fourteen INDstocks serves: `1minute`, `2minute`, `3minute`,
`5minute`, `10minute`, `15minute`, `30minute`, `60minute`, `120minute`, `180minute`, `240minute`, `day`, `week` and
`month`.

**The queue** is worked in priority order - cash daily bars first, then cash intraday, live futures, live options, and
expired contracts last. Each series walks backward from today until it reaches 2013-01-01 or three windows come back
empty, then keeps collecting forward. A window is 7 days for intervals up to 30 minutes, 15 for the hourly ones and a
year for day, week and month - not documented limits but the points past which INDstocks silently truncates. Bars come
from `GET https://api.indstocks.com/market/historical/<interval>` with the window in epoch milliseconds, paced at three
requests a second and 100,000 a day. INDstocks publishes no open interest, so that column stays null.

**Each window** is upserted into `indmoney.price_history` on `(instrument_token, interval, time)` together with the
series' progress, in one transaction, so stopping costs at most the request in flight and a repeated window updates
rather than duplicates. An "Invalid scrip codes" refusal retires the series; a throttle backs off five seconds; a
refused session is logged in once and the window retried.

Run it on its own: the queue is not locked between processes, so two workers on `indmoney.price_history_progress` would
claim the same series and share INDstocks' rate limit.

Exits 0 when stopped, drained or out of time, 1 when it stopped because the session could not be restored or
INDstocks refused this client, and 2 when the first login fails.
"""

import sys
import signal
import argparse
import threading
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

def downloader():
    """
    An IndMoneyCandles that logs in through INDMoneyAPI directly, and remembers why it stopped.
    """
    from stock_brokers.api.indmoney import INDMoneyAPI
    from stock_brokers.instruments.historical.base import CandleAuthenticationError, CandleBlocked, CandleThrottled
    from stock_brokers.instruments.historical.indmoney import IndMoneyCandles

    class DirectLoginIndMoneyCandles(IndMoneyCandles):
        """IndMoneyCandles whose logins construct INDMoneyAPI rather than going through the shared session helper."""

        stopped_by = None

        def _build_api(self):
            return INDMoneyAPI()

        def relogin(self):
            """
            Log in again through INDMoneyAPI, which generates a new token when the stored one is refused.

            Raises:
                CandleAuthenticationError: If no working session could be established.
            """
            try:
                self._api = self._build_api()
                self.after_relogin()
            except Exception as exception:
                raise CandleAuthenticationError(f"logging in again did not produce a working session: "
                                                f"{type(exception).__name__}: {str(exception)[:200]}") from exception
            self._logger.info("indmoney logged in again. Continuing.")

        def visit(self, series):
            # `run` ends its loop on these without raising, so they are noted here for the exit code.
            try:
                return super().visit(series)
            except (CandleAuthenticationError, CandleBlocked, CandleThrottled) as exception:
                self.stopped_by = exception
                raise

    # Passing the API in keeps IndMoneyCandles from establishing the session itself.
    return DirectLoginIndMoneyCandles(api=INDMoneyAPI())

def show_status(candles):
    """
    Print how far the download has got.

    - `candles` is the INDmoney candle downloader.
    """
    summary = candles.summary()
    print("indmoney price history")
    for label, value in (("series registered", summary["series"]), ("series with bars", summary["with_bars"]),
                         ("series retired by the broker", summary["retired"]),
                         ("series stuck on failures", summary["stuck"]), ("bars stored", summary["bars"])):
        print(f"  {label:<30} {value:>14,}")
    if not summary["series"]:
        print("Nothing registered. Run with --seed first.")
    return 0

def main():
    """Work INDmoney's candle queue."""
    parser = argparse.ArgumentParser(description="Download INDmoney's historical candles into indmoney.price_history.")
    parser.add_argument("--seed", action="store_true", help="register every instrument and interval before working")
    parser.add_argument("--seed-only", action="store_true", help="register the series and exit without downloading")
    parser.add_argument("--status", action="store_true", help="show how far the download has got, and exit")
    parser.add_argument("--deadline-seconds", type=int, help="stop after this long, for a nightly window")
    arguments = parser.parse_args()

    from utilities.configurations import get_logger

    logger = get_logger("indmoney.historical_prices")
    try:
        candles = downloader()
    except Exception as exception:
        logger.error(f"Could not log in to INDmoney: {type(exception).__name__}: {exception}")
        return 2

    try:
        if arguments.status:
            return show_status(candles)

        if arguments.seed or arguments.seed_only:
            logger.info("Registering every indmoney instrument and interval. This reads the whole instrument master.")
            added = candles.seed()
            logger.info(f"Registered {added:,} new series.")
            if arguments.seed_only:
                return 0

        # A backfill is stopped many times, so shutdown finishes the window in flight rather than abandoning it:
        # the flag is checked between windows.
        stop = threading.Event()

        def _handle_signal(signal_number, frame):
            logger.info(f"Received signal {signal_number}. Finishing the window in flight, then stopping.")
            stop.set()

        for signal_number in (signal.SIGINT, signal.SIGTERM):
            signal.signal(signal_number, _handle_signal)

        visits, bars = candles.run(stop_event=stop, deadline_seconds=arguments.deadline_seconds)
        logger.info(f"Stored {bars:,} bar(s) over {visits:,} window(s).")
        if candles.stopped_by is not None and not stop.is_set():
            logger.error(f"Stopped early: {type(candles.stopped_by).__name__}: {candles.stopped_by}")
            return 1
        return 0
    finally:
        candles.close()

if __name__ == "__main__":
    raise SystemExit(main())
