#!/usr/bin/env python3
"""
Poll the Dhan holdings every minute and write them to the Redis key `dhan:portfolio:holdings`.

    bin/dhan/portfolio/holdings
    redis-cli GET dhan:portfolio:holdings

Calls `GET https://api.dhan.co/v2/holdings` through `DhanAPI`, which logs in first if the stored session
is dead. Each response - `timestamp`, `status`, `code` and Dhan's holdings list under `data`, one row per
holding with `securityId`, `isin`, `tradingSymbol`, `exchange`, `totalQty`, `dpQty`, `t1Qty`, `avgCostPrice`
and `lastTradedPrice` - is written as one JSON string with SET, replacing the one before.

Dhan refuses an account holding nothing with DH-1111 "No holdings available" rather than an empty list.
That is an answer, not a failure, so it is written the same way with `data` as `[]`.

Runs until Ctrl+C. A dead session (`Invalid_Authentication`, DH-901) is logged in again before the next
request; any other failed poll is logged and leaves `dhan:portfolio:holdings` unchanged. Exits 1 when the first
login, or a login after the session died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from datetime import datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

HOLDINGS_URL = "https://api.dhan.co/v2/holdings"
REDIS_KEY = "dhan:portfolio:holdings"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10
NO_HOLDINGS_MARKERS = ("dh-1111", "no holding")

def is_authentication_error(exception):
    """Whether Dhan refused the request because the session is dead."""
    code = str(getattr(exception, 'code', '') or '').lower()
    return code == 'invalid_authentication' or 'dh-901' in str(exception).lower()

def is_no_holdings(exception):
    """Whether Dhan refused the request only because the account holds nothing."""
    return any(marker in str(exception).lower() for marker in NO_HOLDINGS_MARKERS)

def main():
    """Fetch the holdings and write them to dhan:portfolio:holdings every minute, until interrupted."""
    from stock_brokers.api.dhan import DhanAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("dhan.holdings")
    cache = get_cache()
    try:
        dhan = DhanAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Dhan: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                try:
                    holdings = dhan.get(url=HOLDINGS_URL, timeout=TIMEOUT_SECONDS)
                except Exception as exception:
                    if not is_no_holdings(exception):
                        raise
                    holdings = {'timestamp': datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f"), 'status': 'success',
                                'code': 200, 'data': []}
                cache.set(REDIS_KEY, json.dumps(holdings))
                data = holdings.get('data')
                logger.info(f"Wrote {len(data) if isinstance(data, list) else 0} holdings to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Dhan session expired, logging in again: {exception}")
                    dhan = DhanAPI()
                else:
                    logger.error(f"Holdings poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
