#!/usr/bin/env python3
"""
Mark Dhan as logged out in the Redis key `dhan:session:status`.

    bin/dhan/session/disconnect
    redis-cli GET dhan:session:status

Dhan has no logout or token-revoke endpoint - an access token simply expires 24 hours after it is
issued - so nothing is sent to Dhan. The script only replaces `dhan:session:status` with:

    {"status": "logged out", "access-token": null, "last_login": null}

The stored token in the Redis `last_login` hash and in MongoDB is left alone, and Dhan keeps accepting
it until it expires.

Exits 0 when the key was written and 1 when it could not be, in which case `dhan:session:status` is unchanged.
"""

import sys
import json
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

REDIS_KEY = "dhan:session:status"

def main():
    """Write the logged-out record to dhan:session:status."""
    from utilities.configurations import get_cache

    record = {'status': 'logged out', 'access-token': None, 'last_login': None}
    try:
        get_cache().set(REDIS_KEY, json.dumps(record))
    except Exception as exception:
        print(f"dhan could not write {REDIS_KEY}: {type(exception).__name__}: {exception}", file=sys.stderr)
        return 1

    print(f"dhan logged out in {REDIS_KEY}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
