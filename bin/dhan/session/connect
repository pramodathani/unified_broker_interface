#!/usr/bin/env python3
"""
Log in to the Dhan API by constructing `DhanAPI`, confirm the session works, and record the outcome in
the Redis key `dhan:session:status`.

    bin/dhan/session/connect
    redis-cli GET dhan:session:status

When `dhan-login.timer` started the run, or the stored token was issued before today, a new access
token is generated from the client id, PIN and a TOTP even if the old one still works, so each day
starts with a token issued by the morning login; the timer is told apart by the `TRIGGER_UNIT`
variable systemd passes to the service, on retries too. Otherwise `DhanAPI()` probes `GET /v2/profile` with the stored token and
only generates a new one when that probe fails, so a later run - by hand, or started by the REST API
after a refused request - logs in only when the session is dead. The old token stays in place until
the new one is written to MongoDB and to the Redis `last_login` hash, where every other process picks
it up on its next request. The profile is then fetched once more, so a success means a session that
has actually been used, not just a constructor that returned.

`dhan:session:status` holds one JSON object, replaced on every run:

    {"status": "success", "access-token": "<token>", "last_login": "2026-09-14 08:30:02"}
    {"status": "failure", "access-token": null, "last_login": "2026-09-14 08:30:02"}

On success `last_login` is when the token in force was issued, which is earlier than this run when the
stored session was still good. On failure it is when this attempt was made.

Exits 0 when the session works and 1 when the login, the check or the Redis write fails, so a systemd
unit can retry on failure. Logs in to a live broker account. Reads only - it places no orders.
"""

import sys
import json
from datetime import datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

PROFILE_URL = "https://api.dhan.co/v2/profile"
REDIS_KEY = "dhan:session:status"

def main():
    """Construct DhanAPI, which logs in when the stored session is dead, from an earlier day, or the login timer started this run, confirm it, and record the outcome."""
    from stock_brokers.api.dhan import DhanAPI
    from stock_brokers.api.utilities.session import needs_fresh_login
    from utilities.configurations import get_cache

    try:
        dhan = DhanAPI(force_login=needs_fresh_login("dhan"))
        dhan.get(url=PROFILE_URL)
        login = dhan._last_login or {}
        record = {'status': 'success', 'access-token': login.get('access_token'), 'last_login': login.get('last_login')}
        print(f"dhan ok logged in at {record['last_login']}")
    except Exception as exception:
        record = {'status': 'failure', 'access-token': None, 'last_login': datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
        print(f"dhan FAILED {type(exception).__name__}: {exception}", file=sys.stderr)

    try:
        get_cache().set(REDIS_KEY, json.dumps(record))
    except Exception as exception:
        print(f"dhan could not write {REDIS_KEY}: {type(exception).__name__}: {exception}", file=sys.stderr)
        return 1

    return 0 if record['status'] == 'success' else 1

if __name__ == "__main__":
    raise SystemExit(main())
