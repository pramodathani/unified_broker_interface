#!/usr/bin/env python3
"""
Poll the Dhan positions every half second and merge them into the Redis hash `dhan:portfolio:positions`.

    bin/dhan/positions
    redis-cli HGETALL dhan:portfolio:positions
    redis-cli HGET dhan:portfolio:positions NSE_EQ:2885:CNC

Calls `GET https://api.dhan.co/v2/positions` through `DhanAPI`, which logs in first if the stored session is dead.

**One key for positions.** `dhan:portfolio:positions` is a hash with one field per position, keyed
`exchangeSegment:securityId:productType` - Dhan holds one position per instrument and product. Every value is

    {"observed_at": <epoch>, "source": "rest", "position": <normalized position>, "data": <Dhan's own row>}

with the same shape the brokers that also stream positions over a websocket use, so a reader handles every broker
alike. Dhan streams no positions - its order update socket carries orders only - so this poller is the one writer;
the merge rule below is there so a second writer could share the key. `position` has `id`, `instrument_token`,
`tradingsymbol`, `exchange`, `segment`, `product`, `quantity`, `buy_quantity`, `sell_quantity`, `buy_price`,
`sell_price`, `buy_value`, `sell_value`, `average_price`, `last_price`, `realized_pnl`, `unrealized_pnl`, `pnl`,
`multiplier`, `lot_size`, `day_or_net` and `updated_at`:

| field | from Dhan |
| --- | --- |
| `id` | `exchangeSegment:tradingSymbol` |
| `instrument_token`, `tradingsymbol`, `exchange` | `securityId`, `tradingSymbol`, `exchangeSegment` |
| `segment` | the part of `exchangeSegment` after the underscore (`EQ`, `FNO`, `CURRENCY`, `COMM`) |
| `product` | `productType` on the shared vocabulary (`CNC`, `MIS`, `NRML`, `MTF`...) |
| `quantity`, `buy_quantity`, `sell_quantity` | `netQty`, `buyQty`, `sellQty` |
| `buy_price`, `sell_price` | `buyAvg`, `sellAvg` |
| `buy_value`, `sell_value` | quantity times average, as Dhan reports averages rather than values |
| `average_price` | `costPrice` |
| `realized_pnl`, `unrealized_pnl`, `pnl` | `realizedProfit`, `unrealizedProfit`, and their sum |
| `multiplier` | `multiplier` |
| `day_or_net` | `NET`: Dhan reports each position once, carried forward and today's together |

Dhan sends no last price, lot size or update time, so `last_price`, `lot_size` and `updated_at` are null.

**Which write wins.** A row from this poller replaces an entry only when that entry was observed before this poll's
request was sent, so an entry from a newer writer is never overwritten by an older snapshot. The check and the write
run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00. A position Dhan stops
listing during the day is not removed before then. A flat account answers `[]`, which writes nothing.

Runs until Ctrl+C. A dead session (`Invalid_Authentication`, DH-901) is logged in again before the next request; any
other failed poll is logged and leaves the hash unchanged. Exits 1 when the first login, or a login after the session
died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

POSITIONS_URL = "https://api.dhan.co/v2/positions"
REDIS_KEY = "dhan:portfolio:positions"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "dhan:portfolio:positions:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for Dhan's blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def position_key(row):
    """
    The hash field for a Dhan position row, `exchangeSegment:securityId:productType`, or None when it lacks one of them.

    - `row` is one row of `GET /v2/positions`.
    """
    parts = [text(row.get(field)) for field in ("exchangeSegment", "securityId", "productType")] if isinstance(row, dict) else [None]
    return ":".join(parts) if all(parts) else None

def position_from_row(row):
    """
    A Dhan position row as a normalized position.

    - `row` is one row of `GET /v2/positions`.
    """
    exchange, symbol = text(row.get('exchangeSegment')), text(row.get('tradingSymbol'))
    buy_quantity, sell_quantity = number(row.get('buyQty'), int), number(row.get('sellQty'), int)
    buy_price, sell_price = number(row.get('buyAvg')), number(row.get('sellAvg'))
    realized, unrealized = number(row.get('realizedProfit')), number(row.get('unrealizedProfit'))
    return {
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('securityId')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "segment": exchange.split("_", 1)[1] if exchange and "_" in exchange else None,
        "product": normalize(present(row.get('productType')), PRODUCTS),
        "quantity": number(row.get('netQty'), int),
        "buy_quantity": buy_quantity,
        "sell_quantity": sell_quantity,
        "buy_price": buy_price,
        "sell_price": sell_price,
        "buy_value": buy_quantity * buy_price if buy_quantity is not None and buy_price is not None else None,
        "sell_value": sell_quantity * sell_price if sell_quantity is not None and sell_price is not None else None,
        "average_price": number(row.get('costPrice')),
        "last_price": None,
        "realized_pnl": realized,
        "unrealized_pnl": unrealized,
        "pnl": realized + unrealized if realized is not None and unrealized is not None else None,
        "multiplier": number(row.get('multiplier')),
        "lot_size": None,
        "day_or_net": "NET",
        "updated_at": None,
    }

def is_authentication_error(exception):
    """Whether Dhan refused the request because the session is dead."""
    code = str(getattr(exception, 'code', '') or '').lower()
    return code == 'invalid_authentication' or 'dh-901' in str(exception).lower()

def main():
    """Fetch the positions and merge them into dhan:portfolio:positions every half second, until interrupted."""
    from stock_brokers.api.dhan import DhanAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("dhan.positions")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        dhan = DhanAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Dhan: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = dhan.get(url=POSITIONS_URL, timeout=TIMEOUT_SECONDS)
                rows = response.get('data') if isinstance(response.get('data'), list) else []
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    field = position_key(row)
                    if field is not None:
                        arguments += [field, json.dumps({"observed_at": requested_at, "source": "rest",
                                                         "position": position_from_row(row), "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} position(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Dhan session expired, logging in again: {exception}")
                    dhan = DhanAPI()
                else:
                    report.error(f"Positions poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
