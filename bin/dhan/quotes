#!/usr/bin/env python3
"""
Stream Dhan market quotes over websockets into the Redis hash `dhan:quotes:live`, and keep streaming until
stopped.

    bin/dhan/quotes                                  # instruments from the Redis set dhan:quotes:subscriptions
    bin/dhan/quotes --tokens NSE_EQ:2885,MCX_COMM:565899
    bin/dhan/quotes --per-socket 2000

    redis-cli SADD dhan:quotes:subscriptions NSE_EQ:2885 MCX_COMM:565899
    redis-cli HGET dhan:quotes:live "NSE:RELIANCE"
    redis-cli HGETALL dhan:quotes:instruments

Self-contained: it logs in with `DhanAPI` and carries its own connection, subscription and binary packet
decoding for Dhan's market feed at `wss://api-feed.dhan.co`, so it needs no other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `dhan:quotes:subscriptions`,
each as `SEGMENT:SECURITY_ID` - `NSE_EQ`, `NSE_FNO`, `NSE_CURRENCY`, `BSE_EQ`, `BSE_FNO`, `BSE_CURRENCY`,
`MCX_COMM` or `IDX_I`, then Dhan's security id. Each is named from Dhan's scrip master, downloaded at startup.
One websocket carries up to `--per-socket` instruments, at most 5000, and Dhan allows 5 connections per user.

**Keys.**

- `dhan:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the instrument's name from
  the scrip master (`NSE:RELIANCE`), or by its `SEGMENT:SECURITY_ID` when the scrip master does not name it.
  A tick is replaced as the next one arrives. It is not cleared at startup, so an instrument no longer
  subscribed keeps its last tick.
- `dhan:quotes:instruments`, a hash of every subscribed `SEGMENT:SECURITY_ID` to its name, or to an empty
  string when unnamed. Replaced whole at startup.
- `dhan:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/dhan/persist_ticks` writes to `dhan.ticks`. Capped at about 1,000,000 entries, so ticks that arrive while
  the persister is down for long enough are trimmed before they are persisted.

A tick has `id`, `broker`, `instrument_token`, `exchange`, `mode`, `last_price`, `last_quantity`,
`average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`, `oi_day_high`,
`oi_day_low`, `last_trade_time`, `exchange_timestamp`, `depth` (five `buy` and `sell` levels of `quantity`,
`price` and `orders`) and `received_at`, with `None` for what Dhan does not send. Prices are rupees. Dhan
stamps trade times in IST presented as an epoch; they are shifted to the true epoch. `ohlc.close` is the
previous session's close once Dhan has sent it, and `change` is the percentage change against it.

**Sessions.** Each connection reads the current token when it connects, so a login made by any process is
picked up. When Dhan disconnects a socket for an expired or invalid token (disconnect codes 807, 808, 809),
or a socket fails to open six times running, it logs in again through `DhanAPI` - one socket at a time -
before reconnecting. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket still cannot open after logging
in again, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import csv
import json
import time
import signal
import struct
import argparse
import threading
from io import StringIO
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

FEED_URL = "wss://api-feed.dhan.co"
SCRIP_MASTER_URL = "https://images.dhan.co/api-data/api-scrip-master-detailed.csv"

LIVE_KEY = "dhan:quotes:live"
INSTRUMENTS_KEY = "dhan:quotes:instruments"
SUBSCRIPTIONS_KEY = "dhan:quotes:subscriptions"

# Every tick is also appended here for bin/dhan/persist_ticks, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "dhan:quotes:stream"
STREAM_MAX_LENGTH = 1000000

# Dhan's exchange segments and their numeric codes, per the DhanHQ v2 annexure.
SEGMENT_CODES = {"IDX_I": 0, "NSE_EQ": 1, "NSE_FNO": 2, "NSE_CURRENCY": 3, "BSE_EQ": 4, "MCX_COMM": 5,
                 "BSE_CURRENCY": 7, "BSE_FNO": 8}
SEGMENT_NAMES = {code: segment for segment, code in SEGMENT_CODES.items()}

# The scrip master's exchange and segment columns to Dhan's segment.
SCRIP_SEGMENTS = {("NSE", "E"): "NSE_EQ", ("NSE", "D"): "NSE_FNO", ("NSE", "C"): "NSE_CURRENCY",
                  ("BSE", "E"): "BSE_EQ", ("BSE", "D"): "BSE_FNO", ("BSE", "C"): "BSE_CURRENCY",
                  ("MCX", "M"): "MCX_COMM", ("NSE", "I"): "IDX_I", ("BSE", "I"): "IDX_I"}

# The subscribe request code for full packets: price, quantities, OHLC, open interest and five levels of depth.
SUBSCRIBE_FULL = 21
MAX_INSTRUMENTS_PER_MESSAGE = 100
MAX_INSTRUMENTS_PER_CONNECTION = 5000
CONNECTION_BUDGET = 5

# Response codes that open every packet.
TICKER, QUOTE, OI, PREVIOUS_CLOSE, FULL, DISCONNECT = 2, 4, 5, 6, 8, 50

# Disconnect codes for an expired or invalid token, per the DhanHQ v2 annexure: 807 "Access token is expired",
# 808 "Authentication Failed - Client ID or Access Token invalid", 809 "Access token is invalid".
AUTHENTICATION_DISCONNECT_CODES = (807, 808, 809)

# Dhan's trade times are IST wall clock seconds presented as an epoch.
IST_OFFSET_SECONDS = 19800

PING_INTERVAL_SECONDS = 30
PING_TIMEOUT_SECONDS = 10
MIN_BACKOFF_SECONDS = 1
MAX_BACKOFF_SECONDS = 60
MAX_FAILED_CONNECTS = 6

class DhanSession:
    """
    The Dhan login every socket authenticates with, logged in again by one socket at a time.
    """

    def __init__(self, logger):
        """
        Construct DhanAPI, which logs in when the stored session is dead.

        - `logger` is where logins are reported.
        """
        from stock_brokers.api.dhan import DhanAPI

        self._api_class = DhanAPI
        self._logger = logger
        self._lock = threading.Lock()
        self._dhan = DhanAPI()

    def credentials(self):
        """
        The client id and the access token in force now, which may be one another process has just obtained.
        """
        login = self._dhan._current_login() or {}
        return self._dhan._settings.get('client_id'), login.get('access_token')

    def log_in_again(self, stale_token):
        """
        Log in again, unless another socket already replaced the token that failed.

        - `stale_token` is the access token the failing connection used.
        """
        with self._lock:
            if self.credentials()[1] != stale_token:
                return
            self._logger.warning("Logging in to Dhan again.")
            self._dhan = self._api_class()

class QuotesSocket:
    """
    One Dhan market feed websocket for a batch of instruments, reconnecting until stopped.
    """

    def __init__(self, name, tokens, names, session, cache, logger):
        """
        - `name` is the connection's name, for the log.
        - `tokens` is the batch of `SEGMENT:SECURITY_ID` instrument tokens.
        - `names` maps `SEGMENT:SECURITY_ID` to the instrument's name.
        - `session` is the shared DhanSession.
        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        self.name = name
        self._tokens = tokens
        self._names = names
        self._session = session
        self._cache = cache
        self._logger = logger
        self._stop = threading.Event()
        self._ws = None
        self._token = None
        self._opened = False
        self._authentication_rejected = False
        # The previous close and open interest Dhan sends in packets of their own, per instrument.
        self._remembered = {}
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except Exception as exception:
                self._logger.error(f"{self.name} connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again and failed_connects >= MAX_FAILED_CONNECTS:
                    self.gave_up = True
                    self._logger.error(f"{self.name} still cannot connect after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._session.log_in_again(self._token)
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"{self.name} could not log in to Dhan again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"{self.name} disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info(f"{self.name} stopped.")

    def _connect(self):
        """Open the websocket with the token in force now and block until it closes."""
        import websocket

        client_id, self._token = self._session.credentials()
        url = f"{FEED_URL}?version=2&token={self._token}&clientId={client_id}&authType=2"
        self._ws = websocket.WebSocketApp(url, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=PING_INTERVAL_SECONDS, ping_timeout=PING_TIMEOUT_SECONDS)

    def _on_open(self, ws):
        """Subscribe the batch in full mode, a hundred instruments a message."""
        self._opened = True
        for start in range(0, len(self._tokens), MAX_INSTRUMENTS_PER_MESSAGE):
            batch = self._tokens[start:start + MAX_INSTRUMENTS_PER_MESSAGE]
            ws.send(json.dumps({"RequestCode": SUBSCRIBE_FULL, "InstrumentCount": len(batch),
                                "InstrumentList": [{"ExchangeSegment": token.partition(':')[0],
                                                   "SecurityId": token.partition(':')[2]} for token in batch]}))
        self._logger.info(f"{self.name} opened and subscribed to {len(self._tokens)} instrument(s).")

    def _on_error(self, ws, error):
        self._logger.error(f"{self.name} error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"{self.name} closed with status {status_code}: {message}")

    def _on_message(self, ws, message):
        """Decode a binary message and write its ticks to the live quotes hash."""
        if not isinstance(message, bytes):
            return
        ticks = [tick for tick in (self._parse_packet(packet) for packet in split_packets(message)) if tick]
        if ticks:
            encoded = [(tick['id'], json.dumps(tick)) for tick in ticks]
            # The latest tick per instrument and every tick in arrival order, in one round trip.
            pipeline = self._cache.pipeline(transaction=False)
            pipeline.hset(LIVE_KEY, mapping=dict(encoded))
            for _, payload in encoded:
                pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()

    def _parse_packet(self, packet):
        """
        A normalized tick from one Dhan packet, or None for a packet that carries no tick.

        - `packet` is the binary packet.
        """
        if len(packet) < 8:
            return None
        feed_code = unpack(packet, 0, 1, "B")
        segment_code = unpack(packet, 3, 4, "B")
        token = f"{SEGMENT_NAMES.get(segment_code, segment_code)}:{unpack(packet, 4, 8, 'i')}"

        if feed_code == DISCONNECT:
            code = unpack(packet, 8, 10, "h") if len(packet) >= 10 else None
            self._logger.warning(f"{self.name} received a disconnect packet, code {code}.")
            if code in AUTHENTICATION_DISCONNECT_CODES:
                self._authentication_rejected = True
                self._ws.close()
            return None

        # The previous close and open interest arrive in packets of their own. Written as ticks they would
        # replace the instrument's full tick with one lacking a price, so they are remembered and folded into
        # the ticks that follow.
        remembered = self._remembered.setdefault(token, {})
        if feed_code == PREVIOUS_CLOSE and len(packet) >= 16:
            remembered["previous_close"] = unpack(packet, 8, 12, "f")
            return None
        if feed_code == OI and len(packet) >= 12:
            remembered["oi"] = unpack(packet, 8, 12, "i")
            return None

        if feed_code == TICKER and len(packet) >= 16:
            tick = self._empty_tick(token, segment_code, "ltp")
            tick["last_price"] = unpack(packet, 8, 12, "f")
            tick["last_trade_time"] = true_epoch(unpack(packet, 12, 16, "i"))
            return tick

        if feed_code == QUOTE and len(packet) >= 50:
            tick = self._empty_tick(token, segment_code, "quote")
            self._fill_trade(tick, packet)
            tick["ohlc"] = {"open": unpack(packet, 34, 38, "f"), "close": unpack(packet, 38, 42, "f"),
                            "high": unpack(packet, 42, 46, "f"), "low": unpack(packet, 46, 50, "f")}
            tick["oi"] = remembered.get("oi")
            apply_previous_close(tick, remembered)
            return tick

        if feed_code == FULL and len(packet) >= 162:
            tick = self._empty_tick(token, segment_code, "full")
            self._fill_trade(tick, packet)
            tick["oi"] = unpack(packet, 34, 38, "i")
            tick["oi_day_high"] = unpack(packet, 38, 42, "i")
            tick["oi_day_low"] = unpack(packet, 42, 46, "i")
            tick["ohlc"] = {"open": unpack(packet, 46, 50, "f"), "close": unpack(packet, 50, 54, "f"),
                            "high": unpack(packet, 54, 58, "f"), "low": unpack(packet, 58, 62, "f")}
            apply_previous_close(tick, remembered)
            for offset in range(62, 162, 20):
                tick["depth"]["buy"].append({"quantity": unpack(packet, offset, offset + 4, "i"),
                                             "price": unpack(packet, offset + 12, offset + 16, "f"),
                                             "orders": unpack(packet, offset + 8, offset + 10, "h")})
                tick["depth"]["sell"].append({"quantity": unpack(packet, offset + 4, offset + 8, "i"),
                                              "price": unpack(packet, offset + 16, offset + 20, "f"),
                                              "orders": unpack(packet, offset + 10, offset + 12, "h")})
            return tick

        self._logger.debug(f"{self.name} skipped a packet with feed code {feed_code} and length {len(packet)}.")
        return None

    @staticmethod
    def _fill_trade(tick, packet):
        """
        Fill the trade fields the quote and full packets share, at the same offsets.

        - `tick` is the tick to fill.
        - `packet` is the binary packet.
        """
        tick["last_price"] = unpack(packet, 8, 12, "f")
        tick["last_quantity"] = unpack(packet, 12, 14, "h")
        tick["last_trade_time"] = true_epoch(unpack(packet, 14, 18, "i"))
        tick["average_price"] = unpack(packet, 18, 22, "f")
        tick["volume"] = unpack(packet, 22, 26, "i")
        tick["sell_quantity"] = unpack(packet, 26, 30, "i")
        tick["buy_quantity"] = unpack(packet, 30, 34, "i")

    def _empty_tick(self, token, segment_code, mode):
        """
        A tick with every field unset.

        - `token` is the instrument's `SEGMENT:SECURITY_ID`.
        - `segment_code` is Dhan's numeric segment.
        - `mode` is `ltp`, `quote` or `full`.
        """
        return {"id": self._names.get(token) or token, "broker": "dhan", "instrument_token": token,
                "exchange": SEGMENT_NAMES.get(segment_code), "mode": mode, "last_price": None,
                "last_quantity": None, "average_price": None, "volume": None, "buy_quantity": None,
                "sell_quantity": None, "ohlc": {"open": None, "high": None, "low": None, "close": None},
                "change": None, "oi": None, "oi_day_high": None, "oi_day_low": None, "last_trade_time": None,
                "exchange_timestamp": None, "depth": {"buy": [], "sell": []}, "received_at": time.time()}

def unpack(data, start, end, byte_format):
    """
    A little endian value from a slice of a packet.

    - `data` is the packet.
    - `start` and `end` bound the slice.
    - `byte_format` is the struct format character.
    """
    return struct.unpack("<" + byte_format, data[start:end])[0]

def split_packets(message):
    """
    A Dhan message's packets. One message may carry several back to back, each declaring its own length.

    - `message` is the binary message.
    """
    packets, offset = [], 0
    while offset + 8 <= len(message):
        length = unpack(message, offset + 1, offset + 3, "h")
        # A packet claiming no length would not advance the walk, so it ends it.
        if length <= 0 or offset + length > len(message):
            break
        packets.append(message[offset:offset + length])
        offset += length
    return packets

def true_epoch(timestamp):
    """
    A Dhan IST-as-epoch timestamp on the true epoch, leaving zero as None.

    - `timestamp` is the timestamp Dhan sent.
    """
    return timestamp - IST_OFFSET_SECONDS if timestamp else None

def apply_previous_close(tick, remembered):
    """
    Put the previous session's close in `ohlc.close` once Dhan has sent it, and the change against it.

    The close in Dhan's quote and full packets is the previous close during the session but the day's own
    close after it, so the previous close packet's value, when there is one, is what `close` means.

    - `tick` is the tick to adjust.
    - `remembered` is what the instrument's single-value packets left.
    """
    if remembered.get("previous_close"):
        tick["ohlc"]["close"] = remembered["previous_close"]
    close = tick["ohlc"]["close"]
    tick["change"] = (tick["last_price"] - close) * 100 / close if close else None

def resolve_tokens(tokens, cache, logger):
    """
    The valid `SEGMENT:SECURITY_ID` tokens to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        segment, _, security_id = token.partition(':')
        if segment in SEGMENT_CODES and security_id.isdigit():
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected SEGMENT:SECURITY_ID with SEGMENT one of {', '.join(SEGMENT_CODES)}.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Dhan's scrip master, keyed by `SEGMENT:SECURITY_ID`.

    An unreachable scrip master is reported and leaves every instrument unnamed rather than stopping the feed.

    - `tokens` is the list of subscribed `SEGMENT:SECURITY_ID` tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    try:
        response = requests.get(SCRIP_MASTER_URL, timeout=120)
        response.raise_for_status()
    except Exception as exception:
        logger.warning(f"Could not download Dhan's scrip master, so instruments are keyed by token: {exception}")
        return {}

    names = {}
    for row in csv.DictReader(StringIO(response.text)):
        segment = SCRIP_SEGMENTS.get((row.get('EXCH_ID'), row.get('SEGMENT')))
        token = f"{segment}:{row.get('SECURITY_ID')}"
        if segment and token in wanted:
            names[token] = f"{row['EXCH_ID']}:{row.get('DISPLAY_NAME') or row.get('SYMBOL_NAME')}"
    return names

def main():
    """Stream Dhan quotes into dhan:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Dhan market quotes into dhan:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated SEGMENT:SECURITY_ID tokens, for example NSE_EQ:2885")
    parser.add_argument("--per-socket", type=int, default=MAX_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, at most {MAX_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("dhan.quotes")
    cache = get_cache()

    if not 1 <= arguments.per_socket <= MAX_INSTRUMENTS_PER_CONNECTION:
        logger.error(f"--per-socket must be between 1 and {MAX_INSTRUMENTS_PER_CONNECTION}.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add SEGMENT:SECURITY_ID members to the Redis set "
                     f"{SUBSCRIPTIONS_KEY}.")
        return 2

    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]
    if len(batches) > CONNECTION_BUDGET:
        logger.error(f"{len(tokens)} instruments at {arguments.per_socket} per socket needs {len(batches)} connections, "
                     f"but Dhan allows {CONNECTION_BUDGET} per user.")
        return 2

    try:
        session = DhanSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Dhan: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the scrip master and are keyed by token: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    sockets = [QuotesSocket(f"socket_{index}", batch, names, session, cache, logger) for index, batch in enumerate(batches)]

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"dhan_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
