#!/usr/bin/env python3
"""
Stream Dhan market quotes over websockets into the Redis hash `dhan:quotes:live`, and keep streaming until
stopped.

    bin/dhan/instruments/websocket_quotes                                       # instruments from the Redis set dhan:quotes:subscriptions
    bin/dhan/instruments/websocket_quotes --tokens NSE_EQ:2885,MCX_COMM:565899
    bin/dhan/instruments/websocket_quotes --per-socket 2000

    redis-cli SADD dhan:quotes:subscriptions NSE_EQ:2885 MCX_COMM:565899
    redis-cli HGET dhan:quotes:live "NSE:RELIANCE"
    redis-cli HGETALL dhan:quotes:instruments

The connection, the login and the binary packet decoding for Dhan's market feed at `wss://api-feed.dhan.co`
are `DhanQuotesSocket` and `DhanSession` in `stock_brokers/websockets/dhan.py`, whose module docstring
describes the protocol. This script chooses the instruments, splits them across sockets, runs the sockets and
writes the ticks they decode to Redis, so it needs no other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `dhan:quotes:subscriptions`,
each as `SEGMENT:SECURITY_ID` - `NSE_EQ`, `NSE_FNO`, `NSE_CURRENCY`, `BSE_EQ`, `BSE_FNO`, `BSE_CURRENCY`,
`MCX_COMM` or `IDX_I`, then Dhan's security id. Each is named from Dhan's scrip master, downloaded at startup.
One websocket carries up to `--per-socket` instruments, at most 5000, and Dhan allows 5 connections per user.

**Keys.**

- `dhan:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the instrument's name from
  the scrip master (`NSE:RELIANCE`), or by its `SEGMENT:SECURITY_ID` when the scrip master does not name it.
  A tick is replaced as the next one arrives. It is not cleared at startup, so an instrument no longer
  subscribed keeps its last tick.
- `dhan:quotes:instruments`, a hash of every subscribed `SEGMENT:SECURITY_ID` to its name, or to an empty
  string when unnamed. Replaced whole at startup.
- `dhan:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/dhan/instruments/store_quotes_to_db` writes to `dhan.ticks`. Capped at about 1,000,000 entries, so ticks that arrive while
  the persister is down for long enough are trimmed before they are persisted.

A tick has `id`, `broker`, `instrument_token`, `exchange`, `mode`, `last_price`, `last_quantity`,
`average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`, `oi_day_high`,
`oi_day_low`, `last_trade_time`, `exchange_timestamp`, `depth` (five `buy` and `sell` levels of `quantity`,
`price` and `orders`) and `received_at`, with `None` for what Dhan does not send. Prices are rupees. Dhan
stamps trade times in IST presented as an epoch; they are shifted to the true epoch. `ohlc.close` is the
previous session's close once Dhan has sent it, and `change` is the percentage change against it.

**Sessions.** Every socket shares one `DhanSession`, and reads the current token when it connects, so a login
made by any process is picked up. When Dhan disconnects a socket for an expired or invalid token (disconnect
codes 807, 808, 809), or a socket fails to open six times running, it logs in again - one socket at a time,
and only if no other socket or process already replaced the token - before reconnecting. A reconnect
otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket still cannot open after logging
in again, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import csv
import json
import signal
import argparse
import threading
from io import StringIO
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

SCRIP_MASTER_URL = "https://images.dhan.co/api-data/api-scrip-master-detailed.csv"

LIVE_KEY = "dhan:quotes:live"
INSTRUMENTS_KEY = "dhan:quotes:instruments"
SUBSCRIPTIONS_KEY = "dhan:quotes:subscriptions"

# Every tick is also appended here for bin/dhan/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "dhan:quotes:stream"
STREAM_MAX_LENGTH = 1000000

# Dhan's exchange segments and their numeric codes, per the DhanHQ v2 annexure.
SEGMENT_CODES = {"IDX_I": 0, "NSE_EQ": 1, "NSE_FNO": 2, "NSE_CURRENCY": 3, "BSE_EQ": 4, "MCX_COMM": 5,
                 "BSE_CURRENCY": 7, "BSE_FNO": 8}

# The scrip master's exchange and segment columns to Dhan's segment.
SCRIP_SEGMENTS = {("NSE", "E"): "NSE_EQ", ("NSE", "D"): "NSE_FNO", ("NSE", "C"): "NSE_CURRENCY",
                  ("BSE", "E"): "BSE_EQ", ("BSE", "D"): "BSE_FNO", ("BSE", "C"): "BSE_CURRENCY",
                  ("MCX", "M"): "MCX_COMM", ("NSE", "I"): "IDX_I", ("BSE", "I"): "IDX_I"}

MAX_INSTRUMENTS_PER_CONNECTION = 5000
CONNECTION_BUDGET = 5

class DhanQuotesStore:
    """
    Where the quotes sockets' ticks are written: the live hash and the persistence stream.
    """

    def __init__(self, cache):
        """
        Keeps the Redis client the ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_ticks(self, ticks):
        """
        Writes one message's ticks: the latest tick per instrument and every tick in arrival order, in one round trip.

        Args:
            ticks (list[dict]): The message's ticks, in arrival order.

        Returns:
            None: This method returns nothing.
        """
        encoded = []
        for tick in ticks:
            encoded.append((tick["id"], json.dumps(tick)))
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, mapping=dict(encoded))
        for _, payload in encoded:
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def resolve_tokens(tokens, cache, logger):
    """
    The valid `SEGMENT:SECURITY_ID` tokens to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        segment, _, security_id = token.partition(':')
        if segment in SEGMENT_CODES and security_id.isdigit():
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected SEGMENT:SECURITY_ID with SEGMENT one of {', '.join(SEGMENT_CODES)}.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Dhan's scrip master, keyed by `SEGMENT:SECURITY_ID`.

    An unreachable scrip master is reported and leaves every instrument unnamed rather than stopping the feed.

    - `tokens` is the list of subscribed `SEGMENT:SECURITY_ID` tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    try:
        response = requests.get(SCRIP_MASTER_URL, timeout=120)
        response.raise_for_status()
    except Exception as exception:
        logger.warning(f"Could not download Dhan's scrip master, so instruments are keyed by token: {exception}")
        return {}

    names = {}
    for row in csv.DictReader(StringIO(response.text)):
        segment = SCRIP_SEGMENTS.get((row.get('EXCH_ID'), row.get('SEGMENT')))
        token = f"{segment}:{row.get('SECURITY_ID')}"
        if segment and token in wanted:
            names[token] = f"{row['EXCH_ID']}:{row.get('DISPLAY_NAME') or row.get('SYMBOL_NAME')}"
    return names

def main():
    """Stream Dhan quotes into dhan:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Dhan market quotes into dhan:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated SEGMENT:SECURITY_ID tokens, for example NSE_EQ:2885")
    parser.add_argument("--per-socket", type=int, default=MAX_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, at most {MAX_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from stock_brokers.websockets.dhan import DhanQuotesSocket, DhanSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("dhan.websocket_quotes")
    cache = get_cache()

    if not 1 <= arguments.per_socket <= MAX_INSTRUMENTS_PER_CONNECTION:
        logger.error(f"--per-socket must be between 1 and {MAX_INSTRUMENTS_PER_CONNECTION}.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add SEGMENT:SECURITY_ID members to the Redis set "
                     f"{SUBSCRIPTIONS_KEY}.")
        return 2

    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]
    if len(batches) > CONNECTION_BUDGET:
        logger.error(f"{len(tokens)} instruments at {arguments.per_socket} per socket needs {len(batches)} connections, "
                     f"but Dhan allows {CONNECTION_BUDGET} per user.")
        return 2

    try:
        session = DhanSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Dhan: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the scrip master and are keyed by token: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    store = DhanQuotesStore(cache)
    sockets = []
    for index, batch in enumerate(batches):
        sockets.append(DhanQuotesSocket(f"socket_{index}", batch, names, session, store.write_ticks, logger))

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"dhan_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
