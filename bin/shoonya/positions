#!/usr/bin/env python3
"""
Poll the Shoonya positions every half second and merge them into the Redis hash `shoonya:portfolio:positions`.

    bin/shoonya/positions
    redis-cli HGETALL shoonya:portfolio:positions
    redis-cli HGET shoonya:portfolio:positions NSE:2885:C

Calls `POST https://api.shoonya.com/NorenWClientAPI/PositionBook` for the account in Shoonya's settings (`ucc_code`,
sent as `actid`) through `ShoonyaAPI`, which logs in first if the stored session is dead and signs the request with the
user id and token.

**One key for positions.** `shoonya:portfolio:positions` is a hash with one field per position, keyed `exch:token:prd`
- Noren lists one position per instrument and product. Every value is

    {"observed_at": <epoch>, "source": "rest", "position": <normalized position>, "data": <Noren's own row>}

with the same shape the brokers that also stream positions over a websocket use, so a reader handles every broker
alike. Noren streams no positions - its order stream carries orders only - so this poller is the one writer; the merge
rule below is there so a second writer could share the key. `position` has `id`, `instrument_token`, `tradingsymbol`,
`exchange`, `segment`, `product`, `quantity`, `buy_quantity`, `sell_quantity`, `buy_price`, `sell_price`, `buy_value`,
`sell_value`, `average_price`, `last_price`, `realized_pnl`, `unrealized_pnl`, `pnl`, `multiplier`, `lot_size`,
`day_or_net` and `updated_at`:

| field | from Noren |
| --- | --- |
| `id` | `exch:tsym` |
| `instrument_token`, `tradingsymbol`, `exchange` | `token`, `tsym`, `exch` (`NSE`, `BSE`, `NFO`, `BFO`, `CDS`, `BCD`, `MCX`) |
| `segment` | from `exch`: `EQ` for NSE and BSE, `FNO` for NFO and BFO, `CURRENCY` for CDS and BCD, `COMM` for MCX |
| `product` | `prd` on the shared vocabulary (`C` CNC, `I` MIS, `M` NRML...) |
| `quantity` | `netqty`, signed |
| `buy_quantity`, `sell_quantity` | today's plus carried forward: `daybuyqty` + `cfbuyqty`, `daysellqty` + `cfsellqty` |
| `buy_value`, `sell_value` | `daybuyamt` + `cfbuyamt`, `daysellamt` + `cfsellamt` |
| `buy_price`, `sell_price` | `totbuyavgprc`, `totsellavgprc`, or value over quantity when Noren leaves them out |
| `average_price`, `last_price` | `netavgprc`, `lp` |
| `realized_pnl`, `unrealized_pnl`, `pnl` | `rpnl`, `urmtom`, and their sum |
| `multiplier`, `lot_size` | `mult`, `ls` |
| `day_or_net` | `NET`: Noren's position book reports each position once, carried forward and today's together |

Noren sends no update time, so `updated_at` is null.

**Which write wins.** A row from this poller replaces an entry only when that entry was observed before this poll's
request was sent, so an entry from a newer writer is never overwritten by an older snapshot. The check and the write
run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00. A position Noren stops
listing during the day is not removed before then.

Shoonya runs on Noren, which answers HTTP 200 whether or not it served the request, so the body is checked. A flat
account comes back as a `Not_Ok` saying "no data", which is an answer and writes nothing. A refused session ("Session
Expired", "Invalid Session Key") is logged in again before the next request; any other refusal or failed poll is
logged and leaves the hash unchanged.

Runs until Ctrl+C. Exits 1 when the session does not work at startup or after a login following a refused session -
checked against `UserDetails` after the constructor returns. Reads only - it places no orders.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

POSITION_BOOK_URL = "https://api.shoonya.com/NorenWClientAPI/PositionBook"
USER_DETAILS_URL = "https://api.shoonya.com/NorenWClientAPI/UserDetails"
REDIS_KEY = "shoonya:portfolio:positions"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "shoonya:portfolio:positions:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for Noren's blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value, which Noren sends as a string.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

# Noren's exchanges to the segment they trade.
SEGMENTS = {"NSE": "EQ", "BSE": "EQ", "NFO": "FNO", "BFO": "FNO", "CDS": "CURRENCY", "BCD": "CURRENCY", "MCX": "COMM"}

def position_key(row):
    """
    The hash field for a Noren position row, `exch:token:prd`, or None when it lacks one of them.

    - `row` is one row of `PositionBook`.
    """
    parts = [text(row.get(field)) for field in ("exch", "token", "prd")] if isinstance(row, dict) else [None]
    return ":".join(parts) if all(parts) else None

def summed(row, *fields):
    """
    The sum of the fields Noren sent, or None when it sent none of them.

    - `row` is one row of `PositionBook`.
    - `fields` are the fields to add.
    """
    values = [number(row.get(field)) for field in fields]
    present_values = [value for value in values if value is not None]
    return sum(present_values) if present_values else None

def position_from_row(row):
    """
    A Noren position row as a normalized position.

    - `row` is one row of `PositionBook`.
    """
    exchange, symbol = text(row.get('exch')), text(row.get('tsym'))
    buy_quantity, sell_quantity = summed(row, 'daybuyqty', 'cfbuyqty'), summed(row, 'daysellqty', 'cfsellqty')
    buy_quantity = int(buy_quantity) if buy_quantity is not None else None
    sell_quantity = int(sell_quantity) if sell_quantity is not None else None
    buy_value, sell_value = summed(row, 'daybuyamt', 'cfbuyamt'), summed(row, 'daysellamt', 'cfsellamt')
    buy_price = number(row.get('totbuyavgprc'))
    if buy_price is None and buy_value is not None and buy_quantity:
        buy_price = buy_value / buy_quantity
    sell_price = number(row.get('totsellavgprc'))
    if sell_price is None and sell_value is not None and sell_quantity:
        sell_price = sell_value / sell_quantity
    realized, unrealized = number(row.get('rpnl')), number(row.get('urmtom'))
    return {
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('token')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "segment": SEGMENTS.get(exchange),
        "product": normalize(present(row.get('prd')), PRODUCTS),
        "quantity": number(row.get('netqty'), int),
        "buy_quantity": buy_quantity,
        "sell_quantity": sell_quantity,
        "buy_price": buy_price,
        "sell_price": sell_price,
        "buy_value": buy_value,
        "sell_value": sell_value,
        "average_price": number(row.get('netavgprc')),
        "last_price": number(row.get('lp')),
        "realized_pnl": realized,
        "unrealized_pnl": unrealized,
        "pnl": realized + unrealized if realized is not None and unrealized is not None else None,
        "multiplier": number(row.get('mult')),
        "lot_size": number(row.get('ls'), int),
        "day_or_net": "NET",
        "updated_at": None,
    }

# What Noren says when the session key is no good, lowercased.
AUTHENTICATION_MARKERS = ("session expired", "invalid session key", "invalid session")

# What Noren says when there is nothing to list, lowercased.
NO_DATA_MARKER = "no data"

class ShoonyaRefusal(Exception):
    """Shoonya refused the request in the body of an HTTP 200 response."""

def checked(response):
    """
    The response when Noren served the request, with an empty list for "no data", raising ShoonyaRefusal
    with Noren's message for any other refusal.
    """
    data = (response or {}).get('data')
    if isinstance(data, dict) and str(data.get('stat', '')).lower() != 'ok':
        message = str(data.get('emsg') or data)
        if NO_DATA_MARKER in message.lower():
            return {**response, 'data': []}
        raise ShoonyaRefusal(message[:200])
    if not isinstance(data, list):
        raise ShoonyaRefusal(f"answered without a list: {str(data)[:200]}")
    return response

def confirm_session(shoonya):
    """
    Raise ShoonyaRefusal unless UserDetails serves the session.

    ShoonyaAPI now checks its probe's body and logs in on a Noren refusal, so this is a second line: a login that
    returned without producing a working session stops the script rather than leaving it polling a dead token.
    """
    data = (shoonya.post(url=USER_DETAILS_URL, timeout=TIMEOUT_SECONDS) or {}).get('data')
    if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
        raise ShoonyaRefusal(f"the session was not restored: {str(data)[:200]}")

def is_authentication_error(exception):
    """Whether Shoonya refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the positions and merge them into shoonya:portfolio:positions every half second, until interrupted."""
    from stock_brokers.api.shoonya import ShoonyaAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("shoonya.positions")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        shoonya = ShoonyaAPI()
        confirm_session(shoonya)
    except Exception as exception:
        logger.error(f"Could not log in to Shoonya: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                # A fresh dict each time: the API client writes the user id into the one it is given.
                rows = checked(shoonya.post(url=POSITION_BOOK_URL, data={'actid': shoonya._settings['ucc_code']},
                                            timeout=TIMEOUT_SECONDS))['data']
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    field = position_key(row)
                    if field is not None:
                        arguments += [field, json.dumps({"observed_at": requested_at, "source": "rest",
                                                         "position": position_from_row(row), "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} position(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Shoonya session expired, logging in again: {exception}")
                    shoonya = ShoonyaAPI()
                    confirm_session(shoonya)
                else:
                    report.error(f"Positions poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
