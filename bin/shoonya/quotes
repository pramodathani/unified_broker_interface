#!/usr/bin/env python3
"""
Stream Shoonya market quotes over websockets into the Redis hash `shoonya:quotes:live`, and keep streaming until
stopped.

    bin/shoonya/quotes                               # instruments from the Redis set shoonya:quotes:subscriptions
    bin/shoonya/quotes --tokens NSE|2885,MCX|565899
    bin/shoonya/quotes --per-socket 500

    redis-cli SADD shoonya:quotes:subscriptions "NSE|2885" "MCX|565899"
    redis-cli HGET shoonya:quotes:live "NSE:RELIANCE-EQ"
    redis-cli HGETALL shoonya:quotes:instruments

Self-contained: it logs in with `ShoonyaAPI` and carries its own connection, authentication, subscription and
message decoding for Shoonya's Noren feed at `wss://api.shoonya.com/NorenWSTP/`, so it needs no other feed
process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `shoonya:quotes:subscriptions`,
each as `EXCHANGE|TOKEN` - `NSE`, `NFO`, `CDS`, `MCX`, `BSE`, `BFO` or `NCX`, then Shoonya's token. Each is
named `EXCHANGE:TRADINGSYMBOL` from Shoonya's public scrip files for the exchanges subscribed, downloaded at
startup; an instrument the files do not name takes the trading symbol Noren sends when it acknowledges the
subscription. One websocket carries up to `--per-socket` instruments.

**The protocol.** Noren streams JSON text, and the connection is unusable until it is authenticated: on open the
socket sends `{"t": "a", "uid", "actid", "source": "API", "accesstoken"}`, and only after the `ak` acknowledgement
says `OK` does it subscribe, with one `{"t": "d", "k": "NSE|2885#MCX|565899"}` frame for depth and touchline
together. The feed is incremental: an acknowledgement (`tk`, `dk`) carries every field and each update after it
(`tf`, `df`) only what changed, so the last state of each instrument is kept and every update merged into it
before a tick is written. Every value arrives as a string and is converted. Noren's heartbeat, `{"t":"h"}`, is
sent every three seconds; a plain websocket ping is not enough to keep the connection.

**Keys.**

- `shoonya:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by `EXCHANGE:TRADINGSYMBOL`, or
  by `EXCHANGE|TOKEN` for an instrument not yet named. Replaced as each update arrives; not cleared at startup,
  so an instrument no longer subscribed keeps its last tick.
- `shoonya:quotes:instruments`, a hash of every subscribed `EXCHANGE|TOKEN` to its name, or to an empty string
  when unnamed. Replaced whole at startup; a name Noren sends later is filled in.
- `shoonya:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/shoonya/persist_ticks` writes to `shoonya.ticks`. Capped at about 100,000 entries, so ticks that arrive
  while the persister is down for long enough are trimmed before they are persisted.

A tick has `id`, `broker`, `instrument_token`, `exchange`, `mode`, `last_price`, `last_quantity`,
`average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`, `oi_day_high`, `oi_day_low`,
`last_trade_time`, `exchange_timestamp`, `depth` (up to five `buy` and `sell` levels of `quantity`, `price` and
`orders`) and `received_at`, with `None` for what Noren does not send. Noren spells `ltt` as an epoch, a date and
time, or a bare India clock time; all three become an epoch. No tick is written until an instrument has a price.

**Sessions.** Each connection reads the current token when it connects, so a login made by any process is picked
up. When Noren refuses the connect frame, or a socket fails to open six times running, it logs in again through
`ShoonyaAPI` - a headless Chrome login, so one socket at a time - before reconnecting. A reconnect otherwise backs
off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket is still refused after logging in
again, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import csv
import json
import time
import signal
import zipfile
import argparse
import threading
from io import BytesIO, StringIO
from datetime import datetime, timedelta, timezone
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

FEED_URL = "wss://api.shoonya.com/NorenWSTP/"
SCRIP_FILE_URL = "https://api.shoonya.com/{exchange}_symbols.txt.zip"

LIVE_KEY = "shoonya:quotes:live"
INSTRUMENTS_KEY = "shoonya:quotes:instruments"
SUBSCRIPTIONS_KEY = "shoonya:quotes:subscriptions"

# Every tick is also appended here for bin/shoonya/persist_ticks, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "shoonya:quotes:stream"
STREAM_MAX_LENGTH = 100000

EXCHANGES = ("NSE", "NFO", "CDS", "MCX", "BSE", "BFO", "NCX")
DEFAULT_INSTRUMENTS_PER_CONNECTION = 1000

# Message types: the connect acknowledgement, and the touchline and depth acknowledgements and updates.
CONNECT_ACK = "ak"
TICK_MESSAGES = ("tk", "tf", "dk", "df")
ACKNOWLEDGEMENTS = ("tk", "dk")

HEARTBEAT = '{"t":"h"}'
HEARTBEAT_INTERVAL_SECONDS = 3
HEARTBEAT_TIMEOUT_SECONDS = 2
MIN_BACKOFF_SECONDS = 1
MAX_BACKOFF_SECONDS = 60
MAX_FAILED_CONNECTS = 6

# India has no daylight saving, so a fixed offset turns Noren's India wall clock times into instants.
INDIA = timezone(timedelta(hours=5, minutes=30))
TRADE_TIME_FORMATS = ("%d-%m-%Y %H:%M:%S", "%d/%m/%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S")

class ShoonyaSession:
    """
    The Shoonya login every socket authenticates with, logged in again by one socket at a time.
    """

    def __init__(self, logger):
        """
        Construct ShoonyaAPI, which logs in when the stored session is dead.

        - `logger` is where logins are reported.
        """
        from stock_brokers.api.shoonya import ShoonyaAPI

        self._api_class = ShoonyaAPI
        self._logger = logger
        self._lock = threading.Lock()
        self._shoonya = ShoonyaAPI()

    def credentials(self):
        """
        The Noren user id and the session token in force now, which may be one another process has just obtained.
        """
        login = self._shoonya._current_login() or {}
        return self._shoonya._settings.get('ucc_code'), login.get('access_token')

    def log_in_again(self, stale_token):
        """
        Log in again, unless another socket already replaced the token that failed.

        - `stale_token` is the session token the failing connection used.
        """
        with self._lock:
            if self.credentials()[1] != stale_token:
                return
            self._logger.warning("Logging in to Shoonya again.")
            self._shoonya = self._api_class()

class QuotesSocket:
    """
    One Shoonya market feed websocket for a batch of instruments, reconnecting until stopped.
    """

    def __init__(self, name, tokens, names, session, cache, logger):
        """
        - `name` is the connection's name, for the log.
        - `tokens` is the batch of `EXCHANGE|TOKEN` instrument tokens.
        - `names` maps `EXCHANGE|TOKEN` to the instrument's name, and is filled in from acknowledgements.
        - `session` is the shared ShoonyaSession.
        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        self.name = name
        self._tokens = tokens
        self._names = names
        self._session = session
        self._cache = cache
        self._logger = logger
        self._stop = threading.Event()
        self._ws = None
        self._token = None
        self._opened = False
        self._authentication_rejected = False
        # The merged field state per instrument; Noren sends only what changed.
        self._state = {}
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except Exception as exception:
                self._logger.error(f"{self.name} connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again:
                    self.gave_up = True
                    self._logger.error(f"{self.name} is still refused after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._session.log_in_again(self._token)
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"{self.name} could not log in to Shoonya again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"{self.name} disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info(f"{self.name} stopped.")

    def _connect(self):
        """Open the websocket and block until it closes."""
        import websocket

        self._ws = websocket.WebSocketApp(FEED_URL, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=HEARTBEAT_INTERVAL_SECONDS, ping_timeout=HEARTBEAT_TIMEOUT_SECONDS,
                             ping_payload=HEARTBEAT)

    def _on_open(self, ws):
        """
        Authenticate with the token in force now. The subscription waits for the acknowledgement.

        The frame is `a` with the token named `accesstoken`: Noren also parses a `c` frame naming it `susertoken`,
        and refuses a perfectly good token that way, which reads exactly like an expired session.
        """
        self._opened = True
        self._state = {}
        user_id, self._token = self._session.credentials()
        ws.send(json.dumps({"t": "a", "uid": user_id, "actid": user_id, "source": "API", "accesstoken": self._token}))
        self._logger.info(f"{self.name} opened. Authenticating.")

    def _on_error(self, ws, error):
        self._logger.error(f"{self.name} error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"{self.name} closed with status {status_code}: {message}")

    def _on_message(self, ws, message):
        """Handle the connect acknowledgement, and write each tick to the live quotes hash."""
        tick = self._parse(message)
        if tick:
            payload = json.dumps(tick)
            # The latest tick per instrument and every tick in arrival order, in one round trip.
            pipeline = self._cache.pipeline(transaction=False)
            pipeline.hset(LIVE_KEY, tick['id'], payload)
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()

    def _parse(self, message):
        """
        A tick from one Noren message, or None for a message that carries none.

        - `message` is the message received.
        """
        if isinstance(message, (bytes, bytearray)):
            message = message.decode('utf-8', errors='replace')
        try:
            payload = json.loads(message)
        except (TypeError, json.JSONDecodeError):
            self._logger.debug(f"{self.name} ignored a frame that is not JSON: {str(message)[:160]}")
            return None
        if not isinstance(payload, dict):
            return None

        message_type = payload.get('t')
        if message_type == CONNECT_ACK:
            # Documented as "Ok" at Shoonya and seen as "OK" on the wire, so the comparison ignores case.
            if str(payload.get('s', '')).upper() == 'OK':
                self._ws.send(json.dumps({"t": "d", "k": "#".join(self._tokens)}))
                self._logger.info(f"{self.name} authenticated and subscribed to {len(self._tokens)} instrument(s).")
            else:
                self._logger.error(f"{self.name} authentication refused: {payload}")
                self._authentication_rejected = True
                self._ws.close()
            return None

        if message_type not in TICK_MESSAGES or not payload.get('e') or not payload.get('tk'):
            return None
        token = f"{payload['e']}|{payload['tk']}"

        if message_type in ACKNOWLEDGEMENTS and payload.get('ts') and not self._names.get(token):
            self._names[token] = f"{payload['e']}:{payload['ts']}"
            self._cache.hset(INSTRUMENTS_KEY, token, self._names[token])

        state = self._state.setdefault(token, {})
        state.update({key: value for key, value in payload.items() if key not in ('t', 'e', 'tk')})
        tick = build_tick(token, state, self._names.get(token) or token)
        return tick if tick['last_price'] is not None else None

def number(value, cast=float):
    """
    A Noren string field as a number, with blanks and placeholders as None.

    - `value` is the raw field.
    - `cast` is the target type.
    """
    if value is None or value == "" or value == "NA":
        return None
    try:
        return cast(float(value)) if cast is int else cast(value)
    except (TypeError, ValueError):
        return None

def trade_time(value, feed_time):
    """
    Noren's last trade time as an epoch, whether sent as an epoch, a date and time, or a bare India clock time.

    A bare clock time is dated by the tick's feed time, and moved back a day if that would put the trade after it,
    which happens only for a trade just before midnight reported just after.

    - `value` is the raw `ltt` field.
    - `feed_time` is the tick's `ft` epoch, or None to use the wall clock.
    """
    if value is None or value == "" or value == "NA":
        return None
    text = str(value).strip()
    if text.isdigit():
        return int(text)
    for format in TRADE_TIME_FORMATS:
        try:
            return int(datetime.strptime(text, format).replace(tzinfo=INDIA).timestamp())
        except ValueError:
            continue
    try:
        clock = datetime.strptime(text, "%H:%M:%S").time()
    except ValueError:
        return None
    reference = datetime.fromtimestamp(feed_time if feed_time else time.time(), tz=INDIA)
    moment = datetime.combine(reference.date(), clock, tzinfo=INDIA)
    if moment > reference + timedelta(minutes=5):
        moment -= timedelta(days=1)
    return int(moment.timestamp())

def build_tick(token, state, identifier):
    """
    A normalized tick from an instrument's merged state.

    - `token` is the instrument's `EXCHANGE|TOKEN`.
    - `state` is its merged field state.
    - `identifier` is the name the tick is keyed by.
    """
    last_price = number(state.get('lp'))
    close = number(state.get('c'))
    change = number(state.get('pc'))
    if change is None and last_price is not None and close:
        change = (last_price - close) * 100 / close

    depth = {"buy": [], "sell": []}
    for level in range(1, 6):
        for side, prefix in (("buy", "b"), ("sell", "s")):
            if state.get(f'{prefix}p{level}') is not None:
                depth[side].append({"quantity": number(state.get(f'{prefix}q{level}'), int),
                                    "price": number(state.get(f'{prefix}p{level}')),
                                    "orders": number(state.get(f'{prefix}o{level}'), int)})

    feed_time = number(state.get('ft'), int)
    return {"id": identifier, "broker": "shoonya", "instrument_token": token, "exchange": token.partition('|')[0],
            "mode": "full" if depth["buy"] or depth["sell"] else "quote", "last_price": last_price,
            "last_quantity": number(state.get('ltq'), int), "average_price": number(state.get('ap')),
            "volume": number(state.get('v'), int), "buy_quantity": number(state.get('tbq'), int),
            "sell_quantity": number(state.get('tsq'), int),
            "ohlc": {"open": number(state.get('o')), "high": number(state.get('h')), "low": number(state.get('l')),
                     "close": close},
            "change": change, "oi": number(state.get('oi'), int), "oi_day_high": None, "oi_day_low": None,
            "last_trade_time": trade_time(state.get('ltt'), feed_time), "exchange_timestamp": feed_time,
            "depth": depth, "received_at": time.time()}

def resolve_tokens(tokens, cache, logger):
    """
    The valid `EXCHANGE|TOKEN` tokens to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        exchange, _, instrument = token.partition('|')
        if exchange in EXCHANGES and instrument:
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected EXCHANGE|TOKEN with EXCHANGE one of {', '.join(EXCHANGES)}.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Shoonya's scrip files, keyed by `EXCHANGE|TOKEN`.

    Only the exchanges subscribed are downloaded. A file that cannot be downloaded is reported and leaves its
    instruments to be named by the feed rather than stopping it.

    - `tokens` is the list of subscribed `EXCHANGE|TOKEN` tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    names = {}
    for exchange in sorted({token.partition('|')[0] for token in tokens}):
        url = SCRIP_FILE_URL.format(exchange=exchange)
        try:
            response = requests.get(url, timeout=120)
            response.raise_for_status()
            with zipfile.ZipFile(BytesIO(response.content)) as archive:
                for member in archive.namelist():
                    for row in csv.DictReader(StringIO(archive.read(member).decode("latin-1"))):
                        token = f"{row.get('Exchange')}|{row.get('Token')}"
                        if token in wanted and row.get('TradingSymbol'):
                            names[token] = f"{row['Exchange']}:{row['TradingSymbol']}"
        except Exception as exception:
            logger.warning(f"Could not read {url}, so its instruments are named by the feed: {exception}")
    return names

def main():
    """Stream Shoonya quotes into shoonya:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Shoonya market quotes into shoonya:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated EXCHANGE|TOKEN tokens, for example NSE|2885")
    parser.add_argument("--per-socket", type=int, default=DEFAULT_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, default {DEFAULT_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("shoonya.quotes")
    cache = get_cache()

    if arguments.per_socket < 1:
        logger.error("--per-socket must be at least 1.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE|TOKEN members to the Redis set "
                     f"{SUBSCRIPTIONS_KEY}.")
        return 2

    try:
        session = ShoonyaSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Shoonya: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the scrip files and will be named by the feed: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]
    sockets = [QuotesSocket(f"socket_{index}", batch, names, session, cache, logger) for index, batch in enumerate(batches)]

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"shoonya_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
