#!/usr/bin/env python3
"""
Stream Shoonya order updates over a websocket and merge them into the Redis hash `shoonya:orders:orders`, and keep
streaming until stopped.

    bin/shoonya/orders/websocket_order_details
    redis-cli HGETALL shoonya:orders:orders
    redis-cli HGET shoonya:orders:orders <norenordno>

The connection and the login are `ShoonyaOrderUpdatesSocket` and `ShoonyaSession` in
`stock_brokers/websockets/shoonya.py`, whose module docstring describes Noren's connect frame and heartbeat at
`wss://api.shoonya.com/NorenWSTP/`. This script runs the socket and turns the updates it hands over into the
Redis writes below, so it needs no other feed process or key. The socket opens its own connection, apart from
any market feed, so a market data reconnect can never drop an order event.

**The stream.** On open the socket sends Noren's connect frame, `{"t": "a", "uid", "actid", "source": "API",
"accesstoken"}`, with the account's UCC code as the user id. Once the `ak` acknowledgement says `OK` it subscribes
to the whole account with `{"t": "o", "actid": <ucc code>}`, and from then on every change to an order arrives as
an `om` message: `norenordno`, `exchordid`, `status`, `rejreason`, `exch`, `tsym`, `token`, `trantype`, `prd`,
`prctyp`, `ret`, `qty`, `fillshares`, `cancelqty`, `dscqty`, `prc`, `trgprc`, `avgprc`, `norentm`, `exch_tm`,
`remarks` and more, every value a string. Noren's heartbeat, `{"t":"h"}`, is sent every three seconds.

**The key.** `shoonya:orders:orders` is the one hash for Shoonya's orders, keyed by `norenordno` and shared with
`bin/shoonya/orders/api_order_details`, which merges the polled order book into it. Each update is written as
`{"observed_at": <epoch received>, "source": "websocket", "order": <normalized order>, "data": <om>}`, with Noren's
message exactly as sent in `data`. Noren's `om` message carries the order book's fields, so `order` is built by the
same function the poller uses - see `bin/shoonya/orders/api_order_details` for its fields and mapping. A websocket update always
replaces its order's entry; a polled row replaces it only when the entry was observed before the poll's request was
sent. The hash expires at 06:00 IST, moved to the next 06:00 by every write.

**The stream.** Every update is also appended, in arrival order, to the Redis Stream `shoonya:order-updates:stream`
as an `update` field holding the same JSON, which `bin/shoonya/orders/store_orders_to_db` writes to `shoonya.order_updates` -
so the history the hash overwrites is kept there. Capped at about 20,000 entries.

**Positions.** Noren's order stream carries orders only, so this script writes no positions; `bin/shoonya/portfolio/positions`
fills `shoonya:portfolio:positions` from the REST position book.

**Sessions.** The token is read afresh on every connect, so a login made by any process is picked up. When Noren
refuses the connect frame, or the socket fails to open six times running, it logs in again - a headless Chrome
login, without checking whether another process has already replaced the token - before reconnecting. A reconnect otherwise backs off from 1 to 60 seconds. Updates
arrive only when an order changes, so a quiet socket is not a broken one.

Exits 0 when stopped with Ctrl+C or SIGTERM, and 1 when a login fails or the connect frame is still refused after
logging in again. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import signal
import threading
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_KEY = "shoonya:orders:orders"

# Every update is also appended here for bin/shoonya/orders/store_orders_to_db, which reads it with a consumer group.
STREAM_KEY = "shoonya:order-updates:stream"
STREAM_MAX_LENGTH = 20000

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
