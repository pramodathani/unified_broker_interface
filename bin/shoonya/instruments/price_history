#!/usr/bin/env python3
"""
Download Shoonya's historical candles into `shoonya.price_history`, working a resumable queue until stopped.

    bin/shoonya/instruments/price_history --seed                    # register every instrument and interval, then work
    bin/shoonya/instruments/price_history                           # work the queue until stopped or drained
    bin/shoonya/instruments/price_history --seed-only               # register new series and exit
    bin/shoonya/instruments/price_history --status                  # how far it has got
    bin/shoonya/instruments/price_history --deadline-seconds 21600

Built on `ShoonyaCandles`, with one difference: every login - at startup and after Shoonya refuses the session -
goes straight through `ShoonyaAPI`, which logs in with a headless Chrome when the stored token is dead, rather
than through the shared session helper `stock_brokers.api.utilities.session.ensure_session`.

**Seeding** reads the latest row per instrument from `shoonya.instruments` (filled by `bin/shoonya/instruments/daily_feed`)
and registers one row per instrument and interval in `shoonya.price_history_progress`, leaving existing rows
alone, so seeding again after a new instrument master adds only what is new. An instrument is identified by its
exchange, token and trading symbol joined together, because Noren's two endpoints want different ones. The
intervals are the eleven Noren serves: `1minute`, `2minute`, `3minute`, `5minute`, `10minute`, `15minute`,
`30minute`, `60minute`, `120minute`, `240minute` and `day`.

**The queue** is worked in priority order - cash daily bars first, then cash intraday, live futures, live options,
and expired contracts last. Each series walks backward from today - 180 days a window for one minute bars, a year
for the other intraday intervals and 4000 days daily, wide enough to step over the months Noren's intraday history
is missing - until it reaches 2021-01-01 or three windows come back empty, then keeps collecting forward. Daily bars
come from `POST /NorenWClientAPI/EODChartData` and intraday from `POST /NorenWClientAPI/TPSeries`, paced at one
request a second. Shoonya keeps a rolling five years of daily bars and a rolling year of intraday ones.

**Each window** is upserted into `shoonya.price_history` on `(instrument_token, interval, time)` together with the
series' progress, in one transaction, so stopping costs at most the request in flight and a repeated window updates
rather than duplicates. Noren refuses inside an HTTP 200: its "no data" is the same for an empty window and an
unknown token, so it counts as empty and a series is retired only when its whole walk found nothing; a throttle backs
off five seconds; a refused session ("Session Expired", "Invalid Session Key") is logged in once and the window
retried.

Run it on its own: the queue is not locked between processes, so two workers on `shoonya.price_history_progress` would
claim the same series and share Shoonya's rate limit.

Exits 0 when stopped, drained or out of time, 1 when it stopped because the session could not be restored or
Shoonya refused this client, and 2 when the first login fails.
"""

import sys
import signal
import argparse
import threading
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

def downloader():
    """
    A ShoonyaCandles that logs in through ShoonyaAPI directly, and remembers why it stopped.
    """
    from stock_brokers.api.shoonya import ShoonyaAPI
    from stock_brokers.instruments.historical.base import CandleAuthenticationError, CandleBlocked, CandleThrottled
    from stock_brokers.instruments.historical.shoonya import ShoonyaCandles

    class DirectLoginShoonyaCandles(ShoonyaCandles):
        """ShoonyaCandles whose logins construct ShoonyaAPI rather than going through the shared session helper."""

        stopped_by = None

        def _build_api(self):
            return ShoonyaAPI()

        def relogin(self):
            """
            Log in again through ShoonyaAPI, which runs the real login when the stored session is refused.

            Raises:
                CandleAuthenticationError: If no working session could be established.
            """
            try:
                self._api = self._build_api()
                self.after_relogin()
            except Exception as exception:
                raise CandleAuthenticationError(f"logging in again did not produce a working session: "
                                                f"{type(exception).__name__}: {str(exception)[:200]}") from exception
            self._logger.info("shoonya logged in again. Continuing.")

        def visit(self, series):
            # `run` ends its loop on these without raising, so they are noted here for the exit code.
            try:
                return super().visit(series)
            except (CandleAuthenticationError, CandleBlocked, CandleThrottled) as exception:
                self.stopped_by = exception
                raise

    # Passing the API in keeps NorenCandles from establishing the session itself.
    return DirectLoginShoonyaCandles(api=ShoonyaAPI())

def show_status(candles):
    """
    Print how far the download has got.

    - `candles` is the Shoonya candle downloader.
    """
    summary = candles.summary()
    print("shoonya price history")
    for label, value in (("series registered", summary["series"]), ("series with bars", summary["with_bars"]),
                         ("series retired by the broker", summary["retired"]),
                         ("series stuck on failures", summary["stuck"]), ("bars stored", summary["bars"])):
        print(f"  {label:<30} {value:>14,}")
    if not summary["series"]:
        print("Nothing registered. Run with --seed first.")
    return 0

def main():
    """Work Shoonya's candle queue."""
    parser = argparse.ArgumentParser(description="Download Shoonya's historical candles into shoonya.price_history.")
    parser.add_argument("--seed", action="store_true", help="register every instrument and interval before working")
    parser.add_argument("--seed-only", action="store_true", help="register the series and exit without downloading")
    parser.add_argument("--status", action="store_true", help="show how far the download has got, and exit")
    parser.add_argument("--deadline-seconds", type=int, help="stop after this long, for a nightly window")
    arguments = parser.parse_args()

    from utilities.configurations import get_logger

    logger = get_logger("shoonya.price_history")
    try:
        candles = downloader()
    except Exception as exception:
        logger.error(f"Could not log in to Shoonya: {type(exception).__name__}: {exception}")
        return 2

    try:
        if arguments.status:
            return show_status(candles)

        if arguments.seed or arguments.seed_only:
            logger.info("Registering every shoonya instrument and interval. This reads the whole instrument master.")
            added = candles.seed()
            logger.info(f"Registered {added:,} new series.")
            if arguments.seed_only:
                return 0

        # A backfill is stopped many times, so shutdown finishes the window in flight rather than abandoning it:
        # the flag is checked between windows.
        stop = threading.Event()

        def _handle_signal(signal_number, frame):
            logger.info(f"Received signal {signal_number}. Finishing the window in flight, then stopping.")
            stop.set()

        for signal_number in (signal.SIGINT, signal.SIGTERM):
            signal.signal(signal_number, _handle_signal)

        visits, bars = candles.run(stop_event=stop, deadline_seconds=arguments.deadline_seconds)
        logger.info(f"Stored {bars:,} bar(s) over {visits:,} window(s).")
        if candles.stopped_by is not None and not stop.is_set():
            logger.error(f"Stopped early: {type(candles.stopped_by).__name__}: {candles.stopped_by}")
            return 1
        return 0
    finally:
        candles.close()

if __name__ == "__main__":
    raise SystemExit(main())
