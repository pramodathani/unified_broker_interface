#!/usr/bin/env python3
"""
Stream Shoonya market quotes over websockets into the Redis hash `shoonya:quotes:live`, and keep streaming until
stopped.

    bin/shoonya/instruments/websocket_quotes                               # instruments from the Redis set shoonya:quotes:subscriptions
    bin/shoonya/instruments/websocket_quotes --tokens NSE|2885,MCX|565899
    bin/shoonya/instruments/websocket_quotes --per-socket 500

    redis-cli SADD shoonya:quotes:subscriptions "NSE|2885" "MCX|565899"
    redis-cli HGET shoonya:quotes:live "NSE:RELIANCE-EQ"
    redis-cli HGETALL shoonya:quotes:instruments

The connection, the login, the authentication and the message decoding for Shoonya's Noren feed at
`wss://api.shoonya.com/NorenWSTP/` are `ShoonyaQuotesSocket` and `ShoonyaSession` in
`stock_brokers/websockets/shoonya.py`, whose module docstring describes the protocol. This script chooses the
instruments, splits them across sockets, runs the sockets and writes what they decode to Redis, so it needs no
other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `shoonya:quotes:subscriptions`,
each as `EXCHANGE|TOKEN` - `NSE`, `NFO`, `CDS`, `MCX`, `BSE`, `BFO` or `NCX`, then Shoonya's token. Each is
named `EXCHANGE:TRADINGSYMBOL` from Shoonya's public scrip files for the exchanges subscribed, downloaded at
startup; an instrument the files do not name takes the trading symbol Noren sends when it acknowledges the
subscription. One websocket carries up to `--per-socket` instruments.

**Keys.**

- `shoonya:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by `EXCHANGE:TRADINGSYMBOL`, or
  by `EXCHANGE|TOKEN` for an instrument not yet named. Replaced as each update arrives; not cleared at startup,
  so an instrument no longer subscribed keeps its last tick.
- `shoonya:quotes:instruments`, a hash of every subscribed `EXCHANGE|TOKEN` to its name, or to an empty string
  when unnamed. Replaced whole at startup; a name Noren sends later is filled in.
- `shoonya:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/shoonya/instruments/store_quotes_to_db` writes to `shoonya.ticks`. Capped at about 1,000,000 entries, so ticks that arrive
  while the persister is down for long enough are trimmed before they are persisted.

A tick has `id`, `broker`, `instrument_token`, `exchange`, `mode`, `last_price`, `last_quantity`,
`average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`, `oi_day_high`, `oi_day_low`,
`last_trade_time`, `exchange_timestamp`, `depth` (up to five `buy` and `sell` levels of `quantity`, `price` and
`orders`) and `received_at`, with `None` for what Noren does not send. Noren spells `ltt` as an epoch, a date and
time, or a bare India clock time; all three become an epoch. No tick is written until an instrument has a price.

**Sessions.** Every socket shares one `ShoonyaSession`, and reads the current token when it connects, so a login
made by any process is picked up. When Noren refuses the connect frame, or a socket fails to open six times
running, it logs in again - a headless Chrome login, so one socket at a time, and only if no other socket or
process already replaced the token - before reconnecting. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket is still refused after logging in
again, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import csv
import json
import signal
import zipfile
import argparse
import threading
from io import BytesIO, StringIO
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

SCRIP_FILE_URL = "https://api.shoonya.com/{exchange}_symbols.txt.zip"

LIVE_KEY = "shoonya:quotes:live"
INSTRUMENTS_KEY = "shoonya:quotes:instruments"
SUBSCRIPTIONS_KEY = "shoonya:quotes:subscriptions"

# Every tick is also appended here for bin/shoonya/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "shoonya:quotes:stream"
STREAM_MAX_LENGTH = 1000000

EXCHANGES = ("NSE", "NFO", "CDS", "MCX", "BSE", "BFO", "NCX")
DEFAULT_INSTRUMENTS_PER_CONNECTION = 1000

class ShoonyaQuotesStore:
    """
    Where the quotes sockets' output is written: learned names, the live hash and the persistence stream.
    """

    def __init__(self, cache):
        """
        Keeps the Redis client the names and ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_name(self, token, name):
        """
        Fills in the name Noren gave an instrument in the subscribed instruments hash.

        Args:
            token (str): The instrument's `EXCHANGE|TOKEN`.
            name (str): Its `EXCHANGE:TRADINGSYMBOL`.

        Returns:
            None: This method returns nothing.
        """
        self._cache.hset(INSTRUMENTS_KEY, token, name)

    def write_tick(self, tick):
        """
        Writes one tick: the latest tick per instrument and every tick in arrival order, in one round trip.

        Args:
            tick (dict): The tick.

        Returns:
            None: This method returns nothing.
        """
        payload = json.dumps(tick)
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, tick["id"], payload)
        pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def resolve_tokens(tokens, cache, logger):
    """
    The valid `EXCHANGE|TOKEN` tokens to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        exchange, _, instrument = token.partition('|')
        if exchange in EXCHANGES and instrument:
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected EXCHANGE|TOKEN with EXCHANGE one of {', '.join(EXCHANGES)}.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Shoonya's scrip files, keyed by `EXCHANGE|TOKEN`.

    Only the exchanges subscribed are downloaded. A file that cannot be downloaded is reported and leaves its
    instruments to be named by the feed rather than stopping it.

    - `tokens` is the list of subscribed `EXCHANGE|TOKEN` tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    names = {}
    for exchange in sorted({token.partition('|')[0] for token in tokens}):
        url = SCRIP_FILE_URL.format(exchange=exchange)
        try:
            response = requests.get(url, timeout=120)
            response.raise_for_status()
            with zipfile.ZipFile(BytesIO(response.content)) as archive:
                for member in archive.namelist():
                    for row in csv.DictReader(StringIO(archive.read(member).decode("latin-1"))):
                        token = f"{row.get('Exchange')}|{row.get('Token')}"
                        if token in wanted and row.get('TradingSymbol'):
                            names[token] = f"{row['Exchange']}:{row['TradingSymbol']}"
        except Exception as exception:
            logger.warning(f"Could not read {url}, so its instruments are named by the feed: {exception}")
    return names

def main():
    """Stream Shoonya quotes into shoonya:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Shoonya market quotes into shoonya:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated EXCHANGE|TOKEN tokens, for example NSE|2885")
    parser.add_argument("--per-socket", type=int, default=DEFAULT_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, default {DEFAULT_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from stock_brokers.websockets.shoonya import ShoonyaQuotesSocket, ShoonyaSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("shoonya.websocket_quotes")
    cache = get_cache()

    if arguments.per_socket < 1:
        logger.error("--per-socket must be at least 1.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE|TOKEN members to the Redis set "
                     f"{SUBSCRIPTIONS_KEY}.")
        return 2

    try:
        session = ShoonyaSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Shoonya: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the scrip files and will be named by the feed: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]
    store = ShoonyaQuotesStore(cache)
    sockets = []
    for index, batch in enumerate(batches):
        sockets.append(ShoonyaQuotesSocket(f"socket_{index}", batch, names, session, store.write_name, store.write_tick,
                                           logger))

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"shoonya_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
