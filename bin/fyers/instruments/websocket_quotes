#!/usr/bin/env python3
"""
Stream Fyers market quotes over websockets into the Redis hash `fyers:quotes:live`, and keep streaming until
stopped.

    bin/fyers/instruments/websocket_quotes                                            # instruments from the Redis set fyers:quotes:subscriptions
    bin/fyers/instruments/websocket_quotes --tokens NSE:SBIN-EQ,MCX:CRUDEOIL26SEPFUT
    bin/fyers/instruments/websocket_quotes --per-socket 2000

    redis-cli SADD fyers:quotes:subscriptions NSE:SBIN-EQ NSE:NIFTY50-INDEX
    redis-cli HGET fyers:quotes:live NSE:SBIN-EQ
    redis-cli HGETALL fyers:quotes:instruments

The connection, the login, the symbol lookup and the binary decoding for Fyers' market feed at
`wss://socket.fyers.in/hsm/v1-5/prod` are `FyersQuotesSocket` and `FyersSession` in
`stock_brokers/websockets/fyers.py`, whose module docstring describes the HSM protocol. This script chooses the
instruments, splits them across sockets, runs the sockets and writes the ticks they decode to Redis, so it needs
no other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `fyers:quotes:subscriptions`,
each a Fyers symbol with its exchange, such as `NSE:SBIN-EQ`, `NSE:NIFTY50-INDEX` or `MCX:CRUDEOIL26SEPFUT`.
One websocket carries up to `--per-socket` instruments, at most 5000.

**Keys.**

- `fyers:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the Fyers symbol, which is
  already exchange-qualified and unique. A tick is replaced as the next one arrives. It is not cleared at
  startup, so an instrument no longer subscribed keeps its last tick.
- `fyers:quotes:instruments`, a hash of every subscribed symbol to its name from Fyers' public symbol master,
  downloaded at startup, or to an empty string when the master does not list it. Replaced whole at startup.
- `fyers:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/fyers/instruments/store_quotes_to_db` writes to `fyers.ticks`. Capped at about 1,000,000 entries, so ticks that arrive while
  the persister is down for long enough are trimmed before they are persisted.

A tick has `id`, `broker`, `instrument_token`, `exchange`, `mode`, `last_price`, `last_quantity`,
`average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`, `oi_day_high`,
`oi_day_low`, `last_trade_time`, `exchange_timestamp`, `depth` (`buy` and `sell` levels of `quantity`, `price`
and `orders`; the best bid and offer when no depth topic is subscribed) and `received_at`, with `None` for what
Fyers does not send. `ohlc.close` is the previous close and `change` the percentage change against it.

**Sessions.** Each connection reads the current token when it connects, so a login made by any process is
picked up. A token whose expiry has passed, a symbol lookup refused for the session (Fyers codes -8, -15, -16,
-17, or HTTP 401), or a socket that fails to open six times running logs in again through `FyersAPI` - one
socket at a time, confirmed against the profile - before reconnecting. A Cloudflare ban on the symbol lookup
pauses the socket thirty minutes and a rate limit five, rather than logging in, because every refused request
extends a ban. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket still cannot open after logging
in again, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import csv
import json
import signal
import argparse
import threading
from io import StringIO
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

# Fyers' public symbol masters, headerless, with the symbol name in the second column and the symbol in the tenth.
SYMBOL_MASTER_URLS = [
    "https://public.fyers.in/sym_details/NSE_CD.csv",
    "https://public.fyers.in/sym_details/NSE_FO.csv",
    "https://public.fyers.in/sym_details/NSE_COM.csv",
    "https://public.fyers.in/sym_details/NSE_CM.csv",
    "https://public.fyers.in/sym_details/BSE_CM.csv",
    "https://public.fyers.in/sym_details/BSE_FO.csv",
    "https://public.fyers.in/sym_details/MCX_COM.csv",
]
SYMBOL_NAME_COLUMN = 1
SYMBOL_TICKER_COLUMN = 9

LIVE_KEY = "fyers:quotes:live"
INSTRUMENTS_KEY = "fyers:quotes:instruments"
SUBSCRIPTIONS_KEY = "fyers:quotes:subscriptions"

# Every tick is also appended here for bin/fyers/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "fyers:quotes:stream"
STREAM_MAX_LENGTH = 1000000

MAX_INSTRUMENTS_PER_CONNECTION = 5000

class FyersQuotesStore:
    """
    Where the quotes sockets' ticks are written: the live hash and the persistence stream.
    """

    def __init__(self, cache):
        """
        Keeps the Redis client the ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_ticks(self, ticks):
        """
        Writes one data message's ticks: the latest tick per instrument and every tick in arrival order, in one round trip.

        Args:
            ticks (list[dict]): The message's ticks, in arrival order.

        Returns:
            None: This method returns nothing.
        """
        encoded = []
        for tick in ticks:
            encoded.append((tick["id"], json.dumps(tick)))
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, mapping=dict(encoded))
        for _, payload in encoded:
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def resolve_tokens(tokens, cache, logger):
    """
    The Fyers symbols to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of symbols, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        exchange, _, name = token.partition(':')
        if exchange and name:
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected an exchange-qualified Fyers symbol such as NSE:SBIN-EQ.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(symbols, logger):
    """
    The names of the subscribed symbols from Fyers' public symbol masters.

    A master that cannot be downloaded is reported and leaves its symbols unnamed rather than stopping the feed.

    - `symbols` is the list of subscribed symbols.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(symbols)
    names = {}
    for url in SYMBOL_MASTER_URLS:
        try:
            response = requests.get(url, timeout=120)
            response.raise_for_status()
        except Exception as exception:
            logger.warning(f"Could not download {url}, so its symbols are unnamed: {exception}")
            continue
        for row in csv.reader(StringIO(response.text)):
            if len(row) > SYMBOL_TICKER_COLUMN and row[SYMBOL_TICKER_COLUMN] in wanted:
                names[row[SYMBOL_TICKER_COLUMN]] = row[SYMBOL_NAME_COLUMN]
    return names

def main():
    """Stream Fyers quotes into fyers:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Fyers market quotes into fyers:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated Fyers symbols, for example NSE:SBIN-EQ")
    parser.add_argument("--per-socket", type=int, default=MAX_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, at most {MAX_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from stock_brokers.websockets.fyers import FyersQuotesSocket, FyersSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("fyers.websocket_quotes")
    cache = get_cache()

    if not 1 <= arguments.per_socket <= MAX_INSTRUMENTS_PER_CONNECTION:
        logger.error(f"--per-socket must be between 1 and {MAX_INSTRUMENTS_PER_CONNECTION}.")
        return 2

    symbols = resolve_tokens(arguments.tokens, cache, logger)
    if not symbols:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add Fyers symbols to the Redis set {SUBSCRIPTIONS_KEY}.")
        return 2

    try:
        session = FyersSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Fyers: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(symbols, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={symbol: names.get(symbol, "") for symbol in symbols})
    pipeline.execute()
    unnamed = [symbol for symbol in symbols if symbol not in names]
    logger.info(f"Wrote {len(symbols)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} symbol(s) are not in the symbol master: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    batches = [symbols[start:start + arguments.per_socket] for start in range(0, len(symbols), arguments.per_socket)]
    store = FyersQuotesStore(cache)
    sockets = []
    for index, batch in enumerate(batches):
        sockets.append(FyersQuotesSocket(f"socket_{index}", batch, session, store.write_ticks, logger))

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"fyers_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(symbols)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
