class FyersRefusal(Exception):
    """Fyers refused a request, with its code and message."""

    def __init__(self, code, message):
        super().__init__(code, message)
        self.code = code
        self.message = message

def refusal_code(exception):
    """The numeric code a refusal carries, or None."""
    try:
        return int(getattr(exception, 'code', None))
    except (TypeError, ValueError):
        return None

def is_block(exception):
    """Whether a refusal is Cloudflare's address ban rather than anything Fyers itself said."""
    lowered = str(exception).lower()
    return any(marker in lowered for marker in BLOCK_PAGE_MARKERS) or (refusal_code(exception) == 429 and "cloudflare" in lowered)

def is_throttle(exception):
    """Whether a refusal is a rate limit."""
    lowered = str(exception).lower()
    return refusal_code(exception) == 429 or "too many requests" in lowered or "rate limit" in lowered

def is_authentication_error(exception):
    """Whether Fyers refused the request because the session is dead, and not for a ban or a limit."""
    if is_block(exception) or is_throttle(exception):
        return False
    return refusal_code(exception) in AUTHENTICATION_ERROR_CODES or refusal_code(exception) == 401

def token_claims(access_token):
    """
    The claims inside a Fyers access token, a JWT, or an empty dict when it cannot be decoded.

    - `access_token` is the token from the REST login.
    """
    try:
        return json.loads(base64.urlsafe_b64decode(str(access_token).split('.')[1] + '===').decode())
    except Exception:
        return {}

class FyersSession:
    """
    The Fyers login every socket authenticates with, logged in again by one socket at a time.
    """

    def __init__(self, logger):
        """
        Construct FyersAPI, which logs in when its probe raises, and confirm the session against the profile.

        - `logger` is where logins are reported.
        """
        from stock_brokers.api.fyers import FyersAPI

        self._api_class = FyersAPI
        self._logger = logger
        self._lock = threading.Lock()
        self._fyers = self._confirmed(FyersAPI())

    def _confirmed(self, fyers):
        """
        Raise FyersRefusal unless the profile is served. FyersAPI only logs in when its probe raises, and Fyers
        can refuse a dead session inside an HTTP 200, so a constructor that returned is no proof of a session.

        - `fyers` is a FyersAPI.
        """
        body = (fyers.get(url=PROFILE_URL, timeout=30) or {}).get('data')
        if not isinstance(body, dict) or body.get('s') not in (None, 'ok'):
            raise FyersRefusal((body or {}).get('code') if isinstance(body, dict) else None,
                               f"the profile was refused: {str(body)[:200]}")
        return fyers

    def credentials(self):
        """
        The app id and the access token in force now, which may be one another process has just obtained.
        """
        login = self._fyers._current_login() or {}
        return self._fyers._settings.get('app_id'), login.get('access_token')

    def log_in_again(self, stale_token):
        """
        Log in again, unless another socket already replaced the token that failed.

        - `stale_token` is the access token the failing connection used.
        """
        with self._lock:
            if self.credentials()[1] != stale_token:
                return
            self._logger.warning("Logging in to Fyers again.")
            self._fyers = self._confirmed(self._api_class())

class QuotesSocket:
    """
    One Fyers market feed websocket for a batch of symbols, reconnecting until stopped.
    """

    def __init__(self, name, symbols, session, cache, logger):
        """
        - `name` is the connection's name, for the log.
        - `symbols` is the batch of Fyers symbols.
        - `session` is the shared FyersSession.
        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        self.name = name
        self._symbols = symbols
        self._session = session
        self._cache = cache
        self._logger = logger
        self._stop = threading.Event()
        self._ws = None
        self._token = None
        self._hsm_key = None
        # Topic name to Fyers symbol, from the symbol lookup; topic id to (symbol, topic name), from the snapshots.
        self._resolved = {}
        self._topics = {}
        self._state = {}
        # Acknowledge every `_ack_count` data messages, as the authentication response asks; 0 means never.
        self._ack_count = 0
        self._since_ack = 0
        self._opened = False
        self._authentication_rejected = False
        self._pause_seconds = 0
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            self._pause_seconds = 0
            try:
                self._connect()
            except Exception as exception:
                self._logger.error(f"{self.name} connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._pause_seconds:
                # A ban or a rate limit: waiting is the only thing that helps, and logging in would extend a ban.
                self._stop.wait(self._pause_seconds)
                continue

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                # Refused again straight after a login: another login would not help, and Fyers bans addresses
                # that keep sending refused requests.
                if logged_in_again and (self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS):
                    self.gave_up = True
                    self._logger.error(f"{self.name} still cannot connect after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._session.log_in_again(self._token)
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"{self.name} could not log in to Fyers again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"{self.name} disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info(f"{self.name} stopped.")

    def _connect(self):
        """Check the token, resolve the symbols to topics, then open the websocket and block until it closes."""
        import websocket

        app_id, self._token = self._session.credentials()
        claims = token_claims(self._token)
        if claims.get('exp', 0) <= time.time() or 'hsm_key' not in claims:
            self._logger.warning(f"{self.name}: the Fyers access token has expired or carries no hsm_key.")
            self._authentication_rejected = True
            return
        self._hsm_key = claims['hsm_key']

        try:
            self._resolved = self._resolve_symbols(app_id, self._token)
        except Exception as exception:
            if is_block(exception):
                self._logger.error(f"{self.name}: Cloudflare is blocking Fyers requests, pausing {BLOCK_PAUSE_SECONDS}s: "
                                   f"{str(exception)[:160]}")
                self._pause_seconds = BLOCK_PAUSE_SECONDS
            elif is_throttle(exception):
                self._logger.warning(f"{self.name}: Fyers rate limited the symbol lookup, pausing {THROTTLE_PAUSE_SECONDS}s.")
                self._pause_seconds = THROTTLE_PAUSE_SECONDS
            elif is_authentication_error(exception):
                self._logger.warning(f"{self.name}: Fyers refused the session on the symbol lookup: {exception}")
                self._authentication_rejected = True
            else:
                raise
            return
        resolved_symbols = set(self._resolved.values())
        unresolved = [symbol for symbol in self._symbols if symbol not in resolved_symbols]
        if unresolved:
            self._logger.warning(f"{self.name}: {len(unresolved)} symbol(s) did not resolve and are not subscribed: "
                                 f"{', '.join(unresolved[:20])}{' ...' if len(unresolved) > 20 else ''}")
        if not self._resolved:
            raise FyersRefusal(None, "no symbol resolved to a topic")

        self._topics, self._state, self._ack_count, self._since_ack = {}, {}, 0, 0
        self._ws = websocket.WebSocketApp(FEED_URL, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=PING_INTERVAL_SECONDS, ping_timeout=PING_TIMEOUT_SECONDS)

    def _resolve_symbols(self, app_id, token):
        """
        The Fyers symbol of each HSM topic name, from Fyers' symbol-token endpoint, five hundred symbols a request.

        - `app_id` and `token` authenticate the request.

        A symbol the endpoint lists as invalid, or whose fytoken names a segment the feed does not carry, is left out.
        """
        import requests

        headers = {"Authorization": f"{app_id}:{token}", "Content-Type": "application/json"}
        resolved = {}
        for start in range(0, len(self._symbols), SYMBOLS_PER_LOOKUP):
            response = requests.post(SYMBOL_TOKEN_URL, headers=headers, json={"symbols": self._symbols[start:start + SYMBOLS_PER_LOOKUP]},
                                     timeout=60)
            try:
                body = response.json()
            except ValueError:
                raise FyersRefusal(response.status_code, response.text[:300])
            if response.status_code >= 300 or body.get('s') == 'error':
                raise FyersRefusal(body.get('code') if body.get('code') is not None else response.status_code,
                                   str(body.get('message') or body)[:300])
            for symbol, fytoken in (body.get('validSymbol') or {}).items():
                topic = topic_name(symbol, str(fytoken))
                if topic is not None:
                    resolved[topic] = symbol
        return resolved

    def _on_open(self, ws):
        """Authenticate with the hsm key. Subscription waits for the acknowledgement."""
        self._opened = True
        ws.send(auth_frame(self._hsm_key), opcode=0x2)
        self._logger.info(f"{self.name} opened. Authenticating.")

    def _on_error(self, ws, error):
        self._logger.error(f"{self.name} error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"{self.name} closed with status {status_code}: {message}")

    def _on_message(self, ws, message):
        """Handle the acknowledgements and write each updated instrument's tick to the live quotes hash."""
        if not isinstance(message, (bytes, bytearray)) or len(message) < 3:
            return
        data = bytes(message)
        response_type = data[2]
        if response_type == AUTH_RESPONSE:
            accepted, self._ack_count = auth_response(data)
            if not accepted:
                self._logger.warning(f"{self.name}: Fyers refused the feed authentication.")
                self._authentication_rejected = True
                ws.close()
                return
            ws.send(full_mode_frame(), opcode=0x2)
            topics = list(self._resolved)
            for start in range(0, len(topics), TOPICS_PER_SUBSCRIBE):
                ws.send(subscribe_frame(topics[start:start + TOPICS_PER_SUBSCRIBE]), opcode=0x2)
            self._logger.info(f"{self.name} authenticated and subscribed to {len(self._resolved)} instrument(s).")
            return
        if response_type == SUBSCRIBE:
            accepted = len(data) > 7 and data[7:8] == b"K"
            if accepted:
                self._logger.info(f"{self.name}: subscription acknowledged.")
            else:
                self._logger.error(f"{self.name}: Fyers refused the subscription.")
            return
        if response_type != DATAFEED_RESPONSE:
            return

        if self._ack_count > 0 and len(data) >= 7:
            self._since_ack += 1
            if self._since_ack >= self._ack_count:
                ws.send(acknowledge_frame(struct.unpack(">I", data[3:7])[0]), opcode=0x2)
                self._since_ack = 0

        ticks = [tick for tick in (build_tick(symbol, state, price_divisor(state))
                                   for symbol, state in self.parse_feed(data).items())
                 if tick['last_price'] is not None or tick['depth']['buy'] or tick['depth']['sell']]
        if ticks:
            encoded = [(tick['id'], json.dumps(tick)) for tick in ticks]
            # The latest tick per instrument and every tick in arrival order, in one round trip.
            pipeline = self._cache.pipeline(transaction=False)
            pipeline.hset(LIVE_KEY, mapping=dict(encoded))
            for _, payload in encoded:
                pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()

    def parse_feed(self, data):
        """
        Merge a data feed response into the per-instrument state, and return the state of each instrument it touched.

        - `data` is the binary data feed response.
        """
        if len(data) < 9:
            return {}
        updated = {}
        scrip_count = struct.unpack("!H", data[7:9])[0]
        offset = 9
        for _ in range(scrip_count):
            if offset + 1 > len(data):
                break
            packet_type = data[offset]
            offset += 1

            if packet_type == SNAPSHOT:
                if offset + 3 > len(data):
                    break
                topic_id = struct.unpack("H", data[offset:offset + 2])[0]
                name_length = data[offset + 2]
                offset += 3
                topic_name = data[offset:offset + name_length].decode('utf-8', errors='replace')
                offset += name_length
                if offset >= len(data):
                    break
                field_count = data[offset]
                offset += 1
                symbol = self._resolved.get(topic_name)
                self._topics[topic_id] = (symbol, topic_name)
            elif packet_type in (UPDATE, LITE):
                if offset + 3 > len(data):
                    break
                topic_id = struct.unpack("H", data[offset:offset + 2])[0]
                field_count = data[offset + 2]
                offset += 3
                symbol, topic_name = self._topics.get(topic_id, (None, ''))
            else:
                break

            state = self._state.setdefault(symbol, {}) if symbol else {}
            fields = fields_for(topic_name, field_count)
            for index in range(field_count):
                if offset + 4 > len(data):
                    break
                value = struct.unpack(">i", data[offset:offset + 4])[0]
                offset += 4
                if value != NO_VALUE and index < len(fields):
                    state[fields[index]] = value
            if packet_type == SNAPSHOT:
                # After a snapshot's fields: two reserved bytes, the price multiplier and precision, then the
                # exchange, exchange token and symbol as length-prefixed strings.
                if offset + 5 > len(data):
                    break
                multiplier = struct.unpack(">H", data[offset + 2:offset + 4])[0]
                state['multiplier'], state['precision'] = multiplier, data[offset + 4]
                offset += 5
                for _ in range(3):
                    if offset >= len(data):
                        break
                    offset += 1 + data[offset]
            if symbol:
                updated[symbol] = state
        return updated

def auth_frame(hsm_key):
    """
    The binary frame that authenticates the feed with the hsm key.

    - `hsm_key` is the `hsm_key` claim of the access token.
    """
    frame = bytearray()
    frame.extend(struct.pack("!H", 18 + len(hsm_key) + len(SOURCE) - 2))
    frame.extend(bytes([1, 4]))                                           # authenticate, four fields
    frame.extend(bytes([1]) + struct.pack("!H", len(hsm_key)) + hsm_key.encode())
    frame.extend(bytes([2]) + struct.pack("!H", 1) + MODE.encode())
    frame.extend(bytes([3]) + struct.pack("!H", 1) + bytes([1]))
    frame.extend(bytes([4]) + struct.pack("!H", len(SOURCE)) + SOURCE.encode())
    return bytes(frame)

def auth_response(data):
    """
    Whether an authentication response accepted the feed, and how many data messages to acknowledge at a time.

    - `data` is the binary authentication response: a `K` in its first field on success, then the count.
    """
    try:
        length = struct.unpack("!H", data[5:7])[0]
        accepted = data[7:7 + length] == b"K"
        offset = 7 + length + 1
        length = struct.unpack("!H", data[offset:offset + 2])[0]
        ack_count = struct.unpack(">I", data[offset + 2:offset + 6])[0] if length >= 4 else 0
        return accepted, ack_count
    except struct.error:
        return False, 0

def full_mode_frame():
    """The binary frame that puts the channel in full mode, so data packets carry every field."""
    frame = bytearray(struct.pack(">H", 0))
    frame.extend(bytes([FULL_MODE, 2]))                                   # full mode, two fields
    frame.extend(bytes([1]) + struct.pack(">H", 8) + struct.pack(">Q", 1 << CHANNEL))
    frame.extend(bytes([2]) + struct.pack(">H", 1) + bytes([70]))
    return bytes(frame)

def subscribe_frame(topics):
    """
    The binary frame that subscribes HSM topic names on the channel.

    - `topics` is the list of topic names, such as `sf|nse_cm|3045`, at most 1500 of them in one frame.
    """
    scrips = bytearray(struct.pack(">H", len(topics)))
    for topic in topics:
        encoded = topic.encode("ascii")
        scrips.extend(bytes([len(encoded)]) + encoded)
    frame = bytearray(struct.pack(">H", 18 + len(scrips)))
    frame.extend(bytes([SUBSCRIBE, 2]))                                   # subscribe, two fields
    frame.extend(bytes([1]) + struct.pack(">H", len(scrips)) + scrips)
    frame.extend(bytes([2]) + struct.pack(">H", 1) + bytes([CHANNEL]))
    return bytes(frame)

def acknowledge_frame(message_number):
    """
    The binary frame that acknowledges data messages up to `message_number`, the number in a data message's header.
    """
    return struct.pack(">HBBBHI", 9, ACKNOWLEDGE, 1, 1, 4, message_number)

def topic_name(symbol, fytoken):
    """
    The HSM topic name of a Fyers symbol, or None when its segment is not one the feed carries.

    - `symbol` is the Fyers symbol, such as `NSE:SBIN-EQ` or `NSE:NIFTY50-INDEX`.
    - `fytoken` is the symbol's fytoken from the symbol-token endpoint.
    """
    segment = EXCHANGE_SEGMENTS.get(fytoken[:4])
    if segment is None:
        return None
    if symbol.endswith("-INDEX"):
        return f"if|{segment}|{INDEX_TOPIC_NAMES.get(symbol) or symbol.split(':', 1)[-1].rsplit('-', 1)[0]}"
    return f"sf|{segment}|{fytoken[10:]}"

def price_divisor(state):
    """
    What an instrument's scaled integer prices are divided by: 10 to its precision times its multiplier, from its
    snapshot, or 100 when no snapshot has said.

    - `state` is the instrument's merged field state.
    """
    precision, multiplier = state.get('precision'), state.get('multiplier')
    if precision is None or not multiplier:
        return 100
    return (10 ** precision) * multiplier

def fields_for(topic_name, field_count):
    """
    The field table a packet's positional values are read against.

    - `topic_name` is the topic name its snapshot gave, which encodes the feed kind.
    - `field_count` is the number of values in the packet.
    """
    if topic_name.startswith('dp'):
        return DEPTH_FIELDS
    if topic_name.startswith('if'):
        return INDEX_FIELDS
    if field_count <= len(LITE_FIELDS):
        return LITE_FIELDS
    return DATA_FIELDS

def build_tick(symbol, state, divisor=100):
    """
    A normalized tick from an instrument's merged field state.

    - `symbol` is the Fyers symbol.
    - `state` is the merged field state.
    - `divisor` turns Fyers' scaled integers into rupees.
    """
    price = lambda key: state[key] / divisor if state.get(key) is not None else None
    depth = {"buy": [], "sell": []}
    for level in range(1, 6):
        if state.get(f'bid_price{level}') is not None:
            depth['buy'].append({"quantity": state.get(f'bid_size{level}'), "price": state[f'bid_price{level}'] / divisor,
                                 "orders": state.get(f'bid_order{level}')})
        if state.get(f'ask_price{level}') is not None:
            depth['sell'].append({"quantity": state.get(f'ask_size{level}'), "price": state[f'ask_price{level}'] / divisor,
                                  "orders": state.get(f'ask_order{level}')})
    # The data packet carries the best bid and offer itself, which is the only book there is without a depth topic.
    if not depth['buy'] and state.get('bid_price'):
        depth['buy'].append({"quantity": state.get('bid_size'), "price": state['bid_price'] / divisor, "orders": None})
    if not depth['sell'] and state.get('ask_price'):
        depth['sell'].append({"quantity": state.get('ask_size'), "price": state['ask_price'] / divisor, "orders": None})

    last_price, close = price('ltp'), price('prev_close_price')
    return {"id": symbol, "broker": "fyers", "instrument_token": symbol,
            "exchange": symbol.split(':', 1)[0] if ':' in symbol else None,
            "mode": "full" if depth['buy'] or depth['sell'] else "quote", "last_price": last_price,
            "last_quantity": state.get('last_traded_qty'), "average_price": price('avg_trade_price'),
            "volume": state.get('vol_traded_today'), "buy_quantity": state.get('tot_buy_qty'),
            "sell_quantity": state.get('tot_sell_qty'),
            "ohlc": {"open": price('open_price'), "high": price('high_price'), "low": price('low_price'), "close": close},
            "change": (last_price - close) * 100 / close if last_price is not None and close else None,
            "oi": state.get('OI'), "oi_day_high": None, "oi_day_low": None,
            "last_trade_time": state.get('last_traded_time'), "exchange_timestamp": state.get('exch_feed_time'),
            "depth": depth, "received_at": time.time()}

def resolve_tokens(tokens, cache, logger):
    """
    The Fyers symbols to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of symbols, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        exchange, _, name = token.partition(':')
        if exchange and name:
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected an exchange-qualified Fyers symbol such as NSE:SBIN-EQ.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(symbols, logger):
    """
    The names of the subscribed symbols from Fyers' public symbol masters.

    A master that cannot be downloaded is reported and leaves its symbols unnamed rather than stopping the feed.

    - `symbols` is the list of subscribed symbols.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(symbols)
    names = {}
    for url in SYMBOL_MASTER_URLS:
        try:
            response = requests.get(url, timeout=120)
            response.raise_for_status()
        except Exception as exception:
            logger.warning(f"Could not download {url}, so its symbols are unnamed: {exception}")
            continue
        for row in csv.reader(StringIO(response.text)):
            if len(row) > SYMBOL_TICKER_COLUMN and row[SYMBOL_TICKER_COLUMN] in wanted:
                names[row[SYMBOL_TICKER_COLUMN]] = row[SYMBOL_NAME_COLUMN]
    return names

def main():
    """Stream Fyers quotes into fyers:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Fyers market quotes into fyers:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated Fyers symbols, for example NSE:SBIN-EQ")
    parser.add_argument("--per-socket", type=int, default=MAX_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, at most {MAX_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("fyers.websocket_quotes")
    cache = get_cache()

    if not 1 <= arguments.per_socket <= MAX_INSTRUMENTS_PER_CONNECTION:
        logger.error(f"--per-socket must be between 1 and {MAX_INSTRUMENTS_PER_CONNECTION}.")
        return 2

    symbols = resolve_tokens(arguments.tokens, cache, logger)
    if not symbols:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add Fyers symbols to the Redis set {SUBSCRIPTIONS_KEY}.")
        return 2

    try:
        session = FyersSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Fyers: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(symbols, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={symbol: names.get(symbol, "") for symbol in symbols})
    pipeline.execute()
    unnamed = [symbol for symbol in symbols if symbol not in names]
    logger.info(f"Wrote {len(symbols)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} symbol(s) are not in the symbol master: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    batches = [symbols[start:start + arguments.per_socket] for start in range(0, len(symbols), arguments.per_socket)]
    sockets = [QuotesSocket(f"socket_{index}", batch, session, cache, logger) for index, batch in enumerate(batches)]

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"fyers_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(symbols)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
