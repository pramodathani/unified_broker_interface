#!/usr/bin/env python3
"""
Poll the day's Fyers order book every five seconds and merge it into the Redis hash `fyers:orders:orders`.

    bin/fyers/orders/api_order_details
    redis-cli HGETALL fyers:orders:orders
    redis-cli HGET fyers:orders:orders <order id>

Calls `GET https://api-t1.fyers.in/api/v3/orders` through `FyersAPI`, which logs in first if the stored session is dead.
The body has no `data` envelope: its `orderBook` has one row per order, with `id`, `exchOrdId`, `parentId`, `status`
(a number), `message`, `symbol`, `fyToken`, `segment`, `side` (1 buy, -1 sell), `type` (1 limit, 2 market, 3 stop
market, 4 stop limit), `productType`, `orderValidity`, `qty`, `filledQty`, `remainingQuantity`, `disclosedQty`,
`limitPrice`, `stopPrice`, `tradedPrice`, `orderDateTime` and `orderTag`. An empty book writes nothing.

**One key for orders.** `fyers:orders:orders` is a hash keyed by the order `id`, written by two scripts: this poller, and
`bin/fyers/orders/websocket_order_details`, which merges each order update from Fyers' websocket into the same hash. Every value is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "order": <normalized order>, "data": <Fyers' own payload>}

`order` has the same fields whichever script wrote it - `order_id`, `exchange_order_id`, `parent_order_id`, `status`,
`status_message`, `id`, `instrument_token`, `tradingsymbol`, `exchange`, `transaction_type`, `product`, `order_type`,
`validity`, `quantity`, `filled_quantity`, `pending_quantity`, `cancelled_quantity`, `disclosed_quantity`, `price`,
`trigger_price`, `average_price`, `order_timestamp`, `exchange_timestamp` and `tag` - because Fyers' order book and its
order update stream name the same things differently:

| field | order book (`bin/fyers/orders/api_order_details`) | order update (`bin/fyers/orders/websocket_order_details`) |
| --- | --- | --- |
| `order_id`, `exchange_order_id`, `parent_order_id` | `id`, `exchOrdId`, `parentId` | `id`, `id_exchange`, `id_parent` |
| `status`, `status_message` | `status`, `message` | `org_ord_status` (or `status`), `oms_msg` (or `message`) |
| `id`, `tradingsymbol` | `symbol` (`NSE:INFY-EQ`, already carrying the exchange) | `symbol` |
| `instrument_token` | `fyToken` | `fy_token` |
| `exchange` | the `symbol` prefix (`NSE`) | the `symbol` prefix |
| `transaction_type`, `product`, `order_type`, `validity` | `side`, `productType`, `type`, `orderValidity` | `tran_side`, `product_type`, `ord_type`, `validity` |
| `quantity`, `filled_quantity`, `pending_quantity` | `qty`, `filledQty`, `remainingQuantity` | `qty`, `qty_filled`, `qty_remaining` |
| `cancelled_quantity` | null - the book carries none | `qty_cancelled` |
| `disclosed_quantity` | `disclosedQty` | `qty_disclosed` |
| `price`, `trigger_price`, `average_price` | `limitPrice`, `stopPrice`, `tradedPrice` | `price_limit`, `price_stop`, `price_traded` |
| `order_timestamp` | `orderDateTime` | `time_oms` |
| `exchange_timestamp` | null - the book carries none | `time_exch` |
| `tag` | `orderTag` | `ordertag` |

Status is Fyers' numeric code translated first - 1 `CANCELLED`, 2 and 3 `COMPLETE`, 4 `OPEN`, 5 `REJECTED`, 6 `PENDING`,
the same codes on both sides - and a word on the shared vocabulary otherwise. Side (1 buy, -1 sell), order type (1
limit, 2 market, 3 stop market, 4 stop limit), product and validity are on the shared vocabulary. Both sides send
`exchange` as a number, so the exchange is read from the symbol's prefix. Fyers' `DD-Mon-YYYY HH:MM:SS` times are IST
wall clock, written as ISO timestamps with the IST offset.

**Which write wins.** A websocket update always replaces its order's entry. A row from this poller replaces an entry
only when that entry was observed before this poll's request was sent, so an update that arrived while the request
was in flight is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and
the write run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00, so yesterday's orders
remain readable overnight and the first poll of the day starts a fresh hash. An order is never removed before then:
one the websocket has just reported may not be in the order book yet.

**Refusals.** Fyers can refuse a request inside an HTTP 200 as well as with an error status, so the body is checked:
only an `s` of `ok` (or none) is merged. A dead session - Fyers code -8, -15, -16 or -17 - is logged in again before the
next request, and the new session is confirmed against the profile, because `FyersAPI` only logs in when its probe
raises and a refusal inside a 200 does not. A Cloudflare ban in front of the host pauses polling for thirty minutes and
a rate limit for five, rather than logging in, since every refused request extends a ban. Any other failed poll is
logged and leaves the hash unchanged.

Runs until Ctrl+C. Exits 1 when the session does not work at startup, or after a login following a dead session.
Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_URL = "https://api-t1.fyers.in/api/v3/orders"
PROFILE_URL = "https://api-t1.fyers.in/api/v3/profile"
REDIS_KEY = "fyers:orders:orders"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "fyers:orders:orders:polled_at"
# Fyers allows an app 200 requests a minute and 100,000 a day across every endpoint, shared by every bin/fyers/
# script and the history download, so this polls every five seconds; the order update websocket carries changes as they happen.
DELAY_SECONDS = 5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
    "BUY": "BUY", "B": "BUY", "1": "BUY", "BUY ORDER": "BUY",
    "SELL": "SELL", "S": "SELL", "-1": "SELL", "2": "SELL", "SELL ORDER": "SELL",
}
PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}
ORDER_TYPES = {
    "MARKET": "MARKET", "MKT": "MARKET", "MKT ORDER": "MARKET", "2": "MARKET",
    "LIMIT": "LIMIT", "LMT": "LIMIT", "L": "LIMIT", "1": "LIMIT",
    "SL": "SL", "SL-LMT": "SL", "STOPLIMIT": "SL", "SL LIMIT": "SL", "4": "SL",
    "SL-M": "SL-M", "SL-MKT": "SL-M", "STOPMARKET": "SL-M", "SL MARKET": "SL-M", "3": "SL-M", "SL M": "SL-M",
    "SLM": "SL-M", "STOP LOSS": "SL", "STOP LOSS MARKET": "SL-M",
}
VALIDITIES = {
    "DAY": "DAY", "EOS": "DAY", "0": "DAY", "IOC": "IOC", "IMMEDIATE": "IOC", "1": "IOC",
    "GTT": "GTT", "GTC": "GTC", "GTD": "GTD",
}
STATUSES = {
    "PENDING": "PENDING", "TRANSIT": "PENDING", "VALIDATION PENDING": "PENDING", "PUT ORDER REQ RECEIVED": "PENDING",
    "TRIGGER PENDING": "PENDING", "AMO REQ RECEIVED": "PENDING", "PENDINGNEW": "PENDING", "O-PENDING": "PENDING",
    "MODIFY AMO REQ RECEIVED": "PENDING", "AFTER MARKET ORDER REQ RECEIVED": "PENDING", "AMO PENDING": "PENDING",
    "MODIFY AFTER MARKET ORDER REQ RECEIVED": "PENDING", "QUEUED": "PENDING", "PROCESSING": "PENDING",
    "SL-PENDING": "PENDING",
    "OPEN": "OPEN", "OPEN PENDING": "OPEN", "NEW": "OPEN", "REPLACED": "OPEN", "ACKED": "OPEN", "APPROVED": "OPEN",
    "MODIFICATION REQUESTED": "OPEN", "MODIFIED": "OPEN", "MODIFY VALIDATION PENDING": "OPEN", "MODIFY PENDING": "OPEN",
    "PARTIALLY FILLED": "OPEN", "PARTIALLY EXECUTED": "OPEN", "PLACED": "OPEN", "PART TRADED": "OPEN",
    "PARTIALLYFILLED": "OPEN", "PENDINGREPLACE": "OPEN", "CONFIRMED": "OPEN", "PARTIALLY TRADED": "OPEN",
    "INITIATED": "OPEN",
    "COMPLETE": "COMPLETE", "COMPLETED": "COMPLETE", "TRADED": "COMPLETE", "FILLED": "COMPLETE",
    "EXECUTED": "COMPLETE", "FULLY EXECUTED": "COMPLETE", "DELIVERY AWAITED": "COMPLETE", "SUCCESS": "COMPLETE",
    "CANCELLED": "CANCELLED", "CANCELED": "CANCELLED", "CANCEL": "CANCELLED", "CANCEL PENDING": "CANCELLED",
    "CANCELLATION REQUESTED": "CANCELLED", "PENDINGCANCEL": "CANCELLED", "CANCELLED AFTER MARKET ORDER": "CANCELLED",
    "AMO CANCELLED": "CANCELLED", "PARTIALLY FILLED - CANCELLED": "CANCELLED",
    "REJECTED": "REJECTED", "REJECT": "REJECTED", "FAILED": "REJECTED", "ABORTED": "REJECTED",
    "EXPIRED": "EXPIRED", "PARTIALLY FILLED - EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def exchange_of(symbol):
    """
    The exchange a Fyers symbol names in its prefix (`NSE` for `NSE:INFY-EQ`), or None.

    Both the REST rows and the websocket messages carry `exchange` as a number (10 for NSE), but only the symbol
    names it in words, and both carry the symbol, so it is read from there on either side.

    - `symbol` is the Fyers symbol.
    """
    prefix, colon, _ = str(symbol or "").partition(":")
    return prefix if colon and prefix else None

# Fyers' numeric order states, the same on the order book and the order update stream: 1 cancelled, 2 filled, 3 reserved
# (read as filled), 4 transit, 5 rejected, 6 pending.
FYERS_STATUS_CODES = {1: "CANCELLED", 2: "COMPLETE", 3: "COMPLETE", 4: "OPEN", 5: "REJECTED", 6: "PENDING"}

def fyers_status(value):
    """
    Fyers' order state on the shared vocabulary: its numeric codes translated first, a word normalized.

    - `value` is the raw status, an integer code or a word.
    """
    code = number(value, int)
    if code is not None and code in FYERS_STATUS_CODES:
        return FYERS_STATUS_CODES[code]
    return normalize(present(value), STATUSES)

def fyers_timestamp(value):
    """
    A Fyers order time as an ISO timestamp, or None: `DD-Mon-YYYY HH:MM:SS` is IST wall clock, a number an epoch.

    - `value` is the time as Fyers sent it.
    """
    value = present(value)
    if value is None:
        return None
    if isinstance(value, (int, float)) or str(value).replace(".", "", 1).isdigit():
        try:
            return datetime.fromtimestamp(float(value), tz=INDIA).isoformat()
        except (ValueError, OSError, OverflowError):
            return None
    for fmt in ("%d-%b-%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S", "%d/%m/%Y %H:%M:%S", "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.strptime(str(value).strip(), fmt).replace(tzinfo=INDIA).isoformat()
        except ValueError:
            continue
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_book(row):
    """
    A Fyers order-book row as a normalized order, or None when it has no order id.

    - `row` is one row of `orderBook`.
    """
    if not isinstance(row, dict) or text(row.get('id')) is None:
        return None
    symbol = text(row.get('symbol'))
    quantity, filled = number(row.get('qty'), int), number(row.get('filledQty'), int)
    pending = number(row.get('remainingQuantity'), int)
    if pending is None and quantity is not None and filled is not None:
        pending = quantity - filled
    return {
        "order_id": text(row.get('id')),
        "exchange_order_id": text(row.get('exchOrdId')),
        "parent_order_id": text(row.get('parentId')),
        "status": fyers_status(row.get('status')),
        "status_message": text(row.get('message')),
        "id": symbol,
        "instrument_token": text(row.get('fyToken')),
        "tradingsymbol": symbol,
        "exchange": exchange_of(symbol),
        "transaction_type": normalize(present(row.get('side')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('productType')), PRODUCTS),
        "order_type": normalize(present(row.get('type')), ORDER_TYPES),
        "validity": normalize(present(row.get('orderValidity')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        # The order book carries no cancelled quantity; only the order update stream does.
        "cancelled_quantity": None,
        "disclosed_quantity": number(row.get('disclosedQty'), int),
        "price": number(row.get('limitPrice')),
        "trigger_price": number(row.get('stopPrice')),
        "average_price": number(row.get('tradedPrice')),
        "order_timestamp": fyers_timestamp(row.get('orderDateTime')),
        # Nor an exchange time; only the order update stream does.
        "exchange_timestamp": None,
        "tag": text(row.get('orderTag')),
    }

# Fyers' codes for a dead session.
AUTHENTICATION_ERROR_CODES = {-8, -15, -16, -17}

# Phrases on Cloudflare's block page, which it serves with HTTP 429 in front of api-t1.fyers.in.
BLOCK_PAGE_MARKERS = ("error 1015", "error code: 1015", "banned you temporarily")

BLOCK_PAUSE_SECONDS = 30 * 60
THROTTLE_PAUSE_SECONDS = 5 * 60

class FyersRefusal(Exception):
    """Fyers refused the request in the body of an HTTP 2xx response."""

    def __init__(self, code, message):
        super().__init__(code, message)
        self.code = code
        self.message = message

def checked(response):
    """The response when Fyers served the request, raising FyersRefusal with its code and message when it did not."""
    data = (response or {}).get('data')
    if not isinstance(data, dict):
        raise FyersRefusal(None, f"answered without a body: {str(data)[:200]}")
    if data.get('s') not in (None, 'ok'):
        raise FyersRefusal(data.get('code'), data.get('message'))
    return response

def confirm_session(fyers):
    """
    Raise FyersRefusal unless the profile is served.

    FyersAPI only logs in when its probe raises, and Fyers can refuse a dead session inside an HTTP 200, so a
    constructor that returned is no proof of a working session.
    """
    checked(fyers.get(url=PROFILE_URL, timeout=TIMEOUT_SECONDS))

def refusal_code(exception):
    """The numeric code a Fyers refusal carries, or None."""
    try:
        return int(getattr(exception, 'code', None))
    except (TypeError, ValueError):
        return None

def is_block(exception):
    """Whether a refusal is Cloudflare's address ban rather than anything Fyers itself said."""
    lowered = str(exception).lower()
    return any(marker in lowered for marker in BLOCK_PAGE_MARKERS) or (refusal_code(exception) == 429 and "cloudflare" in lowered)

def is_throttle(exception):
    """Whether a refusal is a rate limit."""
    lowered = str(exception).lower()
    return (refusal_code(exception) == 429 or "too many requests" in lowered or "rate limit" in lowered
            or "request limit" in lowered)

def is_authentication_error(exception):
    """Whether Fyers refused the request because the session is dead, and not for a ban or a limit."""
    if is_block(exception) or is_throttle(exception):
        return False
    return refusal_code(exception) in AUTHENTICATION_ERROR_CODES

def main():
    """Fetch the order book and merge it into fyers:orders:orders every five seconds, until interrupted."""
    from stock_brokers.api.fyers import FyersAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("fyers.api_order_details")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        fyers = FyersAPI()
        confirm_session(fyers)
    except Exception as exception:
        logger.error(f"Could not log in to Fyers: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = checked(fyers.get(url=ORDERS_URL, timeout=TIMEOUT_SECONDS))
                rows = response['data'].get('orderBook')
                rows = rows if isinstance(rows, list) else []
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    order = order_from_book(row)
                    if order is not None:
                        arguments += [order["order_id"], json.dumps({"observed_at": requested_at, "source": "rest",
                                                                     "order": order, "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} order(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_block(exception):
                    logger.error(f"Cloudflare is blocking Fyers requests from this address, pausing "
                                 f"{BLOCK_PAUSE_SECONDS}s: {str(exception)[:160]}")
                    time.sleep(BLOCK_PAUSE_SECONDS)
                elif is_throttle(exception):
                    logger.warning(f"Fyers rate limited the request, pausing {THROTTLE_PAUSE_SECONDS}s: "
                                   f"{str(exception)[:160]}")
                    time.sleep(THROTTLE_PAUSE_SECONDS)
                elif is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Fyers session expired, logging in again: {exception}")
                    fyers = FyersAPI()
                    confirm_session(fyers)
                else:
                    report.error(f"Orders poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
