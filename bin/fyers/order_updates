# Fyers' codes for a dead session: -8 token expired, -15 invalid token, -16 could not authenticate, -17 invalid or
# expired.
AUTHENTICATION_ERROR_CODES = {-8, -15, -16, -17}
AUTHENTICATION_HANDSHAKE_STATUSES = {401, 403}

PING_INTERVAL_SECONDS = 30
PING_TIMEOUT_SECONDS = 10
MIN_BACKOFF_SECONDS = 1
MAX_BACKOFF_SECONDS = 60
MAX_FAILED_CONNECTS = 6

INDIA = ZoneInfo("Asia/Kolkata")
