#!/usr/bin/env python3
"""
Download Fyers' historical candles into `fyers.price_history`, working a resumable queue until stopped.

    bin/fyers/historical_prices --seed              # register every instrument and interval, then work
    bin/fyers/historical_prices                     # work the queue until stopped or drained
    bin/fyers/historical_prices --seed-only         # register new series and exit
    bin/fyers/historical_prices --status            # how far it has got
    bin/fyers/historical_prices --deadline-seconds 21600

Built on `FyersCandles`, with one difference: every login - at startup and after Fyers refuses the session - goes
straight through `FyersAPI`, confirmed against the profile, rather than through the shared session helper
`stock_brokers.api.utilities.session.ensure_session`.

**Seeding** reads the latest row per ticker from `fyers.instruments` (filled by `bin/fyers/instruments`) and
registers one row per instrument and interval in `fyers.price_history_progress`, leaving existing rows alone, so
seeding again after a new instrument master adds only what is new. A series is identified by its Fyers ticker,
such as `NSE:RELIANCE-EQ`, which is what the history endpoint takes. The intervals are the sixteen Fyers
serves: `1minute`, `2minute`, `3minute`, `5minute`, `10minute`, `15minute`, `20minute`, `30minute`, `45minute`,
`60minute`, `120minute`, `180minute`, `240minute`, `day`, `week` and `month`.

**The queue** is worked in priority order - cash daily bars first, then cash intraday, live futures, live
options, and expired contracts last. Each series walks backward from today, 100 days a window intraday and 366
for day, week and month bars, until it reaches 2000-01-01 or three windows come back empty, then keeps collecting
forward. Bars come from `GET https://api-t1.fyers.in/data/history`, paced at half a request a second, so the
pollers in `bin/fyers/` keep their share of Fyers' 200 requests a minute.

**Each window** is upserted into `fyers.price_history` on `(instrument_token, interval, time)` together with the
series' progress, in one transaction, so stopping costs at most the request in flight. `no_data` is an empty
window; an unknown ticker (-300) is retired; a rate limit backs off five seconds; a refused session (-8, -15,
-16, -17) is logged in once and the window retried. Cloudflare's address ban in front of Fyers stops the worker
outright, because every further request extends the ban.

Run it on its own: the queue is not locked between processes, so two workers on `fyers.price_history_progress` would
claim the same series and share Fyers' rate limit.

Exits 0 when stopped, drained or out of time, 1 when it stopped because the session could not be restored or
Cloudflare blocked this address, and 2 when the first login fails.
"""

import sys
import signal
import argparse
import threading
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

PROFILE_URL = "https://api-t1.fyers.in/api/v3/profile"

def confirmed_api():
    """
    A FyersAPI whose session the profile has served.

    FyersAPI only logs in when its probe raises, and Fyers can refuse a dead session inside an HTTP 200, so a
    constructor that returned is no proof of a working session.
    """
    from stock_brokers.api.fyers import FyersAPI

    fyers = FyersAPI()
    body = (fyers.get(url=PROFILE_URL, timeout=30) or {}).get('data')
    if not isinstance(body, dict) or body.get('s') not in (None, 'ok'):
        raise RuntimeError(f"the Fyers profile was refused: {str(body)[:200]}")
    return fyers

def downloader():
    """
    A FyersCandles that logs in through FyersAPI directly, and remembers why it stopped.
    """
    from stock_brokers.instruments.historical.base import CandleAuthenticationError, CandleBlocked, CandleThrottled
    from stock_brokers.instruments.historical.fyers import FyersCandles

    class DirectLoginFyersCandles(FyersCandles):
        """FyersCandles whose logins construct FyersAPI rather than going through the shared session helper."""

        stopped_by = None

        # Fyers limits an app to 200 requests a minute and 100,000 a day across every endpoint, and bin/fyers/ polls
        # orders, positions, trades and funds on the same app all day. Half a request a second - about 43,000 a day -
        # leaves the pollers their share, where FyersCandles' own three a second would take the whole minute.
        REQUESTS_PER_SECOND = 0.5

        def _build_api(self):
            return confirmed_api()

        def relogin(self):
            """
            Log in again through FyersAPI, which generates a new token when the stored one is refused.

            Raises:
                CandleAuthenticationError: If no working session could be established.
            """
            try:
                self._api = self._build_api()
                self.after_relogin()
            except Exception as exception:
                raise CandleAuthenticationError(f"logging in again did not produce a working session: "
                                                f"{type(exception).__name__}: {str(exception)[:200]}") from exception
            self._logger.info("fyers logged in again. Continuing.")

        def visit(self, series):
            # `run` ends its loop on these without raising, so they are noted here for the exit code.
            try:
                return super().visit(series)
            except (CandleAuthenticationError, CandleBlocked, CandleThrottled) as exception:
                self.stopped_by = exception
                raise

    # Passing the API in keeps FyersCandles from establishing the session itself.
    return DirectLoginFyersCandles(api=confirmed_api())

def show_status(candles):
    """
    Print how far the download has got.

    - `candles` is the Fyers candle downloader.
    """
    summary = candles.summary()
    print("fyers price history")
    for label, value in (("series registered", summary["series"]), ("series with bars", summary["with_bars"]),
                         ("series retired by the broker", summary["retired"]),
                         ("series stuck on failures", summary["stuck"]), ("bars stored", summary["bars"])):
        print(f"  {label:<30} {value:>14,}")
    if not summary["series"]:
        print("Nothing registered. Run with --seed first.")
    return 0

def main():
    """Work Fyers' candle queue."""
    parser = argparse.ArgumentParser(description="Download Fyers' historical candles into fyers.price_history.")
    parser.add_argument("--seed", action="store_true", help="register every instrument and interval before working")
    parser.add_argument("--seed-only", action="store_true", help="register the series and exit without downloading")
    parser.add_argument("--status", action="store_true", help="show how far the download has got, and exit")
    parser.add_argument("--deadline-seconds", type=int, help="stop after this long, for a nightly window")
    arguments = parser.parse_args()

    from utilities.configurations import get_logger

    logger = get_logger("fyers.historical_prices")
    try:
        candles = downloader()
    except Exception as exception:
        logger.error(f"Could not log in to Fyers: {type(exception).__name__}: {exception}")
        return 2

    try:
        if arguments.status:
            return show_status(candles)

        if arguments.seed or arguments.seed_only:
            logger.info("Registering every fyers instrument and interval. This reads the whole instrument master.")
            added = candles.seed()
            logger.info(f"Registered {added:,} new series.")
            if arguments.seed_only:
                return 0

        # A backfill is stopped many times, so shutdown finishes the window in flight rather than abandoning it:
        # the flag is checked between windows.
        stop = threading.Event()

        def _handle_signal(signal_number, frame):
            logger.info(f"Received signal {signal_number}. Finishing the window in flight, then stopping.")
            stop.set()

        for signal_number in (signal.SIGINT, signal.SIGTERM):
            signal.signal(signal_number, _handle_signal)

        visits, bars = candles.run(stop_event=stop, deadline_seconds=arguments.deadline_seconds)
        logger.info(f"Stored {bars:,} bar(s) over {visits:,} window(s).")
        if candles.stopped_by is not None and not stop.is_set():
            logger.error(f"Stopped early: {type(candles.stopped_by).__name__}: {candles.stopped_by}")
            return 1
        return 0
    finally:
        candles.close()

if __name__ == "__main__":
    raise SystemExit(main())
