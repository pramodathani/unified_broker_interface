#!/usr/bin/env python3
"""
Poll the day's Flattrade order book every half second and merge it into the Redis hash `flattrade:orders:orders`.

    bin/flattrade/orders
    redis-cli HGETALL flattrade:orders:orders
    redis-cli HGET flattrade:orders:orders <norenordno>

Calls `POST https://piconnect.flattrade.in/PiConnectAPI/OrderBook` through `FlattradeAPI`, which logs in first if the
stored session is dead and signs the request with the user id and token.

**One key for orders.** `flattrade:orders:orders` is a hash keyed by `norenordno`, written by two scripts: this poller,
and `bin/flattrade/order_updates`, which merges each `om` order update from Flattrade's websocket into the same hash.
Every value is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "order": <normalized order>, "data": <Noren's own payload>}

`order` has the same fields whichever script wrote it - `order_id`, `exchange_order_id`, `parent_order_id`, `status`,
`status_message`, `id`, `instrument_token`, `tradingsymbol`, `exchange`, `transaction_type`, `product`, `order_type`,
`validity`, `quantity`, `filled_quantity`, `pending_quantity`, `cancelled_quantity`, `disclosed_quantity`, `price`,
`trigger_price`, `average_price`, `order_timestamp`, `exchange_timestamp` and `tag` - the fields every broker's merged
orders hash carries. Noren's order book and its `om` order updates carry the same abbreviated fields, so both writers
map them with one function:

| field | from Noren |
| --- | --- |
| `order_id`, `exchange_order_id`, `parent_order_id` | `norenordno`, `exchordid`, `snonum` |
| `status`, `status_message` | `status` on the shared vocabulary, `rejreason` |
| `id`, `instrument_token`, `tradingsymbol`, `exchange` | `exch:tsym`, `token`, `tsym`, `exch` (`NSE`, `NFO`...) |
| `transaction_type`, `product`, `order_type`, `validity` | `trantype`, `prd`, `prctyp`, `ret`, on the shared vocabulary |
| quantities | `qty`, `fillshares`, quantity less filled and cancelled (never below 0), `cancelqty`, `dscqty` |
| prices | `prc`, `trgprc`, `avgprc` |
| `order_timestamp`, `exchange_timestamp` | `norentm`, `exch_tm`, IST, in either Noren form (`HH:MM:SS DD-MM-YYYY` or `DD-MM-YYYY HH:MM:SS`); the `01-01-1980` placeholder is null |
| `tag` | `remarks` |

The shared vocabulary puts status on `PENDING`, `OPEN`, `COMPLETE`, `CANCELLED`, `REJECTED`, `EXPIRED`, and passes an
unknown term through uppercased. Times are ISO with the IST offset. `data` is the order-book row exactly as sent.

**Which write wins.** A websocket update always replaces its order's entry. A row from this poller replaces an entry
only when that entry was observed before this poll's request was sent, so an update that arrived while the request
was in flight is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and
the write run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00, so yesterday's orders
remain readable overnight and the first poll of the day starts a fresh hash. An order is never removed before then:
one the websocket has just reported may not be in the order book yet.

Flattrade runs on Noren, which answers HTTP 200 whether or not it served the request, so the body is checked. An empty
book comes back as a `Not_Ok` saying "no data", which is an answer and writes nothing. A refused session ("Session
Expired", "Invalid Session Key") is logged in again before the next request; any other refusal or failed poll is
logged and leaves the hash unchanged.

Runs until Ctrl+C. Exits 1 when the session does not work at startup or after a login following a
refused session - checked against `UserDetails` after the constructor returns. Reads only -
it never places, modifies or cancels an order.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDER_BOOK_URL = "https://piconnect.flattrade.in/PiConnectAPI/OrderBook"
USER_DETAILS_URL = "https://piconnect.flattrade.in/PiConnectAPI/UserDetails"
REDIS_KEY = "flattrade:orders:orders"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "flattrade:orders:orders:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
    "BUY": "BUY", "B": "BUY", "1": "BUY", "BUY ORDER": "BUY",
    "SELL": "SELL", "S": "SELL", "-1": "SELL", "2": "SELL", "SELL ORDER": "SELL",
}
PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}
ORDER_TYPES = {
    "MARKET": "MARKET", "MKT": "MARKET", "MKT ORDER": "MARKET", "2": "MARKET",
    "LIMIT": "LIMIT", "LMT": "LIMIT", "L": "LIMIT", "1": "LIMIT",
    "SL": "SL", "SL-LMT": "SL", "STOPLIMIT": "SL", "SL LIMIT": "SL", "4": "SL",
    "SL-M": "SL-M", "SL-MKT": "SL-M", "STOPMARKET": "SL-M", "SL MARKET": "SL-M", "3": "SL-M", "SL M": "SL-M",
    "SLM": "SL-M", "STOP LOSS": "SL", "STOP LOSS MARKET": "SL-M",
}
VALIDITIES = {
    "DAY": "DAY", "EOS": "DAY", "0": "DAY", "IOC": "IOC", "IMMEDIATE": "IOC", "1": "IOC",
    "GTT": "GTT", "GTC": "GTC", "GTD": "GTD",
}
STATUSES = {
    "PENDING": "PENDING", "TRANSIT": "PENDING", "VALIDATION PENDING": "PENDING", "PUT ORDER REQ RECEIVED": "PENDING",
    "TRIGGER PENDING": "PENDING", "AMO REQ RECEIVED": "PENDING", "PENDINGNEW": "PENDING", "O-PENDING": "PENDING",
    "MODIFY AMO REQ RECEIVED": "PENDING", "AFTER MARKET ORDER REQ RECEIVED": "PENDING", "AMO PENDING": "PENDING",
    "MODIFY AFTER MARKET ORDER REQ RECEIVED": "PENDING", "QUEUED": "PENDING", "PROCESSING": "PENDING",
    "SL-PENDING": "PENDING",
    "OPEN": "OPEN", "OPEN PENDING": "OPEN", "NEW": "OPEN", "REPLACED": "OPEN", "ACKED": "OPEN", "APPROVED": "OPEN",
    "MODIFICATION REQUESTED": "OPEN", "MODIFIED": "OPEN", "MODIFY VALIDATION PENDING": "OPEN", "MODIFY PENDING": "OPEN",
    "PARTIALLY FILLED": "OPEN", "PARTIALLY EXECUTED": "OPEN", "PLACED": "OPEN", "PART TRADED": "OPEN",
    "PARTIALLYFILLED": "OPEN", "PENDINGREPLACE": "OPEN", "CONFIRMED": "OPEN", "PARTIALLY TRADED": "OPEN",
    "INITIATED": "OPEN",
    "COMPLETE": "COMPLETE", "COMPLETED": "COMPLETE", "TRADED": "COMPLETE", "FILLED": "COMPLETE",
    "EXECUTED": "COMPLETE", "FULLY EXECUTED": "COMPLETE", "DELIVERY AWAITED": "COMPLETE", "SUCCESS": "COMPLETE",
    "CANCELLED": "CANCELLED", "CANCELED": "CANCELLED", "CANCEL": "CANCELLED", "CANCEL PENDING": "CANCELLED",
    "CANCELLATION REQUESTED": "CANCELLED", "PENDINGCANCEL": "CANCELLED", "CANCELLED AFTER MARKET ORDER": "CANCELLED",
    "AMO CANCELLED": "CANCELLED", "PARTIALLY FILLED - CANCELLED": "CANCELLED",
    "REJECTED": "REJECTED", "REJECT": "REJECTED", "FAILED": "REJECTED", "ABORTED": "REJECTED",
    "EXPIRED": "EXPIRED", "PARTIALLY FILLED - EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

# Noren's time formats: the order stream's time-first form, and the date-first form its order book uses.
NOREN_TIME_FORMATS = ("%H:%M:%S %d-%m-%Y", "%d-%m-%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S")

def present(value):
    """A value, or None for Noren's blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A Noren string field as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def noren_timestamp(value):
    """
    A Noren order time, IST wall clock, as an ISO timestamp with the IST offset, or None.

    Noren's placeholder for a time the exchange never set, `01-01-1980 00:00:00`, reads as None.

    - `value` is the time as Noren sent it.
    """
    value = present(value)
    if value is None:
        return None
    for fmt in NOREN_TIME_FORMATS:
        try:
            moment = datetime.strptime(str(value).strip(), fmt)
        except ValueError:
            continue
        return None if moment.year <= 1980 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_noren(row):
    """
    A Noren order - an order-book row or an `om` order update, which carry the same fields - as a normalized order,
    or None when it has no order number.

    The same function in bin/flattrade/orders and bin/flattrade/order_updates, so both writers of the orders hash
    produce the same `order`.

    - `row` is one order-book row, or one `om` frame.
    """
    if not isinstance(row, dict) or text(row.get('norenordno')) is None:
        return None
    exchange, symbol = text(row.get('exch')), text(row.get('tsym'))
    quantity, filled = number(row.get('qty'), int), number(row.get('fillshares'), int)
    cancelled = number(row.get('cancelqty'), int)
    pending = max(quantity - (filled or 0) - (cancelled or 0), 0) if quantity is not None else None
    return {
        "order_id": text(row.get('norenordno')),
        "exchange_order_id": text(row.get('exchordid')),
        "parent_order_id": text(row.get('snonum')),
        "status": normalize(present(row.get('status')), STATUSES),
        "status_message": text(row.get('rejreason')),
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('token')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "transaction_type": normalize(present(row.get('trantype')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('prd')), PRODUCTS),
        "order_type": normalize(present(row.get('prctyp')), ORDER_TYPES),
        "validity": normalize(present(row.get('ret')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": cancelled,
        "disclosed_quantity": number(row.get('dscqty'), int),
        "price": number(row.get('prc')),
        "trigger_price": number(row.get('trgprc')),
        "average_price": number(row.get('avgprc')),
        "order_timestamp": noren_timestamp(row.get('norentm')),
        "exchange_timestamp": noren_timestamp(row.get('exch_tm')),
        "tag": text(row.get('remarks')),
    }

# What Noren says when the session key is no good, lowercased.
AUTHENTICATION_MARKERS = ("session expired", "invalid session key", "invalid session")

# What Noren says when there is nothing to list, lowercased.
NO_DATA_MARKER = "no data"

class FlattradeRefusal(Exception):
    """Flattrade refused the request in the body of an HTTP 200 response."""

def checked(response):
    """
    The response when Noren served the request, with an empty list for "no data", raising FlattradeRefusal
    with Noren's message for any other refusal.
    """
    data = (response or {}).get('data')
    if isinstance(data, dict) and str(data.get('stat', '')).lower() != 'ok':
        message = str(data.get('emsg') or data)
        if NO_DATA_MARKER in message.lower():
            return {**response, 'data': []}
        raise FlattradeRefusal(message[:200])
    if not isinstance(data, list):
        raise FlattradeRefusal(f"answered without a list: {str(data)[:200]}")
    return response

def confirm_session(flattrade):
    """
    Raise FlattradeRefusal unless UserDetails serves the session.

    FlattradeAPI now checks its probe's body and logs in on a Noren refusal, so this is a second line: a login that
    returned without producing a working session stops the script rather than leaving it polling a dead token.
    """
    data = (flattrade.post(url=USER_DETAILS_URL, timeout=TIMEOUT_SECONDS) or {}).get('data')
    if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
        raise FlattradeRefusal(f"the session was not restored: {str(data)[:200]}")

def is_authentication_error(exception):
    """Whether Flattrade refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the order book and merge it into flattrade:orders:orders every half second, until interrupted."""
    from stock_brokers.api.flattrade import FlattradeAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("flattrade.orders")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        flattrade = FlattradeAPI()
        confirm_session(flattrade)
    except Exception as exception:
        logger.error(f"Could not log in to Flattrade: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                # A fresh dict each time: the API client writes the user id into the one it is given.
                rows = checked(flattrade.post(url=ORDER_BOOK_URL, data={}, timeout=TIMEOUT_SECONDS))['data']
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    order = order_from_noren(row)
                    if order is not None:
                        arguments += [order["order_id"], json.dumps({"observed_at": requested_at, "source": "rest",
                                                                     "order": order, "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} order(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Flattrade session expired, logging in again: {exception}")
                    flattrade = FlattradeAPI()
                    confirm_session(flattrade)
                else:
                    report.error(f"Orders poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
