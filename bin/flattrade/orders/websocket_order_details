def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

# Noren's time formats: the order stream's time-first form, and the date-first form its order book uses.
NOREN_TIME_FORMATS = ("%H:%M:%S %d-%m-%Y", "%d-%m-%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S")

def present(value):
    """A value, or None for Noren's blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A Noren string field as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def noren_timestamp(value):
    """
    A Noren order time, IST wall clock, as an ISO timestamp with the IST offset, or None.

    Noren's placeholder for a time the exchange never set, `01-01-1980 00:00:00`, reads as None.

    - `value` is the time as Noren sent it.
    """
    value = present(value)
    if value is None:
        return None
    for fmt in NOREN_TIME_FORMATS:
        try:
            moment = datetime.strptime(str(value).strip(), fmt)
        except ValueError:
            continue
        return None if moment.year <= 1980 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_noren(row):
    """
    A Noren order - an order-book row or an `om` order update, which carry the same fields - as a normalized order,
    or None when it has no order number.

    The same function in bin/flattrade/orders/api_order_details and bin/flattrade/orders/websocket_order_details, so both writers of the orders hash
    produce the same `order`.

    - `row` is one order-book row, or one `om` frame.
    """
    if not isinstance(row, dict) or text(row.get('norenordno')) is None:
        return None
    exchange, symbol = text(row.get('exch')), text(row.get('tsym'))
    quantity, filled = number(row.get('qty'), int), number(row.get('fillshares'), int)
    cancelled = number(row.get('cancelqty'), int)
    pending = max(quantity - (filled or 0) - (cancelled or 0), 0) if quantity is not None else None
    return {
        "order_id": text(row.get('norenordno')),
        "exchange_order_id": text(row.get('exchordid')),
        "parent_order_id": text(row.get('snonum')),
        "status": normalize(present(row.get('status')), STATUSES),
        "status_message": text(row.get('rejreason')),
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('token')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "transaction_type": normalize(present(row.get('trantype')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('prd')), PRODUCTS),
        "order_type": normalize(present(row.get('prctyp')), ORDER_TYPES),
        "validity": normalize(present(row.get('ret')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": cancelled,
        "disclosed_quantity": number(row.get('dscqty'), int),
        "price": number(row.get('prc')),
        "trigger_price": number(row.get('trgprc')),
        "average_price": number(row.get('avgprc')),
        "order_timestamp": noren_timestamp(row.get('norentm')),
        "exchange_timestamp": noren_timestamp(row.get('exch_tm')),
        "tag": text(row.get('remarks')),
    }

class OrderUpdatesSocket:
    """
    Flattrade's Noren order update websocket, reconnecting and logging in again until stopped.
    """

    def __init__(self, cache, logger):
        """
        Construct FlattradeAPI, which logs in when the stored session is dead, and confirm the session.

        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        from stock_brokers.api.flattrade import FlattradeAPI

        self._api_class = FlattradeAPI
        self._cache = cache
        self._merge = cache.register_script(MERGE_SCRIPT)
        self._logger = logger
        self._flattrade = FlattradeAPI()
        self._confirm_session()
        self._stop = threading.Event()
        self._ws = None
        self._opened = False
        self._authentication_rejected = False
        self.gave_up = False

    def _confirm_session(self):
        """
        Raise unless UserDetails serves the session. Noren refuses a dead session inside an HTTP 200, so a
        constructor that returned is no proof of a working one.
        """
        data = (self._flattrade.post(url=USER_DETAILS_URL, timeout=10) or {}).get('data')
        if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
            raise RuntimeError(f"UserDetails refused the session: {str(data)[:200]}")

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except Exception as exception:
                self._logger.error(f"Order updates connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again:
                    self.gave_up = True
                    self._logger.error("Order updates are still refused after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._logger.warning("Logging in to Flattrade again.")
                    self._flattrade = self._api_class()
                    self._confirm_session()
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"Could not log in to Flattrade again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"Order updates disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info("Order updates socket stopped.")

    def _connect(self):
        """Open the websocket and block until it closes, sending Noren's heartbeat meanwhile."""
        import websocket

        self._ws = websocket.WebSocketApp(ORDER_UPDATES_URL, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=HEARTBEAT_INTERVAL_SECONDS, ping_timeout=HEARTBEAT_TIMEOUT_SECONDS,
                             ping_payload=HEARTBEAT_PAYLOAD)

    def _user_id(self):
        """The Noren user id, which is also the account."""
        return self._flattrade._settings.get('username')

    def _on_open(self, ws):
        """
        Send the connect frame with the token in force now. Subscription waits for its acknowledgement.

        The frame is `a` with the token named `accesstoken`: Noren answers a `c` frame naming it `susertoken`
        with `NOT_OK` for a token REST accepts, which reads like an expired session and is not one.
        """
        self._opened = True
        login = self._flattrade._current_login() or {}
        ws.send(json.dumps({"t": "a", "uid": self._user_id(), "actid": self._user_id(), "source": "API",
                            "accesstoken": login.get('access_token')}))
        self._logger.info("Order updates socket opened. Authenticating.")

    def _on_error(self, ws, error):
        self._logger.error(f"Order updates error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"Order updates socket closed with status {status_code}: {message}")

    def _on_message(self, ws, message):
        """Subscribe once authenticated, and merge each order frame into the orders hash and append it to the stream."""
        observed_at = time.time()
        updates = self.parse(message)
        if updates:
            merged = []
            for order_id, update in updates:
                data = json.loads(update)['data']
                merged += [order_id, json.dumps({"observed_at": observed_at, "source": "websocket",
                                                 "order": order_from_noren(data), "data": data})]
            # The hash keeps each order's latest state; the stream keeps every transition, even two of one order in the
            # same frame, in the shape bin/flattrade/orders/store_orders_to_db reads.
            self._merge(keys=[ORDERS_KEY], args=[next_reset(), "websocket", repr(observed_at)] + merged)
            pipeline = self._cache.pipeline(transaction=False)
            for _, update in updates:
                pipeline.xadd(STREAM_KEY, {"update": update}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()
            self._logger.info(f"Merged {len(updates)} order update(s) into {ORDERS_KEY}: "
                              f"{', '.join(order_id for order_id, _ in updates)}")

    def parse(self, message):
        """
        The order updates a Noren frame carries, as `[(norenordno, JSON)]` in arrival order, acting on the connect
        acknowledgement.

        - `message` is the frame received.
        """
        if isinstance(message, (bytes, bytearray)):
            message = message.decode('utf-8', errors='replace')
        try:
            payload = json.loads(message)
        except (TypeError, json.JSONDecodeError):
            self._logger.debug(f"Ignoring a frame that is not JSON: {str(message)[:160]}")
            return []

        received = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")
        updates = []
        for entry in (payload if isinstance(payload, list) else [payload]):
            if not isinstance(entry, dict):
                continue
            message_type = entry.get('t')
            if message_type == CONNECT_ACK:
                # Documented as "Ok" at one Noren broker and "OK" at another, so compared without case.
                if str(entry.get('s', '')).upper() == 'OK':
                    self._ws.send(json.dumps({"t": "o", "actid": self._user_id()}))
                    self._logger.info("Authenticated and subscribed to order updates. Waiting for order updates.")
                else:
                    self._logger.error(f"Authentication rejected: {entry}")
                    self._authentication_rejected = True
                    self._ws.close()
            elif message_type == ORDER_UPDATE and entry.get('norenordno'):
                updates.append((str(entry['norenordno']), json.dumps({'timestamp': received, 'data': entry})))
            else:
                self._logger.debug(f"Ignoring a message of type {message_type!r}: {json.dumps(entry)[:200]}")
        return updates

def main():
    """Stream Flattrade order updates into flattrade:orders:orders until stopped."""
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("flattrade.websocket_order_details")
    try:
        socket = OrderUpdatesSocket(get_cache(), logger)
    except Exception as exception:
        logger.error(f"Could not log in to Flattrade: {type(exception).__name__}: {exception}")
        return 1

    # Installed before the thread starts: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing the connection.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the order updates feed.")
        socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    thread = threading.Thread(target=socket.run_forever, name="flattrade_order_updates", daemon=True)
    logger.info("Starting the order updates feed.")
    thread.start()

    # Block in the main thread so the signal handlers above can run.
    while thread.is_alive():
        thread.join(timeout=1)

    if socket.gave_up:
        return 1
    logger.info("Order updates feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
