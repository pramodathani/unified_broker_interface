#!/usr/bin/env python3
"""
Poll the day's Flattrade trade book every half second and write it to the Redis key
`flattrade:orders:trades`.

    bin/flattrade/orders/api_trade_details
    redis-cli GET flattrade:orders:trades

Calls `POST https://piconnect.flattrade.in/PiConnectAPI/TradeBook` for the account in Flattrade's settings
(`username`, sent as `actid`) through `FlattradeAPI`, which logs in first if the stored session is dead and
signs the request with the user id and token. Each response - `timestamp`, `status`, `code` and Noren's
trade list under `data`, one row per fill with `flid`, `norenordno`, `exchordid`, `tsym`, `token`, `exch`,
`trantype`, `prd`, `flqty`, `flprc`, `fltm` and `exch_tm` - is written as one JSON string with SET,
replacing the one before.

Flattrade runs on Noren, which answers HTTP 200 whether or not it served the request, so the body is
checked. An empty book comes back as a `Not_Ok` saying "no data", which is an answer, and is written with
`data` as `[]`. A refused session ("Session Expired", "Invalid Session Key") is logged in again before the
next request; any other refusal or failed poll is logged and leaves `flattrade:orders:trades` unchanged.

Runs until Ctrl+C. Exits 1 when the session does not work at startup or after a login following a
refused session - checked against `UserDetails` after the constructor returns. Reads only -
it never places, modifies or cancels an order.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

TRADE_BOOK_URL = "https://piconnect.flattrade.in/PiConnectAPI/TradeBook"
USER_DETAILS_URL = "https://piconnect.flattrade.in/PiConnectAPI/UserDetails"
REDIS_KEY = "flattrade:orders:trades"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

# What Noren says when the session key is no good, lowercased.
AUTHENTICATION_MARKERS = ("session expired", "invalid session key", "invalid session")

# What Noren says when there is nothing to list, lowercased.
NO_DATA_MARKER = "no data"

class FlattradeRefusal(Exception):
    """Flattrade refused the request in the body of an HTTP 200 response."""

def checked(response):
    """
    The response when Noren served the request, with an empty list for "no data", raising FlattradeRefusal
    with Noren's message for any other refusal.
    """
    data = (response or {}).get('data')
    if isinstance(data, dict) and str(data.get('stat', '')).lower() != 'ok':
        message = str(data.get('emsg') or data)
        if NO_DATA_MARKER in message.lower():
            return {**response, 'data': []}
        raise FlattradeRefusal(message[:200])
    if not isinstance(data, list):
        raise FlattradeRefusal(f"answered without a list: {str(data)[:200]}")
    return response

def confirm_session(flattrade):
    """
    Raise FlattradeRefusal unless UserDetails serves the session.

    FlattradeAPI now checks its probe's body and logs in on a Noren refusal, so this is a second line: a login that
    returned without producing a working session stops the script rather than leaving it polling a dead token.
    """
    data = (flattrade.post(url=USER_DETAILS_URL, timeout=TIMEOUT_SECONDS) or {}).get('data')
    if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
        raise FlattradeRefusal(f"the session was not restored: {str(data)[:200]}")

def is_authentication_error(exception):
    """Whether Flattrade refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the trade book and write it to flattrade:orders:trades every half second, until interrupted."""
    from stock_brokers.api.flattrade import FlattradeAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("flattrade.api_trade_details")
    report = PollReporter(logger)
    cache = get_cache()
    try:
        flattrade = FlattradeAPI()
        confirm_session(flattrade)
    except Exception as exception:
        logger.error(f"Could not log in to Flattrade: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                # A fresh dict each time: the API client writes the user id into the one it is given.
                trades = checked(flattrade.post(url=TRADE_BOOK_URL, data={'actid': flattrade._settings['username']},
                                                timeout=TIMEOUT_SECONDS))
                cache.set(REDIS_KEY, json.dumps(trades))
                report.info(f"Wrote {len(trades['data'])} trades to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Flattrade session expired, logging in again: {exception}")
                    flattrade = FlattradeAPI()
                    confirm_session(flattrade)
                else:
                    report.error(f"Trades poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
