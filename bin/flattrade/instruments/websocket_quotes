USER_DETAILS_URL = "https://piconnect.flattrade.in/PiConnectAPI/UserDetails"
SCRIP_MASTER_URLS = [
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/NSE_Equity.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Nfo_Equity_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Nfo_Index_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Currency_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Commodity.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/BSE_Equity.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Bfo_Index_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Bfo_Equity_Derivatives.csv",
]

LIVE_KEY = "flattrade:quotes:live"
INSTRUMENTS_KEY = "flattrade:quotes:instruments"
SUBSCRIPTIONS_KEY = "flattrade:quotes:subscriptions"

# Every tick is also appended here for bin/flattrade/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "flattrade:quotes:stream"
STREAM_MAX_LENGTH = 1000000

EXCHANGES = ("NSE", "NFO", "CDS", "MCX", "BSE", "BFO")
DEFAULT_INSTRUMENTS_PER_CONNECTION = 1000

# Noren's frame types: connect acknowledgement, touchline and depth acknowledgements and updates.
CONNECT_ACK = "ak"
TOUCHLINE_ACK, TOUCHLINE_FEED = "tk", "tf"
DEPTH_ACK, DEPTH_FEED = "dk", "df"

# Noren keeps a session alive with its own heartbeat frame, every three seconds; a plain websocket ping on the
# default interval is not enough and the server drops the connection.
HEARTBEAT_PAYLOAD = '{"t":"h"}'
HEARTBEAT_INTERVAL_SECONDS = 3
HEARTBEAT_TIMEOUT_SECONDS = 2

MIN_BACKOFF_SECONDS = 1
MAX_BACKOFF_SECONDS = 60
MAX_FAILED_CONNECTS = 6

# India has no daylight saving, so a fixed offset turns Noren's India wall clock times into instants.
INDIA = timezone(timedelta(hours=5, minutes=30))
TRADE_TIME_FORMATS = ("%d-%m-%Y %H:%M:%S", "%d/%m/%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S")

class FlattradeSession:
    """
    The Flattrade login every socket authenticates with, logged in again by one socket at a time.
    """

    def __init__(self, logger):
        """
        Construct FlattradeAPI, which logs in when the stored session is dead, and confirm the session.

        - `logger` is where logins are reported.
        """
        from stock_brokers.api.flattrade import FlattradeAPI

        self._api_class = FlattradeAPI
        self._logger = logger
        self._lock = threading.Lock()
        self._flattrade = FlattradeAPI()
        self._confirm()

    def _confirm(self):
        """
        Raise unless UserDetails serves the session. Noren refuses a dead session inside an HTTP 200, so a
        constructor that returned is no proof of a working one.
        """
        data = (self._flattrade.post(url=USER_DETAILS_URL, timeout=10) or {}).get('data')
        if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
            raise RuntimeError(f"UserDetails refused the session: {str(data)[:200]}")

    def credentials(self):
        """
        The user id and the access token in force now, which may be one another process has just obtained.
        """
        login = self._flattrade._current_login() or {}
        return self._flattrade._settings.get('username'), login.get('access_token')

    def log_in_again(self, stale_token):
        """
        Log in again and confirm the session, unless another socket already replaced the token that failed.

        - `stale_token` is the access token the failing connection used.
        """
        with self._lock:
            if self.credentials()[1] != stale_token:
                return
            self._logger.warning("Logging in to Flattrade again.")
            self._flattrade = self._api_class()
            self._confirm()

class QuotesSocket:
    """
    One Flattrade market feed websocket for a batch of instruments, reconnecting until stopped.
    """

    def __init__(self, name, tokens, names, session, cache, logger):
        """
        - `name` is the connection's name, for the log.
        - `tokens` is the batch of `EXCHANGE|TOKEN` instrument tokens.
        - `names` maps `EXCHANGE|TOKEN` to the instrument's name, and is added to as Noren names instruments.
        - `session` is the shared FlattradeSession.
        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        self.name = name
        self._tokens = tokens
        self._names = names
        self._session = session
        self._cache = cache
        self._logger = logger
        self._stop = threading.Event()
        self._ws = None
        self._token = None
        self._user_id = None
        self._opened = False
        self._authentication_rejected = False
        # The last known fields of each instrument, into which every incremental update is merged.
        self._state = {}
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except Exception as exception:
                self._logger.error(f"{self.name} connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again:
                    self.gave_up = True
                    self._logger.error(f"{self.name} is still refused after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._session.log_in_again(self._token)
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"{self.name} could not log in to Flattrade again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"{self.name} disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info(f"{self.name} stopped.")

    def _connect(self):
        """Open the websocket and block until it closes, sending Noren's heartbeat meanwhile."""
        import websocket

        self._user_id, self._token = self._session.credentials()
        self._ws = websocket.WebSocketApp(FEED_URL, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=HEARTBEAT_INTERVAL_SECONDS, ping_timeout=HEARTBEAT_TIMEOUT_SECONDS,
                             ping_payload=HEARTBEAT_PAYLOAD)

    def _on_open(self, ws):
        """
        Send the connect frame. Subscription waits for its acknowledgement.

        The frame is `a` with the token named `accesstoken`. Noren also accepts a `c` frame naming it
        `susertoken`, and answers that `NOT_OK` for a token REST accepts - which reads like an expired session
        and is not one - so `a` is the one used.
        """
        self._opened = True
        self._state = {}
        ws.send(json.dumps({"t": "a", "uid": self._user_id, "actid": self._user_id, "source": "API",
                            "accesstoken": self._token}))
        self._logger.info(f"{self.name} opened. Authenticating.")

    def _on_error(self, ws, error):
        self._logger.error(f"{self.name} error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"{self.name} closed with status {status_code}: {message}")

    def _on_message(self, ws, message):
        """Handle one Noren frame: the connect acknowledgement, or a touchline or depth update."""
        ticks, named = self.parse(message)
        if named:
            self._cache.hset(INSTRUMENTS_KEY, mapping=named)
        if ticks:
            encoded = [(tick['id'], json.dumps(tick)) for tick in ticks]
            # The latest tick per instrument and every tick in arrival order, in one round trip.
            pipeline = self._cache.pipeline(transaction=False)
            pipeline.hset(LIVE_KEY, mapping=dict(encoded))
            for _, payload in encoded:
                pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()

    def parse(self, message):
        """
        The ticks a Noren frame yields and the instruments it newly names, as `(ticks, {token: name})`.

        - `message` is the frame received.
        """
        if isinstance(message, (bytes, bytearray)):
            message = message.decode('utf-8', errors='replace')
        try:
            payload = json.loads(message)
        except (TypeError, json.JSONDecodeError):
            self._logger.warning(f"{self.name} could not decode a frame: {str(message)[:200]}")
            return [], {}
        if not isinstance(payload, dict):
            return [], {}

        message_type = payload.get('t')
        if message_type == CONNECT_ACK:
            # Documented as "Ok" at one Noren broker and "OK" at another, so compared without case.
            if str(payload.get('s', '')).upper() == 'OK':
                self._ws.send(json.dumps({"t": "d", "k": "#".join(self._tokens)}))
                self._logger.info(f"{self.name} authenticated and subscribed to {len(self._tokens)} instrument(s).")
            else:
                self._logger.error(f"{self.name} authentication rejected: {payload}")
                self._authentication_rejected = True
                self._ws.close()
            return [], {}

        if message_type not in (TOUCHLINE_ACK, TOUCHLINE_FEED, DEPTH_ACK, DEPTH_FEED):
            return [], {}
        exchange, token = payload.get('e'), payload.get('tk')
        if not exchange or not token:
            return [], {}
        instrument_token = f"{exchange}|{token}"

        # An acknowledgement names the instrument.
        named = {}
        if message_type in (TOUCHLINE_ACK, DEPTH_ACK) and payload.get('ts'):
            name = f"{exchange}:{payload['ts']}"
            if self._names.get(instrument_token) != name:
                self._names[instrument_token] = name
                named[instrument_token] = name

        state = self._state.setdefault(instrument_token, {})
        state.update({field: value for field, value in payload.items() if field not in ('t', 'e', 'tk')})
        tick = build_tick(instrument_token, state, self._names.get(instrument_token))
        return ([tick] if tick['last_price'] is not None else []), named

def number(value, cast=float):
    """
    A Noren string field as a number, treating blanks and placeholders as missing.

    - `value` is the raw field value.
    - `cast` is the target type.
    """
    if value is None or value == "" or value == "NA":
        return None
    try:
        return cast(float(value)) if cast is int else cast(value)
    except (TypeError, ValueError):
        return None

def trade_time(value, feed_time):
    """
    Noren's last trade time as an epoch, whichever way it is spelled.

    The field arrives as an epoch, a date and time, or a bare `HH:MM:SS` in India time. A bare clock time is
    dated by the tick's feed time, and moved back a day if that would put the trade after it - a trade just
    before midnight reported just after.

    - `value` is the raw `ltt` field.
    - `feed_time` is the tick's `ft` epoch, or None to date a bare clock time by the wall clock.
    """
    if value is None or value == "" or value == "NA":
        return None
    text = str(value).strip()
    if text.isdigit():
        return int(text)
    for format in TRADE_TIME_FORMATS:
        try:
            return int(datetime.strptime(text, format).replace(tzinfo=INDIA).timestamp())
        except ValueError:
            continue
    try:
        clock = datetime.strptime(text, "%H:%M:%S").time()
    except ValueError:
        return None
    reference = datetime.fromtimestamp(feed_time if feed_time else time.time(), tz=INDIA)
    moment = datetime.combine(reference.date(), clock, tzinfo=INDIA)
    if moment > reference + timedelta(minutes=5):
        moment -= timedelta(days=1)
    return int(moment.timestamp())

def build_tick(instrument_token, state, name):
    """
    A normalized tick from the merged state of an instrument.

    - `instrument_token` is the `EXCHANGE|TOKEN` key.
    - `state` is the instrument's merged fields.
    - `name` is the instrument's name, or None, in which case the tick is keyed by its token.
    """
    exchange = instrument_token.partition('|')[0]
    last_price = number(state.get('lp'))
    close = number(state.get('c'))
    change = number(state.get('pc'))
    if change is None and last_price is not None and close:
        change = (last_price - close) * 100 / close

    depth = {"buy": [], "sell": []}
    for level in range(1, 6):
        if state.get(f'bp{level}') is not None:
            depth['buy'].append({"quantity": number(state.get(f'bq{level}'), int), "price": number(state.get(f'bp{level}')),
                                 "orders": number(state.get(f'bo{level}'), int)})
        if state.get(f'sp{level}') is not None:
            depth['sell'].append({"quantity": number(state.get(f'sq{level}'), int), "price": number(state.get(f'sp{level}')),
                                  "orders": number(state.get(f'so{level}'), int)})

    feed_time = number(state.get('ft'), int)
    return {
        "id": name or instrument_token, "broker": "flattrade", "instrument_token": instrument_token,
        "exchange": exchange, "mode": "full" if depth['buy'] or depth['sell'] else "quote",
        "last_price": last_price, "last_quantity": number(state.get('ltq'), int),
        "average_price": number(state.get('ap')), "volume": number(state.get('v'), int),
        "buy_quantity": number(state.get('tbq'), int), "sell_quantity": number(state.get('tsq'), int),
        "ohlc": {"open": number(state.get('o')), "high": number(state.get('h')), "low": number(state.get('l')),
                 "close": close},
        "change": change, "oi": number(state.get('oi'), int), "oi_day_high": None, "oi_day_low": None,
        "last_trade_time": trade_time(state.get('ltt'), feed_time), "exchange_timestamp": feed_time,
        "depth": depth, "received_at": time.time(),
    }

def resolve_tokens(tokens, cache, logger):
    """
    The valid `EXCHANGE|TOKEN` tokens to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        exchange, _, number_part = token.partition('|')
        if exchange in EXCHANGES and number_part.isdigit():
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected EXCHANGE|TOKEN with EXCHANGE one of {', '.join(EXCHANGES)}.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Flattrade's scrip master files, keyed by `EXCHANGE|TOKEN`.

    A file that cannot be downloaded is reported and skipped; its instruments are named by Noren's
    acknowledgement instead, or keyed by token.

    - `tokens` is the list of subscribed `EXCHANGE|TOKEN` tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    names = {}
    for url in SCRIP_MASTER_URLS:
        try:
            response = requests.get(url, timeout=120)
            response.raise_for_status()
        except Exception as exception:
            logger.warning(f"Could not download {url}: {exception}")
            continue
        for row in csv.DictReader(StringIO(response.text)):
            exchange, token, symbol = (row.get('Exchange') or '').strip(), (row.get('Token') or '').strip(), (row.get('Tradingsymbol') or '').strip()
            if f"{exchange}|{token}" in wanted and symbol:
                names[f"{exchange}|{token}"] = f"{exchange}:{symbol}"
    return names

def main():
    """Stream Flattrade quotes into flattrade:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Flattrade market quotes into flattrade:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated EXCHANGE|TOKEN tokens, for example NSE|2885")
    parser.add_argument("--per-socket", type=int, default=DEFAULT_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, default {DEFAULT_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("flattrade.websocket_quotes")
    cache = get_cache()

    if arguments.per_socket < 1:
        logger.error("--per-socket must be at least 1.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE|TOKEN members to the Redis set "
                     f"{SUBSCRIPTIONS_KEY}.")
        return 2
    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]

    try:
        session = FlattradeSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Flattrade: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the scrip master and are keyed by token until Noren "
                       f"names them: {', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    sockets = [QuotesSocket(f"socket_{index}", batch, names, session, cache, logger) for index, batch in enumerate(batches)]

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"flattrade_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
