#!/usr/bin/env python3
"""
Stream Flattrade market quotes over websockets into the Redis hash `flattrade:quotes:live`, and keep streaming
until stopped.

    bin/flattrade/instruments/websocket_quotes                               # instruments from the Redis set flattrade:quotes:subscriptions
    bin/flattrade/instruments/websocket_quotes --tokens NSE|2885,MCX|565899
    bin/flattrade/instruments/websocket_quotes --per-socket 500

    redis-cli SADD flattrade:quotes:subscriptions "NSE|2885" "MCX|565899"
    redis-cli HGET flattrade:quotes:live "NSE:RELIANCE-EQ"
    redis-cli HGETALL flattrade:quotes:instruments

The connection, the login, the handshake and the message decoding for Flattrade's Noren market feed at
`wss://piconnect.flattrade.in/PiConnectWSTp/` are `FlattradeQuotesSocket` and `FlattradeSession` in
`stock_brokers/websockets/flattrade.py`, whose module docstring describes the protocol. This script chooses the
instruments, splits them across sockets, runs the sockets and writes what they decode to Redis, so it needs no
other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set
`flattrade:quotes:subscriptions`, each as `EXCHANGE|TOKEN` - `NSE`, `NFO`, `CDS`, `MCX`, `BSE` or `BFO`, then
Flattrade's token. Each is named from Flattrade's public scrip master files, downloaded at startup, and from
the trading symbol Noren sends back when a subscription is acknowledged. One websocket carries up to
`--per-socket` instruments.

**Keys.**

- `flattrade:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the instrument's name
  (`NSE:RELIANCE-EQ`), or by its `EXCHANGE|TOKEN` while unnamed. Replaced as each update arrives, and not
  cleared at startup, so an instrument no longer subscribed keeps its last tick.
- `flattrade:quotes:instruments`, a hash of every subscribed `EXCHANGE|TOKEN` to its name, or to an empty
  string when unnamed. Replaced whole at startup; a name Noren supplies later is added as it arrives.
- `flattrade:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/flattrade/instruments/store_quotes_to_db` writes to `flattrade.ticks`. Capped at about 1,000,000 entries, so ticks that arrive
  while the persister is down for long enough are trimmed before they are persisted.

A tick has the same fields as Dhan's: `id`, `broker`, `instrument_token`, `exchange`, `mode`, `last_price`,
`last_quantity`, `average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`,
`oi_day_high`, `oi_day_low`, `last_trade_time`, `exchange_timestamp`, `depth` and `received_at`, with `None`
for what Noren does not send. `change` is Noren's `pc` where sent, and the change against `ohlc.close`
otherwise. `last_trade_time` reads Noren's `ltt` whether it is an epoch, a date and time, or a bare India
clock time. An update that leaves an instrument without a last price is not written.

**Sessions.** Every socket shares one `FlattradeSession`, and reads the current token when it connects, so a
login made by any process is picked up. When Noren refuses the connect frame, or a socket fails to open six
times running, it logs in again - one socket at a time, and only if no other socket or process already replaced
the token - confirms the new session against `UserDetails`, since
Noren refuses a dead session inside an HTTP 200, and only then reconnects. A reconnect otherwise backs off from
1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket is still refused after logging
in again, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import csv
import json
import signal
import argparse
import threading
from io import StringIO
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

SCRIP_MASTER_URLS = [
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/NSE_Equity.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Nfo_Equity_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Nfo_Index_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Currency_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Commodity.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/BSE_Equity.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Bfo_Index_Derivatives.csv",
    "https://flattrade.s3.ap-south-1.amazonaws.com/scripmaster/Bfo_Equity_Derivatives.csv",
]

LIVE_KEY = "flattrade:quotes:live"
INSTRUMENTS_KEY = "flattrade:quotes:instruments"
SUBSCRIPTIONS_KEY = "flattrade:quotes:subscriptions"

# Every tick is also appended here for bin/flattrade/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "flattrade:quotes:stream"
STREAM_MAX_LENGTH = 1000000

EXCHANGES = ("NSE", "NFO", "CDS", "MCX", "BSE", "BFO")
DEFAULT_INSTRUMENTS_PER_CONNECTION = 1000

class FlattradeQuotesStore:
    """
    Where the quotes sockets' output is written: learned names, the live hash and the persistence stream.
    """

    def __init__(self, cache):
        """
        Keeps the Redis client the names and ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_names(self, named):
        """
        Writes the names Noren gave instruments to the subscribed instruments hash.

        Args:
            named (dict[str, str]): Each `EXCHANGE|TOKEN` to its new `EXCHANGE:TRADINGSYMBOL`.

        Returns:
            None: This method returns nothing.
        """
        self._cache.hset(INSTRUMENTS_KEY, mapping=named)

    def write_ticks(self, ticks):
        """
        Writes one frame's ticks: the latest tick per instrument and every tick in arrival order, in one round trip.

        Args:
            ticks (list[dict]): The frame's ticks, in arrival order.

        Returns:
            None: This method returns nothing.
        """
        encoded = []
        for tick in ticks:
            encoded.append((tick["id"], json.dumps(tick)))
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, mapping=dict(encoded))
        for _, payload in encoded:
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def resolve_tokens(tokens, cache, logger):
    """
    The valid `EXCHANGE|TOKEN` tokens to subscribe to: `--tokens` when given, otherwise the subscription set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        exchange, _, number_part = token.partition('|')
        if exchange in EXCHANGES and number_part.isdigit():
            resolved.append(token)
        else:
            logger.warning(f"Skipping {token}: expected EXCHANGE|TOKEN with EXCHANGE one of {', '.join(EXCHANGES)}.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Flattrade's scrip master files, keyed by `EXCHANGE|TOKEN`.

    A file that cannot be downloaded is reported and skipped; its instruments are named by Noren's
    acknowledgement instead, or keyed by token.

    - `tokens` is the list of subscribed `EXCHANGE|TOKEN` tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    names = {}
    for url in SCRIP_MASTER_URLS:
        try:
            response = requests.get(url, timeout=120)
            response.raise_for_status()
        except Exception as exception:
            logger.warning(f"Could not download {url}: {exception}")
            continue
        for row in csv.DictReader(StringIO(response.text)):
            exchange, token, symbol = (row.get('Exchange') or '').strip(), (row.get('Token') or '').strip(), (row.get('Tradingsymbol') or '').strip()
            if f"{exchange}|{token}" in wanted and symbol:
                names[f"{exchange}|{token}"] = f"{exchange}:{symbol}"
    return names

def main():
    """Stream Flattrade quotes into flattrade:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Flattrade market quotes into flattrade:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated EXCHANGE|TOKEN tokens, for example NSE|2885")
    parser.add_argument("--per-socket", type=int, default=DEFAULT_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, default {DEFAULT_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from stock_brokers.websockets.flattrade import FlattradeQuotesSocket, FlattradeSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("flattrade.websocket_quotes")
    cache = get_cache()

    if arguments.per_socket < 1:
        logger.error("--per-socket must be at least 1.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE|TOKEN members to the Redis set "
                     f"{SUBSCRIPTIONS_KEY}.")
        return 2
    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]

    try:
        session = FlattradeSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Flattrade: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the scrip master and are keyed by token until Noren "
                       f"names them: {', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    store = FlattradeQuotesStore(cache)
    sockets = []
    for index, batch in enumerate(batches):
        sockets.append(FlattradeQuotesSocket(f"socket_{index}", batch, names, session, store.write_names, store.write_ticks,
                                             logger))

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"flattrade_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
