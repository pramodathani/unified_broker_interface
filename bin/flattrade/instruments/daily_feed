#!/usr/bin/env python3
"""
Download Flattrade's instrument master, append today's snapshot to `flattrade.instruments`, and store it in
Redis as `flattrade:instruments:master` with `flattrade:instruments:meta` beside it.

    bin/flattrade/instruments/daily_feed
    bin/flattrade/instruments/daily_feed --bootstrap             # replace today's stored snapshot in the table

    redis-cli HGET flattrade:instruments:master NSE:RELIANCE-EQ
    redis-cli GET flattrade:instruments:meta

**The download** is Flattrade's eight public scrip master CSV files on S3 - NSE equity, NFO equity and index
derivatives, currency derivatives, commodity, BSE equity, BFO index and equity derivatives - about 11 MB and
156,000 rows together, sharing one nine-column header and needing no login. They are fetched once through
`FlattradeInstruments`, stacked, and used for both stores.

**The table** is written by `FlattradeInstruments.ingest`: column names normalized to snake_case (`exchange`,
`token`, `lotsize`, `symbol`, `tradingsymbol`, `instrument`, `expiry`, `strike`, `optiontype`), whitespace stripped,
`NSETEST` placeholder rows dropped, duplicates on `(exchange, tradingsymbol)` dropped, `download_date` added, and
the rows appended to `flattrade.instruments`. A date already stored is skipped unless `--bootstrap` is given, and a
row count more than ten percent off the earlier days' average is reported.

**Redis** gets the same cleaned rows, whether or not the table already had today's:

- `flattrade:instruments:master`, a hash with one field per instrument, `EXCHANGE:TRADINGSYMBOL`
  (`NSE:RELIANCE-EQ`, `MCX:CRUDEOIL21SEP26`) - the table's own natural key. The value is the row as a JSON
  array in column order, with `null` for a blank value; the column names are stored once in the meta key.
  The blank rows the BSE file ends with, which the table keeps as one row with an empty exchange and symbol,
  have no key and are left out.
- `flattrade:instruments:meta`, a JSON object: `download_date`, `rows`, `columns` (the order the arrays
  follow), `source_last_modified` (each file's Last-Modified header, by URL) and `written_at`.

The hash is built under `flattrade:instruments:master:staging` and swapped in at the end, so a reader sees
either the previous complete hash or today's, never one half-written; the previous hash is unlinked in the
background rather than freed inline.

Exits 0 when both the table and Redis were written (or the table already held today's snapshot), and 1 when
the download, the table write or the Redis write failed, saying which.
"""

import sys
import json
import argparse
from datetime import date, datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

MASTER_KEY = "flattrade:instruments:master"
STAGING_KEY = "flattrade:instruments:master:staging"
PREVIOUS_KEY = "flattrade:instruments:master:previous"
META_KEY = "flattrade:instruments:meta"

KEY_COLUMNS = ("exchange", "tradingsymbol")
FIELDS_PER_BATCH = 5000

def downloader():
    """
    A FlattradeInstruments whose download happens once, so the table write and Redis share one fetch.
    """
    from stock_brokers.instruments.flattrade import FlattradeInstruments

    class OnceDownloadedFlattradeInstruments(FlattradeInstruments):
        """FlattradeInstruments keeping the frame it downloaded, for the Redis write to reuse."""

        _frame = None

        def download(self):
            if self._frame is None:
                self._frame = super().download()
            return self._frame.copy()

    return OnceDownloadedFlattradeInstruments()

def cleaned(ingester):
    """
    The downloaded rows cleaned exactly as `ingest` cleans them before the table write.

    - `ingester` is the FlattradeInstruments that downloaded the files.
    """
    frame = ingester.download()
    for step in (ingester.normalize_columns, ingester.strip_whitespace, ingester.drop_unnamed_columns,
                 ingester.drop_garbage_rows, ingester.dedupe):
        frame = step(frame)
    return frame

def source_last_modified():
    """Each scrip master file's Last-Modified header by URL, None for a file whose header cannot be read."""
    import requests
    from stock_brokers.instruments.flattrade import INSTRUMENTS_URLS

    headers = {}
    for url in INSTRUMENTS_URLS:
        try:
            headers[url] = requests.head(url, timeout=30).headers.get("Last-Modified")
        except Exception:
            headers[url] = None
    return headers

def write_redis(cache, frame, download_date, logger):
    """
    Build the instrument hash under a staging key, then swap it and the meta in together.

    - `cache` is the Redis client.
    - `frame` is the cleaned instrument rows.
    - `download_date` is the snapshot's date.
    - `logger` is where progress is reported.
    """
    columns = list(frame.columns)
    key_positions = [columns.index(column) for column in KEY_COLUMNS]
    # A blank value arrives as NaN, which is not JSON; NaN is the one value unequal to itself.
    rows = [[None if value != value else value for value in row] for row in frame.itertuples(index=False, name=None)]
    keyed = [row for row in rows if all(row[position] for position in key_positions)]

    cache.unlink(STAGING_KEY)
    for start in range(0, len(keyed), FIELDS_PER_BATCH):
        batch = keyed[start:start + FIELDS_PER_BATCH]
        cache.hset(STAGING_KEY, mapping={":".join(str(row[position]) for position in key_positions): json.dumps(row)
                                         for row in batch})
    stored = cache.hlen(STAGING_KEY)

    meta = {"download_date": str(download_date), "rows": stored, "columns": columns,
            "source_last_modified": source_last_modified(), "written_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")}

    # Renaming onto an existing key frees the old value inline, which for a hash this size can stall Redis,
    # so the old hash is moved aside and unlinked, which frees it in the background.
    pipeline = cache.pipeline(transaction=True)
    if cache.exists(MASTER_KEY):
        pipeline.rename(MASTER_KEY, PREVIOUS_KEY)
    pipeline.rename(STAGING_KEY, MASTER_KEY)
    pipeline.set(META_KEY, json.dumps(meta))
    pipeline.unlink(PREVIOUS_KEY)
    pipeline.execute()

    if len(keyed) != len(rows):
        logger.info(f"Left {len(rows) - len(keyed)} row(s) with a blank exchange or trading symbol out of {MASTER_KEY}.")
    if stored != len(keyed):
        logger.warning(f"{len(keyed)} row(s) produced {stored} field(s): some rows share an EXCHANGE:TRADINGSYMBOL.")
    logger.info(f"Wrote {stored} instrument(s) to {MASTER_KEY} and the meta to {META_KEY}.")

def main():
    """Download Flattrade's instrument master into flattrade.instruments and Redis."""
    parser = argparse.ArgumentParser(description="Download Flattrade's instrument master into flattrade.instruments and Redis.")
    parser.add_argument("--bootstrap", action="store_true",
                        help="replace today's stored snapshot in the table instead of skipping")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("flattrade.daily_feed")
    download_date = date.today()
    ingester = downloader()

    try:
        frame = cleaned(ingester)
    except Exception as exception:
        logger.error(f"Could not download Flattrade's instrument master: {type(exception).__name__}: {exception}")
        return 1
    logger.info(f"Downloaded {len(frame)} instrument(s) for {download_date}.")

    failures = []
    try:
        rows = ingester.ingest(download_date=download_date, bootstrap=arguments.bootstrap)
        if rows:
            ingester.check_row_count_deviation(download_date)
    except Exception as exception:
        failures.append("table")
        logger.error(f"Could not write flattrade.instruments: {type(exception).__name__}: {exception}")

    try:
        write_redis(get_cache(), frame, download_date, logger)
    except Exception as exception:
        failures.append("Redis")
        logger.error(f"Could not write {MASTER_KEY}: {type(exception).__name__}: {exception}")

    if failures:
        logger.error(f"Failed: {' and '.join(failures)}.")
        return 1
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
