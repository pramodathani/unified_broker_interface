#!/usr/bin/env python3
"""
Poll the Flattrade holdings every minute and write them to the Redis key `flattrade:portfolio:holdings`.

    bin/flattrade/portfolio/holdings
    redis-cli GET flattrade:portfolio:holdings

Calls `POST https://piconnect.flattrade.in/PiConnectAPI/Holdings` for the account in Flattrade's settings
(`username`, sent as `actid`) and the cash-and-carry product through `FlattradeAPI`, which logs in first if
the stored session is dead and signs the request with the user id and token. Each response - `timestamp`,
`status`, `code` and Noren's holdings list under `data`, one row per holding with `exch_tsym` (the stock's
listings, each with `exch`, `token`, `tsym` and `isin`), the quantity spread over `holdqty`, `npoadqty` and
`npoadt1qty`, `upldprc`, the average price, `colqty` and `c`, the previous close - is written as one JSON
string with SET, replacing the one before.

Flattrade runs on Noren, which answers HTTP 200 whether or not it served the request, so the body is
checked. An account holding nothing comes back as a `Not_Ok` saying "no data", which is an answer, and is
written with `data` as `[]`. A refused session ("Session Expired", "Invalid Session Key") is logged in
again before the next request; any other refusal or failed poll is logged and leaves
`flattrade:portfolio:holdings` unchanged.

Runs until Ctrl+C. Exits 1 when the session does not work at startup or after a login following a
refused session - checked against `UserDetails` after the constructor returns. Reads only -
it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

HOLDINGS_URL = "https://piconnect.flattrade.in/PiConnectAPI/Holdings"
USER_DETAILS_URL = "https://piconnect.flattrade.in/PiConnectAPI/UserDetails"
REDIS_KEY = "flattrade:portfolio:holdings"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10

# What Noren says when the session key is no good, lowercased.
AUTHENTICATION_MARKERS = ("session expired", "invalid session key", "invalid session")

# What Noren says when there is nothing to list, lowercased.
NO_DATA_MARKER = "no data"

class FlattradeRefusal(Exception):
    """Flattrade refused the request in the body of an HTTP 200 response."""

def checked(response):
    """
    The response when Noren served the request, with an empty list for "no data", raising FlattradeRefusal
    with Noren's message for any other refusal.
    """
    data = (response or {}).get('data')
    if isinstance(data, dict) and str(data.get('stat', '')).lower() != 'ok':
        message = str(data.get('emsg') or data)
        if NO_DATA_MARKER in message.lower():
            return {**response, 'data': []}
        raise FlattradeRefusal(message[:200])
    if not isinstance(data, list):
        raise FlattradeRefusal(f"answered without a list: {str(data)[:200]}")
    return response

def confirm_session(flattrade):
    """
    Raise FlattradeRefusal unless UserDetails serves the session.

    FlattradeAPI now checks its probe's body and logs in on a Noren refusal, so this is a second line: a login that
    returned without producing a working session stops the script rather than leaving it polling a dead token.
    """
    data = (flattrade.post(url=USER_DETAILS_URL, timeout=TIMEOUT_SECONDS) or {}).get('data')
    if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
        raise FlattradeRefusal(f"the session was not restored: {str(data)[:200]}")

def is_authentication_error(exception):
    """Whether Flattrade refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the holdings and write them to flattrade:portfolio:holdings every minute, until interrupted."""
    from stock_brokers.api.flattrade import FlattradeAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("flattrade.holdings")
    cache = get_cache()
    try:
        flattrade = FlattradeAPI()
        confirm_session(flattrade)
    except Exception as exception:
        logger.error(f"Could not log in to Flattrade: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                # A fresh dict each time: the API client writes the user id into the one it is given.
                holdings = checked(flattrade.post(url=HOLDINGS_URL, data={'actid': flattrade._settings['username'], 'prd': 'C'},
                                                  timeout=TIMEOUT_SECONDS))
                cache.set(REDIS_KEY, json.dumps(holdings))
                logger.info(f"Wrote {len(holdings['data'])} holdings to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Flattrade session expired, logging in again: {exception}")
                    flattrade = FlattradeAPI()
                    confirm_session(flattrade)
                else:
                    logger.error(f"Holdings poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
