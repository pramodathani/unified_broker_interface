#!/usr/bin/env python3
"""
Poll the Flattrade user details every minute and write them to the Redis key `flattrade:user:details`.

    bin/flattrade/user-profile
    redis-cli GET flattrade:user:details

Calls `POST https://piconnect.flattrade.in/PiConnectAPI/UserDetails` through `FlattradeAPI`, which logs in
first if the stored session is dead and signs the request with the user id and token. Each response -
`timestamp`, `status`, `code` and Noren's user details under `data`, among them `actid`, `email`,
`brkname`, and the exchanges, products and order types the account may use in `exarr`, `prarr` and
`orarr` - is written as one JSON string with SET, replacing the one before.

Flattrade runs on Noren, which answers HTTP 200 whether or not it served the request, so the body is
checked: only a `stat` of `Ok` is written. A refused session ("Session Expired", "Invalid Session Key") is
logged in again before the next request; any other refusal or failed poll is logged and leaves
`flattrade:user:details` unchanged.

Runs until Ctrl+C. Exits 1 when the session does not work at startup or after a login following a
refused session - checked against `UserDetails` after the constructor returns. Reads only -
it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

USER_DETAILS_URL = "https://piconnect.flattrade.in/PiConnectAPI/UserDetails"
REDIS_KEY = "flattrade:user:details"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10

# What Noren says when the session key is no good, lowercased.
AUTHENTICATION_MARKERS = ("session expired", "invalid session key", "invalid session")

class FlattradeRefusal(Exception):
    """Flattrade refused the request in the body of an HTTP 200 response."""

def checked(response):
    """The response when Noren served the request, raising FlattradeRefusal with its message when it did not."""
    data = (response or {}).get('data')
    if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
        message = str(data.get('emsg') or data) if isinstance(data, dict) else str(data)
        raise FlattradeRefusal(message[:200])
    return response

def confirm_session(flattrade):
    """
    Raise FlattradeRefusal unless UserDetails serves the session.

    FlattradeAPI now checks its probe's body and logs in on a Noren refusal, so this is a second line: a login that
    returned without producing a working session stops the script rather than leaving it polling a dead token.
    """
    data = (flattrade.post(url=USER_DETAILS_URL, timeout=TIMEOUT_SECONDS) or {}).get('data')
    if not isinstance(data, dict) or str(data.get('stat', '')).lower() != 'ok':
        raise FlattradeRefusal(f"the session was not restored: {str(data)[:200]}")

def is_authentication_error(exception):
    """Whether Flattrade refused the request because the session is dead."""
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the user details and write them to flattrade:user:details every minute, until interrupted."""
    from stock_brokers.api.flattrade import FlattradeAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("flattrade.user_profile")
    cache = get_cache()
    try:
        flattrade = FlattradeAPI()
        confirm_session(flattrade)
    except Exception as exception:
        logger.error(f"Could not log in to Flattrade: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                profile = checked(flattrade.post(url=USER_DETAILS_URL, timeout=TIMEOUT_SECONDS))
                cache.set(REDIS_KEY, json.dumps(profile))
                logger.info(f"Wrote the details of {profile['data'].get('actid')} to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Flattrade session expired, logging in again: {exception}")
                    flattrade = FlattradeAPI()
                    confirm_session(flattrade)
                else:
                    logger.error(f"User details poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
