def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for XTS's blanks and its `NA` and `NaN` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA", "NaN", "nan") else value

def first(data, *names):
    """
    The first present value among several spellings of a field.

    - `data` is the XTS payload.
    - `names` are the candidate field names.
    """
    for name in names:
        if present(data.get(name)) is not None:
            return data[name]
    return None

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric. XTS sends many numbers as strings.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A present value as a string, or None."""
    value = present(value)
    return None if value is None else str(value)

# XTS writes times day first - `12-09-2026 09:20:11` - and in a few other shapes, sometimes with milliseconds after a
# colon or a dot, which are dropped.
XTS_TIME_FORMATS = ("%d-%m-%Y %H:%M:%S", "%d-%b-%Y %H:%M:%S", "%b %d %Y %H:%M:%S", "%d/%m/%Y %H:%M:%S",
                    "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S")

def xts_timestamp(value):
    """
    An XTS time, IST wall clock, as an ISO timestamp with the IST offset, or None.

    A placeholder for a time not yet set - `01-01-1980 00:00:00` and the like - reads as None.

    - `value` is the time as XTS sent it.
    """
    value = present(value)
    if value is None:
        return None
    raw = str(value).strip()
    candidates = [raw]
    head, separator, tail = raw.rpartition(":")
    if separator and tail.isdigit() and len(tail) == 3:
        candidates.append(head)                       # 12-09-2026 09:20:11:123
    candidates.append(raw.split(".")[0])              # 2026-09-12T09:20:11.123
    for candidate in candidates:
        for fmt in XTS_TIME_FORMATS:
            try:
                moment = datetime.strptime(candidate, fmt)
            except ValueError:
                continue
            return None if moment.year <= 1980 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def normalized_order(row):
    """
    An XTS order as a normalized order, or None when it has no `AppOrderID`.

    XTS's order-book row and its interactive socket's order event are the same object, so `bin/wisdom_capital/orders`
    and `bin/wisdom_capital/order_updates` both build `order` with this function.

    - `row` is one order-book row or one order event payload.
    """
    if not isinstance(row, dict) or text(row.get('AppOrderID')) is None:
        return None
    segment = text(row.get('ExchangeSegment'))
    symbol = text(first(row, 'TradingSymbol', 'TradingSymbolName'))
    quantity, filled = number(row.get('OrderQuantity'), int), number(row.get('CumulativeQuantity'), int)
    pending = number(row.get('LeavesQuantity'), int)
    if pending is None and quantity is not None and filled is not None:
        pending = quantity - filled
    return {
        "order_id": text(row.get('AppOrderID')),
        "exchange_order_id": text(row.get('ExchangeOrderID')),
        "parent_order_id": text(row.get('OrderReferenceID')),
        "status": normalize(present(row.get('OrderStatus')), STATUSES),
        "status_message": text(row.get('CancelRejectReason')),
        "id": f"{segment}:{symbol}" if segment and symbol else symbol,
        "instrument_token": text(row.get('ExchangeInstrumentID')),
        "tradingsymbol": symbol,
        "exchange": segment,
        "transaction_type": normalize(present(row.get('OrderSide')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('ProductType')), PRODUCTS),
        "order_type": normalize(present(row.get('OrderType')), ORDER_TYPES),
        "validity": normalize(present(row.get('TimeInForce')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": number(row.get('CancelledQuantity'), int),
        "disclosed_quantity": number(row.get('OrderDisclosedQuantity'), int),
        "price": number(row.get('OrderPrice')),
        "trigger_price": number(row.get('OrderStopPrice')),
        "average_price": number(row.get('OrderAverageTradedPrice')),
        "order_timestamp": xts_timestamp(first(row, 'OrderGeneratedDateTime', 'LastUpdateDateTime')),
        "exchange_timestamp": xts_timestamp(row.get('ExchangeTransactTime')),
        "tag": text(row.get('OrderUniqueIdentifier')),
    }

def day_or_net(value):
    """
    `NET` or `DAY` for XTS's basis spelling - the positions request's `NetWise` or `DayWise`, or a position's own
    `DayOrNet` - or None when it names neither.

    - `value` is the basis as XTS spells it.
    """
    value = (text(value) or "").strip().upper()
    return "DAY" if value.startswith("DAY") else "NET" if value.startswith("NET") else None

def position_field(row, basis=None):
    """
    The hash field for an XTS position, `DAY_OR_NET:ExchangeSegment:ExchangeInstrumentID:ProductType`, or None when
    it lacks one of them.

    The basis comes from the positions request for a polled row and from the position's own `DayOrNet` for a socket
    event, so the same position gets the same field from both writers. A socket position with no `DayOrNet` is taken
    as `NET`, XTS's default view.

    - `row` is one position row or one position event payload.
    - `basis` is the request's `NetWise` or `DayWise`, or None to read the position's own.
    """
    if not isinstance(row, dict):
        return None
    view = day_or_net(basis if basis is not None else first(row, 'DayOrNet', 'IsDayWiseNetWise')) or "NET"
    parts = [text(row.get('ExchangeSegment')), text(first(row, 'ExchangeInstrumentID', 'ExchangeInstrumentId')),
             (text(row.get('ProductType')) or "").upper() or None]
    return ":".join([view] + parts) if all(parts) else None

def position_from_row(row, basis=None):
    """
    An XTS position as a normalized position, following XTS's published position schema.

    - `row` is one position row or one position event payload.
    - `basis` is the request's `NetWise` or `DayWise`, or None to read the position's own.
    """
    segment = text(row.get('ExchangeSegment'))
    instrument = text(first(row, 'ExchangeInstrumentID', 'ExchangeInstrumentId'))
    symbol = text(first(row, 'TradingSymbol', 'TradingSymbolName', 'Symbol'))
    buy_quantity, sell_quantity = number(row.get('OpenBuyQuantity'), int), number(row.get('OpenSellQuantity'), int)
    quantity = number(first(row, 'Quantity', 'NetQuantity'), int)
    if quantity is None and buy_quantity is not None and sell_quantity is not None:
        quantity = buy_quantity - sell_quantity
    return {
        "id": f"{segment}:{symbol}" if segment and symbol else symbol or (f"{segment}:{instrument}" if segment else instrument),
        "instrument_token": instrument,
        "tradingsymbol": symbol,
        "exchange": segment,
        "segment": segment[-2:] if segment and segment[-2:] in ("CM", "FO", "CD") else None,
        "product": normalize(present(row.get('ProductType')), PRODUCTS),
        "quantity": quantity,
        "buy_quantity": buy_quantity,
        "sell_quantity": sell_quantity,
        "buy_price": number(row.get('BuyAveragePrice')),
        "sell_price": number(row.get('SellAveragePrice')),
        "buy_value": number(row.get('BuyAmount')),
        "sell_value": number(row.get('SellAmount')),
        "average_price": None,
        "last_price": None,
        "realized_pnl": number(row.get('RealizedMTM')),
        "unrealized_pnl": number(row.get('UnrealizedMTM')),
        "pnl": number(row.get('MTM')),
        "multiplier": number(row.get('Multiplier')),
        "lot_size": number(first(row, 'Marketlot', 'LotSize'), int),
        "day_or_net": day_or_net(basis if basis is not None else first(row, 'DayOrNet', 'IsDayWiseNetWise')) or "NET",
        "updated_at": text(row.get('LastUpdateDateTime')),
    }


def pinned_get(path):
    """
    An HTTPS GET to the platform over a connection pinned to its certificate.

    - `path` is the path to request.
    """
    import urllib3

    pool = urllib3.HTTPSConnectionPool(HOST, PORT, assert_fingerprint=CERTIFICATE_FINGERPRINT)
    return pool.request("GET", path, headers={"Content-Type": "application/json"}, timeout=30)

def first_json_object(text):
    """
    The first balanced `{...}` in an Engine.IO polling body, decoded, or None.

    - `text` is the body, which frames the handshake JSON with a length prefix.
    """
    start, depth = text.find('{'), 0
    if start == -1:
        return None
    for index in range(start, len(text)):
        depth += 1 if text[index] == '{' else (-1 if text[index] == '}' else 0)
        if depth == 0:
            return json.loads(text[start:index + 1])
    return None

class OrderUpdatesSocket:
    """
    Wisdom Capital's XTS interactive socket, reconnecting and logging in again until stopped.
    """

    def __init__(self, cache, logger):
        """
        Construct WisdomCapitalAPI, which logs in when the stored session is dead.

        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        from stock_brokers.api.wisdom_capital import WisdomCapitalAPI

        self._api_class = WisdomCapitalAPI
        self._api = WisdomCapitalAPI()
        self._cache = cache
        self._merge = cache.register_script(MERGE_SCRIPT)
        self._logger = logger
        self._stop = threading.Event()
        self._ws = None
        self._opened = False
        self._authentication_rejected = False
        self._heartbeat_seconds = DEFAULT_HEARTBEAT_SECONDS
        self._connection_closed = threading.Event()
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except Exception as exception:
                self._logger.error(f"Order updates connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again and (self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS):
                    self.gave_up = True
                    self._logger.error("Order updates are still refused after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._logger.warning("Logging in to Wisdom Capital again.")
                    self._api = self._api_class()
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"Could not log in to Wisdom Capital again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"Order updates disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info("Order updates socket stopped.")

    def _interactive_session(self):
        """Log in to the interactive application for this connection and return its token and user id."""
        settings = self._api._settings or {}
        response = self._api.post(url=SESSION_URL, headers={"Content-Type": "application/json"},
                                  json={"appKey": settings.get('api_key'), "secretKey": settings.get('api_secret'),
                                        "source": "WEBAPI"})
        result = (response or {}).get('data') or {}
        if not result.get('token'):
            raise RuntimeError(f"the interactive login returned no token: {str(response)[:200]}")
        return result['token'], result.get('userID')

    def _connect(self):
        """Log in, open an Engine.IO session, attach the websocket and block until it closes."""
        import websocket

        token, user_id = self._interactive_session()
        query = f"token={token}&userID={user_id}&apiType=INTERACTIVE"

        response = pinned_get(f"{APPLICATION_PATH}/socket.io/?EIO=3&transport=polling&{query}")
        body = response.data.decode('utf-8', errors='replace')
        handshake = first_json_object(body) if response.status < 300 else None
        if not handshake or not handshake.get('sid'):
            self._authentication_rejected = any(marker in body.lower() for marker in AUTHENTICATION_MARKERS)
            raise RuntimeError(f"Engine.IO handshake failed with {response.status}: {body[:200]}")
        # The interactive namespace asks for a ping every 25 seconds but waits only 20, so half the shorter of the
        # two sits inside both.
        limits = [float(value) / 1000.0 for value in (handshake.get('pingInterval'), handshake.get('pingTimeout')) if value]
        self._heartbeat_seconds = max(1.0, min(limits) / 2.0) if limits else DEFAULT_HEARTBEAT_SECONDS

        url = f"wss://{HOST}{APPLICATION_PATH}/socket.io/?EIO=3&transport=websocket&sid={handshake['sid']}&{query}"
        self._connection_closed = threading.Event()
        self._ws = websocket.WebSocketApp(url, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        # websocket-client cannot pin a fingerprint, so the chain is verified, the hostname check relaxed, and the
        # pin checked on the live socket in _on_open.
        context = ssl.create_default_context()
        context.check_hostname = False
        self._ws.run_forever(sslopt={"context": context})

    def _on_open(self, ws):
        """Check the pinned certificate, then begin the Engine.IO upgrade."""
        try:
            fingerprint = hashlib.sha256(ws.sock.sock.getpeercert(True)).hexdigest().upper()
        except (AttributeError, TypeError):
            fingerprint = CERTIFICATE_FINGERPRINT
        if fingerprint != CERTIFICATE_FINGERPRINT:
            self._logger.error(f"{HOST} presented certificate {fingerprint}, which does not match the pin. "
                               f"If Wisdom Capital has renewed, refresh CERTIFICATE_FINGERPRINT.")
            ws.close()
            return
        self._opened = True
        ws.send("2probe")

    def _on_error(self, ws, error):
        self._logger.error(f"Order updates error: {error}")

    def _on_close(self, ws, status_code, message):
        self._connection_closed.set()
        self._logger.info(f"Order updates socket closed with status {status_code}: {message}")

    def _start_heartbeat(self, ws):
        """Send the Engine.IO ping on the interval the server asked for, until this connection closes."""
        closed, interval = self._connection_closed, self._heartbeat_seconds

        def beat():
            while not closed.wait(interval) and not self._stop.is_set():
                try:
                    ws.send("2")
                except Exception:
                    return

        threading.Thread(target=beat, name="wisdom_capital_order_updates_heartbeat", daemon=True).start()

    def _on_message(self, ws, message):
        """Handle Engine.IO control frames and merge the orders and positions each socket.io event carries."""
        if isinstance(message, (bytes, bytearray)):
            message = message.decode('utf-8', errors='replace')
        if message == "3probe":
            ws.send("5")                                  # complete the websocket upgrade
            self._start_heartbeat(ws)
            self._logger.info("Joined the interactive namespace. Waiting for order and position updates.")
            return
        if message == "2":
            ws.send("3")
            return
        if not isinstance(message, str) or not message.startswith("42"):
            return

        try:
            event = json.loads(message[2:])
        except json.JSONDecodeError:
            return
        if not isinstance(event, list) or not event:
            return
        name = str(event[0]).lower()
        payload = event[1] if len(event) > 1 else None
        if isinstance(payload, str):
            try:
                payload = json.loads(payload)
            except json.JSONDecodeError:
                pass
        entries = [entry for entry in (payload if isinstance(payload, list) else [payload]) if isinstance(entry, dict)]
        received_at = datetime.now()
        received, observed_at = received_at.strftime("%Y-%m-%d %H:%M:%S.%f"), received_at.timestamp()

        if "position" in name:
            merged, appended = [], []
            for entry in entries:
                field = position_field(entry)
                if field is None:
                    continue
                merged += [field, json.dumps({"observed_at": observed_at, "source": "websocket",
                                              "position": position_from_row(entry), "data": entry})]
                appended.append(json.dumps({'timestamp': received, 'data': entry}))
            if merged:
                self._write(POSITIONS_KEY, POSITION_STREAM_KEY, "position", observed_at, merged, appended)
                self._logger.info(f"Merged {len(appended)} position update(s) into {POSITIONS_KEY}: {', '.join(merged[0::2])}")
        elif "trade" in name:
            self._logger.debug("Trade event received; the matching order event carries the fill.")
        elif "order" in name or "interactive" in name:
            merged, appended = [], []
            for entry in entries:
                order = normalized_order(entry)
                if order is None:
                    continue
                merged += [order["order_id"], json.dumps({"observed_at": observed_at, "source": "websocket",
                                                          "order": order, "data": entry})]
                appended.append(json.dumps({'timestamp': received, 'data': entry}))
            if merged:
                self._write(ORDERS_KEY, ORDER_STREAM_KEY, "update", observed_at, merged, appended)
                self._logger.info(f"Merged {len(appended)} order update(s) into {ORDERS_KEY}: {', '.join(merged[0::2])}")
        else:
            self._logger.info(f"Event {event[0]!r}: {json.dumps(payload)[:200]}")

    def _write(self, hash_key, stream_key, field, observed_at, merged, appended):
        """
        Merge the latest state into a hash, then append every update, in arrival order, to its stream.

        - `hash_key` is the merged hash.
        - `stream_key` is the stream keeping every update.
        - `field` names the stream entry's field.
        - `observed_at` is when the event was received, as an epoch.
        - `merged` is the flat list of hash field and value pairs; two of one field in the same message are both sent,
          and the later one wins.
        - `appended` is each update's `{"timestamp", "data"}` JSON, in the shape the persisters read.
        """
        self._merge(keys=[hash_key], args=[next_reset(), "websocket", repr(observed_at)] + merged)
        pipeline = self._cache.pipeline(transaction=False)
        for update in appended:
            pipeline.xadd(stream_key, {field: update}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def main():
    """Stream Wisdom Capital order and position updates into Redis until stopped."""
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("wisdom_capital.order_updates")
    try:
        socket = OrderUpdatesSocket(get_cache(), logger)
    except Exception as exception:
        logger.error(f"Could not log in to Wisdom Capital: {type(exception).__name__}: {exception}")
        return 1

    # Installed before the thread starts: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing the connection.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the order updates feed.")
        socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    thread = threading.Thread(target=socket.run_forever, name="wisdom_capital_order_updates", daemon=True)
    logger.info("Starting the order updates feed.")
    thread.start()

    # Block in the main thread so the signal handlers above can run.
    while thread.is_alive():
        thread.join(timeout=1)

    if socket.gave_up:
        return 1
    logger.info("Order updates feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
