#!/usr/bin/env python3
"""
Fetch the Wisdom Capital user profile once a day and write it to the Redis key `wisdom_capital:user:details`.

    bin/wisdom_capital/user-profile
    redis-cli GET wisdom_capital:user:details

Calls `GET https://trade.wisdomcapital.in/interactive/user/profile` for the account in Wisdom Capital's
settings (`ucc_code`, sent as `clientID`) through `WisdomCapitalAPI`, which logs in first if the stored
session is dead. Each response - `timestamp`, `status`, `code` and XTS's profile under `data` - is written
as one JSON string with SET, replacing the one before.

Wisdom Capital allows only about one profile call a day, so a profile that was written is not asked for
again for a day. A failed call - a refusal for rate (HTTP 429 or an `e-apirl` code) or anything else - is
logged, leaves `wisdom_capital:user:details` holding the last profile that was served, and is retried after
an hour rather than a day, so a refusal in the morning does not leave the key empty until tomorrow.

Runs until Ctrl+C. A dead session (an XTS `e-session` or `e-token` code, or "Invalid Token") is logged in
again before the retry. Exits 1 when the first login, or a login after the session died, fails. Reads
only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

PROFILE_URL = "https://trade.wisdomcapital.in/interactive/user/profile"
REDIS_KEY = "wisdom_capital:user:details"
DELAY_SECONDS = 24 * 60 * 60
RETRY_SECONDS = 60 * 60
TIMEOUT_SECONDS = 10

# What XTS says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("e-session", "e-token", "invalid token")

def is_authentication_error(exception):
    """Whether XTS refused the request because the session is dead."""
    text = f"{getattr(exception, 'code', '')} {getattr(exception, 'message', '')} {exception}".lower()
    return any(marker in text for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the profile and write it to wisdom_capital:user:details once a day, until interrupted."""
    from stock_brokers.api.wisdom_capital import WisdomCapitalAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("wisdom_capital.user_profile")
    cache = get_cache()
    try:
        wisdom_capital = WisdomCapitalAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Wisdom Capital: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            delay = RETRY_SECONDS
            try:
                profile = wisdom_capital.get(url=PROFILE_URL, params={'clientID': wisdom_capital._settings.get('ucc_code', '')},
                                             timeout=TIMEOUT_SECONDS)
                cache.set(REDIS_KEY, json.dumps(profile))
                delay = DELAY_SECONDS
                logger.info(f"Wrote the profile to {REDIS_KEY}; next fetch in a day")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Wisdom Capital session expired, logging in again: {exception}")
                    wisdom_capital = WisdomCapitalAPI()
                else:
                    logger.error(f"Profile fetch failed, retrying in an hour: {type(exception).__name__}: {exception}")
            time.sleep(delay)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
