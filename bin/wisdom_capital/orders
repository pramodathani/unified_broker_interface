#!/usr/bin/env python3
"""
Poll the day's Wisdom Capital order book every half second and merge it into the Redis hash
`wisdom_capital:orders:orders`.

    bin/wisdom_capital/orders
    redis-cli HGETALL wisdom_capital:orders:orders
    redis-cli HGET wisdom_capital:orders:orders <AppOrderID>

Calls `GET https://trade.wisdomcapital.in/interactive/orders` for the account in Wisdom Capital's settings (`ucc_code`,
sent as `clientID`) through `WisdomCapitalAPI`, which logs in first if the stored session is dead.

**One key for orders.** `wisdom_capital:orders:orders` is a hash keyed by `AppOrderID`, written by two scripts: this
poller, and `bin/wisdom_capital/order_updates`, which merges each order event from the XTS interactive socket into the
same hash. Every value is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "order": <normalized order>, "data": <XTS's own order>}

XTS pushes the order-book object itself as its order event, so both writers build `order` with the same function, and
`data` is the order exactly as XTS sent it:

| field | from XTS |
| --- | --- |
| `order_id`, `exchange_order_id`, `parent_order_id` | `AppOrderID`, `ExchangeOrderID`, `OrderReferenceID` |
| `status`, `status_message` | `OrderStatus` on the shared vocabulary (`New` `OPEN`, `PartiallyFilled` `OPEN`, `Filled` `COMPLETE`, `PendingCancel` `CANCELLED`...), `CancelRejectReason` |
| `id`, `instrument_token`, `tradingsymbol`, `exchange` | `ExchangeSegment:TradingSymbol`, `ExchangeInstrumentID`, `TradingSymbol`, `ExchangeSegment` (`NSECM`, `NSEFO`...) |
| `transaction_type`, `product`, `order_type`, `validity` | `OrderSide`, `ProductType`, `OrderType`, `TimeInForce`, on the shared vocabulary |
| `quantity`, `filled_quantity`, `pending_quantity` | `OrderQuantity`, `CumulativeQuantity`, `LeavesQuantity` (or quantity less filled) |
| `cancelled_quantity`, `disclosed_quantity` | `CancelledQuantity`, `OrderDisclosedQuantity` |
| `price`, `trigger_price`, `average_price` | `OrderPrice`, `OrderStopPrice`, `OrderAverageTradedPrice` |
| `order_timestamp`, `exchange_timestamp` | `OrderGeneratedDateTime` (or `LastUpdateDateTime`), `ExchangeTransactTime`: day-first IST, ISO with the IST offset |
| `tag` | `OrderUniqueIdentifier` |

XTS sends many numbers as strings and some as `NaN`; blanks, `NA` and `NaN` read as null, as does its `01-01-1980`
placeholder time.

**Which write wins.** A websocket update always replaces its entry. A row from `bin/wisdom_capital/orders` replaces an entry
only when that entry was observed before the poll's request was sent, so an update that arrived while the request was
in flight is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and the
write run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00, so yesterday's orders
remain readable overnight and the first poll of the day starts a fresh hash. An order is never removed before then:
one the socket has just reported may not be in the order book yet. An empty book, `[]` or `null`, writes nothing.

Runs until Ctrl+C. A dead session (an XTS `e-session` or `e-token` code, or "Invalid Token") is logged in again before
the next request; any other failed poll, including a rate-limit refusal, is logged and leaves the hash unchanged.
Exits 1 when the first login, or a login after the session died, fails. Reads only - it never places, modifies or
cancels an order.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_URL = "https://trade.wisdomcapital.in/interactive/orders"
REDIS_KEY = "wisdom_capital:orders:orders"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "wisdom_capital:orders:orders:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
    "BUY": "BUY", "B": "BUY", "1": "BUY", "BUY ORDER": "BUY",
    "SELL": "SELL", "S": "SELL", "-1": "SELL", "2": "SELL", "SELL ORDER": "SELL",
}
PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}
ORDER_TYPES = {
    "MARKET": "MARKET", "MKT": "MARKET", "MKT ORDER": "MARKET", "2": "MARKET",
    "LIMIT": "LIMIT", "LMT": "LIMIT", "L": "LIMIT", "1": "LIMIT",
    "SL": "SL", "SL-LMT": "SL", "STOPLIMIT": "SL", "SL LIMIT": "SL", "4": "SL",
    "SL-M": "SL-M", "SL-MKT": "SL-M", "STOPMARKET": "SL-M", "SL MARKET": "SL-M", "3": "SL-M", "SL M": "SL-M",
    "SLM": "SL-M", "STOP LOSS": "SL", "STOP LOSS MARKET": "SL-M",
}
VALIDITIES = {
    "DAY": "DAY", "EOS": "DAY", "0": "DAY", "IOC": "IOC", "IMMEDIATE": "IOC", "1": "IOC",
    "GTT": "GTT", "GTC": "GTC", "GTD": "GTD",
}
STATUSES = {
    "PENDING": "PENDING", "TRANSIT": "PENDING", "VALIDATION PENDING": "PENDING", "PUT ORDER REQ RECEIVED": "PENDING",
    "TRIGGER PENDING": "PENDING", "AMO REQ RECEIVED": "PENDING", "PENDINGNEW": "PENDING", "O-PENDING": "PENDING",
    "OPEN": "OPEN", "OPEN PENDING": "OPEN", "NEW": "OPEN", "REPLACED": "OPEN", "ACKED": "OPEN", "APPROVED": "OPEN",
    "MODIFICATION REQUESTED": "OPEN", "MODIFIED": "OPEN", "MODIFY VALIDATION PENDING": "OPEN", "MODIFY PENDING": "OPEN",
    "PARTIALLY FILLED": "OPEN", "PARTIALLY EXECUTED": "OPEN", "PLACED": "OPEN", "PART TRADED": "OPEN",
    "PARTIALLYFILLED": "OPEN", "PENDINGREPLACE": "OPEN", "CONFIRMED": "OPEN",
    "COMPLETE": "COMPLETE", "COMPLETED": "COMPLETE", "TRADED": "COMPLETE", "FILLED": "COMPLETE",
    "EXECUTED": "COMPLETE", "FULLY EXECUTED": "COMPLETE", "DELIVERY AWAITED": "COMPLETE",
    "CANCELLED": "CANCELLED", "CANCELED": "CANCELLED", "CANCEL": "CANCELLED", "CANCEL PENDING": "CANCELLED",
    "CANCELLATION REQUESTED": "CANCELLED", "PENDINGCANCEL": "CANCELLED", "CANCELLED AFTER MARKET ORDER": "CANCELLED",
    "REJECTED": "REJECTED", "REJECT": "REJECTED", "FAILED": "REJECTED", "EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for XTS's blanks and its `NA` and `NaN` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA", "NaN", "nan") else value

def first(data, *names):
    """
    The first present value among several spellings of a field.

    - `data` is the XTS payload.
    - `names` are the candidate field names.
    """
    for name in names:
        if present(data.get(name)) is not None:
            return data[name]
    return None

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric. XTS sends many numbers as strings.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A present value as a string, or None."""
    value = present(value)
    return None if value is None else str(value)

# XTS writes times day first - `12-09-2026 09:20:11` - and in a few other shapes, sometimes with milliseconds after a
# colon or a dot, which are dropped.
XTS_TIME_FORMATS = ("%d-%m-%Y %H:%M:%S", "%d-%b-%Y %H:%M:%S", "%b %d %Y %H:%M:%S", "%d/%m/%Y %H:%M:%S",
                    "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S")

def xts_timestamp(value):
    """
    An XTS time, IST wall clock, as an ISO timestamp with the IST offset, or None.

    A placeholder for a time not yet set - `01-01-1980 00:00:00` and the like - reads as None.

    - `value` is the time as XTS sent it.
    """
    value = present(value)
    if value is None:
        return None
    raw = str(value).strip()
    candidates = [raw]
    head, separator, tail = raw.rpartition(":")
    if separator and tail.isdigit() and len(tail) == 3:
        candidates.append(head)                       # 12-09-2026 09:20:11:123
    candidates.append(raw.split(".")[0])              # 2026-09-12T09:20:11.123
    for candidate in candidates:
        for fmt in XTS_TIME_FORMATS:
            try:
                moment = datetime.strptime(candidate, fmt)
            except ValueError:
                continue
            return None if moment.year <= 1980 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def normalized_order(row):
    """
    An XTS order as a normalized order, or None when it has no `AppOrderID`.

    XTS's order-book row and its interactive socket's order event are the same object, so `bin/wisdom_capital/orders`
    and `bin/wisdom_capital/order_updates` both build `order` with this function.

    - `row` is one order-book row or one order event payload.
    """
    if not isinstance(row, dict) or text(row.get('AppOrderID')) is None:
        return None
    segment = text(row.get('ExchangeSegment'))
    symbol = text(first(row, 'TradingSymbol', 'TradingSymbolName'))
    quantity, filled = number(row.get('OrderQuantity'), int), number(row.get('CumulativeQuantity'), int)
    pending = number(row.get('LeavesQuantity'), int)
    if pending is None and quantity is not None and filled is not None:
        pending = quantity - filled
    return {
        "order_id": text(row.get('AppOrderID')),
        "exchange_order_id": text(row.get('ExchangeOrderID')),
        "parent_order_id": text(row.get('OrderReferenceID')),
        "status": normalize(present(row.get('OrderStatus')), STATUSES),
        "status_message": text(row.get('CancelRejectReason')),
        "id": f"{segment}:{symbol}" if segment and symbol else symbol,
        "instrument_token": text(row.get('ExchangeInstrumentID')),
        "tradingsymbol": symbol,
        "exchange": segment,
        "transaction_type": normalize(present(row.get('OrderSide')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('ProductType')), PRODUCTS),
        "order_type": normalize(present(row.get('OrderType')), ORDER_TYPES),
        "validity": normalize(present(row.get('TimeInForce')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": number(row.get('CancelledQuantity'), int),
        "disclosed_quantity": number(row.get('OrderDisclosedQuantity'), int),
        "price": number(row.get('OrderPrice')),
        "trigger_price": number(row.get('OrderStopPrice')),
        "average_price": number(row.get('OrderAverageTradedPrice')),
        "order_timestamp": xts_timestamp(first(row, 'OrderGeneratedDateTime', 'LastUpdateDateTime')),
        "exchange_timestamp": xts_timestamp(row.get('ExchangeTransactTime')),
        "tag": text(row.get('OrderUniqueIdentifier')),
    }

# What XTS says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("e-session", "e-token", "invalid token")

def is_authentication_error(exception):
    """Whether XTS refused the request because the session is dead."""
    text = f"{getattr(exception, 'code', '')} {getattr(exception, 'message', '')} {exception}".lower()
    return any(marker in text for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the order book and merge it into wisdom_capital:orders:orders every half second, until interrupted."""
    from stock_brokers.api.wisdom_capital import WisdomCapitalAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("wisdom_capital.orders")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        wisdom_capital = WisdomCapitalAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Wisdom Capital: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = wisdom_capital.get(url=ORDERS_URL, params={'clientID': wisdom_capital._settings.get('ucc_code', '')},
                                              timeout=TIMEOUT_SECONDS)
                rows = response.get('data') if isinstance(response.get('data'), list) else []
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    order = normalized_order(row)
                    if order is not None:
                        arguments += [order["order_id"], json.dumps({"observed_at": requested_at, "source": "rest",
                                                                     "order": order, "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} order(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Wisdom Capital session expired, logging in again: {exception}")
                    wisdom_capital = WisdomCapitalAPI()
                else:
                    report.error(f"Orders poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
