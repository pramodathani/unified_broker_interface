#!/usr/bin/env python3
"""
Download Wisdom Capital's instrument master, append today's snapshot to `wisdom_capital.instruments`, and store
it in Redis as `wisdom_capital:instruments:master` with `wisdom_capital:instruments:meta` beside it.

    bin/wisdom_capital/instruments/daily_feed
    bin/wisdom_capital/instruments/daily_feed --bootstrap        # replace today's stored snapshot in the table

    redis-cli HGET wisdom_capital:instruments:master NSECM:2885
    redis-cli GET wisdom_capital:instruments:meta

**The download** is Wisdom Capital's public XTS master, `POST https://trade.wisdomcapital.in/apimarketdata/instruments/master`,
one call per exchange segment (NSECM, NSEFO, NSECD, NSECO, BSECM, BSEFO, BSECD, MCXFO, NCDEX) - no login needed.
Each answers pipe separated text with no header, in three shapes (equities, options, futures) that carry
different columns, so `WisdomCapitalInstruments` parses each shape with its own column names and records it in
`data_category`. A segment the platform is not publishing that day answers empty and is skipped. Measured on
2026-09-14: about 183,000 rows. It is fetched once and used for both stores.

**The table** is written by `WisdomCapitalInstruments.ingest`: column names normalized to snake_case, whitespace
stripped, `NSETEST` placeholder rows dropped, duplicates on `(exchangesegment, exchangeinstrumentid)` dropped,
`download_date` added, and the rows appended to `wisdom_capital.instruments`. A date already stored is skipped
unless `--bootstrap` is given, and a row count more than ten percent off the earlier days' average is reported.

**Redis** gets the same cleaned rows, whether or not the table already had today's:

- `wisdom_capital:instruments:master`, a hash with one field per instrument, `EXCHANGESEGMENT:EXCHANGEINSTRUMENTID`
  as the platform spells them (`NSECM:2885`, `NSEFO:35001`, `MCXFO:447552`) - the table's own natural key. The
  value is the row as a JSON array in column order; the three shapes share one column list, so a column a
  shape does not carry is an empty string. The column names are stored once in the meta key rather than in
  every row, which keeps the hash near the size of the data itself - about 55 MB of values on 2026-09-14.
- `wisdom_capital:instruments:meta`, a JSON object: `download_date`, `rows`, `columns` (the order the arrays
  follow), `segments` (the rows per exchange segment) and `written_at`.

The hash is built under `wisdom_capital:instruments:master:staging` and swapped in at the end, so a reader sees
either yesterday's complete hash or today's, never one half-written; the previous hash is unlinked in the
background rather than freed inline.

Exits 0 when both the table and Redis were written (or the table already held today's snapshot), and 1 when
the download, the table write or the Redis write failed, saying which.
"""

import sys
import json
import argparse
from datetime import date, datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

MASTER_KEY = "wisdom_capital:instruments:master"
STAGING_KEY = "wisdom_capital:instruments:master:staging"
PREVIOUS_KEY = "wisdom_capital:instruments:master:previous"
META_KEY = "wisdom_capital:instruments:meta"

KEY_COLUMNS = ("exchangesegment", "exchangeinstrumentid")
FIELDS_PER_BATCH = 5000

def downloader():
    """
    A WisdomCapitalInstruments whose download happens once, so the table write and Redis share one fetch.
    """
    from stock_brokers.instruments.wisdom_capital import WisdomCapitalInstruments

    class OnceDownloadedWisdomCapitalInstruments(WisdomCapitalInstruments):
        """WisdomCapitalInstruments keeping the frame it downloaded, for the Redis write to reuse."""

        _frame = None

        def download(self):
            if self._frame is None:
                self._frame = super().download()
            return self._frame.copy()

    return OnceDownloadedWisdomCapitalInstruments()

def cleaned(ingester):
    """
    The downloaded rows cleaned exactly as `ingest` cleans them before the table write.

    - `ingester` is the WisdomCapitalInstruments that downloaded the file.
    """
    frame = ingester.download()
    for step in (ingester.normalize_columns, ingester.strip_whitespace, ingester.drop_unnamed_columns,
                 ingester.drop_garbage_rows, ingester.dedupe):
        frame = step(frame)
    return frame

def write_redis(cache, frame, download_date, logger):
    """
    Build the instrument hash under a staging key, then swap it and the meta in together.

    - `cache` is the Redis client.
    - `frame` is the cleaned instrument rows.
    - `download_date` is the snapshot's date.
    - `logger` is where progress is reported.
    """
    columns = list(frame.columns)
    key_positions = [columns.index(column) for column in KEY_COLUMNS]
    # A missing value arrives as NaN, which is not JSON; NaN is the one value unequal to itself.
    rows = [[None if value != value else value for value in row] for row in frame.itertuples(index=False, name=None)]

    cache.unlink(STAGING_KEY)
    for start in range(0, len(rows), FIELDS_PER_BATCH):
        batch = rows[start:start + FIELDS_PER_BATCH]
        cache.hset(STAGING_KEY, mapping={":".join(str(row[position]) for position in key_positions): json.dumps(row)
                                         for row in batch})
    stored = cache.hlen(STAGING_KEY)

    segments = {str(segment): int(count) for segment, count in frame["exchangesegment"].value_counts().items()}
    meta = {"download_date": str(download_date), "rows": stored, "columns": columns, "segments": segments,
            "written_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")}

    # Renaming onto an existing key frees the old value inline, which for a hash this size can stall Redis,
    # so the old hash is moved aside and unlinked, which frees it in the background.
    pipeline = cache.pipeline(transaction=True)
    if cache.exists(MASTER_KEY):
        pipeline.rename(MASTER_KEY, PREVIOUS_KEY)
    pipeline.rename(STAGING_KEY, MASTER_KEY)
    pipeline.set(META_KEY, json.dumps(meta))
    pipeline.unlink(PREVIOUS_KEY)
    pipeline.execute()

    if stored != len(rows):
        logger.warning(f"{len(rows)} row(s) produced {stored} field(s): some rows share an "
                       f"EXCHANGESEGMENT:EXCHANGEINSTRUMENTID.")
    logger.info(f"Wrote {stored} instrument(s) to {MASTER_KEY} and the meta to {META_KEY}.")

def main():
    """Download Wisdom Capital's instrument master into wisdom_capital.instruments and Redis."""
    parser = argparse.ArgumentParser(
        description="Download Wisdom Capital's instrument master into wisdom_capital.instruments and Redis.")
    parser.add_argument("--bootstrap", action="store_true",
                        help="replace today's stored snapshot in the table instead of skipping")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("wisdom_capital.daily_feed")
    download_date = date.today()
    ingester = downloader()

    try:
        frame = cleaned(ingester)
    except Exception as exception:
        logger.error(f"Could not download Wisdom Capital's instrument master: {type(exception).__name__}: {exception}")
        return 1
    logger.info(f"Downloaded {len(frame)} instrument(s) for {download_date}.")

    failures = []
    try:
        rows = ingester.ingest(download_date=download_date, bootstrap=arguments.bootstrap)
        if rows:
            ingester.check_row_count_deviation(download_date)
    except Exception as exception:
        failures.append("table")
        logger.error(f"Could not write wisdom_capital.instruments: {type(exception).__name__}: {exception}")

    try:
        write_redis(get_cache(), frame, download_date, logger)
    except Exception as exception:
        failures.append("Redis")
        logger.error(f"Could not write {MASTER_KEY}: {type(exception).__name__}: {exception}")

    if failures:
        logger.error(f"Failed: {' and '.join(failures)}.")
        return 1
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
