#!/usr/bin/env python3
"""
Stream Wisdom Capital market quotes over its XTS socket into the Redis hash `wisdom_capital:quotes:live`, and keep
streaming until stopped.

    bin/wisdom_capital/instruments/websocket_quotes                            # instruments from the Redis set wisdom_capital:quotes:subscriptions
    bin/wisdom_capital/instruments/websocket_quotes --tokens 1:2885,51:447552
    bin/wisdom_capital/instruments/websocket_quotes --per-socket 500

    redis-cli SADD wisdom_capital:quotes:subscriptions 1:2885 2:35001
    redis-cli HGET wisdom_capital:quotes:live "NSECM:RELIANCE-EQ"
    redis-cli HGETALL wisdom_capital:quotes:instruments

The XTS transport - pinned TLS, the Engine.IO handshake, socket.io framing and heartbeat, REST subscription and
quote decoding - and the market data login are `WisdomCapitalQuotesSocket` and `WisdomCapitalMarketDataSession`
in `stock_brokers/websockets/wisdom_capital.py`, whose module docstring describes them. This script chooses the
instruments, splits them across sockets, runs the sockets and writes the ticks they decode to Redis, so it needs
no other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set
`wisdom_capital:quotes:subscriptions`, each as `SEGMENT:EXCHANGEINSTRUMENTID` with XTS's segment number: 1 NSECM,
2 NSEFO, 3 NSECD, 4 NSECO, 11 BSECM, 12 BSEFO, 13 BSECD, 21 NCDEX, 51 MCXFO. Each is named `SEGMENT:DESCRIPTION`
(`NSECM:RELIANCE-EQ`) from the platform's public instrument master, downloaded at startup for the segments
subscribed. One socket carries up to `--per-socket` instruments, 1000 by default.

**The market data session.** XTS splits a broker into two applications. Quotes need the market data one, whose
token is minted from `price_api_key` and `price_api_secret` - the trading token is refused - and XTS issues
exactly one market data session per application key, a second login invalidating the first. Constructing
`WisdomCapitalAPI` establishes both sessions and stores the market data token and user id in `last_login` as
`market_data_access_token` and `market_data_user_id`, shared with `bin/wisdom_capital/instruments/price_history`.
A new one is minted only when none is stored or the one in use has been refused and nobody has replaced it,
under `wisdom_capital:session:marketdata:lock`. Each connection reads it afresh.

**Keys.**

- `wisdom_capital:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by its name, or by its
  `SEGMENT:EXCHANGEINSTRUMENTID` when the master does not name it. Touchline and depth updates for one
  instrument are merged before a tick is built. Not cleared at startup.
- `wisdom_capital:quotes:instruments`, a hash of every subscribed token to its name, or to an empty string when
  unnamed. Replaced whole at startup.
- `wisdom_capital:quotes:stream`, a Redis Stream with every tick written to the live hash, in arrival order, as a
  `tick` field, which `bin/wisdom_capital/instruments/store_quotes_to_db` writes to `wisdom_capital.ticks`. Capped at about
  1,000,000 entries, so ticks that arrive while the persister is down for long enough are trimmed before they
  are persisted.

A tick has the same fields as Dhan's: `id`, `broker`, `instrument_token`, `exchange` (the XTS segment name),
`mode` (`full` with a book, `quote` without), `last_price`, `last_quantity`, `average_price`, `volume`,
`buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`, `oi_day_high`, `oi_day_low`, `last_trade_time`,
`exchange_timestamp`, `depth` and `received_at`. XTS counts seconds from 1980 in IST; the times are shifted onto
the true Unix epoch.

**Sessions.** XTS reports instruments that are still subscribed from an earlier connection as `e-session-0002
Instrument Already Subscribed`, which carries the same prefix as a refused token although the request plainly
authenticated, so such an answer is met by dropping that subscription and asking again rather than by replacing
a perfectly good token. A socket whose handshake or subscription is then still refused for its token
(`e-session`, `e-token`, "Invalid Token"), or that fails to open six times running, replaces the market data
token - one process and one
socket at a time - before reconnecting. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket still cannot open after the token
was replaced, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import json
import signal
import argparse
import threading
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

INSTRUMENTS_MASTER_URL = "https://trade.wisdomcapital.in/apimarketdata/instruments/master"

LIVE_KEY = "wisdom_capital:quotes:live"
INSTRUMENTS_KEY = "wisdom_capital:quotes:instruments"
SUBSCRIPTIONS_KEY = "wisdom_capital:quotes:subscriptions"

# Every tick is also appended here for bin/wisdom_capital/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "wisdom_capital:quotes:stream"
STREAM_MAX_LENGTH = 1000000

# XTS segment numbers and the names its instrument master uses for them.
SEGMENT_NAMES = {1: "NSECM", 2: "NSEFO", 3: "NSECD", 4: "NSECO", 11: "BSECM", 12: "BSEFO", 13: "BSECD",
                 21: "NCDEX", 51: "MCXFO"}

DEFAULT_INSTRUMENTS_PER_SOCKET = 1000

class WisdomCapitalQuotesStore:
    """
    Where the quotes sockets' ticks are written: the live hash and the persistence stream.
    """

    def __init__(self, cache):
        """
        Keeps the Redis client the ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_ticks(self, ticks):
        """
        Writes ticks: the latest tick per instrument and every tick in arrival order, in one round trip.

        Args:
            ticks (list[dict]): The ticks, in arrival order.

        Returns:
            None: This method returns nothing.
        """
        encoded = []
        for tick in ticks:
            encoded.append((tick["id"], json.dumps(tick)))
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, mapping=dict(encoded))
        for _, payload in encoded:
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def resolve_tokens(tokens, cache, logger):
    """
    The valid `SEGMENT:EXCHANGEINSTRUMENTID` tokens to subscribe to: `--tokens` when given, otherwise the set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        segment, _, instrument_id = token.partition(':')
        if segment.isdigit() and int(segment) in SEGMENT_NAMES and instrument_id.isdigit():
            resolved.append(f"{int(segment)}:{int(instrument_id)}")
        else:
            logger.warning(f"Skipping {token}: expected SEGMENT:EXCHANGEINSTRUMENTID with SEGMENT one of "
                           f"{', '.join(f'{number} ({name})' for number, name in SEGMENT_NAMES.items())}.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from the platform's public instrument master, keyed by token.

    Only the segments subscribed are downloaded. A line is pipe separated with the segment name, the instrument id
    and the description in the first, second and fifth fields in every row shape. An unreachable master is
    reported and leaves instruments unnamed rather than stopping the feed.

    - `tokens` is the list of subscribed `SEGMENT:EXCHANGEINSTRUMENTID` tokens.
    - `logger` is where a failed download is reported.
    """
    from stock_brokers.instruments.wisdom_capital import build_session

    wanted = set(tokens)
    names = {}
    session = build_session()
    for number in sorted({int(token.split(':')[0]) for token in tokens}):
        segment = SEGMENT_NAMES[number]
        try:
            response = session.post(INSTRUMENTS_MASTER_URL, json={"exchangeSegmentList": [segment]}, timeout=120)
            response.raise_for_status()
            text = response.json().get("result") or ""
        except Exception as exception:
            logger.warning(f"Could not download the {segment} instrument master, so its instruments are keyed by token: {exception}")
            continue
        for line in text.splitlines():
            fields = [field.strip() for field in line.split("|")]
            if len(fields) > 4 and f"{number}:{fields[1]}" in wanted:
                names[f"{number}:{fields[1]}"] = f"{segment}:{fields[4]}"
    return names

def main():
    """Stream Wisdom Capital quotes into wisdom_capital:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Wisdom Capital market quotes into wisdom_capital:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated SEGMENT:EXCHANGEINSTRUMENTID tokens, for example 1:2885")
    parser.add_argument("--per-socket", type=int, default=DEFAULT_INSTRUMENTS_PER_SOCKET,
                        help=f"instruments per socket, default {DEFAULT_INSTRUMENTS_PER_SOCKET}")
    arguments = parser.parse_args()

    from stock_brokers.websockets.wisdom_capital import WisdomCapitalMarketDataSession, WisdomCapitalQuotesSocket
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("wisdom_capital.websocket_quotes")
    cache = get_cache()

    if arguments.per_socket < 1:
        logger.error("--per-socket must be at least 1.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add SEGMENT:EXCHANGEINSTRUMENTID members to the Redis "
                     f"set {SUBSCRIPTIONS_KEY}.")
        return 2

    try:
        session = WisdomCapitalMarketDataSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Wisdom Capital: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the instrument master and are keyed by token: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]
    store = WisdomCapitalQuotesStore(cache)
    sockets = []
    for index, batch in enumerate(batches):
        sockets.append(WisdomCapitalQuotesSocket(f"socket_{index}", batch, names, session, store.write_ticks, logger))

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"wisdom_capital_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} socket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
