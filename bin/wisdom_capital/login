#!/usr/bin/env python3
"""
Log in to the Wisdom Capital (Symphony XTS) API by constructing `WisdomCapitalAPI`, confirm the session
works, and record the outcome in the Redis key `wisdom_capital:session:status`.

    bin/wisdom_capital/login
    redis-cli GET wisdom_capital:session:status

`WisdomCapitalAPI()` probes `GET /interactive/user/balance` with the stored token and only opens a new
interactive session - posting the app key and secret to `/interactive/user/session` - when that probe is
refused for anything but a rate limit. A new token is written to MongoDB and to the Redis `last_login` hash,
where every other process picks it up. The balance is then asked once more, so a success means a session
that has actually been used, not just a constructor that returned.

The check uses the balance rather than `/user/profile` because Wisdom Capital allows only about one profile
call a day. A check refused for rate (HTTP 429 or an `e-apirl` code) still counts as a working session: XTS
rate limits only after the request has authenticated.

`wisdom_capital:session:status` holds one JSON object, replaced on every run:

    {"status": "success", "access-token": "<token>", "last_login": "2026-09-14 08:30:02"}
    {"status": "failure", "access-token": null, "last_login": "2026-09-14 08:30:02"}

On success `last_login` is when the token in force was issued, which is earlier than this run when the
stored session was still good. On failure it is when this attempt was made.

Exits 0 when the session works and 1 when the login, the check or the Redis write fails, so a systemd
unit can retry on failure. Logs in to a live broker account. Reads only - it places no orders.
"""

import sys
import json
from datetime import datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

BALANCE_URL = "https://trade.wisdomcapital.in/interactive/user/balance"
REDIS_KEY = "wisdom_capital:session:status"
TIMEOUT_SECONDS = 10

def is_rate_limited(exception):
    """Whether XTS refused the request for rate, which it does only after authenticating it."""
    return getattr(exception, 'code', None) in (429, "429") or "e-apirl" in str(exception).lower()

def main():
    """Construct WisdomCapitalAPI, which logs in when the stored session is dead, confirm it, and record the outcome."""
    from stock_brokers.api.wisdom_capital import WisdomCapitalAPI
    from utilities.configurations import get_cache

    try:
        wisdom_capital = WisdomCapitalAPI()
        try:
            wisdom_capital.get(url=BALANCE_URL, params={'clientID': wisdom_capital._settings.get('ucc_code', '')},
                               timeout=TIMEOUT_SECONDS)
        except Exception as exception:
            if not is_rate_limited(exception):
                raise
        login = wisdom_capital._last_login or {}
        record = {'status': 'success', 'access-token': login.get('access_token'), 'last_login': login.get('last_login')}
        print(f"wisdom_capital ok logged in at {record['last_login']}")
    except Exception as exception:
        record = {'status': 'failure', 'access-token': None, 'last_login': datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
        print(f"wisdom_capital FAILED {type(exception).__name__}: {exception}", file=sys.stderr)

    try:
        get_cache().set(REDIS_KEY, json.dumps(record))
    except Exception as exception:
        print(f"wisdom_capital could not write {REDIS_KEY}: {type(exception).__name__}: {exception}", file=sys.stderr)
        return 1

    return 0 if record['status'] == 'success' else 1

if __name__ == "__main__":
    raise SystemExit(main())
