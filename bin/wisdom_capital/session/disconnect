#!/usr/bin/env python3
"""
Mark Wisdom Capital as logged out in the Redis key `wisdom_capital:session:status`.

    bin/wisdom_capital/session/disconnect
    redis-cli GET wisdom_capital:session:status

Nothing is sent to Wisdom Capital. The script only replaces `wisdom_capital:session:status` with:

    {"status": "logged out", "access-token": null, "market-data-access-token": null, "last_login": null}

Symphony XTS, which Wisdom Capital runs on, does have a logout (`DELETE /interactive/user/session`), and it
is deliberately not called: it would end the session every other process - the feeds, the pollers, the REST
API - is using. The same goes for the market data application's logout. The stored tokens in the Redis
`last_login` hash and in MongoDB are left alone, and Wisdom Capital keeps accepting them until they expire.

Exits 0 when the key was written and 1 when it could not be, in which case `wisdom_capital:session:status`
is unchanged.
"""

import sys
import json
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

REDIS_KEY = "wisdom_capital:session:status"

def main():
    """Write the logged-out record to wisdom_capital:session:status."""
    from utilities.configurations import get_cache

    record = {'status': 'logged out', 'access-token': None, 'market-data-access-token': None, 'last_login': None}
    try:
        get_cache().set(REDIS_KEY, json.dumps(record))
    except Exception as exception:
        print(f"wisdom_capital could not write {REDIS_KEY}: {type(exception).__name__}: {exception}", file=sys.stderr)
        return 1

    print(f"wisdom_capital logged out in {REDIS_KEY}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
