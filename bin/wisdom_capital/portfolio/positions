#!/usr/bin/env python3
"""
Poll the Wisdom Capital positions every half second and merge them into the Redis hash
`wisdom_capital:portfolio:positions`.

    bin/wisdom_capital/portfolio/positions
    redis-cli HGETALL wisdom_capital:portfolio:positions
    redis-cli HGET wisdom_capital:portfolio:positions NET:NSEFO:35001:NRML

XTS refuses a positions request without `dayOrNet`, so each poll calls
`GET https://trade.wisdomcapital.in/interactive/portfolio/positions` twice for the account in Wisdom Capital's settings
(`ucc_code`, sent as `clientID`) - `dayOrNet=NetWise`, then `DayWise` - through `WisdomCapitalAPI`, which logs in
first if the stored session is dead.

**One key for positions.** `wisdom_capital:portfolio:positions` is a hash with one field per position in each view,
keyed `NET:ExchangeSegment:ExchangeInstrumentID:ProductType` or `DAY:...` - XTS holds one position per instrument and
product, reported once in each view. It is written by two scripts: this poller, and `bin/wisdom_capital/orders/websocket_order_details`,
which merges each position event from the XTS interactive socket into the same hash, taking the view from the event's
own `DayOrNet`. Every value is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "position": <normalized position>, "data": <XTS's own position>}

XTS's position rows and its socket's position events share its published position schema, so both writers build the
field and `position` with the same functions:

| field | from XTS |
| --- | --- |
| `id` | `ExchangeSegment:TradingSymbol` |
| `instrument_token`, `tradingsymbol`, `exchange` | `ExchangeInstrumentID` (or `ExchangeInstrumentId`), `TradingSymbol`, `ExchangeSegment` |
| `segment` | the product family at the end of `ExchangeSegment`: `CM` cash, `FO` derivatives, `CD` currency |
| `product` | `ProductType` on the shared vocabulary |
| `quantity`, `buy_quantity`, `sell_quantity` | `Quantity` (or `NetQuantity`, else buy less sell), `OpenBuyQuantity`, `OpenSellQuantity` |
| `buy_price`, `sell_price`, `buy_value`, `sell_value` | `BuyAveragePrice`, `SellAveragePrice`, `BuyAmount`, `SellAmount` |
| `realized_pnl`, `unrealized_pnl`, `pnl` | `RealizedMTM`, `UnrealizedMTM`, `MTM` |
| `multiplier`, `lot_size`, `updated_at` | `Multiplier`, `Marketlot` (or `LotSize`), `LastUpdateDateTime` as XTS wrote it |
| `day_or_net` | `NET` or `DAY`: the request's `NetWise` or `DayWise`, or the socket position's `DayOrNet` |

An XTS position carries no net average or last price, so `average_price` and `last_price` are null.

**Which write wins.** A websocket update always replaces its entry. A row from `bin/wisdom_capital/portfolio/positions` replaces an entry
only when that entry was observed before the poll's request was sent, so an update that arrived while the request was
in flight is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and the
write run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent. Both views of one poll share the observed-at of the first request.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00. A position XTS stops
listing during the day is not removed before then. A flat account writes nothing.

Runs until Ctrl+C. A dead session (an XTS `e-session` or `e-token` code, or "Invalid Token") is logged in again before
the next request; any other failed poll - including either view failing, or a rate-limit refusal - is logged and leaves
the hash unchanged. Exits 1 when the first login, or a login after the session died, fails. Reads only - it places no
orders.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

POSITIONS_URL = "https://trade.wisdomcapital.in/interactive/portfolio/positions"
BASES = ("NetWise", "DayWise")
REDIS_KEY = "wisdom_capital:portfolio:positions"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "wisdom_capital:portfolio:positions:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
    "BUY": "BUY", "B": "BUY", "1": "BUY", "BUY ORDER": "BUY",
    "SELL": "SELL", "S": "SELL", "-1": "SELL", "2": "SELL", "SELL ORDER": "SELL",
}
PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}
ORDER_TYPES = {
    "MARKET": "MARKET", "MKT": "MARKET", "MKT ORDER": "MARKET", "2": "MARKET",
    "LIMIT": "LIMIT", "LMT": "LIMIT", "L": "LIMIT", "1": "LIMIT",
    "SL": "SL", "SL-LMT": "SL", "STOPLIMIT": "SL", "SL LIMIT": "SL", "4": "SL",
    "SL-M": "SL-M", "SL-MKT": "SL-M", "STOPMARKET": "SL-M", "SL MARKET": "SL-M", "3": "SL-M", "SL M": "SL-M",
    "SLM": "SL-M", "STOP LOSS": "SL", "STOP LOSS MARKET": "SL-M",
}
VALIDITIES = {
    "DAY": "DAY", "EOS": "DAY", "0": "DAY", "IOC": "IOC", "IMMEDIATE": "IOC", "1": "IOC",
    "GTT": "GTT", "GTC": "GTC", "GTD": "GTD",
}
STATUSES = {
    "PENDING": "PENDING", "TRANSIT": "PENDING", "VALIDATION PENDING": "PENDING", "PUT ORDER REQ RECEIVED": "PENDING",
    "TRIGGER PENDING": "PENDING", "AMO REQ RECEIVED": "PENDING", "PENDINGNEW": "PENDING", "O-PENDING": "PENDING",
    "OPEN": "OPEN", "OPEN PENDING": "OPEN", "NEW": "OPEN", "REPLACED": "OPEN", "ACKED": "OPEN", "APPROVED": "OPEN",
    "MODIFICATION REQUESTED": "OPEN", "MODIFIED": "OPEN", "MODIFY VALIDATION PENDING": "OPEN", "MODIFY PENDING": "OPEN",
    "PARTIALLY FILLED": "OPEN", "PARTIALLY EXECUTED": "OPEN", "PLACED": "OPEN", "PART TRADED": "OPEN",
    "PARTIALLYFILLED": "OPEN", "PENDINGREPLACE": "OPEN", "CONFIRMED": "OPEN",
    "COMPLETE": "COMPLETE", "COMPLETED": "COMPLETE", "TRADED": "COMPLETE", "FILLED": "COMPLETE",
    "EXECUTED": "COMPLETE", "FULLY EXECUTED": "COMPLETE", "DELIVERY AWAITED": "COMPLETE",
    "CANCELLED": "CANCELLED", "CANCELED": "CANCELLED", "CANCEL": "CANCELLED", "CANCEL PENDING": "CANCELLED",
    "CANCELLATION REQUESTED": "CANCELLED", "PENDINGCANCEL": "CANCELLED", "CANCELLED AFTER MARKET ORDER": "CANCELLED",
    "REJECTED": "REJECTED", "REJECT": "REJECTED", "FAILED": "REJECTED", "EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for XTS's blanks and its `NA` and `NaN` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA", "NaN", "nan") else value

def first(data, *names):
    """
    The first present value among several spellings of a field.

    - `data` is the XTS payload.
    - `names` are the candidate field names.
    """
    for name in names:
        if present(data.get(name)) is not None:
            return data[name]
    return None

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric. XTS sends many numbers as strings.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A present value as a string, or None."""
    value = present(value)
    return None if value is None else str(value)

# XTS writes times day first - `12-09-2026 09:20:11` - and in a few other shapes, sometimes with milliseconds after a
# colon or a dot, which are dropped.
XTS_TIME_FORMATS = ("%d-%m-%Y %H:%M:%S", "%d-%b-%Y %H:%M:%S", "%b %d %Y %H:%M:%S", "%d/%m/%Y %H:%M:%S",
                    "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S")

def xts_timestamp(value):
    """
    An XTS time, IST wall clock, as an ISO timestamp with the IST offset, or None.

    A placeholder for a time not yet set - `01-01-1980 00:00:00` and the like - reads as None.

    - `value` is the time as XTS sent it.
    """
    value = present(value)
    if value is None:
        return None
    raw = str(value).strip()
    candidates = [raw]
    head, separator, tail = raw.rpartition(":")
    if separator and tail.isdigit() and len(tail) == 3:
        candidates.append(head)                       # 12-09-2026 09:20:11:123
    candidates.append(raw.split(".")[0])              # 2026-09-12T09:20:11.123
    for candidate in candidates:
        for fmt in XTS_TIME_FORMATS:
            try:
                moment = datetime.strptime(candidate, fmt)
            except ValueError:
                continue
            return None if moment.year <= 1980 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def day_or_net(value):
    """
    `NET` or `DAY` for XTS's basis spelling - the positions request's `NetWise` or `DayWise`, or a position's own
    `DayOrNet` - or None when it names neither.

    - `value` is the basis as XTS spells it.
    """
    value = (text(value) or "").strip().upper()
    return "DAY" if value.startswith("DAY") else "NET" if value.startswith("NET") else None

def position_field(row, basis=None):
    """
    The hash field for an XTS position, `DAY_OR_NET:ExchangeSegment:ExchangeInstrumentID:ProductType`, or None when
    it lacks one of them.

    The basis comes from the positions request for a polled row and from the position's own `DayOrNet` for a socket
    event, so the same position gets the same field from both writers. A socket position with no `DayOrNet` is taken
    as `NET`, XTS's default view.

    - `row` is one position row or one position event payload.
    - `basis` is the request's `NetWise` or `DayWise`, or None to read the position's own.
    """
    if not isinstance(row, dict):
        return None
    view = day_or_net(basis if basis is not None else first(row, 'DayOrNet', 'IsDayWiseNetWise')) or "NET"
    parts = [text(row.get('ExchangeSegment')), text(first(row, 'ExchangeInstrumentID', 'ExchangeInstrumentId')),
             (text(row.get('ProductType')) or "").upper() or None]
    return ":".join([view] + parts) if all(parts) else None

def position_from_row(row, basis=None):
    """
    An XTS position as a normalized position, following XTS's published position schema.

    - `row` is one position row or one position event payload.
    - `basis` is the request's `NetWise` or `DayWise`, or None to read the position's own.
    """
    segment = text(row.get('ExchangeSegment'))
    instrument = text(first(row, 'ExchangeInstrumentID', 'ExchangeInstrumentId'))
    symbol = text(first(row, 'TradingSymbol', 'TradingSymbolName', 'Symbol'))
    buy_quantity, sell_quantity = number(row.get('OpenBuyQuantity'), int), number(row.get('OpenSellQuantity'), int)
    quantity = number(first(row, 'Quantity', 'NetQuantity'), int)
    if quantity is None and buy_quantity is not None and sell_quantity is not None:
        quantity = buy_quantity - sell_quantity
    return {
        "id": f"{segment}:{symbol}" if segment and symbol else symbol or (f"{segment}:{instrument}" if segment else instrument),
        "instrument_token": instrument,
        "tradingsymbol": symbol,
        "exchange": segment,
        "segment": segment[-2:] if segment and segment[-2:] in ("CM", "FO", "CD") else None,
        "product": normalize(present(row.get('ProductType')), PRODUCTS),
        "quantity": quantity,
        "buy_quantity": buy_quantity,
        "sell_quantity": sell_quantity,
        "buy_price": number(row.get('BuyAveragePrice')),
        "sell_price": number(row.get('SellAveragePrice')),
        "buy_value": number(row.get('BuyAmount')),
        "sell_value": number(row.get('SellAmount')),
        "average_price": None,
        "last_price": None,
        "realized_pnl": number(row.get('RealizedMTM')),
        "unrealized_pnl": number(row.get('UnrealizedMTM')),
        "pnl": number(row.get('MTM')),
        "multiplier": number(row.get('Multiplier')),
        "lot_size": number(first(row, 'Marketlot', 'LotSize'), int),
        "day_or_net": day_or_net(basis if basis is not None else first(row, 'DayOrNet', 'IsDayWiseNetWise')) or "NET",
        "updated_at": text(row.get('LastUpdateDateTime')),
    }

# What XTS says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("e-session", "e-token", "invalid token")

def is_authentication_error(exception):
    """Whether XTS refused the request because the session is dead."""
    text = f"{getattr(exception, 'code', '')} {getattr(exception, 'message', '')} {exception}".lower()
    return any(marker in text for marker in AUTHENTICATION_MARKERS)

def fetch_positions(wisdom_capital):
    """Each view's position rows, as `(basis, rows)` pairs."""
    views = []
    for basis in BASES:
        response = wisdom_capital.get(url=POSITIONS_URL, timeout=TIMEOUT_SECONDS,
                                      params={'dayOrNet': basis, 'clientID': wisdom_capital._settings.get('ucc_code', '')})
        data = response.get('data')
        if not isinstance(data, dict) or not isinstance(data.get('positionList', []), list):
            raise RuntimeError(f"XTS answered the {basis} positions request without positions: {str(data)[:200]}")
        views.append((basis, data.get('positionList') or []))
    return views

def main():
    """Fetch the positions and merge them into wisdom_capital:portfolio:positions every half second, until interrupted."""
    from stock_brokers.api.wisdom_capital import WisdomCapitalAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("wisdom_capital.positions")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        wisdom_capital = WisdomCapitalAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Wisdom Capital: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                views = fetch_positions(wisdom_capital)
                arguments = [next_reset(), "rest", repr(requested_at)]
                for basis, rows in views:
                    for row in rows:
                        field = position_field(row, basis)
                        if field is not None:
                            arguments += [field, json.dumps({"observed_at": requested_at, "source": "rest",
                                                             "position": position_from_row(row, basis), "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {sum(len(rows) for _, rows in views)} position(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Wisdom Capital session expired, logging in again: {exception}")
                    wisdom_capital = WisdomCapitalAPI()
                else:
                    report.error(f"Positions poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
