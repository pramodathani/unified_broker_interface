#!/usr/bin/env python3
"""
Poll the Wisdom Capital holdings every minute and write them to the Redis key
`wisdom_capital:portfolio:holdings`.

    bin/wisdom_capital/holdings
    redis-cli GET wisdom_capital:portfolio:holdings

Calls `GET https://trade.wisdomcapital.in/interactive/portfolio/holdings` for the account in Wisdom
Capital's settings (`ucc_code`, sent as `clientID`) through `WisdomCapitalAPI`, which logs in first if the
stored session is dead. Each response - `timestamp`, `status`, `code` and XTS's holdings under `data` - is
written as one JSON string with SET, replacing the one before. XTS does not send a list: the holdings are
`data.RMSHoldings.Holdings`, an object keyed by ISIN, each entry with `ExchangeNSEInstrumentId` and
`ExchangeBSEInstrumentId` (zero where not listed), `HoldingQuantity`, `BuyAvgPrice` and
`CollateralQuantity` or `PledgeQuantity`, and no price. An account holding nothing has an empty object
there.

Runs until Ctrl+C. A dead session (an XTS `e-session` or `e-token` code, or "Invalid Token") is logged in
again before the next request; any other failed poll, including a rate-limit refusal, is logged and leaves
`wisdom_capital:portfolio:holdings` unchanged. Exits 1 when the first login, or a login after the session
died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

HOLDINGS_URL = "https://trade.wisdomcapital.in/interactive/portfolio/holdings"
REDIS_KEY = "wisdom_capital:portfolio:holdings"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10

# What XTS says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("e-session", "e-token", "invalid token")

def is_authentication_error(exception):
    """Whether XTS refused the request because the session is dead."""
    text = f"{getattr(exception, 'code', '')} {getattr(exception, 'message', '')} {exception}".lower()
    return any(marker in text for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the holdings and write them to wisdom_capital:portfolio:holdings every minute, until interrupted."""
    from stock_brokers.api.wisdom_capital import WisdomCapitalAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("wisdom_capital.holdings")
    cache = get_cache()
    try:
        wisdom_capital = WisdomCapitalAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Wisdom Capital: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                holdings = wisdom_capital.get(url=HOLDINGS_URL, params={'clientID': wisdom_capital._settings.get('ucc_code', '')},
                                              timeout=TIMEOUT_SECONDS)
                cache.set(REDIS_KEY, json.dumps(holdings))
                data = holdings.get('data') if isinstance(holdings.get('data'), dict) else {}
                rows = (data.get('RMSHoldings') or {}).get('Holdings') or {}
                logger.info(f"Wrote {len(rows) if isinstance(rows, dict) else 0} holdings to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Wisdom Capital session expired, logging in again: {exception}")
                    wisdom_capital = WisdomCapitalAPI()
                else:
                    logger.error(f"Holdings poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
