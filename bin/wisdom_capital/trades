#!/usr/bin/env python3
"""
Poll the day's Wisdom Capital trade book every half second and write it to the Redis key
`wisdom_capital:orders:trades`.

    bin/wisdom_capital/trades
    redis-cli GET wisdom_capital:orders:trades

Calls `GET https://trade.wisdomcapital.in/interactive/orders/trades` for the account in Wisdom Capital's
settings (`ucc_code`, sent as `clientID`) through `WisdomCapitalAPI`, which logs in first if the stored
session is dead. Each response - `timestamp`, `status`, `code` and XTS's trade list under `data`, one row per
fill with `ExecutionID`, `AppOrderID`, `ExchangeOrderID`, `TradingSymbol`, `ExchangeInstrumentID`,
`ExchangeSegment`, `OrderSide`, `ProductType`, `LastTradedQuantity`, `LastTradedPrice` and
`LastExecutionTransactTime` - is written as one JSON string with SET, replacing the one before. An empty
book is `[]`; a `null` is written as `[]` too.

Runs until Ctrl+C. A dead session (an XTS `e-session` or `e-token` code, or "Invalid Token") is logged in
again before the next request; any other failed poll, including a rate-limit refusal, is logged and leaves
`wisdom_capital:orders:trades` unchanged. Exits 1 when the first login, or a login after the session died,
fails. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

TRADES_URL = "https://trade.wisdomcapital.in/interactive/orders/trades"
REDIS_KEY = "wisdom_capital:orders:trades"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

# What XTS says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("e-session", "e-token", "invalid token")

def is_authentication_error(exception):
    """Whether XTS refused the request because the session is dead."""
    text = f"{getattr(exception, 'code', '')} {getattr(exception, 'message', '')} {exception}".lower()
    return any(marker in text for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the trade book and write it to wisdom_capital:orders:trades every half second, until interrupted."""
    from stock_brokers.api.wisdom_capital import WisdomCapitalAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("wisdom_capital.trades")
    report = PollReporter(logger)
    cache = get_cache()
    try:
        wisdom_capital = WisdomCapitalAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Wisdom Capital: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                trades = wisdom_capital.get(url=TRADES_URL, params={'clientID': wisdom_capital._settings.get('ucc_code', '')},
                                            timeout=TIMEOUT_SECONDS)
                if trades.get('data') is None:
                    trades['data'] = []
                cache.set(REDIS_KEY, json.dumps(trades))
                data = trades['data']
                report.info(f"Wrote {len(data) if isinstance(data, list) else 0} trades to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Wisdom Capital session expired, logging in again: {exception}")
                    wisdom_capital = WisdomCapitalAPI()
                else:
                    report.error(f"Trades poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
