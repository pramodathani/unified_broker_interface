def message_classes():
    """The `OrderDetailsBroadCastDto` and `PositionDetailProto` message classes, built from the embedded descriptors."""
    from google.protobuf import descriptor_pb2, descriptor_pool, message_factory

    pool = descriptor_pool.DescriptorPool()
    for serialized in (ORDERS_DESCRIPTOR, POSITIONS_DESCRIPTOR):
        pool.Add(descriptor_pb2.FileDescriptorProto.FromString(base64.b64decode("".join(serialized))))
    return (message_factory.GetMessageClass(pool.FindMessageTypeByName("OrderDetailsBroadCastDto")),
            message_factory.GetMessageClass(pool.FindMessageTypeByName("groww.protobuf.fno.dto.fnoData.PositionDetailProto")))

def as_dict(message):
    """
    A protobuf message as a JSON-ready dict: Groww's field names, enums by name, every field present.

    - `message` is the decoded message.
    """
    from google.protobuf import json_format

    return json_format.MessageToDict(message, preserving_proto_field_name=True, always_print_fields_with_no_presence=True)

# ---- NATS NKEY keys and signing ---------------------------------------------------------------------------------

NKEY_PREFIX_USER = 20 << 3

def crc16(data):
    """
    CRC-16/XMODEM, as NATS computes it over NKEY material.

    - `data` is the bytes to checksum.
    """
    crc = 0
    for byte in data:
        crc ^= byte << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc

class NkeyPair:
    """
    An ed25519 key pair in NATS NKEY form: the public key as a user NKEY, and nonce signing.
    """

    def __init__(self):
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
        from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

        self._private_key = Ed25519PrivateKey.generate()
        raw_public = self._private_key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
        body = bytes([NKEY_PREFIX_USER]) + raw_public
        self.public_key = base64.b32encode(body + crc16(body).to_bytes(2, "little")).rstrip(b"=").decode()

    def signed_nonce(self, nonce):
        """
        A server nonce signed with the private key, base64url encoded without padding, as NATS expects.

        - `nonce` is the nonce from the INFO frame.
        """
        signature = self._private_key.sign(nonce.encode() if isinstance(nonce, str) else nonce)
        return base64.urlsafe_b64encode(signature).rstrip(b"=").decode()

class SocketRefused(Exception):
    """Groww refused the socket token request for the session."""

# ---- the connection ---------------------------------------------------------------------------------------------

class OrderUpdatesSocket:
    """
    Groww's order and position update stream, reconnecting and logging in again until stopped.
    """

    def __init__(self, cache, logger):
        """
        Construct GrowwAPI, which logs in when the stored session is dead.

        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        from stock_brokers.api.groww import GrowwAPI

        self._api_class = GrowwAPI
        self._groww = GrowwAPI()
        self._cache = cache
        self._merge = cache.register_script(MERGE_SCRIPT)
        self._logger = logger
        self._order_class, self._position_class = message_classes()
        self._stop = threading.Event()
        self._ws = None
        self._key_pair = None
        self._socket_jwt = None
        self._subscription_id = None
        self._buffer = b""
        self._opened = False
        self._authentication_rejected = False
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except SocketRefused as exception:
                self._authentication_rejected = True
                self._logger.error(f"Socket token refused: {exception}")
            except Exception as exception:
                self._logger.error(f"Order updates connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again and (self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS):
                    self.gave_up = True
                    self._logger.error("Order updates are still refused after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._logger.warning("Logging in to Groww again.")
                    self._groww = self._api_class()
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"Could not log in to Groww again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"Order updates disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info("Order updates socket stopped.")

    def _socket_token(self):
        """
        A socket JWT bound to a fresh key pair, and the subscription id issued with it.

        Raises SocketRefused for HTTP 401 or 403, which means the access token is dead.
        """
        import requests

        self._key_pair = NkeyPair()
        access_token = (self._groww._current_login() or {}).get('access_token')
        headers = {"x-request-id": str(uuid.uuid4()), "Authorization": f"Bearer {access_token}",
                   "Content-Type": "application/json", "x-client-id": "growwapi",
                   "x-client-platform": "growwapi-python-client"}
        response = requests.post(SOCKET_TOKEN_URL, headers=headers, json={"socketKey": self._key_pair.public_key}, timeout=30)
        if response.status_code in (401, 403):
            raise SocketRefused(f"HTTP {response.status_code}: {response.text[:200]}")
        response.raise_for_status()
        payload = response.json()
        payload = payload.get('payload', payload)
        if not payload.get('token') or not payload.get('subscriptionId'):
            raise RuntimeError(f"No token or subscription id in the Groww socket token response: {str(payload)[:200]}")
        self._socket_jwt, self._subscription_id = payload['token'], payload['subscriptionId']

    def _connect(self):
        """Obtain a socket JWT, open the websocket, and block until it closes."""
        import websocket

        self._socket_token()
        self._buffer = b""
        self._ws = websocket.WebSocketApp(FEED_URL, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=PING_INTERVAL_SECONDS, ping_timeout=PING_TIMEOUT_SECONDS)

    def _on_open(self, ws):
        self._opened = True
        self._logger.info("Order updates socket opened. Waiting for the NATS INFO frame.")

    def _on_error(self, ws, error):
        self._logger.error(f"Order updates error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"Order updates socket closed with status {status_code}: {message}")

    def _send(self, lines):
        for line in lines if isinstance(lines, (list, tuple)) else [lines]:
            self._ws.send(line)

    def order_subjects(self):
        """The subjects carrying this account's equity and derivatives orders."""
        return [f"{EQUITY_ORDERS}{self._subscription_id}", f"{DERIVATIVES_ORDERS}{self._subscription_id}"]

    def position_subjects(self):
        """The subject carrying this account's derivatives positions."""
        return [f"{DERIVATIVES_POSITIONS}{self._subscription_id}"]

    def _on_message(self, ws, message):
        """Consume a frame as NATS, merge the orders and positions it completed into the hashes, and append them to the streams."""
        received_at, orders, positions = self.parse(message)
        if not orders and not positions:
            return
        received = datetime.fromtimestamp(received_at).strftime("%Y-%m-%d %H:%M:%S.%f")
        # The hashes keep each order's and position's latest state; the streams keep every update, even two of one order
        # in the same frame, in the shape bin/groww/persist_orders and bin/groww/persist_positions read.
        for hash_key, name, entries in ((ORDERS_KEY, "order", orders), (POSITIONS_KEY, "position", positions)):
            if entries:
                values = []
                for field, normalized, data in entries:
                    values += [field, json.dumps({"observed_at": received_at, "source": "websocket", name: normalized,
                                                  "data": data})]
                self._merge(keys=[hash_key], args=[next_reset(), "websocket", repr(received_at)] + values)
        pipeline = self._cache.pipeline(transaction=False)
        for stream_key, field, entries in ((ORDER_STREAM_KEY, "update", orders), (POSITION_STREAM_KEY, "position", positions)):
            for _, _, data in entries:
                pipeline.xadd(stream_key, {field: json.dumps({'timestamp': received, 'data': data})},
                              maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()
        if orders:
            self._logger.info(f"Merged {len(orders)} order update(s) into {ORDERS_KEY}: {', '.join(entry[0] for entry in orders)}")
        if positions:
            self._logger.info(f"Merged {len(positions)} position update(s) into {POSITIONS_KEY}: "
                              f"{', '.join(entry[0] for entry in positions)}")

    def parse(self, message):
        """
        The epoch the frame was received, and the order and position entries it completed, each a list of
        `(hash field, normalized, decoded message)` in arrival order.

        - `message` is the frame received.
        """
        received_at = datetime.now().timestamp()
        position_subjects = set(self.position_subjects())
        order_subjects = set(self.order_subjects())
        orders, positions = [], []
        for subject, payload in self.consume_nats(message):
            try:
                if subject in order_subjects:
                    broadcast = self._order_class.FromString(payload)
                    if broadcast.HasField('orderDetailUpdateDto') and broadcast.orderDetailUpdateDto.growwOrderId:
                        data = as_dict(broadcast)
                        order = order_from_update(data, received_at)
                        if order is not None:
                            orders.append((order["order_id"], order, data))
                elif subject in position_subjects:
                    detail = self._position_class.FromString(payload)
                    if detail.HasField('symbolData'):
                        data = as_dict(detail)
                        symbol = data['symbolData']
                        field = position_field(symbol.get('exchange'), symbol.get('contractId') or symbol.get('displayName'),
                                               symbol.get('stocksProduct'))
                        position = position_from_update(data)
                        if field is not None and position is not None:
                            positions.append((field, position, data))
                else:
                    self._logger.info(f"Ignoring a message on an unexpected subject {subject}.")
            except Exception as exception:
                self._logger.warning(f"Could not decode a payload on {subject}: {type(exception).__name__}: {exception}")
        return received_at, orders, positions

    def consume_nats(self, message):
        """
        Feed a frame through the NATS protocol and return the `(subject, payload)` messages it completed.

        NATS is line based: control lines end with CRLF, and a `MSG` line is followed by a payload of the declared
        length. A frame may split or join those, so the stream is buffered and only whole messages come back.

        - `message` is the frame received.
        """
        if isinstance(message, str):
            message = message.encode()
        self._buffer += bytes(message)
        delivered = []
        while True:
            end = self._buffer.find(b"\r\n")
            if end == -1:
                break
            line, rest = self._buffer[:end], self._buffer[end + 2:]
            if line.startswith(b"MSG "):
                parts = line.decode('utf-8', errors='replace').split()
                if len(parts) < 4:
                    self._buffer = rest
                    continue
                length = int(parts[-1])
                if len(rest) < length + 2:
                    break                                   # the payload has not fully arrived yet
                delivered.append((parts[1], rest[:length]))
                self._buffer = rest[length + 2:]
                continue

            self._buffer = rest
            if line.startswith(b"INFO "):
                info = json.loads(line[5:].decode('utf-8'))
                connect = {"jwt": self._socket_jwt, "sig": self._key_pair.signed_nonce(info.get('nonce', '')),
                           "verbose": False, "pedantic": False, "tls_required": False, "lang": "python",
                           "version": "1.0.0", "protocol": 1, "headers": bool(info.get('headers', False)),
                           "no_responders": False}
                subjects = self.order_subjects() + self.position_subjects()
                self._send([f"CONNECT {json.dumps(connect)}\r\n", "PING\r\n"]
                           + [f"SUB {subject} {index}\r\n" for index, subject in enumerate(subjects, start=1)])
                self._logger.info(f"Authenticated and subscribed to {len(subjects)} subject(s). Waiting for updates.")
            elif line == b"PING":
                self._send("PONG\r\n")
            elif line.startswith(b"-ERR"):
                error = line.decode('utf-8', errors='replace')
                self._logger.error(f"NATS error: {error}")
                if any(marker in error.lower() for marker in AUTHENTICATION_ERRORS):
                    self._authentication_rejected = True
                    self._ws.close()
        return delivered

def main():
    """Stream Groww order and position updates into Redis until stopped."""
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("groww.order_updates")
    try:
        socket = OrderUpdatesSocket(get_cache(), logger)
    except Exception as exception:
        logger.error(f"Could not log in to Groww: {type(exception).__name__}: {exception}")
        return 1

    # Installed before the thread starts: systemd stops a unit with SIGTERM, and the default action would kill the
    # process without closing the connection.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the order updates feed.")
        socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    thread = threading.Thread(target=socket.run_forever, name="groww_order_updates", daemon=True)
    logger.info("Starting the order updates feed.")
    thread.start()

    # Block in the main thread so the signal handlers above can run.
    while thread.is_alive():
        thread.join(timeout=1)

    if socket.gave_up:
        return 1
    logger.info("Order updates feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
