#!/usr/bin/env python3
"""
Log in to the Groww API by constructing `GrowwAPI`, confirm the session works, and record the outcome in
the Redis key `groww:session:status`.

    bin/groww/session/connect
    redis-cli GET groww:session:status

`GrowwAPI()` probes `GET /v1/user/detail` with the stored token and only generates a new access token -
from the TOTP token and a TOTP, through `POST /v1/token/api/access` - when that probe fails. A new token is
written to MongoDB and to the Redis `last_login` hash, where every other process picks it up. The user
detail is then fetched once more, so a success means a session that has actually been used, not just a
constructor that returned.

`groww:session:status` holds one JSON object, replaced on every run:

    {"status": "success", "access-token": "<token>", "last_login": "2026-09-14 08:30:02.123456"}
    {"status": "failure", "access-token": null, "last_login": "2026-09-14 08:30:02.123456"}

On success `last_login` is when the token in force was issued, which is earlier than this run when the
stored session was still good. On failure it is when this attempt was made.

Exits 0 when the session works and 1 when the login, the check or the Redis write fails, so a systemd
unit can retry on failure. Logs in to a live broker account. Reads only - it places no orders.
"""

import sys
import json
from datetime import datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

USER_DETAIL_URL = "https://api.groww.in/v1/user/detail"
REDIS_KEY = "groww:session:status"
TIMEOUT_SECONDS = 10

def main():
    """Construct GrowwAPI, which logs in when the stored session is dead, confirm it, and record the outcome."""
    from stock_brokers.api.groww import GrowwAPI
    from utilities.configurations import get_cache

    try:
        groww = GrowwAPI()
        if not isinstance((groww.get(url=USER_DETAIL_URL, timeout=TIMEOUT_SECONDS) or {}).get('data'), dict):
            raise RuntimeError("Groww answered the user detail request without user details")
        login = groww._last_login or {}
        record = {'status': 'success', 'access-token': login.get('access_token'), 'last_login': login.get('last_login')}
        print(f"groww ok logged in at {record['last_login']}")
    except Exception as exception:
        record = {'status': 'failure', 'access-token': None, 'last_login': datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")}
        print(f"groww FAILED {type(exception).__name__}: {exception}", file=sys.stderr)

    try:
        get_cache().set(REDIS_KEY, json.dumps(record))
    except Exception as exception:
        print(f"groww could not write {REDIS_KEY}: {type(exception).__name__}: {exception}", file=sys.stderr)
        return 1

    return 0 if record['status'] == 'success' else 1

if __name__ == "__main__":
    raise SystemExit(main())
