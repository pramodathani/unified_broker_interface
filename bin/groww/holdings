#!/usr/bin/env python3
"""
Poll the Groww holdings every minute and write them to the Redis key `groww:portfolio:holdings`.

    bin/groww/holdings
    redis-cli GET groww:portfolio:holdings

Calls `GET https://api.groww.in/v1/holdings/user` through `GrowwAPI`, which logs in first if the stored
session is dead. Each response - `timestamp`, `status`, `code` and Groww's holdings under `data` (the API
client unwraps Groww's `payload`), an object whose `holdings` holds one row per holding with `isin`,
`trading_symbol`, `tradable_exchanges`, `quantity`, `demat_free_quantity`, `t1_quantity`,
`pledge_quantity` and `average_price`, and no token or price - is written as one JSON string with SET,
replacing the one before.

Runs until Ctrl+C. A dead session (HTTP 401, or a refusal naming authentication or an expired or invalid
token) is logged in again before the next request; Groww's 403, an endpoint the account is not entitled
to, and 429, a rate limit, are not taken for one. Any other failed poll is logged and leaves
`groww:portfolio:holdings` unchanged. Exits 1 when the first login, or a login after the session died,
fails. Reads only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

HOLDINGS_URL = "https://api.groww.in/v1/holdings/user"
REDIS_KEY = "groww:portfolio:holdings"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10

# What Groww says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("unauthori", "authentication", "token expired", "invalid token", "expired token", "jwt")

def is_authentication_error(exception):
    """Whether Groww refused the request because the session is dead, rather than for entitlement or rate."""
    status = str(getattr(exception, 'code', '') or '').strip()
    lowered = str(exception).lower()
    if status in ('403', '429') or 'access forbidden' in lowered:
        return False
    return status == '401' or any(marker in lowered for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the holdings and write them to groww:portfolio:holdings every minute, until interrupted."""
    from stock_brokers.api.groww import GrowwAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("groww.holdings")
    cache = get_cache()
    try:
        groww = GrowwAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Groww: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                holdings = groww.get(url=HOLDINGS_URL, timeout=TIMEOUT_SECONDS) or {}
                data = holdings.get('data')
                if not isinstance(data, dict) or not isinstance(data.get('holdings', []), list):
                    raise RuntimeError(f"Groww answered without holdings: {str(data)[:200]}")
                cache.set(REDIS_KEY, json.dumps(holdings))
                logger.info(f"Wrote {len(data.get('holdings') or [])} holdings to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Groww session expired, logging in again: {exception}")
                    groww = GrowwAPI()
                else:
                    logger.error(f"Holdings poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
