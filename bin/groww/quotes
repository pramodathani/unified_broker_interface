def stocks_response_class():
    """The `stocksData.response.StocksSocketResponseProtoDto` message class, built from the embedded descriptor."""
    from google.protobuf import descriptor_pb2, descriptor_pool, message_factory

    pool = descriptor_pool.DescriptorPool()
    pool.Add(descriptor_pb2.FileDescriptorProto.FromString(base64.b64decode("".join(STOCKS_DESCRIPTOR))))
    return message_factory.GetMessageClass(pool.FindMessageTypeByName("stocksData.response.StocksSocketResponseProtoDto"))

# ---- NATS NKEY keys and signing ---------------------------------------------------------------------------------

NKEY_PREFIX_SEED = 18 << 3
NKEY_PREFIX_USER = 20 << 3

def crc16(data):
    """
    CRC-16/XMODEM, as NATS computes it over NKEY material.

    - `data` is the bytes to checksum.
    """
    crc = 0
    for byte in data:
        crc ^= byte << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc

class NkeyPair:
    """
    An ed25519 key pair in NATS NKEY form: the public key as a user NKEY, and nonce signing.
    """

    def __init__(self):
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
        from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

        self._private_key = Ed25519PrivateKey.generate()
        raw_public = self._private_key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
        body = bytes([NKEY_PREFIX_USER]) + raw_public
        self.public_key = base64.b32encode(body + crc16(body).to_bytes(2, "little")).rstrip(b"=").decode()

    def signed_nonce(self, nonce):
        """
        A server nonce signed with the private key, base64url encoded without padding, as NATS expects.

        - `nonce` is the nonce from the INFO frame.
        """
        signature = self._private_key.sign(nonce.encode() if isinstance(nonce, str) else nonce)
        return base64.urlsafe_b64encode(signature).rstrip(b"=").decode()

# ---- the session ------------------------------------------------------------------------------------------------

class SocketRefused(Exception):
    """Groww refused the socket token request for the session."""

class GrowwSession:
    """
    The Groww login every socket authenticates with, logged in again by one socket at a time.
    """

    def __init__(self, logger):
        """
        Construct GrowwAPI, which logs in when the stored session is dead.

        - `logger` is where logins are reported.
        """
        from stock_brokers.api.groww import GrowwAPI

        self._api_class = GrowwAPI
        self._logger = logger
        self._lock = threading.Lock()
        self._groww = GrowwAPI()

    def access_token(self):
        """The access token in force now, which may be one another process has just obtained."""
        return (self._groww._current_login() or {}).get('access_token')

    def socket_token(self, key_pair):
        """
        A socket JWT bound to the key pair's public key, and the subscription id issued with it.

        Raises SocketRefused for HTTP 401 or 403, which means the access token is dead.

        - `key_pair` is the connection's NkeyPair.
        """
        import requests

        headers = {"x-request-id": str(uuid.uuid4()), "Authorization": f"Bearer {self.access_token()}",
                   "Content-Type": "application/json", "x-client-id": "growwapi",
                   "x-client-platform": "growwapi-python-client"}
        response = requests.post(SOCKET_TOKEN_URL, headers=headers, json={"socketKey": key_pair.public_key}, timeout=30)
        if response.status_code in (401, 403):
            raise SocketRefused(f"HTTP {response.status_code}: {response.text[:200]}")
        response.raise_for_status()
        payload = response.json()
        payload = payload.get('payload', payload)
        if not payload.get('token'):
            raise RuntimeError(f"No token in the Groww socket token response: {str(payload)[:200]}")
        return payload['token'], payload.get('subscriptionId')

    def log_in_again(self, stale_token):
        """
        Log in again, unless another socket already replaced the token that failed.

        - `stale_token` is the access token the failing connection used.
        """
        with self._lock:
            if self.access_token() != stale_token:
                return
            self._logger.warning("Logging in to Groww again.")
            self._groww = self._api_class()

# ---- one connection ---------------------------------------------------------------------------------------------

class QuotesSocket:
    """
    One Groww NATS websocket for a batch of instruments, reconnecting until stopped.
    """

    def __init__(self, name, tokens, names, session, cache, logger):
        """
        - `name` is the connection's name, for the log.
        - `tokens` is the batch of `EXCHANGE|SEGMENT|EXCHANGE_TOKEN` tokens.
        - `names` maps a token to the instrument's name; names Groww's payloads reveal are added to it.
        - `session` is the shared GrowwSession.
        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        self.name = name
        self._tokens = tokens
        self._names = names
        self._session = session
        self._cache = cache
        self._logger = logger
        self._response_class = stocks_response_class()
        self._stop = threading.Event()
        self._ws = None
        self._token = None
        self._key_pair = None
        self._socket_jwt = None
        self._buffer = b""
        self._subjects = {}
        self._state = {}
        self._opened = False
        self._authentication_rejected = False
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except SocketRefused as exception:
                self._authentication_rejected = True
                self._logger.error(f"{self.name} socket token refused: {exception}")
            except Exception as exception:
                self._logger.error(f"{self.name} connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again and failed_connects >= MAX_FAILED_CONNECTS:
                    self.gave_up = True
                    self._logger.error(f"{self.name} still cannot connect after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again.
                    self._session.log_in_again(self._token)
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"{self.name} could not log in to Groww again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"{self.name} disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info(f"{self.name} stopped.")

    def _connect(self):
        """Obtain a socket JWT for a fresh key pair, open the websocket, and block until it closes."""
        import websocket

        self._token = self._session.access_token()
        self._key_pair = NkeyPair()
        self._socket_jwt, _ = self._session.socket_token(self._key_pair)
        self._buffer, self._subjects, self._state = b"", {}, {}
        self._ws = websocket.WebSocketApp(FEED_URL, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=PING_INTERVAL_SECONDS, ping_timeout=PING_TIMEOUT_SECONDS)

    def _on_open(self, ws):
        self._opened = True
        self._logger.info(f"{self.name} opened. Waiting for the NATS INFO frame.")

    def _on_error(self, ws, error):
        self._logger.error(f"{self.name} error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"{self.name} closed with status {status_code}: {message}")

    def _send(self, lines):
        for line in lines if isinstance(lines, (list, tuple)) else [lines]:
            self._ws.send(line)

    def _on_nats_ready(self):
        """Subscribe the price and depth subjects of every instrument in the batch."""
        lines = []
        for token in self._tokens:
            exchange, segment, exchange_token = token.split('|')
            for kind, prefixes in (("price", PRICE_SUBJECTS), ("depth", DEPTH_SUBJECTS)):
                subject = f"{prefixes[(segment, exchange)]}{exchange_token}"
                self._subjects[subject] = token
                lines.append(f"SUB {subject} {len(self._subjects)}\r\n")
        self._send(lines)
        self._logger.info(f"{self.name} subscribed to {len(lines)} subject(s) for {len(self._tokens)} instrument(s).")

    def _on_message(self, ws, message):
        """Consume a websocket frame as NATS and write the ticks it completed to the live quotes hash and the stream."""
        ticks = []
        for subject, payload in self.consume_nats(message):
            token = self._subjects.get(subject)
            if token is None:
                continue
            try:
                state = self.apply_payload(token, payload)
            except Exception as exception:
                self._logger.warning(f"{self.name} could not decode a payload on {subject}: {exception}")
                continue
            tick = self.build_tick(token, state)
            if tick['last_price'] is not None or tick['depth']['buy'] or tick['depth']['sell']:
                ticks.append((tick['id'], json.dumps(tick)))
        if ticks:
            # The latest tick per instrument and every tick in arrival order, in one round trip.
            pipeline = self._cache.pipeline(transaction=False)
            pipeline.hset(LIVE_KEY, mapping=dict(ticks))
            for _, payload in ticks:
                pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()

    def consume_nats(self, message):
        """
        Feed a frame through the NATS protocol and return the `(subject, payload)` messages it completed.

        NATS is line based: control lines end with CRLF, and a `MSG` line is followed by a payload of the declared
        length. A frame may split or join those, so the stream is buffered and only whole messages come back.

        - `message` is the frame received.
        """
        if isinstance(message, str):
            message = message.encode()
        self._buffer += bytes(message)
        delivered = []
        while True:
            end = self._buffer.find(b"\r\n")
            if end == -1:
                break
            line, rest = self._buffer[:end], self._buffer[end + 2:]
            if line.startswith(b"MSG "):
                parts = line.decode('utf-8', errors='replace').split()
                if len(parts) < 4:
                    self._buffer = rest
                    continue
                length = int(parts[-1])
                if len(rest) < length + 2:
                    break                                   # the payload has not fully arrived yet
                delivered.append((parts[1], rest[:length]))
                self._buffer = rest[length + 2:]
                continue

            self._buffer = rest
            if line.startswith(b"INFO "):
                info = json.loads(line[5:].decode('utf-8'))
                connect = {"jwt": self._socket_jwt, "sig": self._key_pair.signed_nonce(info.get('nonce', '')),
                           "verbose": False, "pedantic": False, "tls_required": False, "lang": "python",
                           "version": "1.0.0", "protocol": 1, "headers": bool(info.get('headers', False)),
                           "no_responders": False}
                self._send([f"CONNECT {json.dumps(connect)}\r\n", "PING\r\n"])
                self._on_nats_ready()
            elif line == b"PING":
                self._send("PONG\r\n")
            elif line.startswith(b"-ERR"):
                error = line.decode('utf-8', errors='replace')
                self._logger.error(f"{self.name} NATS error: {error}")
                if any(marker in error.lower() for marker in AUTHENTICATION_ERRORS):
                    self._authentication_rejected = True
                    self._ws.close()
        return delivered

    @staticmethod
    def whole(value):
        """A protobuf double quantity as a whole number, or None."""
        return int(round(value)) if value is not None else None

    def apply_payload(self, token, payload):
        """
        Merge one protobuf payload into an instrument's state and return the state.

        - `token` is the instrument's `EXCHANGE|SEGMENT|EXCHANGE_TOKEN`.
        - `payload` is the protobuf bytes.
        """
        message = self._response_class.FromString(payload)
        state = self._state.setdefault(token, {})

        if message.HasField('stockLivePrice'):
            live = message.stockLivePrice
            for field in ('tsInMillis', 'open', 'high', 'low', 'close', 'volume', 'value', 'bidQty', 'offerQty',
                          'avgPrice', 'ltp', 'openInterest'):
                if getattr(live, field, None):
                    state[field] = getattr(live, field)

        if message.HasField('stocksMarketDepth'):
            book = message.stocksMarketDepth
            # buyBook and sellBook are maps keyed by depth level, read in level order.
            levels = lambda book_map: [{"quantity": self.whole(entry.qty), "price": entry.price / DIVISOR, "orders": None}
                                       for _, entry in sorted(book_map.items())]
            state['depth'] = {"buy": levels(book.buyBook), "sell": levels(book.sellBook)}
            if book.tsInMillis:
                state['tsInMillis'] = book.tsInMillis

        if message.HasField('stocksLiveIndices'):
            indices = message.stocksLiveIndices
            if indices.value:
                state['ltp'] = indices.value
            if indices.tsInMillis:
                state['tsInMillis'] = indices.tsInMillis

        if message.symbol and not self._names.get(token):
            self._names[token] = f"{token.split('|')[0]}:{message.symbol}"
        return state

    def build_tick(self, token, state):
        """
        A normalized tick from an instrument's merged state.

        - `token` is the instrument's `EXCHANGE|SEGMENT|EXCHANGE_TOKEN`.
        - `state` is the merged fields.
        """
        price = lambda key: state[key] / DIVISOR if state.get(key) is not None else None
        last_price, close = price('ltp'), price('close')
        return {"id": self._names.get(token) or token, "broker": "groww", "instrument_token": token,
                "exchange": token.split('|')[0], "mode": "full" if state.get('depth') else "quote",
                "last_price": last_price, "last_quantity": None, "average_price": price('avgPrice'),
                "volume": self.whole(state.get('volume')), "buy_quantity": self.whole(state.get('bidQty')),
                "sell_quantity": self.whole(state.get('offerQty')),
                "ohlc": {"open": price('open'), "high": price('high'), "low": price('low'), "close": close},
                "change": (last_price - close) * 100 / close if last_price is not None and close else None,
                "oi": self.whole(state.get('openInterest')), "oi_day_high": None, "oi_day_low": None,
                "last_trade_time": None,
                "exchange_timestamp": int(state['tsInMillis'] / 1000) if state.get('tsInMillis') else None,
                "depth": state.get('depth') or {"buy": [], "sell": []}, "received_at": time.time()}

def resolve_tokens(tokens, cache, logger):
    """
    The valid `EXCHANGE|SEGMENT|EXCHANGE_TOKEN` tokens to subscribe to: `--tokens` when given, otherwise the set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = tokens.split(","), "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        parts = [part.strip().upper() for part in token.split('|')]
        if len(parts) == 3 and (parts[1], parts[0]) in PRICE_SUBJECTS and parts[2]:
            resolved.append("|".join(parts))
        else:
            logger.warning(f"Skipping {token}: expected EXCHANGE|SEGMENT|EXCHANGE_TOKEN with EXCHANGE NSE or BSE "
                           f"and SEGMENT CASH or FNO.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Groww's instrument file, keyed by `EXCHANGE|SEGMENT|EXCHANGE_TOKEN`.

    An unreachable file is reported and leaves the names to what the payloads reveal rather than stopping the feed.

    - `tokens` is the list of subscribed tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    try:
        response = requests.get(INSTRUMENTS_URL, timeout=120)
        response.raise_for_status()
    except Exception as exception:
        logger.warning(f"Could not download Groww's instrument file, so names come from the feed: {exception}")
        return {}

    names = {}
    for row in csv.DictReader(StringIO(response.text)):
        token = f"{row.get('exchange')}|{row.get('segment')}|{row.get('exchange_token')}"
        if token in wanted:
            names[token] = f"{row['exchange']}:{row.get('trading_symbol')}"
    return names

def main():
    """Stream Groww quotes into groww:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Groww market quotes into groww:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated EXCHANGE|SEGMENT|EXCHANGE_TOKEN tokens, for example NSE|CASH|2885")
    parser.add_argument("--per-socket", type=int, default=DEFAULT_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, default {DEFAULT_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger

    logger = get_logger("groww.quotes")
    cache = get_cache()

    if arguments.per_socket < 1:
        logger.error("--per-socket must be at least 1.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE|SEGMENT|EXCHANGE_TOKEN members to the "
                     f"Redis set {SUBSCRIPTIONS_KEY}.")
        return 2

    try:
        session = GrowwSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Groww: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the instrument file and are named from the feed or "
                       f"keyed by token: {', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]
    sockets = [QuotesSocket(f"socket_{index}", batch, names, session, cache, logger) for index, batch in enumerate(batches)]

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill the
    # process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"groww_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
