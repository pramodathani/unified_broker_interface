    "EXPIRED": "EXPIRED", "PARTIALLY FILLED - EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks, protobuf's unset empty strings and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric. Protobuf's 64-bit integers arrive as strings.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def position_field(exchange, symbol, product):
    """
    The hash field for a Groww position, `EXCHANGE:SYMBOL:PRODUCT`, or None when one part is missing.

    Built the same way from a REST row (`exchange`, `trading_symbol`, `product`) and a websocket position
    (`symbolData.exchange`, `symbolData.contractId`, `symbolData.stocksProduct`), with the product on the shared
    vocabulary, so both writers address the same position.

    - `exchange`, `symbol` and `product` are the position's exchange, trading symbol and product as the broker sent them.
    """
    parts = [text(exchange), text(symbol), normalize(present(product), PRODUCTS)]
    return ":".join(str(part).upper() for part in parts) if all(parts) else None

def rupees(value):
    """
    An integer paise price in rupees, or None.

    - `value` is the price as Groww sent it.
    """
    paise = number(value)
    return paise / PAISE_PER_RUPEE if paise is not None else None

def stage_timestamp(stage, received_at):
    """
    A stage's `timeStampFromMidNight`, seconds after midnight, as an ISO timestamp on the IST day the update arrived.

    - `stage` is one entry of `stageAndTimeStamp`.
    - `received_at` is the epoch the update was received.
    """
    seconds = number((stage or {}).get('timeStampFromMidNight'))
    if not seconds:
        return None
    midnight = datetime.fromtimestamp(received_at, tz=INDIA).replace(hour=0, minute=0, second=0, microsecond=0)
    return (midnight + timedelta(seconds=seconds)).isoformat()

def order_from_update(data, received_at):
    """
    A decoded `OrderDetailsBroadCastDto` as a normalized order, or None when it has no order id.

    - `data` is the decoded message.
    - `received_at` is the epoch it was received.
    """
    detail = data.get('orderDetailUpdateDto') if isinstance(data, dict) else None
    if not isinstance(detail, dict) or text(detail.get('growwOrderId')) is None:
        return None
    stages = [stage for stage in (data.get('stageAndTimeStamp') or []) if isinstance(stage, dict)]
    exchange, symbol = text(detail.get('exchange')), text(detail.get('contractId'))
    quantity, filled = number(detail.get('qty'), int), number(detail.get('filledQty'), int)
    pending = number(detail.get('remainingQty'), int)
    if pending is None and quantity is not None and filled is not None:
        pending = quantity - filled
    return {
        "order_id": text(detail.get('growwOrderId')),
        "exchange_order_id": text(detail.get('exchangeOrderId')),
        "parent_order_id": None,
        "status": normalize(present(detail.get('orderStatus')), STATUSES),
        "status_message": text(detail.get('remark')),
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": None,
        "tradingsymbol": symbol,
        "exchange": exchange,
        "transaction_type": normalize(present(detail.get('buySell')), TRANSACTION_TYPES),
        "product": normalize(present(detail.get('product')), PRODUCTS),
        "order_type": normalize(present(detail.get('orderType')), ORDER_TYPES),
        "validity": normalize(present(detail.get('duration')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": None,
        "disclosed_quantity": None,
        "price": rupees(detail.get('price')),
        "trigger_price": rupees(detail.get('triggerPrice')),
        "average_price": rupees(detail.get('avgFillPrice')),
        "order_timestamp": stage_timestamp(stages[0], received_at) if stages else None,
        "exchange_timestamp": stage_timestamp(stages[-1], received_at) if stages else None,
        "tag": text(detail.get('guiOrderId')),
    }

def position_from_update(data):
    """
    A decoded `PositionDetailProto` as a normalized position, summing its `NSE` and `BSE` legs, or None when it names no
    contract.

    - `data` is the decoded message.
    """
    symbol_data = data.get('symbolData') if isinstance(data, dict) else None
    if not isinstance(symbol_data, dict):
        return None
    symbol = text(symbol_data.get('contractId')) or text(symbol_data.get('displayName'))
    if symbol is None:
        return None
    info = data.get('positionInfo') if isinstance(data.get('positionInfo'), dict) else {}
    buy_quantity = buy_value = sell_quantity = sell_value = 0.0
    for leg in (info.get('NSE'), info.get('BSE')):
        if isinstance(leg, dict):
            credit, debit = number(leg.get('creditQty')) or 0.0, number(leg.get('debitQty')) or 0.0
            buy_quantity += credit
            sell_quantity += debit
            buy_value += credit * (number(leg.get('creditPrice')) or 0.0)
            sell_value += debit * (number(leg.get('debitPrice')) or 0.0)
    exchange = text(symbol_data.get('exchange'))
    updated_at = text(symbol_data.get('trTimeStamp'))
    return {
        "id": f"{exchange}:{symbol}" if exchange else symbol,
        "instrument_token": None,
        "tradingsymbol": symbol,
        "exchange": exchange,
        "segment": "FNO",
        "product": normalize(present(symbol_data.get('stocksProduct')), PRODUCTS),
        "quantity": int(buy_quantity - sell_quantity),
        "buy_quantity": int(buy_quantity),
        "sell_quantity": int(sell_quantity),
        "buy_price": buy_value / buy_quantity if buy_quantity else None,
        "sell_price": sell_value / sell_quantity if sell_quantity else None,
        "buy_value": buy_value,
        "sell_value": sell_value,
        "average_price": None,
        "last_price": None,
        "realized_pnl": None,
        "unrealized_pnl": None,
        "pnl": None,
        "multiplier": None,
        "lot_size": number(symbol_data.get('nseMarketLot'), int) or number(symbol_data.get('bseMarketLot'), int) or None,
        "day_or_net": "NET",
        "updated_at": None if updated_at in (None, "0") else updated_at,
    }


class GrowwOrderUpdatesStore:
    """
    Where the order stream's decoded orders and positions are written: the merged hashes and their streams.
    """

    def __init__(self, cache, logger):
        """
        Registers the merge script on the Redis client the updates are written to.

        Args:
            cache (redis.Redis): The Redis client.
            logger (logging.Logger): Where writes and unreadable updates are reported.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache
        self._merge = cache.register_script(MERGE_SCRIPT)
        self._logger = logger

    def write_updates(self, orders, positions, received_at):
        """
        Normalizes one frame's orders and positions, merges them into their hashes and appends each to its stream.

        The hashes keep each order's and position's latest state.
        The streams keep every update, even two of one order in the same frame, in the shape `bin/groww/orders/store_orders_to_db` and `bin/groww/portfolio/store_positions_to_db` read.
        An order or position the normalizer cannot read is skipped.

        Args:
            orders (list[dict]): The frame's decoded `OrderDetailsBroadCastDto` messages.
            positions (list[dict]): The frame's decoded `PositionDetailProto` messages.
            received_at (float): The epoch the frame was received.

        Returns:
            None: This method returns nothing.
        """
        order_entries = []
        for data in orders:
            try:
                order = order_from_update(data, received_at)
            except Exception as exception:
                self._logger.warning(f"Could not normalize an order update: {type(exception).__name__}: {exception}")
                continue
            if order is not None:
                order_entries.append((order["order_id"], order, data))
        position_entries = []
        for data in positions:
            try:
                symbol = data["symbolData"]
                field = position_field(symbol.get("exchange"), symbol.get("contractId") or symbol.get("displayName"),
                                       symbol.get("stocksProduct"))
                position = position_from_update(data)
            except Exception as exception:
                self._logger.warning(f"Could not normalize a position update: {type(exception).__name__}: {exception}")
                continue
            if field is not None and position is not None:
                position_entries.append((field, position, data))
        if not order_entries and not position_entries:
            return

        received = datetime.fromtimestamp(received_at).strftime("%Y-%m-%d %H:%M:%S.%f")
        for hash_key, name, entries in ((ORDERS_KEY, "order", order_entries), (POSITIONS_KEY, "position", position_entries)):
            if entries:
                values = []
                for field, normalized, data in entries:
                    values.append(field)
                    values.append(json.dumps({"observed_at": received_at, "source": "websocket", name: normalized, "data": data}))
                self._merge(keys=[hash_key], args=[next_reset(), "websocket", repr(received_at)] + values)
        pipeline = self._cache.pipeline(transaction=False)
        for stream_key, field_name, entries in ((ORDER_STREAM_KEY, "update", order_entries), (POSITION_STREAM_KEY, "position", position_entries)):
            for _, _, data in entries:
                pipeline.xadd(stream_key, {field_name: json.dumps({"timestamp": received, "data": data})},
                              maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()
        if order_entries:
            self._logger.info(f"Merged {len(order_entries)} order update(s) into {ORDERS_KEY}: {', '.join(entry[0] for entry in order_entries)}")
        if position_entries:
            self._logger.info(f"Merged {len(position_entries)} position update(s) into {POSITIONS_KEY}: "
                              f"{', '.join(entry[0] for entry in position_entries)}")

def main():
    """Stream Groww order and position updates into Redis until stopped."""
    from stock_brokers.websockets.groww import GrowwOrderUpdatesSocket, GrowwSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("groww.websocket_order_details")
    try:
        session = GrowwSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Groww: {type(exception).__name__}: {exception}")
        return 1
    store = GrowwOrderUpdatesStore(get_cache(), logger)
    socket = GrowwOrderUpdatesSocket(session, store.write_updates, logger)

    # Installed before the thread starts: systemd stops a unit with SIGTERM, and the default action would kill the
    # process without closing the connection.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the order updates feed.")
        socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    thread = threading.Thread(target=socket.run_forever, name="groww_order_updates", daemon=True)
    logger.info("Starting the order updates feed.")
    thread.start()

    # Block in the main thread so the signal handlers above can run.
    while thread.is_alive():
        thread.join(timeout=1)

    if socket.gave_up:
        return 1
    logger.info("Order updates feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
