#!/usr/bin/env python3
"""
Stream Groww order updates, and derivatives position updates, over a websocket and merge them into the Redis hashes
`groww:orders:orders` and `groww:portfolio:positions`, and keep streaming until stopped.

    bin/groww/orders/websocket_order_details
    redis-cli HGETALL groww:orders:orders
    redis-cli HGET groww:orders:orders <groww order id>
    redis-cli HGETALL groww:portfolio:positions

The NATS connection, the ed25519 handshake, the subscriptions and the protobuf decoding for Groww's stream at
`wss://socket-api.groww.in` are `GrowwOrderUpdatesSocket` and `GrowwSession` in `stock_brokers/websockets/groww.py`,
whose module docstring describes the protocol. This script runs the socket and turns the decoded orders and
positions it hands over into the Redis writes below, so it needs no other feed process or key.

**The subjects** are the account's own, keyed by the subscription id Groww issues with the socket token:
equity and derivatives orders (`OrderDetailsBroadCastDto`) and derivatives positions (`PositionDetailProto`).
Groww streams no equity positions or holdings.

**Keys.** Each message is decoded to a plain JSON object with Groww's own field names, enum fields by name
(`orderStatus: "EXECUTED"`), and every field present even when zero. Nothing else is converted: prices are in
integer paise exactly as Groww sends them, and a stage's `timeStampFromMidNight` is seconds since midnight.

- `groww:orders:orders`, the one hash for Groww's orders, keyed by `growwOrderId` and shared with `bin/groww/orders/api_order_details`,
  which merges the polled order book into it. Each update is written as
  `{"observed_at": <epoch received>, "source": "websocket", "order": <normalized order>, "data": <OrderDetailsBroadCastDto>}`
  - the order under `orderDetailUpdateDto` and its stage history under `stageAndTimeStamp` in `data` - with the same
  normalized `order` the poller builds from an order-book row: prices divided from paise into rupees, the first and
  latest stage times placed on the IST day the update arrived. See `bin/groww/orders/api_order_details` for the fields and how each side
  fills them.
- `groww:portfolio:positions`, the one hash for Groww's positions, keyed `EXCHANGE:CONTRACT_ID:PRODUCT` from the message's
  `symbolData` with the product on the shared vocabulary (`NSE:NIFTY26SEP26000CE:NRML`) and shared with
  `bin/groww/portfolio/positions`. Each update is written as
  `{"observed_at": <epoch received>, "source": "websocket", "position": <normalized position>, "data": <PositionDetailProto>}`
  - the contract under `symbolData` and the credit (bought) and debit (sold) quantities and prices per exchange under
  `positionInfo` - with the legs summed into the normalized `position`. See `bin/groww/portfolio/positions` for the fields.

A websocket update always replaces its entry; a polled row replaces it only when the entry was observed before the
poll's request was sent. Both hashes expire at 06:00 IST, moved to the next 06:00 by every write. Updates arrive only
when an order or position changes, so a quiet socket is not a broken one.

**The streams.** Every update is also appended, in arrival order, to a Redis Stream holding the same JSON - orders to
`groww:order-updates:stream` as an `update` field, which `bin/groww/orders/store_orders_to_db` writes to `groww.order_updates`,
and positions to `groww:positions_updates:stream` as a `position` field, which `bin/groww/portfolio/store_positions_to_db` writes
to `groww.positions` - so the history the hashes overwrite is kept there. Each is capped at about 20,000 entries.

**Sessions.** The access token is read afresh on every connect. When Groww refuses the socket token request (HTTP
401 or 403) or the NATS server reports an authorization error, or the socket fails to open six times running, it
logs in again before reconnecting, without checking whether another process has already replaced the token. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, and 1 when a login fails or the socket still cannot open after logging
in again. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import signal
import threading
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)


ORDERS_KEY = "groww:orders:orders"
POSITIONS_KEY = "groww:portfolio:positions"

# Every order and position update is also appended to these, in arrival order, for bin/groww/orders/store_orders_to_db and
# bin/groww/portfolio/store_positions_to_db, which read them with consumer groups. The caps bound Redis memory when a persister
# is down; entries trimmed before it returns are not persisted.
ORDER_STREAM_KEY = "groww:order-updates:stream"
POSITION_STREAM_KEY = "groww:positions_updates:stream"
STREAM_MAX_LENGTH = 20000

# Groww's websocket prices are integer paise.
PAISE_PER_RUPEE = 100.0

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
