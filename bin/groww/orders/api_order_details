#!/usr/bin/env python3
"""
Poll the day's Groww order book every half second and merge it into the Redis hash `groww:orders:orders`.

    bin/groww/orders/api_order_details
    redis-cli HGETALL groww:orders:orders
    redis-cli HGET groww:orders:orders <groww order id>

Calls `GET https://api.groww.in/v1/order/list` through `GrowwAPI`, which logs in first if the stored session is dead.
The API client unwraps Groww's `payload`, whose `order_list` holds one row per order; an empty book is
`{"order_list": []}` and writes nothing.

**One key for orders.** `groww:orders:orders` is a hash keyed by Groww's order id, written by two scripts: this poller,
and `bin/groww/orders/websocket_order_details`, which merges each order update from Groww's websocket into the same hash. Every value is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "order": <normalized order>, "data": <Groww's own payload>}

**The same order on both sides.** The field is the one id Groww gives an order: `groww_order_id` in the order book,
`growwOrderId` in the websocket's `OrderDetailsBroadCastDto` - the same `GMK...` value, which the project's order
placement also reads back as `groww_order_id`.

`order` has the same fields whichever script wrote it, although the two payloads differ in names, enums and units -
the order book is snake_case JSON in rupees, the websocket a protobuf message in camelCase with prices in integer paise:

| field | order book (`bin/groww/orders/api_order_details`) | order update (`bin/groww/orders/websocket_order_details`) |
| --- | --- | --- |
| `order_id` | `groww_order_id` | `orderDetailUpdateDto.growwOrderId` |
| `exchange_order_id` | `exchange_order_id`, when the row has one | `exchangeOrderId` |
| `status`, `status_message` | `order_status`, `remark` | `orderStatus`, `remark` |
| `id`, `tradingsymbol`, `exchange` | `exchange:trading_symbol`, `trading_symbol`, `exchange` | `exchange:contractId`, `contractId`, `exchange` |
| `transaction_type`, `product`, `order_type`, `validity` | `transaction_type`, `product`, `order_type`, `validity` | `buySell`, `product`, `orderType`, `duration` |
| `quantity`, `filled_quantity`, `pending_quantity` | `quantity`, `filled_quantity`, `remaining_quantity` | `qty`, `filledQty`, `remainingQty` |
| `price`, `trigger_price`, `average_price` | `price`, `trigger_price`, `average_fill_price`, rupees | `price`, `triggerPrice`, `avgFillPrice`, paise divided by 100 |
| `order_timestamp` | `created_at` | the first stage's `timeStampFromMidNight`, on the IST day the update arrived |
| `exchange_timestamp` | `exchange_time` | the latest stage's `timeStampFromMidNight`, the same way |
| `tag` | `order_reference_id` | `guiOrderId` |

`instrument_token`, `parent_order_id`, `cancelled_quantity` and `disclosed_quantity` are null on both: Groww sends no
token, parent id, cancelled or disclosed quantity. Status, side, product, order type and validity are on the shared
vocabulary (`PENDING`, `OPEN`, `COMPLETE`, `CANCELLED`, `REJECTED`, `EXPIRED` for status) - Groww's two spellings,
`MARKET` and `MKT`, `BUY` and `B`, meet there. Times are ISO with their offset, India wall clock when Groww gives none.

**Which write wins.** A websocket update always replaces its entry. A row from this poller replaces an entry only when
that entry was observed before this poll's request was sent, so an update that arrived while the request was in flight
is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and the write run
together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00, so yesterday's entries
remain readable overnight and the first poll of the day starts a fresh hash. An entry is never removed before then: one
the websocket has just reported may not be in the REST answer yet.

Runs until Ctrl+C. A dead session (HTTP 401, or a refusal naming authentication or an expired or invalid token) is
logged in again before the next request; Groww's 403, an endpoint the account is not entitled to, and 429, a rate
limit, are not taken for one. Any other failed poll is logged and leaves the hash unchanged. Exits 1 when the first
login, or a login after the session died, fails. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_URL = "https://api.groww.in/v1/order/list"
REDIS_KEY = "groww:orders:orders"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "groww:orders:orders:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
    "BUY": "BUY", "B": "BUY", "1": "BUY", "BUY ORDER": "BUY",
    "SELL": "SELL", "S": "SELL", "-1": "SELL", "2": "SELL", "SELL ORDER": "SELL",
}
PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}
ORDER_TYPES = {
    "MARKET": "MARKET", "MKT": "MARKET", "MKT ORDER": "MARKET", "2": "MARKET",
    "LIMIT": "LIMIT", "LMT": "LIMIT", "L": "LIMIT", "1": "LIMIT",
    "SL": "SL", "SL-LMT": "SL", "STOPLIMIT": "SL", "SL LIMIT": "SL", "4": "SL",
    "SL-M": "SL-M", "SL-MKT": "SL-M", "STOPMARKET": "SL-M", "SL MARKET": "SL-M", "3": "SL-M", "SL M": "SL-M",
    "SLM": "SL-M", "STOP LOSS": "SL", "STOP LOSS MARKET": "SL-M",
}
VALIDITIES = {
    "DAY": "DAY", "EOS": "DAY", "0": "DAY", "IOC": "IOC", "IMMEDIATE": "IOC", "1": "IOC",
    "GTT": "GTT", "GTC": "GTC", "GTD": "GTD",
}
STATUSES = {
    "PENDING": "PENDING", "TRANSIT": "PENDING", "VALIDATION PENDING": "PENDING", "PUT ORDER REQ RECEIVED": "PENDING",
    "TRIGGER PENDING": "PENDING", "AMO REQ RECEIVED": "PENDING", "PENDINGNEW": "PENDING", "O-PENDING": "PENDING",
    "MODIFY AMO REQ RECEIVED": "PENDING", "AFTER MARKET ORDER REQ RECEIVED": "PENDING", "AMO PENDING": "PENDING",
    "MODIFY AFTER MARKET ORDER REQ RECEIVED": "PENDING", "QUEUED": "PENDING", "PROCESSING": "PENDING",
    "SL-PENDING": "PENDING",
    "OPEN": "OPEN", "OPEN PENDING": "OPEN", "NEW": "OPEN", "REPLACED": "OPEN", "ACKED": "OPEN", "APPROVED": "OPEN",
    "MODIFICATION REQUESTED": "OPEN", "MODIFIED": "OPEN", "MODIFY VALIDATION PENDING": "OPEN", "MODIFY PENDING": "OPEN",
    "PARTIALLY FILLED": "OPEN", "PARTIALLY EXECUTED": "OPEN", "PLACED": "OPEN", "PART TRADED": "OPEN",
    "PARTIALLYFILLED": "OPEN", "PENDINGREPLACE": "OPEN", "CONFIRMED": "OPEN", "PARTIALLY TRADED": "OPEN",
    "INITIATED": "OPEN",
    "COMPLETE": "COMPLETE", "COMPLETED": "COMPLETE", "TRADED": "COMPLETE", "FILLED": "COMPLETE",
    "EXECUTED": "COMPLETE", "FULLY EXECUTED": "COMPLETE", "DELIVERY AWAITED": "COMPLETE", "SUCCESS": "COMPLETE",
    "CANCELLED": "CANCELLED", "CANCELED": "CANCELLED", "CANCEL": "CANCELLED", "CANCEL PENDING": "CANCELLED",
    "CANCELLATION REQUESTED": "CANCELLED", "PENDINGCANCEL": "CANCELLED", "CANCELLED AFTER MARKET ORDER": "CANCELLED",
    "AMO CANCELLED": "CANCELLED", "PARTIALLY FILLED - CANCELLED": "CANCELLED",
    "REJECTED": "REJECTED", "REJECT": "REJECTED", "FAILED": "REJECTED", "ABORTED": "REJECTED",
    "EXPIRED": "EXPIRED", "PARTIALLY FILLED - EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks, protobuf's unset empty strings and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric. Protobuf's 64-bit integers arrive as strings.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def groww_timestamp(value):
    """
    A Groww REST time as an ISO timestamp with its offset, or None.

    An epoch is read as UTC, in milliseconds when it is too large for seconds; text with an offset keeps it, and text
    without one is India wall clock.

    - `value` is the time as Groww sent it.
    """
    value = present(value)
    if value is None:
        return None
    if isinstance(value, (int, float)) or str(value).replace(".", "", 1).isdigit():
        seconds = float(value)
        seconds = seconds / 1000 if seconds > 1e11 else seconds
        return datetime.fromtimestamp(seconds, tz=INDIA).isoformat() if seconds > 0 else None
    raw = str(value).strip().replace("Z", "+00:00")
    try:
        moment = datetime.fromisoformat(raw)
    except ValueError:
        moment = None
        for fmt in ("%Y-%m-%d %H:%M:%S", "%d-%m-%Y %H:%M:%S", "%d/%m/%Y %H:%M:%S", "%Y-%m-%d %H:%M"):
            try:
                moment = datetime.strptime(raw, fmt)
                break
            except ValueError:
                continue
    if moment is None or moment.year < 1971:
        return None
    return (moment if moment.tzinfo else moment.replace(tzinfo=INDIA)).isoformat()

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_book(row):
    """
    A Groww order-book row as a normalized order, or None when it has no order id.

    - `row` is one row of `order_list`.
    """
    if not isinstance(row, dict) or text(row.get('groww_order_id')) is None:
        return None
    exchange, symbol = text(row.get('exchange')), text(row.get('trading_symbol'))
    quantity, filled = number(row.get('quantity'), int), number(row.get('filled_quantity'), int)
    pending = number(row.get('remaining_quantity'), int)
    if pending is None and quantity is not None and filled is not None:
        pending = quantity - filled
    return {
        "order_id": text(row.get('groww_order_id')),
        "exchange_order_id": text(row.get('exchange_order_id')),
        "parent_order_id": None,
        "status": normalize(present(row.get('order_status')), STATUSES),
        "status_message": text(row.get('remark')),
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": None,
        "tradingsymbol": symbol,
        "exchange": exchange,
        "transaction_type": normalize(present(row.get('transaction_type')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('product')), PRODUCTS),
        "order_type": normalize(present(row.get('order_type')), ORDER_TYPES),
        "validity": normalize(present(row.get('validity')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": None,
        "disclosed_quantity": None,
        "price": number(row.get('price')),
        "trigger_price": number(row.get('trigger_price')),
        "average_price": number(row.get('average_fill_price')),
        "order_timestamp": groww_timestamp(row.get('created_at')),
        "exchange_timestamp": groww_timestamp(row.get('exchange_time')),
        "tag": text(row.get('order_reference_id')),
    }

# What Groww says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("unauthori", "authentication", "token expired", "invalid token", "expired token", "jwt")

def is_authentication_error(exception):
    """Whether Groww refused the request because the session is dead, rather than for entitlement or rate."""
    status = str(getattr(exception, 'code', '') or '').strip()
    lowered = str(exception).lower()
    if status in ('403', '429') or 'access forbidden' in lowered:
        return False
    return status == '401' or any(marker in lowered for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the order book and merge it into groww:orders:orders every half second, until interrupted."""
    from stock_brokers.api.groww import GrowwAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("groww.api_order_details")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        groww = GrowwAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Groww: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = groww.get(url=ORDERS_URL, timeout=TIMEOUT_SECONDS) or {}
                data = response.get('data') if response.get('data') is not None else {'order_list': []}
                if not isinstance(data, dict) or not isinstance(data.get('order_list') or [], list):
                    raise RuntimeError(f"Groww answered without an order list: {str(data)[:200]}")
                rows = data.get('order_list') or []
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    order = order_from_book(row)
                    if order is not None:
                        arguments += [order["order_id"], json.dumps({"observed_at": requested_at, "source": "rest",
                                                                     "order": order, "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} order(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Groww session expired, logging in again: {exception}")
                    groww = GrowwAPI()
                else:
                    report.error(f"Orders poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
