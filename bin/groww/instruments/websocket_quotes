#!/usr/bin/env python3
"""
Stream Groww market quotes over websockets into the Redis hash `groww:quotes:live`, and keep streaming until
stopped.

    bin/groww/instruments/websocket_quotes                                         # instruments from the Redis set groww:quotes:subscriptions
    bin/groww/instruments/websocket_quotes --tokens "NSE|CASH|2885,NSE|FNO|35001"
    bin/groww/instruments/websocket_quotes --per-socket 500

    redis-cli SADD groww:quotes:subscriptions "NSE|CASH|2885" "BSE|CASH|500325"
    redis-cli HGET groww:quotes:live "NSE:RELIANCE"
    redis-cli HGETALL groww:quotes:instruments

The NATS connection, the ed25519 handshake, the subscriptions and the protobuf decoding for Groww's feed at
`wss://socket-api.groww.in` are `GrowwQuotesSocket` and `GrowwSession` in `stock_brokers/websockets/groww.py`,
whose module docstring describes the protocol. This script chooses the instruments, splits them across sockets,
runs the sockets and writes the ticks they decode to Redis, so it needs no other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `groww:quotes:subscriptions`,
each as `EXCHANGE|SEGMENT|EXCHANGE_TOKEN` - `NSE` or `BSE`, `CASH` or `FNO`, then Groww's exchange token (a number
for stocks and contracts, the index name such as `NIFTY` for an index). Groww's feed has no subjects for
commodities, so `COMMODITY` tokens are skipped. Each is named from Groww's public instrument file, downloaded at
startup. One websocket carries up to `--per-socket` instruments, default 1000.

**Keys.**

- `groww:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the instrument's name
  (`NSE:RELIANCE`) - from the instrument file, else from the symbol Groww puts in the payload, else the token.
  Price and depth arrive separately and are merged, so each tick carries the latest of both. It is not cleared at
  startup, so an instrument no longer subscribed keeps its last tick.
- `groww:quotes:instruments`, a hash of every subscribed `EXCHANGE|SEGMENT|EXCHANGE_TOKEN` to its name, or to an
  empty string when the instrument file does not name it. Replaced whole at startup.
- `groww:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/groww/instruments/store_quotes_to_db` writes to `groww.ticks`. Capped at about 1,000,000 entries, so ticks that arrive while
  the persister is down for long enough are trimmed before they are persisted.

A tick has `id`, `broker`, `instrument_token`, `exchange`, `mode` (`full` once depth has arrived, else `quote`),
`last_price`, `last_quantity`, `average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`,
`oi_day_high`, `oi_day_low`, `last_trade_time`, `exchange_timestamp`, `depth` (`buy` and `sell` levels of
`quantity`, `price` and `orders`) and `received_at`, with `None` for what Groww does not send - it sends no last
quantity, trade time, open interest range or order counts. Groww sends prices in paise; they are divided into
rupees. Quantities arrive as doubles and are rounded to whole numbers.

**Sessions.** The access token is read afresh on every connect, so a login made by any process is picked up. When
Groww refuses the socket token request (HTTP 401 or 403) or the NATS server reports an authorization error, or a
socket fails to open six times running, it logs in again through the shared `GrowwSession` - one socket at a
time, and only if no other socket or process already replaced the token - before reconnecting. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket still cannot open after logging in
again, and 2 when there is nothing to subscribe to. Reads only - it places no orders.
"""

import sys
import csv
import json
import signal
import argparse
import threading
from io import StringIO
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

INSTRUMENTS_URL = "https://growwapi-assets.groww.in/instruments/instrument.csv"

LIVE_KEY = "groww:quotes:live"
INSTRUMENTS_KEY = "groww:quotes:instruments"
SUBSCRIPTIONS_KEY = "groww:quotes:subscriptions"

# Every tick is also appended here for bin/groww/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "groww:quotes:stream"
STREAM_MAX_LENGTH = 1000000

# NATS subject prefixes, by segment and exchange.
PRICE_SUBJECTS = {("CASH", "NSE"): "/ld/eq/nse/price_detailed.", ("CASH", "BSE"): "/ld/eq/bse/price_detailed.",
                  ("FNO", "NSE"): "/ld/fo/nse/price_detailed.", ("FNO", "BSE"): "/ld/fo/bse/price_detailed."}

DEFAULT_INSTRUMENTS_PER_CONNECTION = 1000

class GrowwQuotesStore:
    """
    Where the quotes sockets' ticks are written: the live hash and the persistence stream.
    """

    def __init__(self, cache):
        """
        Keeps the Redis client the ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_ticks(self, ticks):
        """
        Writes one frame's ticks: the latest tick per instrument and every tick in arrival order, in one round trip.

        Args:
            ticks (list[dict]): The frame's ticks, in arrival order.

        Returns:
            None: This method returns nothing.
        """
        encoded = []
        for tick in ticks:
            encoded.append((tick["id"], json.dumps(tick)))
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, mapping=dict(encoded))
        for _, payload in encoded:
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def resolve_tokens(tokens, cache, logger):
    """
    The valid `EXCHANGE|SEGMENT|EXCHANGE_TOKEN` tokens to subscribe to: `--tokens` when given, otherwise the set.

    - `tokens` is a comma separated list of instrument tokens, or None.
    - `cache` is the Redis client.
    - `logger` is where the resolution is reported.
    """
    if tokens:
        wanted, source = tokens.split(","), "--tokens"
    else:
        wanted, source = list(cache.smembers(SUBSCRIPTIONS_KEY)), SUBSCRIPTIONS_KEY

    resolved = []
    for token in sorted({str(token).strip() for token in wanted if str(token).strip()}):
        parts = [part.strip().upper() for part in token.split('|')]
        if len(parts) == 3 and (parts[1], parts[0]) in PRICE_SUBJECTS and parts[2]:
            resolved.append("|".join(parts))
        else:
            logger.warning(f"Skipping {token}: expected EXCHANGE|SEGMENT|EXCHANGE_TOKEN with EXCHANGE NSE or BSE "
                           f"and SEGMENT CASH or FNO.")
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Groww's instrument file, keyed by `EXCHANGE|SEGMENT|EXCHANGE_TOKEN`.

    An unreachable file is reported and leaves the names to what the payloads reveal rather than stopping the feed.

    - `tokens` is the list of subscribed tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = set(tokens)
    try:
        response = requests.get(INSTRUMENTS_URL, timeout=120)
        response.raise_for_status()
    except Exception as exception:
        logger.warning(f"Could not download Groww's instrument file, so names come from the feed: {exception}")
        return {}

    names = {}
    for row in csv.DictReader(StringIO(response.text)):
        token = f"{row.get('exchange')}|{row.get('segment')}|{row.get('exchange_token')}"
        if token in wanted:
            names[token] = f"{row['exchange']}:{row.get('trading_symbol')}"
    return names

def main():
    """Stream Groww quotes into groww:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Groww market quotes into groww:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated EXCHANGE|SEGMENT|EXCHANGE_TOKEN tokens, for example NSE|CASH|2885")
    parser.add_argument("--per-socket", type=int, default=DEFAULT_INSTRUMENTS_PER_CONNECTION,
                        help=f"instruments per websocket connection, default {DEFAULT_INSTRUMENTS_PER_CONNECTION}")
    arguments = parser.parse_args()

    from stock_brokers.websockets.groww import GrowwQuotesSocket, GrowwSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("groww.websocket_quotes")
    cache = get_cache()

    if arguments.per_socket < 1:
        logger.error("--per-socket must be at least 1.")
        return 2

    tokens = resolve_tokens(arguments.tokens, cache, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE|SEGMENT|EXCHANGE_TOKEN members to the "
                     f"Redis set {SUBSCRIPTIONS_KEY}.")
        return 2

    try:
        session = GrowwSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Groww: {type(exception).__name__}: {exception}")
        return 1

    names = instrument_names(tokens, logger)
    pipeline = cache.pipeline()
    pipeline.delete(INSTRUMENTS_KEY)
    pipeline.hset(INSTRUMENTS_KEY, mapping={token: names.get(token, "") for token in tokens})
    pipeline.execute()
    unnamed = [token for token in tokens if token not in names]
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are not in the instrument file and are named from the feed or "
                       f"keyed by token: {', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

    batches = [tokens[start:start + arguments.per_socket] for start in range(0, len(tokens), arguments.per_socket)]
    store = GrowwQuotesStore(cache)
    sockets = []
    for index, batch in enumerate(batches):
        sockets.append(GrowwQuotesSocket(f"socket_{index}", batch, names, session, store.write_ticks, logger))

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill the
    # process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"groww_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
