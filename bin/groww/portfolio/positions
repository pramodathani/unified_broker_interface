#!/usr/bin/env python3
"""
Poll the Groww positions every half second and merge them into the Redis hash `groww:portfolio:positions`.

    bin/groww/portfolio/positions
    redis-cli HGETALL groww:portfolio:positions
    redis-cli HGET groww:portfolio:positions NSE:NIFTY26SEP26000CE:NRML

Calls `GET https://api.groww.in/v1/positions/user` through `GrowwAPI`, which logs in first if the stored session is
dead. The API client unwraps Groww's `payload`, whose `positions` holds one row per position; a flat account is
`{"positions": []}` and writes nothing.

**One key for positions.** `groww:portfolio:positions` is a hash with one field per position, keyed
`EXCHANGE:TRADING_SYMBOL:PRODUCT` with the product on the shared vocabulary (`NSE:INFY:CNC`), written by two scripts:
this poller, for every position, and `bin/groww/orders/websocket_order_details`, which merges the derivatives positions Groww streams
over its websocket into the same hash - Groww streams no equity positions. Every value is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "position": <normalized position>, "data": <Groww's own payload>}

`position` has `id`, `instrument_token`, `tradingsymbol`, `exchange`, `segment`, `product`, `quantity`, `buy_quantity`,
`sell_quantity`, `buy_price`, `sell_price`, `buy_value`, `sell_value`, `average_price`, `last_price`, `realized_pnl`,
`unrealized_pnl`, `pnl`, `multiplier`, `lot_size`, `day_or_net` and `updated_at`, the same shape every broker's
positions hash uses. The two payloads differ, and are mapped onto it like this:

| field | REST row (`bin/groww/portfolio/positions`) | websocket `PositionDetailProto` (`bin/groww/orders/websocket_order_details`) |
| --- | --- | --- |
| field key | `exchange:trading_symbol:product` | `symbolData.exchange:symbolData.contractId:symbolData.stocksProduct` |
| `id`, `tradingsymbol`, `exchange` | `exchange:trading_symbol`, `trading_symbol`, `exchange` | `exchange:contractId`, `contractId`, `exchange` |
| `segment` | `segment` (`CASH`, `FNO`, `COMMODITY`) | `FNO` - the stream is the derivatives subject |
| `product` | `product` | `stocksProduct` |
| `buy_quantity`, `buy_price` | `credit_quantity`, `credit_price` | `creditQty` summed over the `NSE` and `BSE` legs, value-weighted `creditPrice` |
| `sell_quantity`, `sell_price` | `debit_quantity`, `debit_price` | `debitQty` and `debitPrice`, the same way |
| `quantity` | `quantity` (signed) | bought less sold |
| `buy_value`, `sell_value` | quantity times price | the legs' quantity times price, summed |
| `lot_size`, `updated_at` | null - the row has neither | `nseMarketLot` or `bseMarketLot`, `trTimeStamp` |

Prices are rupees on both sides: the REST row's, and the websocket legs' doubles. `instrument_token`, `average_price`,
`last_price`, the three profit fields and `multiplier` are null on both - Groww sends no token, price or profit on a
position - and `day_or_net` is `NET`.

**Matching a websocket position to its row** rests on `contractId` being the contract's trading symbol, as it is for an
order (`NIFTY26SEP26000CE`, `INFY`). If Groww ever sends a different spelling for a position, the two writers produce
two fields for one position rather than overwriting each other; the entries' `source` and `id` show it.

**Which write wins.** A websocket update always replaces its entry. A row from this poller replaces an entry only when
that entry was observed before this poll's request was sent, so an update that arrived while the request was in flight
is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and the write run
together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00, so yesterday's entries
remain readable overnight and the first poll of the day starts a fresh hash. An entry is never removed before then: one
the websocket has just reported may not be in the REST answer yet.

Runs until Ctrl+C. A dead session (HTTP 401, or a refusal naming authentication or an expired or invalid token) is
logged in again before the next request; Groww's 403, an endpoint the account is not entitled to, and 429, a rate
limit, are not taken for one. Any other failed poll is logged and leaves the hash unchanged. Exits 1 when the first
login, or a login after the session died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

POSITIONS_URL = "https://api.groww.in/v1/positions/user"
REDIS_KEY = "groww:portfolio:positions"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "groww:portfolio:positions:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks, protobuf's unset empty strings and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric. Protobuf's 64-bit integers arrive as strings.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def position_field(exchange, symbol, product):
    """
    The hash field for a Groww position, `EXCHANGE:SYMBOL:PRODUCT`, or None when one part is missing.

    Built the same way from a REST row (`exchange`, `trading_symbol`, `product`) and a websocket position
    (`symbolData.exchange`, `symbolData.contractId`, `symbolData.stocksProduct`), with the product on the shared
    vocabulary, so both writers address the same position.

    - `exchange`, `symbol` and `product` are the position's exchange, trading symbol and product as the broker sent them.
    """
    parts = [text(exchange), text(symbol), normalize(present(product), PRODUCTS)]
    return ":".join(str(part).upper() for part in parts) if all(parts) else None

def position_from_row(row):
    """
    A Groww REST position row as a normalized position.

    - `row` is one row of `positions`.
    """
    exchange, symbol = text(row.get('exchange')), text(row.get('trading_symbol'))
    buy_quantity, sell_quantity = number(row.get('credit_quantity'), int), number(row.get('debit_quantity'), int)
    buy_price, sell_price = number(row.get('credit_price')), number(row.get('debit_price'))
    return {
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": None,
        "tradingsymbol": symbol,
        "exchange": exchange,
        "segment": text(row.get('segment')),
        "product": normalize(present(row.get('product')), PRODUCTS),
        "quantity": number(row.get('quantity'), int),
        "buy_quantity": buy_quantity,
        "sell_quantity": sell_quantity,
        "buy_price": buy_price,
        "sell_price": sell_price,
        "buy_value": buy_quantity * buy_price if buy_quantity is not None and buy_price is not None else None,
        "sell_value": sell_quantity * sell_price if sell_quantity is not None and sell_price is not None else None,
        "average_price": None,
        "last_price": None,
        "realized_pnl": None,
        "unrealized_pnl": None,
        "pnl": None,
        "multiplier": None,
        "lot_size": None,
        "day_or_net": "NET",
        "updated_at": None,
    }

# What Groww says when the session is no good, lowercased.
AUTHENTICATION_MARKERS = ("unauthori", "authentication", "token expired", "invalid token", "expired token", "jwt")

def is_authentication_error(exception):
    """Whether Groww refused the request because the session is dead, rather than for entitlement or rate."""
    status = str(getattr(exception, 'code', '') or '').strip()
    lowered = str(exception).lower()
    if status in ('403', '429') or 'access forbidden' in lowered:
        return False
    return status == '401' or any(marker in lowered for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the positions and merge them into groww:portfolio:positions every half second, until interrupted."""
    from stock_brokers.api.groww import GrowwAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("groww.positions")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        groww = GrowwAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Groww: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = groww.get(url=POSITIONS_URL, timeout=TIMEOUT_SECONDS) or {}
                data = response.get('data')
                if not isinstance(data, dict) or not isinstance(data.get('positions') or [], list):
                    raise RuntimeError(f"Groww answered without positions: {str(data)[:200]}")
                rows = data.get('positions') or []
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    field = position_field(row.get('exchange'), row.get('trading_symbol'), row.get('product')) \
                        if isinstance(row, dict) else None
                    if field is not None:
                        arguments += [field, json.dumps({"observed_at": requested_at, "source": "rest",
                                                         "position": position_from_row(row), "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} position(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Groww session expired, logging in again: {exception}")
                    groww = GrowwAPI()
                else:
                    report.error(f"Positions poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
