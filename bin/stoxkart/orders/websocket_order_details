#!/usr/bin/env python3
"""Stream Stoxkart order updates from its order websocket into the Redis hash `stoxkart:orders:orders`, and keep streaming until stopped.

    bin/stoxkart/orders/websocket_order_details
    redis-cli HGETALL stoxkart:orders:orders
    redis-cli XRANGE stoxkart:order-updates:stream - + COUNT 5

**The socket** - the RequestId authentication, the connection, the heartbeat and the eviction by another session - is `StoxkartOrderSocket` and `StoxkartSession` in `stock_brokers/websockets/stoxkart.py`, whose module docstring describes it. This script runs the socket and turns the messages it hands over into the Redis writes below.

**What an update holds** was first seen on 2026-09-15, when three KWIL orders sent after the close were rejected: an update arrived within a second of each order, carrying `client_id`, `user_id`, `order_id`, `exch_order_id`, `order_timestamp` (blank on a rejection), `variety`, `exchange`, `trading_symbol`, `symbol`, `token`, `segment`, `order_type`, `transaction_type`, `validity`, `product`, `quantity`, `disclose_quantity`, `disclose_quantity_remaining`, `price`, `trigger_price`, `traded_quantity`, `pending_quantity`, `order_status`, `reason`, `expiry_date`, `strike_price`, `option_type` and `lot_size`, every value a string. No update arrived when two after-market orders were placed the same evening, which only `bin/stoxkart/orders/api_order_details` recorded, but one arrived for each when they were cancelled, with `order_status` `AMO CANCELLED`. Updates for open, partly filled and filled orders have not been seen yet. Every JSON object received is logged at INFO with its first 300 characters.

**Keys.** An object carrying an `order_id` is an order update:

- It is merged into `stoxkart:orders:orders`, the hash `bin/stoxkart/orders/api_order_details` also writes, keyed by `order_id`, as `{"observed_at": <epoch>, "source": "websocket", "order": <normalized order>, "data": <the update as Stoxkart sent it>, "variety": <the order's variety>}`. `variety` is what the REST API's cancel endpoint builds Stoxkart's cancel path from. Stoxkart's socket reported `NORMAL` for after-market orders whose order book row said `AMO`, so an `AMO` or `BO` variety already stored for the order is kept, a status beginning with `AMO` means `AMO`, and only otherwise is the update's own `variety` used. A websocket update always replaces its entry; the poller replaces an entry only when it was observed before the poll's request was sent. The hash expires at 06:00 IST, moved to the next 06:00 by every write.
- It is appended to the Redis Stream `stoxkart:order-updates:stream` as an `update` field holding `{"timestamp": "YYYY-MM-DD HH:MM:SS.ffffff", "order": <normalized order>, "data": <the update>}`, capped at about 20,000 entries, which `bin/stoxkart/orders/store_orders_to_db` writes to `stoxkart.order_updates` and `bin/unified/orders/websocket_order_details` combines.

Any other object - an acknowledgement, a heartbeat reply - is logged and not stored.

**The normalized order** has the fields `bin/stoxkart/orders/api_order_details` builds, read from the order book's field names or, where an update may name a field differently, from the likeliest alternative:

| field | from the update |
| --- | --- |
| `order_id`, `exchange_order_id`, `parent_order_id` | `order_id`, `exch_order_id` or `exchange_order_id`, `parent_order_id` |
| `status`, `status_message` | `status` or `order_status` on the shared vocabulary, `reason`, `rejection_reason` or `status_message` |
| `id`, `instrument_token`, `tradingsymbol`, `exchange` | `exchange:tradingsymbol`, `token` or `instrument_token`, `symbol_description` for a contract whose description names it and otherwise `symbol` or `trading_symbol`, `exchange` |
| `transaction_type`, `product`, `order_type`, `validity` | `action` or `transaction_type`, `product_type` or `product`, `order_type`, `validity`, on the shared vocabulary |
| `quantity`, `filled_quantity`, `pending_quantity`, `disclosed_quantity` | `quantity`, `traded_quantity` or `filled_quantity`, `pending_quantity`, `disclose_quantity` or `disclosed_quantity` |
| `price`, `trigger_price`, `average_price` | `price`, `trigger_price`, `trade_average_price` or `average_price` |
| `order_timestamp` | `order_date_time` or `order_timestamp`, India time, as ISO with the IST offset |
| `cancelled_quantity`, `exchange_timestamp` | null |
| `tag` | `tag` |

**Sessions.** The access token is read afresh for every authentication, so a login made by any process is picked up. An authentication refused with `AuthorizationError` logs in again through `StoxkartSession` before retrying. Other failures reconnect with a backoff from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, and 1 when the first login, or a login after the session died, fails. Reads only - it never places, modifies or cancels an order.
"""

import json
import signal
import sys
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

from utilities.configurations import get_cache, get_logger

ORDERS_KEY = "stoxkart:orders:orders"
STREAM_KEY = "stoxkart:order-updates:stream"
STREAM_MAX_LENGTH = 20000
INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""


class StoxkartUpdateNormalizer:
    """Turns a Stoxkart order update into the normalized order every broker's scripts share."""

    TRANSACTION_TYPES = {
        "BUY": "BUY",
        "B": "BUY",
        "SELL": "SELL",
        "S": "SELL",
    }
    PRODUCTS = {
        "DELIVERY": "CNC",
        "CNC": "CNC",
        "INTRADAY": "MIS",
        "MIS": "MIS",
        "CARRYFORWARD": "NRML",
        "CARRY FORWARD": "NRML",
        "NRML": "NRML",
        "NORMAL": "NRML",
        "BO": "BO",
        "BRACKET ORDER": "BO",
        "CO": "CO",
        "COVER ORDER": "CO",
        "MTF": "MTF",
    }
    ORDER_TYPES = {
        "MARKET": "MARKET",
        "MKT": "MARKET",
        "RL MKT": "MARKET",
        "RL-MKT": "MARKET",
        "LIMIT": "LIMIT",
        "RL": "LIMIT",
        "L": "LIMIT",
        "STOPLOSS LIMIT": "SL",
        "SL": "SL",
        "SL LIMIT": "SL",
        "STOPLOSS MARKET": "SL-M",
        "SL-M": "SL-M",
        "SL M": "SL-M",
        "SL-MKT": "SL-M",
        "SL MKT": "SL-M",
    }
    VALIDITIES = {
        "DAY": "DAY",
        "EOTODY": "DAY",
        "EOSESS": "DAY",
        "IOC": "IOC",
        "GTC": "GTC",
        "GTD": "GTD",
        "GTT": "GTT",
    }
    STATUSES = {
        "PENDING": "PENDING",
        "TRANSIT": "PENDING",
        "TRIGGER PENDING": "PENDING",
        "AMO REQ RECEIVED": "PENDING",
        "AMO PENDING": "PENDING",
        "AFTER MARKET ORDER REQ RECEIVED": "PENDING",
        "O-PENDING": "PENDING",
        "OPEN": "OPEN",
        "NEW": "OPEN",
        "MODIFIED": "OPEN",
        "REPLACED": "OPEN",
        "PARTIALLY EXECUTED": "OPEN",
        "PARTIALLY FILLED": "OPEN",
        "PART TRADED": "OPEN",
        "PARTIALLY TRADED": "OPEN",
        "COMPLETE": "COMPLETE",
        "COMPLETED": "COMPLETE",
        "EXECUTED": "COMPLETE",
        "FULLY EXECUTED": "COMPLETE",
        "TRADED": "COMPLETE",
        "FILLED": "COMPLETE",
        "CANCELLED": "CANCELLED",
        "CANCELED": "CANCELLED",
        "CANCEL": "CANCELLED",
        "AMO CANCELLED": "CANCELLED",
        "REJECTED": "REJECTED",
        "REJECT": "REJECTED",
        "FAILED": "REJECTED",
        "EXPIRED": "EXPIRED",
    }
    DERIVATIVE_TYPE_PREFIXES = (
        "FUT",
        "OPT",
    )

    def normalize(self, update):
        """Builds the normalized order for one update.

        Args:
            update (dict): One order update as Stoxkart sent it.

        Returns:
            dict | None: The normalized order, or None when the update has no order id.
        """
        order_id = self._first(update, "order_id")
        if order_id is None:
            return None

        exchange = self._first(update, "exchange")
        symbol = self._trading_symbol(update)
        instrument_name = symbol
        if exchange and symbol:
            instrument_name = f"{exchange}:{symbol}"

        return {
            "order_id": order_id,
            "exchange_order_id": self._identifier(self._first(update, "exch_order_id", "exchange_order_id")),
            "parent_order_id": self._identifier(self._first(update, "parent_order_id")),
            "status": self._vocabulary(self._first(update, "status", "order_status"), self.STATUSES),
            "status_message": self._first(update, "reason", "rejection_reason", "status_message"),
            "id": instrument_name,
            "instrument_token": self._first(update, "token", "instrument_token"),
            "tradingsymbol": symbol,
            "exchange": exchange,
            "transaction_type": self._vocabulary(self._first(update, "action", "transaction_type"), self.TRANSACTION_TYPES),
            "product": self._vocabulary(self._first(update, "product_type", "product"), self.PRODUCTS),
            "order_type": self._vocabulary(self._first(update, "order_type"), self.ORDER_TYPES),
            "validity": self._vocabulary(self._first(update, "validity"), self.VALIDITIES),
            "quantity": self._integer(self._first(update, "quantity")),
            "filled_quantity": self._integer(self._first(update, "traded_quantity", "filled_quantity")),
            "pending_quantity": self._integer(self._first(update, "pending_quantity")),
            "cancelled_quantity": None,
            "disclosed_quantity": self._integer(self._first(update, "disclose_quantity", "disclosed_quantity")),
            "price": self._decimal(self._first(update, "price")),
            "trigger_price": self._decimal(self._first(update, "trigger_price")),
            "average_price": self._decimal(self._first(update, "trade_average_price", "average_price")),
            "order_timestamp": self._india_timestamp(self._first(update, "order_date_time", "order_timestamp")),
            "exchange_timestamp": None,
            "tag": self._first(update, "tag"),
        }

    def _trading_symbol(self, update):
        """Chooses the name that identifies the contract.

        A future or option is named by `symbol_description` when that begins with its symbol, is longer, has no space and carries a digit, as `NIFTY23FEBFUT` does. Anything else is named by `symbol` or `trading_symbol`.

        Args:
            update (dict): One order update.

        Returns:
            str | None: The trading symbol, or None when the update names none.
        """
        symbol = self._first(update, "symbol", "trading_symbol")
        instrument_type = str(update.get("instrument_type") or "").upper()
        description = self._first(update, "symbol_description")
        if not instrument_type.startswith(self.DERIVATIVE_TYPE_PREFIXES) or description is None:
            return symbol
        if symbol is None:
            return description
        if not description.startswith(symbol) or len(description) <= len(symbol) or " " in description:
            return symbol
        for character in description:
            if character.isdigit():
                return description
        return symbol

    def _first(self, update, *names):
        """Returns the first of several fields the update carries a value for, as a string.

        Args:
            update (dict): One order update.
            *names (str): The field names to try, in order.

        Returns:
            str | None: The stripped value, or None when every field is missing, blank or Stoxkart's `NA` placeholder.
        """
        for name in names:
            value = update.get(name)
            if value is None:
                continue
            text = str(value).strip()
            if text not in ("", "NA"):
                return text
        return None

    def _identifier(self, value):
        """Returns an order id, treating Stoxkart's `0` for an id not yet assigned as missing.

        Args:
            value (str | None): The raw field value.

        Returns:
            str | None: The id, or None when it is missing or `0`.
        """
        if value == "0":
            return None
        return value

    def _vocabulary(self, value, table):
        """Maps a Stoxkart term onto the shared vocabulary.

        Args:
            value (str | None): The term as Stoxkart sent it.
            table (dict): One of the vocabulary tables on this class.

        Returns:
            str | None: The shared term, the term uppercased when the table does not know it, or None when it is blank.
        """
        if value is None:
            return None
        key = " ".join(value.upper().replace("_", " ").split())
        if key in table:
            return table[key]
        return key

    def _decimal(self, value):
        """Returns a value as a float.

        Args:
            value (str | None): The raw field value.

        Returns:
            float | None: The number, or None when the value is missing or not numeric.
        """
        if value is None:
            return None
        try:
            return float(value)
        except ValueError:
            return None

    def _integer(self, value):
        """Returns a value as an integer.

        Args:
            value (str | None): The raw field value.

        Returns:
            int | None: The number, or None when the value is missing or not numeric.
        """
        number = self._decimal(value)
        if number is None:
            return None
        return int(number)

    def _india_timestamp(self, value):
        """Converts a Stoxkart order time into an ISO timestamp with the IST offset.

        Args:
            value (str | None): The time as Stoxkart sent it, such as `16-02-2023 17:15:37`.

        Returns:
            str | None: The ISO timestamp, or None when the value is missing or in no known format.
        """
        if value is None:
            return None
        for pattern in ("%d-%b-%Y %H:%M:%S", "%d-%m-%Y %H:%M:%S", "%d/%m/%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S"):
            try:
                moment = datetime.strptime(value, pattern)
            except ValueError:
                continue
            return moment.replace(tzinfo=INDIA).isoformat()
        return None


class StoxkartOrderUpdatesStore:
    """Where the order socket's updates are written: the merged orders hash and the persistence stream.

    Attributes:
        normalizer (StoxkartUpdateNormalizer): Builds the normalized order from each update.
    """

    def __init__(self, cache, logger):
        """Registers the merge script on the Redis client the updates are written to.

        Args:
            cache (redis.Redis): The Redis client.
            logger (logging.Logger): Where writes are reported.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache
        self._logger = logger
        self.normalizer = StoxkartUpdateNormalizer()
        self._merge = cache.register_script(MERGE_SCRIPT)

    def write_updates(self, items, received_at):
        """Stores every order update in one frame's messages, keeping a variety the order book already gave.

        Args:
            items (list): The frame's messages, as dictionaries exactly as Stoxkart sent them.
            received_at (datetime): When the frame was read, as a naive India wall clock time.

        Returns:
            None: This method returns nothing.
        """
        observed_at = received_at.timestamp()
        received = received_at.strftime("%Y-%m-%d %H:%M:%S.%f")
        merge_arguments = [
            self._next_reset(),
            "websocket",
            repr(observed_at),
        ]
        stream_entries = []
        orders = []
        for item in items:
            order = self.normalizer.normalize(item)
            if order is not None:
                orders.append((order, item))
        stored_varieties = self._stored_varieties(orders)
        for order, item in orders:
            entry = {
                "observed_at": observed_at,
                "source": "websocket",
                "order": order,
                "data": item,
                "variety": self._variety(item, stored_varieties.get(order["order_id"])),
            }
            merge_arguments.append(order["order_id"])
            merge_arguments.append(json.dumps(entry))
            stream_entries.append(json.dumps({"timestamp": received, "order": order, "data": item}))

        if not stream_entries:
            return
        self._merge(keys=[ORDERS_KEY], args=merge_arguments)
        pipeline = self._cache.pipeline(transaction=False)
        for update in stream_entries:
            pipeline.xadd(STREAM_KEY, {"update": update}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()
        self._logger.info(f"Merged {len(stream_entries)} order update(s) into {ORDERS_KEY}")

    def _stored_varieties(self, orders):
        """Reads the variety already stored for each order, from the entries in `stoxkart:orders:orders`.

        Args:
            orders (list): Pairs of (normalized order, update).

        Returns:
            dict: Each order id mapped to its stored variety, uppercased, for the orders whose entry holds one.
        """
        if not orders:
            return {}
        order_ids = []
        for order, _ in orders:
            order_ids.append(order["order_id"])
        stored = self._cache.hmget(ORDERS_KEY, order_ids)
        varieties = {}
        for order_id, value in zip(order_ids, stored):
            if not value:
                continue
            try:
                entry = json.loads(value)
            except ValueError:
                continue
            if not isinstance(entry, dict):
                continue
            variety = entry.get("variety")
            data = entry.get("data")
            if not variety and entry.get("source") == "rest" and isinstance(data, dict):
                variety = data.get("variety")
            if variety:
                varieties[order_id] = str(variety).strip().upper()
        return varieties

    def _variety(self, update, stored_variety):
        """Chooses the variety an order is cancelled with.

        Stoxkart's order socket reported `NORMAL` for two after-market orders on 2026-09-15 while the order book said `AMO`, so an `AMO` or `BO` variety already stored for the order is kept, a status beginning with `AMO` means `AMO`, and only otherwise is the update's own variety used.

        Args:
            update (dict): One order update as Stoxkart sent it.
            stored_variety (str | None): The variety already stored for the order, uppercased, or None.

        Returns:
            str | None: The variety, uppercased, or None when neither the stored entry nor the update names one.
        """
        if stored_variety in ("AMO", "BO"):
            return stored_variety
        status = str(update.get("order_status") or update.get("status") or "").strip().upper()
        if status.startswith("AMO"):
            return "AMO"
        variety = str(update.get("variety") or "").strip().upper()
        if variety:
            return variety
        return stored_variety

    def _next_reset(self):
        """Returns the epoch of the next 06:00 in India, when the order hash expires.

        Returns:
            int: The epoch in seconds.
        """
        now = datetime.now(INDIA)
        reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
        if reset <= now:
            reset = reset + timedelta(days=1)
        return int(reset.timestamp())


class StoxkartOrderUpdatesApplication:
    """The command line entry point: logs in and runs the order socket until stopped."""

    def run(self):
        """Logs in, installs the signal handlers and streams order updates.

        Returns:
            int: 0 when stopped, and 1 when a login failed.
        """
        from stock_brokers.websockets.stoxkart import StoxkartOrderSocket, StoxkartSession

        logger = get_logger("stoxkart.websocket_order_details")
        try:
            session = StoxkartSession()
        except Exception as error:
            logger.error(f"Could not log in to Stoxkart: {type(error).__name__}: {error}")
            return 1

        store = StoxkartOrderUpdatesStore(get_cache(), logger)
        socket = StoxkartOrderSocket(session, store.write_updates, logger)

        def stop_socket(signal_number, frame):
            """Sets the socket's stop event.

            Args:
                signal_number (int): The signal received.
                frame (frame): The interrupted stack frame, unused.
            """
            del frame
            logger.info(f"Received signal {signal_number}. Stopping.")
            socket.stop.set()

        signal.signal(signal.SIGINT, stop_socket)
        signal.signal(signal.SIGTERM, stop_socket)
        return socket.run()


if __name__ == "__main__":
    raise SystemExit(StoxkartOrderUpdatesApplication().run())
