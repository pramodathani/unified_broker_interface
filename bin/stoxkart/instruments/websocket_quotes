#!/usr/bin/env python3
"""Stream Stoxkart market quotes from its broadcast websocket into the Redis hash `stoxkart:quotes:live`, and keep streaming until stopped.

    bin/stoxkart/instruments/websocket_quotes                                 # instruments from the Redis set stoxkart:quotes:subscriptions
    bin/stoxkart/instruments/websocket_quotes --tokens NSE:760946,MCX:565899

    redis-cli SADD stoxkart:quotes:subscriptions NSE:760946 MCX:565899
    redis-cli HGET stoxkart:quotes:live NSE:KWIL
    redis-cli HGETALL stoxkart:quotes:instruments

**The feed.** Stoxkart's API documentation gives a binary quote websocket at `ws://inmob.stoxkart.com:7763`, which could not be reached on 2026-09-15. Stoxkart's own trading website streams quotes from `wss://broadcasting-v2.stoxkart.com/` on port 443 instead, and this script connects there. The feed takes no login: the connection header's token field is left blank, exactly as Stoxkart's website sends it. It is not documented for API users, so Stoxkart may change it without notice; the REST poller this script replaced is in git history as a fallback.

**The protocol** - the broadcast requests, the packet codes and fields, the ping and the reconnect rules - is `StoxkartQuoteStream` in `stock_brokers/websockets/stoxkart.py`, whose module docstring describes it. This script chooses and names the instruments, runs the stream and writes the ticks it decodes to Redis.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `stoxkart:quotes:subscriptions`. Each is `EXCHANGE:TOKEN`, the field format of `stoxkart:instruments:master`, with the exchange one of `NSE`, `BSE`, `NFO` or `MCX`, whose broadcast segments are 1, 4, 2 and 5. Other Stoxkart exchanges are refused, because no trade packet was seen for them on 2026-09-15 and their segment numbers are unconfirmed. Each instrument is named from `stoxkart:instruments:master`: a future or option by its `symbol_description` when that begins with its `symbol`, is longer, has no space and carries a digit (`NFO:NIFTY26SEPFUT`), any other contract, such as an MCX future whose description is `COPPER` or `GOLD 995`, by its symbol, expiry, strike and option type (`MCX:CRUDEOIL21SEP26FUT`), and anything else by its `symbol` (`NSE:KWIL`).

**Keys.**

- `stoxkart:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the instrument's name, or by `EXCHANGE:TOKEN` when the master does not name it. It is not cleared at startup.
- `stoxkart:quotes:instruments`, a hash of every subscribed `EXCHANGE:TOKEN` to its name, or to an empty string when unnamed. Replaced whole at startup.
- `stoxkart:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which `bin/stoxkart/instruments/store_quotes_to_db` writes to `stoxkart.ticks`. Capped at about 1,000,000 entries.

**The tick.** Stoxkart sends each instrument's packets together in one frame, so one tick is written per instrument per frame, and only when it differs from the previous tick apart from `received_at`.

| field | from the packets |
| --- | --- |
| `id` | the instrument's name, or `EXCHANGE:TOKEN` |
| `broker`, `mode` | `stoxkart`, `full` |
| `instrument_token`, `exchange` | `EXCHANGE:TOKEN` as subscribed, the exchange |
| `last_price`, `last_quantity`, `average_price`, `volume`, `oi` | the trade packet |
| `buy_quantity`, `sell_quantity` | the top of book packet's total bid and total offered |
| `ohlc` | open, high and low from the OHLC packet, close from the previous close packet |
| `change` | the percentage change of the last price against the previous close |
| `last_trade_time` | the trade packet's last trade time plus 315532800, because Stoxkart counts seconds from 1980-01-01 UTC; null when 0 |
| `exchange_timestamp` | the trade packet's last update time plus 315532800 less 19800, because it counts India wall-clock seconds from 1980; null when 0 |
| `oi_day_high`, `oi_day_low` | null, because Stoxkart does not send them |
| `depth` | the depth packet's five `buy` and `sell` levels of `quantity`, `price` and `orders` |
| `received_at` | when this script decoded the frame |

Prices arrive as 32-bit floats in rupees and are rounded to four decimal places, which removes the float noise without touching a real tick.

Exits 0 when stopped with Ctrl+C or SIGTERM, and 2 when there is nothing to subscribe to or an instrument is not `EXCHANGE:TOKEN` on a supported exchange. A connection that fails is retried with a backoff from 1 to 60 seconds. Reads only - it places no orders.
"""

import argparse
import json
import signal
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

from utilities.configurations import get_cache, get_logger

LIVE_KEY = "stoxkart:quotes:live"
INSTRUMENTS_KEY = "stoxkart:quotes:instruments"
SUBSCRIPTIONS_KEY = "stoxkart:quotes:subscriptions"
STREAM_KEY = "stoxkart:quotes:stream"
STREAM_MAX_LENGTH = 1000000
MASTER_KEY = "stoxkart:instruments:master"
META_KEY = "stoxkart:instruments:meta"
SEGMENTS = {
    "NSE": 1,
    "NFO": 2,
    "BSE": 4,
    "MCX": 5,
}


class StoxkartInstrumentNames:
    """Trading symbols for Stoxkart instruments, read from the instrument master stored in Redis."""

    DERIVATIVE_TYPE_PREFIXES = (
        "FUT",
        "OPT",
    )

    def __init__(self, cache):
        """Remembers the Redis client.

        Args:
            cache (redis.Redis): The Redis client holding `stoxkart:instruments:master`.
        """
        self._cache = cache

    def names(self, instruments):
        """Looks up the name of every instrument.

        Args:
            instruments (list): The `EXCHANGE:TOKEN` strings to name.

        Returns:
            dict: Each `EXCHANGE:TOKEN` mapped to `EXCHANGE:SYMBOL`, or to an empty string when the master does not name it.
        """
        names = {}
        columns = self._column_positions()
        rows = []
        if columns is not None and instruments:
            rows = self._cache.hmget(MASTER_KEY, instruments)
        for index, instrument in enumerate(instruments):
            names[instrument] = ""
            if index < len(rows) and rows[index]:
                symbol = self._symbol(rows[index], columns)
                if symbol:
                    exchange = instrument.split(":")[0]
                    names[instrument] = f"{exchange}:{symbol}"
        return names

    def _symbol(self, stored, columns):
        """Picks the trading symbol out of one stored master row.

        A future or option whose `symbol_description` already names the contract, such as `NIFTY26SEPFUT`, is named by that description. A commodity contract's description is often only the commodity's name, such as `LIGHT SWEET CRUDE OIL`, `COPPER` or `GOLD 995`, so its name is built from the symbol, expiry, strike and option type instead, such as `CRUDEOIL21SEP26FUT`. Anything else is named by `symbol`.

        Args:
            stored (str): The row as the JSON array the master hash holds.
            columns (dict): Each column name mapped to its position in a row.

        Returns:
            str | None: The trading symbol, or None when the row cannot be read.
        """
        try:
            row = json.loads(stored)
        except ValueError:
            return None
        symbol = row[columns["symbol"]]
        instrument_type = str(row[columns["instrument_type"]] or "").upper()
        if not symbol or not instrument_type.startswith(self.DERIVATIVE_TYPE_PREFIXES):
            return symbol
        description = str(row[columns["symbol_description"]] or "")
        if self._is_contract_name(description, str(symbol)):
            return description
        return self._contract_name(row, columns, symbol)

    def _is_contract_name(self, description, symbol):
        """Reports whether a master row's description already names the contract.

        A contract name such as `NIFTY26SEPFUT` begins with the symbol, is longer than it, has no spaces and carries the expiry's digits. A commodity description such as `COPPER` or `GOLD 995` fails at least one of those tests.

        Args:
            description (str): The row's `symbol_description`.
            symbol (str): The row's `symbol`.

        Returns:
            bool: True when the description can be used as the trading symbol.
        """
        if not description.startswith(symbol) or len(description) <= len(symbol):
            return False
        if " " in description:
            return False
        for character in description:
            if character.isdigit():
                return True
        return False

    def _contract_name(self, row, columns, symbol):
        """Builds a contract name from the symbol, expiry, strike and option type.

        Args:
            row (list): The master row.
            columns (dict): Each column name mapped to its position in a row.
            symbol (str): The contract's underlying symbol.

        Returns:
            str: The name, such as `CRUDEOIL21SEP26FUT` or `SILVER24FEB26150000CE`, or the symbol alone when the expiry cannot be read.
        """
        try:
            expiry = datetime.strptime(str(row[columns["expiry_date"]]), "%d-%m-%Y")
        except ValueError:
            return symbol
        name = f"{symbol}{expiry.strftime('%d%b%y').upper()}"
        option_type = str(row[columns["option_type"]] or "").upper()
        if option_type not in ("CE", "PE"):
            return f"{name}FUT"
        try:
            strike = float(row[columns["strike_price"]]) / 100
        except (TypeError, ValueError):
            return f"{name}{option_type}"
        return f"{name}{strike:g}{option_type}"

    def _column_positions(self):
        """Reads the master's column order from its meta key.

        Returns:
            dict | None: Each column name mapped to its position in a row, or None when the meta key is missing or lacks a needed column.
        """
        stored = self._cache.get(META_KEY)
        if not stored:
            return None
        try:
            columns = json.loads(stored).get("columns") or []
        except ValueError:
            return None
        positions = {}
        for index, name in enumerate(columns):
            positions[name] = index
        for needed in ("instrument_type", "symbol", "symbol_description", "expiry_date", "strike_price", "option_type"):
            if needed not in positions:
                return None
        return positions


class StoxkartQuotesStore:
    """Where the quote stream's ticks are written: the live hash and the persistence stream."""

    def __init__(self, cache):
        """Keeps the Redis client the ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_ticks(self, ticks):
        """Writes one frame's ticks: each instrument's latest tick and every tick in arrival order, in one round trip.

        Args:
            ticks (list): The frame's ticks.

        Returns:
            None: This method returns nothing.
        """
        pipeline = self._cache.pipeline(transaction=False)
        for tick in ticks:
            payload = json.dumps(tick)
            pipeline.hset(LIVE_KEY, tick["id"], payload)
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()


class StoxkartQuotesApplication:
    """The command line entry point: reads the options, resolves the instruments and runs the stream."""

    def run(self):
        """Parses the options, names the instruments, and streams until stopped.

        Returns:
            int: 0 when stopped, and 2 for nothing to subscribe to or a malformed instrument.
        """
        arguments = self._parse_arguments()
        logger = get_logger("stoxkart.websocket_quotes")
        cache = get_cache()
        instruments, source = self._instruments(arguments.tokens, cache)
        if not instruments:
            logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE:TOKEN members to the Redis set {SUBSCRIPTIONS_KEY}.")
            return 2
        malformed = self._malformed(instruments)
        if malformed:
            logger.error(f"Not EXCHANGE:TOKEN on one of {', '.join(SEGMENTS)}: {', '.join(malformed)}")
            return 2

        names = StoxkartInstrumentNames(cache).names(instruments)
        pipeline = cache.pipeline(transaction=True)
        pipeline.delete(INSTRUMENTS_KEY)
        pipeline.hset(INSTRUMENTS_KEY, mapping=names)
        pipeline.execute()
        unnamed = 0
        for name in names.values():
            if not name:
                unnamed += 1
        logger.info(f"Subscribing to {len(instruments)} instrument(s) from {source}, {unnamed} without a name in {MASTER_KEY}.")

        from stock_brokers.websockets.stoxkart import StoxkartQuoteStream

        stream = StoxkartQuoteStream(instruments, names, StoxkartQuotesStore(cache).write_ticks, logger)
        self._handle_signals(stream)
        return stream.run()

    def _parse_arguments(self):
        """Reads the command line options.

        Returns:
            argparse.Namespace: The option `tokens`.
        """
        parser = argparse.ArgumentParser(description="Stream Stoxkart market quotes into stoxkart:quotes:live and stoxkart:quotes:stream.")
        parser.add_argument("--tokens", help="comma-separated EXCHANGE:TOKEN instruments instead of the subscription set")
        return parser.parse_args()

    def _instruments(self, tokens, cache):
        """Collects the instruments to subscribe.

        Args:
            tokens (str | None): The `--tokens` option, or None.
            cache (redis.Redis): The Redis client holding the subscription set.

        Returns:
            tuple: A tuple (instruments, source), where instruments is a sorted list of distinct `EXCHANGE:TOKEN` strings and source names where they came from.
        """
        if tokens:
            wanted = tokens.split(",")
            source = "--tokens"
        else:
            wanted = list(cache.smembers(SUBSCRIPTIONS_KEY))
            source = SUBSCRIPTIONS_KEY
        instruments = set()
        for instrument in wanted:
            cleaned = instrument.strip().upper()
            if cleaned:
                instruments.add(cleaned)
        return sorted(instruments), source

    def _malformed(self, instruments):
        """Finds the instruments that are not `EXCHANGE:TOKEN` on a supported exchange.

        Args:
            instruments (list): The instruments to check.

        Returns:
            list: The malformed instruments, empty when all are well formed.
        """
        malformed = []
        for instrument in instruments:
            parts = instrument.split(":")
            if len(parts) != 2 or parts[0] not in SEGMENTS or not parts[1].isdigit():
                malformed.append(instrument)
        return malformed

    def _handle_signals(self, stream):
        """Makes Ctrl+C and SIGTERM stop the stream.

        Args:
            stream (StoxkartQuoteStream): The stream to stop.
        """
        def stop_stream(signal_number, frame):
            """Sets the stream's stop event.

            Args:
                signal_number (int): The signal received.
                frame (frame): The interrupted stack frame, unused.
            """
            del frame
            stream.logger.info(f"Received signal {signal_number}. Stopping.")
            stream.stop.set()

        signal.signal(signal.SIGINT, stop_stream)
        signal.signal(signal.SIGTERM, stop_stream)


if __name__ == "__main__":
    raise SystemExit(StoxkartQuotesApplication().run())
