#!/usr/bin/env python3
"""Mark Stoxkart as logged out in the Redis key `stoxkart:session:status`.

    bin/stoxkart/session/disconnect
    redis-cli GET stoxkart:session:status

Nothing is sent to Stoxkart. The script only replaces `stoxkart:session:status` with:

    {"status": "logged out", "access-token": null, "last_login": null}

Stoxkart's API has a logout call, and it is deliberately not made: it would invalidate the one access token that every other process - the pollers, the quote feed and the REST API - is using. The stored token in the Redis `last_login` hash and in MongoDB is left alone, and Stoxkart keeps accepting it until it expires.

Exits 0 when the key was written and 1 when it could not be, in which case `stoxkart:session:status` is unchanged.
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

from utilities.configurations import get_cache

REDIS_KEY = "stoxkart:session:status"


class StoxkartLogout:
    """One run that records Stoxkart as logged out without contacting the broker."""

    def run(self):
        """Writes the logged-out record to `stoxkart:session:status`.

        Returns:
            int: 0 when the key was written, and 1 when it could not be.
        """
        record = {
            "status": "logged out",
            "access-token": None,
            "last_login": None,
        }
        try:
            get_cache().set(REDIS_KEY, json.dumps(record))
        except Exception as error:
            print(f"stoxkart could not write {REDIS_KEY}: {type(error).__name__}: {error}", file=sys.stderr)
            return 1

        print(f"stoxkart logged out in {REDIS_KEY}")
        return 0


if __name__ == "__main__":
    raise SystemExit(StoxkartLogout().run())
