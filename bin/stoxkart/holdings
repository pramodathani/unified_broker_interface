#!/usr/bin/env python3
"""Poll the Stoxkart holdings every minute and write them to the Redis key `stoxkart:portfolio:holdings`.

    bin/stoxkart/holdings
    redis-cli GET stoxkart:portfolio:holdings

Calls `GET https://openapi.stoxkart.com/portfolio/holdings` through `StoxkartAPI`, which logs in first if the stored session is dead. Each response is written as one JSON string with SET, replacing the one before: `timestamp`, `status`, `code`, and Stoxkart's holdings under `data` as a list with one row per security. An account holding nothing is written too, as an empty list.

A row seen on 2026-09-15 carries `nse_symbol` and `nse_token`, `bse_symbol` and `bse_token` (the security's symbol and token on each exchange), `isin_code`, `quantity`, `utilized_quantity`, `remaining_quantity`, `last_trade_price`, `average_price`, `collateral`, `collateral_quantity`, `market_value` and `exchange`, every value a string. This differs from Stoxkart's documentation, whose sample has a single `symbol` and `token`.

Runs until Ctrl+C. A dead session, which Stoxkart refuses with HTTP 401 and the code `AuthorizationError`, is logged in again before the next request. Any other failed poll is logged and leaves `stoxkart:portfolio:holdings` unchanged. Exits 1 when the first login, or a login after the session died, fails. Reads only - it places no orders.
"""

import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

from stock_brokers.api.stoxkart import StoxkartAPI
from utilities.configurations import get_cache, get_logger
from utilities.poll_reporter import PollReporter

HOLDINGS_URL = "https://openapi.stoxkart.com/portfolio/holdings"
REDIS_KEY = "stoxkart:portfolio:holdings"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10
AUTHENTICATION_CODES = (
    "AuthorizationError",
    "401",
    "Invalid Session",
)


class StoxkartHoldingsPoller:
    """A loop that copies Stoxkart's holdings into Redis once a minute.

    Attributes:
        logger (logging.Logger): Where logins and failures are reported.
        reporter (PollReporter): Where each cycle's outcome is reported when it changes.
        cache (redis.Redis): The Redis client the holdings are written with.
    """

    def __init__(self):
        """Creates the logger, the reporter and the Redis client."""
        self.logger = get_logger("stoxkart.holdings")
        self.reporter = PollReporter(self.logger)
        self.cache = get_cache()
        self._stoxkart = None

    def run(self):
        """Logs in and polls the holdings until interrupted.

        Returns:
            int: 0 when stopped with Ctrl+C, and 1 when a login failed.
        """
        try:
            self._stoxkart = StoxkartAPI()
        except Exception as error:
            self.logger.error(f"Could not log in to Stoxkart: {type(error).__name__}: {error}")
            return 1

        try:
            while True:
                self._poll_once()
                time.sleep(DELAY_SECONDS)
        except KeyboardInterrupt:
            self.logger.info("Stopped")
        return 0

    def _poll_once(self):
        """Fetches the holdings once and writes them, logging in again when the session is dead.

        Raises:
            StoxkartAPIException: Logging in again after a dead session failed.
        """
        try:
            holdings = self._stoxkart.get(url=HOLDINGS_URL, timeout=TIMEOUT_SECONDS)
            self.cache.set(REDIS_KEY, json.dumps(holdings))
            rows = holdings.get("data")
            count = len(rows) if isinstance(rows, list) else 0
            self.reporter.info(f"Wrote {count} holding(s) to {REDIS_KEY}")
        except Exception as error:
            if self._is_authentication_error(error):
                self.logger.warning(f"Stoxkart session expired, logging in again: {error}")
                self._stoxkart = StoxkartAPI()
            else:
                self.reporter.error(f"Holdings poll failed: {type(error).__name__}: {error}")

    def _is_authentication_error(self, error):
        """Reports whether Stoxkart refused the request because the session is dead.

        Args:
            error (Exception): The exception the request raised.

        Returns:
            bool: True when the exception carries one of Stoxkart's authentication codes.
        """
        return str(getattr(error, "code", "")) in AUTHENTICATION_CODES


if __name__ == "__main__":
    raise SystemExit(StoxkartHoldingsPoller().run())
