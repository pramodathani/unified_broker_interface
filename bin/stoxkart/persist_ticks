#!/usr/bin/env python3
"""Persist Stoxkart ticks from the Redis Stream `stoxkart:quotes:stream` into `stoxkart.ticks`, and keep persisting until stopped.

    bin/stoxkart/persist_ticks
    bin/stoxkart/persist_ticks --batch-size 2000 --flush-interval 2

    redis-cli XINFO GROUPS stoxkart:quotes:stream          # lag and pending count

`bin/stoxkart/quotes` appends every changed tick to the stream; this reads it as the `persist` consumer group and writes the ticks to the `stoxkart.ticks` hypertable with COPY, a batch at a time. A batch is written when it holds `--batch-size` ticks or has waited `--flush-interval` seconds, whichever comes first.

**Nothing is lost across a restart.** An entry is acknowledged only after the batch holding it has been committed. A crash, a refused write or a lost connection leaves the batch pending in the group, and the next read - after a reconnect, or at the next start - takes the pending entries first. The price is that a batch committed just before a crash, and not yet acknowledged, is written a second time; `stoxkart.ticks` has no unique key to stop that. The one way ticks are lost is the stream's cap: `bin/stoxkart/quotes` trims it at about 100,000 entries, so ticks trimmed while this is stopped are gone, and are counted as skipped when their pending ids come back empty.

The consumer group is created at the start of the stream the first time, so the first run persists everything already in it. Run one instance: a second would share the consumer name and re-read the first's pending entries.

**Columns.** `time` is when `bin/stoxkart/quotes` received the tick; then `id`, `instrument_token`, `exchange`, `mode`, the prices and quantities, `open`, `high`, `low` and `close` from `ohlc`, `change`, the open interest, `last_trade_time` and `exchange_timestamp` as timestamps, and the five bid and ask levels flattened into `bid1_price` to `ask5_orders`. A tick without an `id`, or one that is not JSON, is skipped and acknowledged.

**The table** is created on start from `100_stoxkart_streams.sql` in `stock_brokers/instruments/ticks/utilities/sql/ddl`, whose statements are all safe to run again, so a new database needs no separate step. A start that cannot apply it exits 1.

Exits 0 when stopped with Ctrl+C or SIGTERM, after writing and acknowledging the batch in hand, and 2 for an out-of-range option. A database or Redis that cannot be reached is retried with backoff rather than ending the process.
"""

import argparse
import io
import json
import signal
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

from utilities.configurations import get_cache, get_logger, get_postgres

STREAM_KEY = "stoxkart:quotes:stream"
STREAM_FIELD = "tick"
TABLE = "stoxkart.ticks"
DDL_FILE = "100_stoxkart_streams.sql"
DDL_DIRECTORY = PROJECT_ROOT / "stock_brokers" / "instruments" / "ticks" / "utilities" / "sql" / "ddl"
GROUP = "persist"
CONSUMER = "persist_ticks"
MINIMUM_BACKOFF_SECONDS = 1
MAXIMUM_BACKOFF_SECONDS = 60
DEPTH_LEVELS = 5


class StoxkartTickRow:
    """Flattens a normalized tick into the column order of `stoxkart.ticks`."""

    FIRST_COLUMNS = [
        "time",
        "id",
        "instrument_token",
        "exchange",
        "mode",
        "last_price",
        "last_quantity",
        "average_price",
        "volume",
        "buy_quantity",
        "sell_quantity",
        "open",
        "high",
        "low",
        "close",
        "change",
        "oi",
        "oi_day_high",
        "oi_day_low",
        "last_trade_time",
        "exchange_timestamp",
    ]

    def columns(self):
        """Lists the table's columns in the order rows are built.

        Returns:
            list: The column names, ending with the flattened depth columns.
        """
        names = list(self.FIRST_COLUMNS)
        for side in ("bid", "ask"):
            for level in range(1, DEPTH_LEVELS + 1):
                names.append(f"{side}{level}_price")
                names.append(f"{side}{level}_quantity")
                names.append(f"{side}{level}_orders")
        return names

    def build(self, tick):
        """Builds one row from a decoded tick.

        Args:
            tick (object): The decoded tick.

        Returns:
            list | None: The values in column order, or None when the tick is not a dict with an `id`.
        """
        if not isinstance(tick, dict) or not tick.get("id"):
            return None
        ohlc = tick.get("ohlc") or {}
        depth = tick.get("depth") or {}
        received_at = self._timestamp(tick.get("received_at"))
        if received_at is None:
            received_at = datetime.now(tz=timezone.utc).isoformat()
        row = [
            received_at,
            tick.get("id"),
            tick.get("instrument_token"),
            tick.get("exchange"),
            tick.get("mode"),
            tick.get("last_price"),
            tick.get("last_quantity"),
            tick.get("average_price"),
            tick.get("volume"),
            tick.get("buy_quantity"),
            tick.get("sell_quantity"),
            ohlc.get("open"),
            ohlc.get("high"),
            ohlc.get("low"),
            ohlc.get("close"),
            tick.get("change"),
            tick.get("oi"),
            tick.get("oi_day_high"),
            tick.get("oi_day_low"),
            self._timestamp(tick.get("last_trade_time")),
            self._timestamp(tick.get("exchange_timestamp")),
        ]
        for side in ("buy", "sell"):
            levels = depth.get(side) or []
            for index in range(DEPTH_LEVELS):
                level = {}
                if index < len(levels) and isinstance(levels[index], dict):
                    level = levels[index]
                row.append(level.get("price"))
                row.append(level.get("quantity"))
                row.append(level.get("orders"))
        return row

    def _timestamp(self, value):
        """Converts epoch seconds into an ISO timestamp in UTC.

        Args:
            value (object): The epoch in seconds, or None.

        Returns:
            str | None: The ISO timestamp, or None when the value is missing or cannot be converted.
        """
        if not value:
            return None
        try:
            return datetime.fromtimestamp(float(value), tz=timezone.utc).isoformat()
        except (TypeError, ValueError, OSError, OverflowError):
            return None


class StoxkartTickPersister:
    """Reads the tick stream as a consumer group and writes its entries to the table, acknowledging after commit.

    Attributes:
        written (int): How many ticks have been written.
        skipped (int): How many entries were acknowledged without a row.
    """

    def __init__(self, cache, logger, batch_size, flush_interval):
        """Remembers where to read, where to write and how to batch.

        Args:
            cache (redis.Redis): The Redis client holding the stream.
            logger (logging.Logger): Where progress and failures are reported.
            batch_size (int): The most rows written in one COPY.
            flush_interval (float): The longest a row waits, in seconds, before its batch is written.
        """
        self._cache = cache
        self._logger = logger
        self._batch_size = batch_size
        self._flush_interval = flush_interval
        self._rows = StoxkartTickRow()
        self._columns = self._rows.columns()
        self._connection = None
        self.written = 0
        self.skipped = 0

    def apply_table(self):
        """Applies the stream table DDL, which creates the table the first time and changes nothing after.

        The file is executed through psycopg2 rather than SQLAlchemy's text(), which would take colons in the file for bind parameters.

        Raises:
            Exception: The database could not be reached or refused a statement.
        """
        path = DDL_DIRECTORY / DDL_FILE
        connection = get_postgres()
        try:
            with connection.cursor() as cursor:
                cursor.execute(path.read_text())
            connection.commit()
        except Exception:
            connection.rollback()
            raise
        finally:
            connection.close()
        self._logger.info(f"Applied {path.name}.")

    def run(self, stop):
        """Persists until `stop` is set, then writes and acknowledges whatever batch is in hand.

        Args:
            stop (threading.Event): Set when persisting should end.
        """
        backoff = MINIMUM_BACKOFF_SECONDS
        pending_first = True
        batch = []
        started = time.monotonic()
        while True:
            try:
                if pending_first:
                    self._ensure_group()
                    entries = self._read(True, self._batch_size, 0)
                    if entries:
                        self._write(entries)
                    else:
                        pending_first = False
                    backoff = MINIMUM_BACKOFF_SECONDS
                    continue

                if not stop.is_set():
                    remaining = self._flush_interval
                    if batch:
                        remaining = self._flush_interval - (time.monotonic() - started)
                    entries = self._read(False, self._batch_size - len(batch), max(0.0, remaining))
                    if entries and not batch:
                        started = time.monotonic()
                    batch.extend(entries)

                due = bool(batch) and time.monotonic() - started >= self._flush_interval
                if batch and (len(batch) >= self._batch_size or due or stop.is_set()):
                    self._write(batch)
                    batch = []
                    backoff = MINIMUM_BACKOFF_SECONDS
                elif stop.is_set():
                    break
            except Exception as error:
                self._logger.error(f"Persisting failed, retrying in {backoff} seconds: {type(error).__name__}: {error}")
                self._reset_connection()
                batch = []
                pending_first = True
                if stop.is_set():
                    break
                stop.wait(backoff)
                backoff = min(backoff * 2, MAXIMUM_BACKOFF_SECONDS)
        self._reset_connection()
        self._logger.info(f"Stopped. Wrote {self.written} tick(s), skipped {self.skipped}.")

    def _ensure_group(self):
        """Creates the consumer group at the start of the stream, creating the stream too, unless the group exists.

        Raises:
            redis.RedisError: Redis refused for a reason other than the group already existing.
        """
        try:
            self._cache.xgroup_create(STREAM_KEY, GROUP, id="0", mkstream=True)
            self._logger.info(f"Created consumer group {GROUP} on {STREAM_KEY}.")
        except Exception as error:
            if "BUSYGROUP" not in str(error):
                raise

    def _read(self, pending, count, wait):
        """Reads entries for this consumer.

        Args:
            pending (bool): True to read this consumer's pending entries instead of new ones.
            count (int): The most entries to read.
            wait (float): How long to block for new entries, in seconds.

        Returns:
            list: Pairs of (entry id, fields).
        """
        stream_position = ">"
        block = max(1, int(wait * 1000))
        if pending:
            stream_position = "0"
            block = None
        response = self._cache.xreadgroup(GROUP, CONSUMER, {STREAM_KEY: stream_position}, count=count, block=block)
        entries = []
        for _, stream_entries in response or []:
            entries.extend(stream_entries)
        return entries

    def _write(self, batch):
        """Writes a batch with COPY, commits, then acknowledges every entry in it.

        Args:
            batch (list): Pairs of (entry id, fields).
        """
        buffer = io.StringIO()
        rows = 0
        skipped = 0
        for _, fields in batch:
            try:
                row = self._rows.build(json.loads((fields or {}).get(STREAM_FIELD)))
            except (TypeError, ValueError):
                row = None
            if row is None:
                skipped += 1
                continue
            values = []
            for value in row:
                values.append(self._copy_value(value))
            buffer.write("\t".join(values) + "\n")
            rows += 1

        if rows:
            if self._connection is None:
                self._connection = get_postgres()
            buffer.seek(0)
            quoted_columns = []
            for column in self._columns:
                quoted_columns.append(f'"{column}"')
            with self._connection.cursor() as cursor:
                cursor.copy_expert(f"copy {TABLE} ({', '.join(quoted_columns)}) from stdin with (format text)", buffer)
            self._connection.commit()
            self.written += rows

        entry_ids = []
        for entry_id, _ in batch:
            entry_ids.append(entry_id)
        self._cache.xack(STREAM_KEY, GROUP, *entry_ids)
        self.skipped += skipped
        self._logger.debug(f"Wrote {rows} tick(s) to {TABLE}.")

    def _copy_value(self, value):
        """Formats one value for COPY's text format.

        Args:
            value (object): The column value.

        Returns:
            str: The value with COPY's NULL marker for None and its structural characters escaped.
        """
        if value is None:
            return "\\N"
        return str(value).replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")

    def _reset_connection(self):
        """Rolls back and closes the database connection, so the next write opens a fresh one."""
        if self._connection is None:
            return
        try:
            self._connection.rollback()
            self._connection.close()
        except Exception:
            pass
        self._connection = None


class StoxkartPersistTicksApplication:
    """The command line entry point: reads the options, prepares the table and runs the persister."""

    def run(self):
        """Parses the options, applies the table DDL and persists until stopped.

        Returns:
            int: 0 when stopped, 1 when the table could not be prepared, and 2 for an out-of-range option.
        """
        arguments = self._parse_arguments()
        logger = get_logger("stoxkart.persist_ticks")
        if arguments.batch_size < 1 or arguments.flush_interval <= 0:
            logger.error("--batch-size must be at least 1 and --flush-interval above 0.")
            return 2

        persister = StoxkartTickPersister(get_cache(), logger, arguments.batch_size, arguments.flush_interval)
        try:
            persister.apply_table()
        except Exception as error:
            logger.error(f"Could not prepare {TABLE}: {type(error).__name__}: {error}")
            return 1

        stop = threading.Event()

        def request_stop(signal_number, frame):
            """Sets the stop event so the batch in hand is written before exiting.

            Args:
                signal_number (int): The signal received.
                frame (frame): The interrupted stack frame, unused.
            """
            del frame
            logger.info(f"Received signal {signal_number}. Writing the batch in hand, then stopping.")
            stop.set()

        signal.signal(signal.SIGINT, request_stop)
        signal.signal(signal.SIGTERM, request_stop)

        logger.info(f"Persisting {STREAM_KEY} into {TABLE}.")
        persister.run(stop)
        return 0

    def _parse_arguments(self):
        """Reads the command line options.

        Returns:
            argparse.Namespace: The options `batch_size` and `flush_interval`.
        """
        parser = argparse.ArgumentParser(description="Persist Stoxkart ticks from stoxkart:quotes:stream into stoxkart.ticks.")
        parser.add_argument("--batch-size", type=int, default=500, help="most ticks written in one COPY, default 500")
        parser.add_argument("--flush-interval", type=float, default=1.0, help="longest a tick waits before its batch is written, in seconds, default 1")
        return parser.parse_args()


if __name__ == "__main__":
    raise SystemExit(StoxkartPersistTicksApplication().run())
