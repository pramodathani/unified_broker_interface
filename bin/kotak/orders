#!/usr/bin/env python3
"""
Poll the day's Kotak order book every half second and merge it into the Redis hash `kotak:orders:orders`.

    bin/kotak/orders
    redis-cli HGETALL kotak:orders:orders
    redis-cli HGET kotak:orders:orders <order number>

Calls `GET {base_url}/quick/user/orders`, where `base_url` is the API host Kotak assigned the session at login, read
from the stored login with its `Auth` and `Sid`; `KotakAPI` logs in first if the stored session is dead. An empty book
answers `{"stCode": 5203, "errMsg": "No Data", "stat": "Not_Ok"}` in an HTTP 200, which is an answer and writes nothing.

**One key for orders.** `kotak:orders:orders` is a hash keyed by order number (`nOrdNo`), written by two scripts: this
poller, and `bin/kotak/order_updates`, which merges each order update from Kotak's websocket into the same hash. Every
value is

    {"observed_at": <epoch>, "source": "rest" | "websocket", "order": <normalized order>, "data": <Kotak's own order>}

Kotak's order-book row and its order message carry the same abbreviated fields, so both writers build `order` with the
same function, and `data` is the order exactly as Kotak sent it:

| field | from Kotak |
| --- | --- |
| `order_id`, `exchange_order_id`, `parent_order_id` | `nOrdNo`, `exOrdId`, `snoOrdNo` |
| `status`, `status_message` | `ordSt` (or `stat`) on the shared vocabulary; `rejRsn`, `rejectionReason`, `errMsg` or `statMsg` |
| `id`, `instrument_token`, `tradingsymbol`, `exchange` | `exSeg:trdSym`, `tok`, `trdSym` (or `sym`), `exSeg` (`nse_cm`, `nse_fo`...) |
| `transaction_type`, `product`, `order_type`, `validity` | `trnsTp`, `prod`, `prcTp`, `vldt` (or `ret`), on the shared vocabulary |
| quantities | `qty`, `fldQty`, `unFldSz` (or quantity less filled), `cnclQty`, `dscQty` |
| prices | `prc`, `trgPrc`, `avgPrc` |
| `order_timestamp`, `exchange_timestamp` | `ordDtTm`, `exCfmTm` (or `boeSec`), IST such as `12-Sep-2026 09:20:11`, ISO with the IST offset |
| `tag` | `tag`, `usrRmk` or `remarks` |

The shared vocabulary puts status on `PENDING`, `OPEN`, `COMPLETE`, `CANCELLED`, `REJECTED` and `EXPIRED`, and passes an
unknown term through uppercased.

**Which write wins.** A websocket update always replaces its entry. A row from this poller replaces an entry only when
that entry was observed before this poll's request was sent, so an update that arrived while the request was in flight
is never overwritten by the older snapshot; a stale entry is corrected by the next poll. The check and the write run
together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00, so yesterday's orders
remain readable overnight and the first poll of the day starts a fresh hash. An order is never removed before then:
one the websocket has just reported may not be in the order book yet.

Runs until Ctrl+C. A dead session (HTTP 401, "unauthorised") is logged in again before the next request; any other
failed poll, including a `Not_Ok` body other than "No Data", is logged and leaves the hash unchanged. Exits 1 when the
first login, or a login after the session died, fails. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_PATH = "/quick/user/orders"
REDIS_KEY = "kotak:orders:orders"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "kotak:orders:orders:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
TRANSACTION_TYPES = {
    "BUY": "BUY", "B": "BUY", "1": "BUY", "BUY ORDER": "BUY",
    "SELL": "SELL", "S": "SELL", "-1": "SELL", "2": "SELL", "SELL ORDER": "SELL",
}
PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}
ORDER_TYPES = {
    "MARKET": "MARKET", "MKT": "MARKET", "MKT ORDER": "MARKET", "2": "MARKET",
    "LIMIT": "LIMIT", "LMT": "LIMIT", "L": "LIMIT", "1": "LIMIT",
    "SL": "SL", "SL-LMT": "SL", "STOPLIMIT": "SL", "SL LIMIT": "SL", "4": "SL",
    "SL-M": "SL-M", "SL-MKT": "SL-M", "STOPMARKET": "SL-M", "SL MARKET": "SL-M", "3": "SL-M", "SL M": "SL-M",
    "SLM": "SL-M", "STOP LOSS": "SL", "STOP LOSS MARKET": "SL-M",
}
VALIDITIES = {
    "DAY": "DAY", "EOS": "DAY", "0": "DAY", "IOC": "IOC", "IMMEDIATE": "IOC", "1": "IOC",
    "GTT": "GTT", "GTC": "GTC", "GTD": "GTD",
}
STATUSES = {
    "PENDING": "PENDING", "TRANSIT": "PENDING", "VALIDATION PENDING": "PENDING", "PUT ORDER REQ RECEIVED": "PENDING",
    "TRIGGER PENDING": "PENDING", "AMO REQ RECEIVED": "PENDING", "PENDINGNEW": "PENDING", "O-PENDING": "PENDING",
    "OPEN": "OPEN", "OPEN PENDING": "OPEN", "NEW": "OPEN", "REPLACED": "OPEN", "ACKED": "OPEN", "APPROVED": "OPEN",
    "MODIFICATION REQUESTED": "OPEN", "MODIFIED": "OPEN", "MODIFY VALIDATION PENDING": "OPEN", "MODIFY PENDING": "OPEN",
    "PARTIALLY FILLED": "OPEN", "PARTIALLY EXECUTED": "OPEN", "PLACED": "OPEN", "PART TRADED": "OPEN",
    "PARTIALLYFILLED": "OPEN", "PENDINGREPLACE": "OPEN", "CONFIRMED": "OPEN",
    "COMPLETE": "COMPLETE", "COMPLETED": "COMPLETE", "TRADED": "COMPLETE", "FILLED": "COMPLETE",
    "EXECUTED": "COMPLETE", "FULLY EXECUTED": "COMPLETE", "DELIVERY AWAITED": "COMPLETE",
    "CANCELLED": "CANCELLED", "CANCELED": "CANCELLED", "CANCEL": "CANCELLED", "CANCEL PENDING": "CANCELLED",
    "CANCELLATION REQUESTED": "CANCELLED", "PENDINGCANCEL": "CANCELLED", "CANCELLED AFTER MARKET ORDER": "CANCELLED",
    "REJECTED": "REJECTED", "REJECT": "REJECTED", "FAILED": "REJECTED", "EXPIRED": "EXPIRED",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for Kotak's blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def first(data, *names):
    """
    The first present value among a field's spellings; Kotak's abbreviations vary between segments.

    - `data` is the payload.
    - `names` are the candidate field names.
    """
    for name in names:
        if present(data.get(name)) is not None:
            return data[name]
    return None

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def kotak_timestamp(value):
    """
    A Kotak time, IST wall clock such as `12-Sep-2026 09:20:11`, as an ISO timestamp with the IST offset, or None.

    An epoch is read as one; a placeholder before 1971 or an unrecognised string reads as None.

    - `value` is the time as Kotak sent it.
    """
    value = present(value)
    if value is None:
        return None
    raw = str(value).strip()
    if raw.replace(".", "", 1).isdigit():
        try:
            return datetime.fromtimestamp(float(raw), tz=INDIA).isoformat()
        except (ValueError, OSError, OverflowError):
            return None
    for fmt in ("%d-%b-%Y %H:%M:%S", "%d-%b-%Y %H:%M:%S.%f", "%d/%m/%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S",
                "%Y-%m-%dT%H:%M:%S", "%d-%m-%Y %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            moment = datetime.strptime(raw, fmt)
        except ValueError:
            continue
        return None if moment.year < 1971 else moment.replace(tzinfo=INDIA).isoformat()
    return None

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def normalized_order(data):
    """
    A Kotak order as a normalized order, or None when it has no order number.

    Kotak's order-book row and its order update message carry the same abbreviated fields, so both writers of
    `kotak:orders:orders` build `order` with this one function.

    - `data` is an order-book row, or an order message's `data`.
    """
    if not isinstance(data, dict) or text(data.get('nOrdNo')) is None:
        return None
    symbol, exchange = text(first(data, 'trdSym', 'sym')), text(first(data, 'exSeg', 'exch'))
    quantity, filled = number(data.get('qty'), int), number(data.get('fldQty'), int)
    pending = number(data.get('unFldSz'), int)
    if pending is None and quantity is not None and filled is not None:
        pending = quantity - filled
    return {
        "order_id": text(data.get('nOrdNo')),
        "exchange_order_id": text(data.get('exOrdId')),
        "parent_order_id": text(data.get('snoOrdNo')),
        "status": normalize(present(first(data, 'ordSt', 'stat')), STATUSES),
        "status_message": text(first(data, 'rejRsn', 'rejectionReason', 'errMsg', 'statMsg')),
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(data.get('tok')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "transaction_type": normalize(present(data.get('trnsTp')), TRANSACTION_TYPES),
        "product": normalize(present(data.get('prod')), PRODUCTS),
        "order_type": normalize(present(data.get('prcTp')), ORDER_TYPES),
        "validity": normalize(present(first(data, 'vldt', 'ret')), VALIDITIES),
        "quantity": quantity,
        "filled_quantity": filled,
        "pending_quantity": pending,
        "cancelled_quantity": number(data.get('cnclQty'), int),
        "disclosed_quantity": number(data.get('dscQty'), int),
        "price": number(data.get('prc')),
        "trigger_price": number(data.get('trgPrc')),
        "average_price": number(data.get('avgPrc')),
        "order_timestamp": kotak_timestamp(data.get('ordDtTm')),
        "exchange_timestamp": kotak_timestamp(first(data, 'exCfmTm', 'boeSec')),
        "tag": text(first(data, 'tag', 'usrRmk', 'remarks')),
    }

# Kotak's status code for an answer with nothing in it.
NO_DATA_STATUS_CODE = 5203

# What Kotak says when the session is no good, lowercased. A dead session is HTTP 401 and "unauthorised".
AUTHENTICATION_MARKERS = ("unauthorised", "unauthorized", "invalid session", "session expired")

def kotak_request(kotak, method, path, body=None):
    """
    Call a Kotak path on the session's host and return the response in the API client's shape.

    Made here rather than through the API client, because the client drops `timeout`. Kotak's "No Data"
    answer comes back with `data` as `[]`; any other `Not_Ok` body, and any HTTP error, raises
    KotakAPIException.

    - `kotak` is the KotakAPI whose stored login supplies the host, `Auth` and `Sid`.
    - `method` is the HTTP method.
    - `path` is the path on the session's host.
    - `body` is the form body to send, if any.
    """
    import requests
    from stock_brokers.api.kotak import KotakAPIException

    login = kotak._current_login() or {}
    headers = {"neo-fin-key": "neotradeapi", "Auth": str(login.get("access_token")), "Sid": str(login.get("sid"))}
    response = requests.request(method, kotak.url(path), data=body, headers=headers, timeout=TIMEOUT_SECONDS)
    if response.status_code >= 300:
        raise KotakAPIException(code=response.status_code, message=response.text[:300])
    try:
        payload = response.json()
    except ValueError:
        raise KotakAPIException(code=response.status_code, message=response.text[:300])

    content = {'timestamp': datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f"), 'status': 'success',
               'code': response.status_code}
    if isinstance(payload, dict) and payload.get('stCode') == NO_DATA_STATUS_CODE:
        return {**content, 'data': []}
    if isinstance(payload, dict) and payload.get('stat') not in (None, 'Ok'):
        message = str(payload.get('errMsg') or payload.get('emsg') or payload)
        raise KotakAPIException(code=payload.get('stCode'), message=message[:300])
    return {**content, 'data': payload.get('data') if isinstance(payload, dict) and 'data' in payload else payload}

def is_authentication_error(exception):
    """Whether Kotak refused the request because the session is dead."""
    if str(getattr(exception, 'code', '')) == '401':
        return True
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the order book and merge it into kotak:orders:orders every half second, until interrupted."""
    from stock_brokers.api.kotak import KotakAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("kotak.orders")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        kotak = KotakAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Kotak: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = kotak_request(kotak, 'GET', ORDERS_PATH)
                rows = response['data'] if response['data'] not in (None, {}) else []
                if not isinstance(rows, list):
                    raise ValueError(f"Kotak answered without a list: {str(rows)[:200]}")
                arguments = [next_reset(), "rest", repr(requested_at)]
                for row in rows:
                    order = normalized_order(row)
                    if order is not None:
                        arguments += [order["order_id"], json.dumps({"observed_at": requested_at, "source": "rest",
                                                                     "order": order, "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {len(rows)} order(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Kotak session expired, logging in again: {exception}")
                    kotak = KotakAPI()
                else:
                    report.error(f"Orders poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
