#!/usr/bin/env python3
"""Streams Kotak Neo market quotes over websockets into the Redis hash `kotak:quotes:live` until stopped.

    bin/kotak/instruments/websocket_quotes                                        # instruments from the Redis set kotak:quotes:subscriptions
    bin/kotak/instruments/websocket_quotes --tokens "nse_cm|11536,mcx_fo|565899"
    bin/kotak/instruments/websocket_quotes --per-socket 50

    redis-cli SADD kotak:quotes:subscriptions "nse_cm|11536" "nse_fo|42020"
    redis-cli HGET kotak:quotes:live "TCS-EQ"
    redis-cli HGETALL kotak:quotes:instruments

The connection, the login, the subscription, the acknowledgements and the binary packet decoding for Kotak's HSM market feed at `wss://mlhsm.kotaksecurities.com`, the feed Kotak's own Python SDK (`neo_api_client`) streams from, are `KotakQuotesSocket` and `KotakSession` in `stock_brokers/websockets/kotak.py`, whose module docstring describes the protocol. This script chooses the instruments, splits them across sockets, runs the sockets and writes what they decode to Redis, so it needs no other feed process or key.

**Instruments** are `--tokens` when given, otherwise the members of the Redis set `kotak:quotes:subscriptions`, each as `EXCHANGE|TOKEN` with Kotak's lowercase segment names - `nse_cm`, `bse_cm`, `nse_fo`, `bse_fo`, `cde_fo`, `nse_com`, `bse_cd`, `bse_co` or `mcx_fo` - and the instrument's `pSymbol` from Kotak's scrip master. Each is named with its trading symbol (`pTrdSymbol`) from Kotak's public scrip master files for today, downloaded at startup; an instrument those do not name takes the trading symbol the feed's first snapshot carries. One websocket carries up to `--per-socket` instruments, 100 by default and at most, because every instrument takes two of the 200 subscriptions Kotak allows on one channel.

**Keys.**

- `kotak:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the instrument's trading symbol (`TCS-EQ`), or by its `EXCHANGE|TOKEN` while it has no name. A tick is replaced as the next one arrives. It is not cleared at startup, so an instrument no longer subscribed keeps its last tick.
- `kotak:quotes:instruments`, a hash of every subscribed `EXCHANGE|TOKEN` to its trading symbol, or to an empty string when unnamed. Replaced whole at startup, and filled in when a snapshot names an instrument.
- `kotak:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which `bin/kotak/instruments/store_quotes_to_db` writes to `kotak.ticks`. Capped at about 1,000,000 entries, so ticks that arrive while the persister is down for long enough are trimmed before they are persisted.

**The tick.** Every instrument is subscribed twice: as a scrip topic (`sf|EXCHANGE|TOKEN`) for its prices and quantities, and as a depth topic (`dp|EXCHANGE|TOKEN`) for its five-level order book. A topic arrives once as a snapshot and then as updates carrying only the fields that changed, so the script keeps each topic's latest values and writes a whole tick for an instrument every time either of its topics changes. A tick is written only once the scrip snapshot has arrived.

| Tick field | Scrip topic field |
| --- | --- |
| `last_price` | 5 (`ltp`) |
| `last_quantity` | 6 (`ltq`) |
| `average_price` | 13 (`ap`) |
| `volume` | 4 (`v`) |
| `buy_quantity`, `sell_quantity` | 7 (`tbq`), 8 (`tsq`) |
| `ohlc` | 20 (`op`), 15 (`h`), 14 (`lo`), 21 (`c`, the previous session's close) |
| `change` | Computed as the percentage of `last_price` over `close` |
| `oi` | 22 (`oi`), which cash instruments do not send |
| `last_trade_time` | 3 (`ltt`), epoch seconds |
| `exchange_timestamp` | 2 (`fdtm`), epoch seconds |
| `depth` | The depth topic: prices 2 to 6 (buy) and 7 to 11 (sell), quantities 12 to 16 and 17 to 21, orders 22 to 26 and 27 to 31 |

`oi_day_high` and `oi_day_low` are always `None`. `mode` is `full` once the depth topic has arrived and `quote` before. Prices are integers divided by the topic's multiplier (scrip field 23, depth field 32) times ten to its precision (scrip field 24, depth field 33). On MCX every quantity, open interest and order book quantity included, is lots times Kotak's own lot size; on NSE and BSE quantities are units.

**Sessions.** Each connection reads the access token and session id in force when it connects, so a login made by any process is picked up. When Kotak refuses the connection, or a socket fails to open six times running, it logs in again through the shared `KotakSession` - one socket at a time, and only if no other socket or process already replaced the session - before reconnecting. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket still cannot open after logging in again, and 2 when there is nothing to subscribe to or `--per-socket` is out of range. Reads only - it places no orders.
"""

import argparse
import csv
import json
import signal
import sys
import threading
from datetime import date
from io import StringIO
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

SCRIP_MASTER_BASE_URL = "https://lapi.kotaksecurities.com/wso2-scripmaster/v1/prod"
SCRIP_MASTER_FILES = (
    "transformed/cde_fo",
    "transformed/mcx_fo",
    "transformed/nse_fo",
    "transformed/bse_fo",
    "transformed/nse_com",
    "transformed-v1/bse_cm-v1",
    "transformed-v1/nse_cm-v1",
)

LIVE_KEY = "kotak:quotes:live"
INSTRUMENTS_KEY = "kotak:quotes:instruments"
SUBSCRIPTIONS_KEY = "kotak:quotes:subscriptions"
STREAM_KEY = "kotak:quotes:stream"
STREAM_MAX_LENGTH = 1000000

SEGMENTS = (
    "nse_cm",
    "nse_fo",
    "cde_fo",
    "nse_com",
    "bse_cm",
    "bse_fo",
    "bse_cd",
    "bse_co",
    "mcx_fo",
)

DEFAULT_PER_SOCKET = 100
MAX_PER_SOCKET = 100


class KotakQuotesStore:
    """Where the quotes sockets' output is written: learned names, the live hash and the persistence stream."""

    def __init__(self, cache):
        """Keeps the Redis client the names and ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_name(self, instrument_token, trading_symbol):
        """Fills in the trading symbol a snapshot gave an instrument in the subscribed instruments hash.

        Args:
            instrument_token (str): The instrument's `EXCHANGE|TOKEN`.
            trading_symbol (str): Its trading symbol.

        Returns:
            None: This method returns nothing.
        """
        self._cache.hset(INSTRUMENTS_KEY, instrument_token, trading_symbol)

    def write_ticks(self, ticks):
        """Writes one data frame's ticks to the live hash and the stream in one round trip.

        Args:
            ticks (list[dict]): The ticks, in arrival order.

        Returns:
            None: This method returns nothing.
        """
        encoded = []
        for tick in ticks:
            encoded.append((tick["id"], json.dumps(tick)))
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, mapping=dict(encoded))
        for _, payload in encoded:
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()


class KotakQuotesApplication:
    """The command line program: resolves the instruments, starts the sockets and waits for them."""

    def __init__(self):
        """Prepares an application with no sockets yet."""
        self._sockets = []
        self._logger = None

    def _parse_arguments(self):
        """Reads the command line.

        Returns:
            argparse.Namespace: The arguments.
        """
        parser = argparse.ArgumentParser(description="Stream Kotak Neo market quotes into kotak:quotes:live until stopped.")
        parser.add_argument("--tokens", help='comma separated EXCHANGE|TOKEN tokens, for example "nse_cm|11536"')
        parser.add_argument("--per-socket", type=int, default=DEFAULT_PER_SOCKET, help=f"instruments per websocket connection, default and at most {MAX_PER_SOCKET}")
        return parser.parse_args()

    def _resolve_tokens(self, tokens, cache):
        """Returns the valid `EXCHANGE|TOKEN` instruments to subscribe to: `--tokens` when given, otherwise the subscription set.

        Args:
            tokens (str | None): A comma separated list of instrument tokens.
            cache (redis.Redis): The Redis client.

        Returns:
            list[str]: The instruments, sorted and without duplicates.
        """
        if tokens:
            wanted = tokens.split(",")
            source = "--tokens"
        else:
            wanted = list(cache.smembers(SUBSCRIPTIONS_KEY))
            source = SUBSCRIPTIONS_KEY

        cleaned = set()
        for token in wanted:
            if isinstance(token, bytes):
                token = token.decode("utf-8")
            token = str(token).strip()
            if token:
                cleaned.add(token)

        resolved = []
        for token in sorted(cleaned):
            segment, _, instrument = token.partition("|")
            if segment in SEGMENTS and instrument.isdigit():
                resolved.append(token)
            else:
                self._logger.warning(f"Skipping {token}: expected EXCHANGE|TOKEN with EXCHANGE one of {', '.join(SEGMENTS)}.")
        self._logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
        return resolved

    def _instrument_names(self, instrument_tokens):
        """Returns the trading symbols of the subscribed instruments from today's scrip master files.

        A file that cannot be downloaded is reported and skipped; its instruments take their names from the feed's snapshots instead.

        Args:
            instrument_tokens (list[str]): The subscribed `EXCHANGE|TOKEN` instruments.

        Returns:
            dict[str, str]: `EXCHANGE|TOKEN` to trading symbol.
        """
        import requests

        wanted = set(instrument_tokens)
        wanted_segments = set()
        for instrument_token in instrument_tokens:
            wanted_segments.add(instrument_token.partition("|")[0])

        names = {}
        for path in SCRIP_MASTER_FILES:
            segment = path.rsplit("/", 1)[1].removesuffix("-v1")
            if segment not in wanted_segments:
                continue
            url = f"{SCRIP_MASTER_BASE_URL}/{date.today().isoformat()}/{path}.csv"
            try:
                response = requests.get(url, timeout=120)
                response.raise_for_status()
            except Exception as exception:
                self._logger.warning(f"Could not download Kotak's {segment} scrip master: {exception}")
                continue
            for row in csv.DictReader(StringIO(response.text)):
                instrument_token = f"{(row.get('pExchSeg') or '').strip()}|{(row.get('pSymbol') or '').strip()}"
                trading_symbol = (row.get("pTrdSymbol") or "").strip()
                if instrument_token in wanted and trading_symbol:
                    names[instrument_token] = trading_symbol
        return names

    def _handle_signal(self, signal_number, frame):
        """Closes every socket when systemd or Ctrl+C asks the program to stop.

        Args:
            signal_number (int): The signal received.
            frame (types.FrameType | None): The interrupted frame.
        """
        del frame
        self._logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in self._sockets:
            socket.close()

    def run(self):
        """Streams Kotak quotes into kotak:quotes:live until stopped.

        Returns:
            int: The exit code: 0 when stopped, 1 when a login fails or a socket gives up, 2 for bad arguments or nothing to subscribe to.
        """
        arguments = self._parse_arguments()

        from stock_brokers.websockets.kotak import KotakQuotesSocket, KotakSession
        from utilities.configurations import get_cache, get_logger

        self._logger = get_logger("kotak.websocket_quotes")
        cache = get_cache()

        if arguments.per_socket < 1 or arguments.per_socket > MAX_PER_SOCKET:
            self._logger.error(f"--per-socket must be between 1 and {MAX_PER_SOCKET}.")
            return 2

        instrument_tokens = self._resolve_tokens(arguments.tokens, cache)
        if not instrument_tokens:
            self._logger.error(f"Nothing to subscribe to. Pass --tokens or add EXCHANGE|TOKEN members to the Redis set {SUBSCRIPTIONS_KEY}.")
            return 2

        try:
            session = KotakSession(self._logger)
        except Exception as exception:
            self._logger.error(f"Could not log in to Kotak: {type(exception).__name__}: {exception}")
            return 1

        names = self._instrument_names(instrument_tokens)
        instruments = {}
        unnamed = []
        for instrument_token in instrument_tokens:
            instruments[instrument_token] = names.get(instrument_token, "")
            if instrument_token not in names:
                unnamed.append(instrument_token)
        pipeline = cache.pipeline()
        pipeline.delete(INSTRUMENTS_KEY)
        pipeline.hset(INSTRUMENTS_KEY, mapping=instruments)
        pipeline.execute()
        self._logger.info(f"Wrote {len(instrument_tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")
        if unnamed:
            self._logger.warning(f"{len(unnamed)} instrument(s) are not in the scrip master and are keyed by token until Kotak names them: {', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

        store = KotakQuotesStore(cache)
        for start in range(0, len(instrument_tokens), arguments.per_socket):
            batch = instrument_tokens[start:start + arguments.per_socket]
            socket_name = f"socket_{len(self._sockets)}"
            self._sockets.append(KotakQuotesSocket(socket_name, batch, names, session, store.write_name, store.write_ticks, self._logger))

        signal.signal(signal.SIGINT, self._handle_signal)
        signal.signal(signal.SIGTERM, self._handle_signal)

        threads = []
        for socket in self._sockets:
            threads.append(threading.Thread(target=socket.run_forever, name=f"kotak_quotes_{socket.name}", daemon=True))
        self._logger.info(f"Starting {len(self._sockets)} websocket(s) for {len(instrument_tokens)} instrument(s).")
        for thread in threads:
            thread.start()

        while any(thread.is_alive() for thread in threads):
            for thread in threads:
                thread.join(timeout=1)

        gave_up = []
        for socket in self._sockets:
            if socket.gave_up:
                gave_up.append(socket.name)
        if gave_up:
            self._logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
            return 1
        self._logger.info("Quotes feed stopped.")
        return 0


if __name__ == "__main__":
    raise SystemExit(KotakQuotesApplication().run())
