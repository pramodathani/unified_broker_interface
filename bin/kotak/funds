#!/usr/bin/env python3
"""
Poll the Kotak funds every half second and write them to the Redis key `kotak:portfolio:funds`.

    bin/kotak/funds
    redis-cli GET kotak:portfolio:funds

Calls `POST {base_url}/quick/user/limits` with the form body `jData={"seg":"ALL","exch":"ALL","prod":"ALL"}`,
where `base_url` is the API host Kotak assigned the session at login, read from the stored login with its
`Auth` and `Sid`; `KotakAPI` logs in first if the stored session is dead. Each response - `timestamp`,
`status`, `code` and Kotak's limits under `data`, about eighty flat fields covering every segment and
product: `Net` (the available balance), `CollateralValue`, `AdhocMargin`, `MarginUsed`, `SpanMarginPrsnt`,
`ExposureMarginPrsnt`, `RealizedMtomPrsnt`, `UnrealizedMtomPrsnt`, `RmsPayInAmt`, `RmsPayOutAmt`, and the
per-segment SPAN and exposure fields - is written as one JSON string with SET, replacing the one before.

Runs until Ctrl+C. A dead session (HTTP 401, "unauthorised") is logged in again before the next request;
any other failed poll, including a `Not_Ok` body other than "No Data", is logged and leaves
`kotak:portfolio:funds` unchanged. Exits 1 when the first login, or a login after the session died, fails.
Reads only - it places no orders.
"""

import sys
import json
import time
from datetime import datetime
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

LIMITS_PATH = "/quick/user/limits"
REDIS_KEY = "kotak:portfolio:funds"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

# The limits body must be this Noren-style form; the plain JSON and form bodies in Kotak's documentation get a 500.
LIMITS_BODY = "jData=" + json.dumps({"seg": "ALL", "exch": "ALL", "prod": "ALL"})

# Kotak's status code for an answer with nothing in it.
NO_DATA_STATUS_CODE = 5203

# What Kotak says when the session is no good, lowercased. A dead session is HTTP 401 and "unauthorised".
AUTHENTICATION_MARKERS = ("unauthorised", "unauthorized", "invalid session", "session expired")

def kotak_request(kotak, method, path, body=None):
    """
    Call a Kotak path on the session's host and return the response in the API client's shape.

    Made here rather than through the API client, because the client drops `timeout`. Kotak's "No Data"
    answer comes back with `data` as `[]`; any other `Not_Ok` body, and any HTTP error, raises
    KotakAPIException.

    - `kotak` is the KotakAPI whose stored login supplies the host, `Auth` and `Sid`.
    - `method` is the HTTP method.
    - `path` is the path on the session's host.
    - `body` is the form body to send, if any.
    """
    import requests
    from stock_brokers.api.kotak import KotakAPIException

    login = kotak._current_login() or {}
    headers = {"neo-fin-key": "neotradeapi", "Auth": str(login.get("access_token")), "Sid": str(login.get("sid"))}
    response = requests.request(method, kotak.url(path), data=body, headers=headers, timeout=TIMEOUT_SECONDS)
    if response.status_code >= 300:
        raise KotakAPIException(code=response.status_code, message=response.text[:300])
    try:
        payload = response.json()
    except ValueError:
        raise KotakAPIException(code=response.status_code, message=response.text[:300])

    content = {'timestamp': datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f"), 'status': 'success',
               'code': response.status_code}
    if isinstance(payload, dict) and payload.get('stCode') == NO_DATA_STATUS_CODE:
        return {**content, 'data': []}
    if isinstance(payload, dict) and payload.get('stat') not in (None, 'Ok'):
        message = str(payload.get('errMsg') or payload.get('emsg') or payload)
        raise KotakAPIException(code=payload.get('stCode'), message=message[:300])
    return {**content, 'data': payload.get('data') if isinstance(payload, dict) and 'data' in payload else payload}

def is_authentication_error(exception):
    """Whether Kotak refused the request because the session is dead."""
    if str(getattr(exception, 'code', '')) == '401':
        return True
    return any(marker in str(exception).lower() for marker in AUTHENTICATION_MARKERS)

def main():
    """Fetch the limits and write them to kotak:portfolio:funds every half second, until interrupted."""
    from stock_brokers.api.kotak import KotakAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("kotak.funds")
    report = PollReporter(logger)
    cache = get_cache()
    try:
        kotak = KotakAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Kotak: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                funds = kotak_request(kotak, 'POST', LIMITS_PATH, body=LIMITS_BODY)
                if not isinstance(funds['data'], dict):
                    raise ValueError(f"Kotak answered the limits request without limits: {str(funds['data'])[:200]}")
                cache.set(REDIS_KEY, json.dumps(funds))
                report.info(f"Wrote funds (net {funds['data'].get('Net')}, margin used {funds['data'].get('MarginUsed')}) "
                            f"to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Kotak session expired, logging in again: {exception}")
                    kotak = KotakAPI()
                else:
                    report.error(f"Funds poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
