#!/usr/bin/env python3
"""
Stream Kotak Neo order and position updates over a websocket and merge them into the Redis hashes `kotak:orders:orders`
and `kotak:portfolio:positions`, and keep streaming until stopped.

    bin/kotak/order_updates
    redis-cli HGETALL kotak:orders:orders
    redis-cli HGET kotak:orders:orders <order number>
    redis-cli HGETALL kotak:portfolio:positions

Self-contained: it logs in with `KotakAPI` and carries its own connection to Kotak's order update stream, so it
needs no other feed process or key.

**The stream.** The host is account specific: `wss://<host>/realtime`, where the host is the `base_url` Kotak
assigned the session at login - `e21`, `e43` and so on - read afresh on every connect. After connecting it sends
Kotak's connection frame, which is a raw unquoted string and deliberately not JSON:
`{type:cn,Authorization:<access token>,Sid:<session id>,src:WEB}`. Kotak acknowledges it with `{"ak":"ok",
"type":"cn",...}` or refuses it with `{"ak":"nk","type":"failed to connect","msg":...}`. From then on the same
connection carries two kinds of JSON message:

- `{"type": "order", "data": {...}}`, an order with Kotak's abbreviated fields: `nOrdNo`, `exOrdId`, `ordSt`,
  `rejRsn`, `trdSym`, `sym`, `exSeg`, `tok`, `trnsTp`, `prcTp`, `prod`, `vldt`, `qty`, `fldQty`, `unFldSz`, `prc`,
  `trgPrc`, `avgPrc`, `ordDtTm`, `exCfmTm` and more.
- `{"type": "position", "data": {...}}`, a position: `trdSym`, `sym`, `exSeg`, `tok`, `prod`, `flBuyQty`,
  `flSellQty`, `buyAmt`, `sellAmt`, `lotSz`, `multiplier`, `hsUpTm` and more.

**The keys.** Orders and positions from this socket are merged into the same hashes the REST pollers fill, so each has
one key:

- `kotak:orders:orders`, keyed by order number (`nOrdNo`), shared with `bin/kotak/orders`.
- `kotak:portfolio:positions`, keyed `exSeg:tok:prod` - segment, instrument token and product, as Kotak holds a
  separate position per product on the same instrument; the trading symbol stands in for a missing token - shared with
  `bin/kotak/positions`.

Each update is written as `{"observed_at": <epoch received>, "source": "websocket", "order" | "position": <normalized>,
"data": <Kotak's payload exactly as sent>}`. Kotak's order message and order-book row carry the same fields, as do its
position message and positions row, so `order` and `position` are built with the same functions as the pollers' - see
`bin/kotak/orders` and `bin/kotak/positions` for their fields. A websocket update always replaces its entry; a polled
row replaces it only when the entry was observed before the poll's request was sent. Both hashes expire at 06:00 IST,
moved to the next 06:00 by every write.

**The streams.** Every update is also appended, in arrival order and with the same JSON, to a Redis Stream, so the
history the hashes overwrite is kept there - in the shape `{"timestamp": ..., "data": <Kotak's payload>}`: orders to `kotak:order-updates:stream` as an `update` field, which
`bin/kotak/persist_orders` writes to `kotak.order_updates`, and positions to `kotak:positions_updates:stream` as a
`position` field, which `bin/kotak/persist_positions` writes to `kotak.positions`. Each is capped at about 20,000
entries.

**Sessions.** A refused connection frame, or a socket that fails to open six times running, is taken as a dead
session: it logs in again through `KotakAPI` before reconnecting, which also refreshes the host. A reconnect
otherwise backs off from 1 to 60 seconds. Updates arrive only when an order or position changes, so a quiet socket
is not a broken one.

Exits 0 when stopped with Ctrl+C or SIGTERM, and 1 when a login fails or the socket is still refused after logging
in again. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import signal
import threading
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

REALTIME_PATH = "/realtime"
ORDERS_KEY = "kotak:orders:orders"
POSITIONS_KEY = "kotak:portfolio:positions"

# Every order and position update is also appended to a stream, for bin/kotak/persist_orders and
# bin/kotak/persist_positions, which read them with a consumer group.
ORDER_STREAM_KEY = "kotak:order-updates:stream"
POSITION_STREAM_KEY = "kotak:positions_updates:stream"
STREAM_MAX_LENGTH = 20000

ORDER, POSITION, CONNECT_ACK = "order", "position", "cn"

PING_INTERVAL_SECONDS = 30
PING_TIMEOUT_SECONDS = 10
MIN_BACKOFF_SECONDS = 1
MAX_BACKOFF_SECONDS = 60
MAX_FAILED_CONNECTS = 6

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
