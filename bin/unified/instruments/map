#!/usr/bin/env python3
"""
Map every broker's instrument snapshot into `unified.instruments` and `unified.broker_mappings`, and cache the day's rows
in Redis as `unified:instruments` and `unified:broker_mappings`.

    bin/unified/instruments/map                                      # every broker, today
    bin/unified/instruments/map dhan kotak                           # only these
    bin/unified/instruments/map --date 2026-09-14                    # a date already downloaded, not older than one already mapped
    bin/unified/instruments/map --skip-collisions                    # leave stale duplicate instruments alone
    bin/unified/instruments/map --cache-only --date 2026-09-13       # only rewrite the Redis cache for a mapped date

    redis-cli HGET unified:instruments <instrument id>
    redis-cli HGET unified:broker_mappings dhan:<instrument id>
    redis-cli HGET unified:broker_tokens dhan:2885
    redis-cli HGET unified:instrument_symbols nse_equities:RELIANCE
    redis-cli GET unified:mapping:meta

Each run does five things, in order; `--cache-only` does only the last three, for a date already mapped.

**1. Tables.** The DDL under `stock_brokers/instruments/mapping/utilities/sql/ddl` is applied - every statement is safe
to run again - which creates the `unified` schema and its two tables the first time. `unified.broker_mappings` is a
hypertable by `mapping_date`.

**2. Mapping.** The brokers' stored snapshots in `<broker>.instruments` for the date are mapped by the project's
mapping stage, pointed at the unified tables: each broker's rows are classified by its rules file, given a computed
`instrument_id`, and upserted into `unified.instruments` (seen dates only widen) and `unified.broker_mappings` (the
broker's rows for the date replaced). Brokers run in the fixed order the mapping needs, because later brokers read
index rows earlier ones wrote; one without rows stored for the date is skipped. When all ten brokers had rows stored
for the date, stale duplicate instruments are merged away afterwards, even if one of them failed to map, unless
`--skip-collisions`. A date older than the newest date
already in `unified.broker_mappings` is refused: mapping an older date on top of newer data leaves seen dates and index
names resolved in the wrong order, and a backfill has to start from empty tables instead.

**3. Contract sizes.** `stock_brokers/instruments/mapping/utilities/contract_sizes.py` decides how many quotation units
one lot of every live currency and commodity derivative is, from the contract size fields several brokers' snapshots
carry, and writes each decision, its status and every source's figure to `unified.contract_sizes` for the date. An
order on such a contract reads only that decision. A failure is logged and does not fail the run; orders on those
contracts are then refused, because the warm finds no decision for them.

**4. Cache.** The mapped date's rows are written to Redis, whether or not every broker mapped:

- `unified:instruments`, a hash of every instrument mapped on the date, keyed by `instrument_id`, each value a JSON
  array in the order `columns.instruments` in the meta gives: `exchange`, `segment`, `shape`, `symbol`,
  `underlying_symbol`, `expiry_date`, `strike_price`, `option_type`, `first_seen_date`, `last_seen_date`.
- `unified:broker_mappings`, a hash of the date's mappings keyed `broker:instrument_id` - a token is not unique within
  a broker, so the instrument is the key - each value a JSON array of `broker_token`, `broker_symbol`,
  `order_symbol`, `lot_size`, `tick_size`.
- `unified:broker_tokens`, the reverse lookup: a hash keyed `broker:broker_token`, each value a JSON array of the
  instrument ids that token names on the date. Usually one; several where a broker reuses a token across an exchange's
  scrip files, which a reader tells apart by the instruments' segments.
- `unified:instrument_symbols`, securities by symbol for a broker that sends no token: a hash keyed
  `segment:SYMBOL` (`nse_equities:RELIANCE`), each value the instrument id as a JSON string.
- `unified:mapping:meta`, a JSON object: `mapping_date`, the four counts, `columns`, and `written_at`.

Dates are ISO strings and numbers JSON numbers. All four hashes are built under `:staging` keys and swapped in together with
the meta, so a reader sees yesterday's complete cache or today's, never a mix; the previous hashes are unlinked in the
background. For today's date that is about half a million instruments and two million mappings.

**5. The REST API's catalogue.** The REST API's instrument routes read the mapping cache in
`stock_brokers/instruments/mapping/utilities/cache.py` - identities, each broker's tokens, order handles, and a
browsable catalogue per segment, and the contract size decisions - so it is warmed for the date from the unified tables, under `unified:catalogue:`,
and every other date's keys there are cleared. A warm that fails is logged and does not fail the run: the API reads the
unified tables until the next warm succeeds.

Exits 0 when every broker with rows mapped without errors and the cache was written; 1 when a broker failed, rows
could not be mapped, no broker had rows stored for the date, the tables could not be prepared or the cache could not
be written; and 2 for a bad argument or a date older than the newest mapped.
"""

import sys
import json
import argparse
from datetime import date, datetime
from decimal import Decimal
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

INSTRUMENTS_KEY = "unified:instruments"
BROKER_MAPPINGS_KEY = "unified:broker_mappings"
BROKER_TOKENS_KEY = "unified:broker_tokens"
INSTRUMENT_SYMBOLS_KEY = "unified:instrument_symbols"
META_KEY = "unified:mapping:meta"
FIELDS_PER_BATCH = 10000

INSTRUMENT_COLUMNS = ["exchange", "segment", "shape", "symbol", "underlying_symbol", "expiry_date", "strike_price",
                      "option_type", "first_seen_date", "last_seen_date"]
MAPPING_COLUMNS = ["broker_token", "broker_symbol", "order_symbol", "lot_size", "tick_size"]

def json_value(value):
    """
    A database value as JSON can hold it: dates as ISO strings, whole numerics as integers, other numerics as floats.

    - `value` is the column value.
    """
    if isinstance(value, (date, datetime)):
        return value.isoformat()
    if isinstance(value, Decimal):
        return int(value) if value == value.to_integral_value() else float(value)
    return value

def apply_tables(logger):
    """
    Apply the mapping DDL, which creates the unified schema and tables the first time and changes nothing after.

    - `logger` is where progress is reported.
    """
    from stock_brokers.instruments.mapping.utilities.sql.apply_ddl import DDL_DIRECTORY
    from stock_brokers.instruments.sql.apply_ddl import apply_all

    logger.info(f"Applying the DDL in {DDL_DIRECTORY}.")
    apply_all(DDL_DIRECTORY)


def newest_mapping_date(connect):
    """
    The newest date in unified.broker_mappings, or None when it is empty.

    - `connect` opens a database connection.
    """
    connection = connect()
    try:
        with connection.cursor() as cursor:
            cursor.execute("select max(mapping_date) from unified.broker_mappings")
            return cursor.fetchone()[0]
    finally:
        connection.rollback()
        connection.close()

def write_cache(cache, connect, mapping_date, logger):
    """
    Cache the date's instruments, mappings and the two lookups under staging keys, then swap all four in with the meta.

    Returns a dict of the counts written per key, or None when nothing is mapped on the date.

    - `cache` is the Redis client.
    - `connect` opens a database connection.
    - `mapping_date` is the date to cache.
    - `logger` is where progress is reported.
    """
    keys = (INSTRUMENTS_KEY, BROKER_MAPPINGS_KEY, BROKER_TOKENS_KEY, INSTRUMENT_SYMBOLS_KEY)
    staging = {key: f"{key}:staging" for key in keys}
    cache.unlink(*staging.values())

    def fill(key, query, field, value):
        # A named cursor streams the rows from the server a batch at a time rather than holding millions in memory.
        connection = connect()
        written = 0
        try:
            with connection.cursor(name=f"cache_{key.replace(':', '_')}") as cursor:
                cursor.itersize = FIELDS_PER_BATCH
                cursor.execute(query, {"d": mapping_date})
                batch = {}
                for row in cursor:
                    batch[field(row)] = json.dumps(value(row))
                    if len(batch) >= FIELDS_PER_BATCH:
                        cache.hset(staging[key], mapping=batch)
                        written += len(batch)
                        batch = {}
                if batch:
                    cache.hset(staging[key], mapping=batch)
                    written += len(batch)
        finally:
            connection.rollback()
            connection.close()
        return written

    counts = {}
    instrument_columns = ", ".join(f'i."{column}"' for column in INSTRUMENT_COLUMNS)
    mapped_on_date = ("exists (select 1 from unified.broker_mappings b "
                      "        where b.instrument_id = i.instrument_id and b.mapping_date = %(d)s)")
    counts[BROKER_MAPPINGS_KEY] = fill(
        BROKER_MAPPINGS_KEY,
        "select broker, instrument_id, " + ", ".join(f'"{column}"' for column in MAPPING_COLUMNS)
        + " from unified.broker_mappings where mapping_date = %(d)s",
        lambda row: f"{row[0]}:{row[1]}",
        lambda row: [json_value(value) for value in row[2:]],
    )
    if not counts[BROKER_MAPPINGS_KEY]:
        cache.unlink(*staging.values())
        return None
    counts[INSTRUMENTS_KEY] = fill(
        INSTRUMENTS_KEY,
        f"select i.instrument_id, {instrument_columns} from unified.instruments i where {mapped_on_date}",
        lambda row: str(row[0]),
        lambda row: [json_value(value) for value in row[1:]],
    )
    # Every instrument a broker's token names on the date: a token is unique only within one of an exchange's scrip
    # files, so one token can name several instruments, told apart by segment when a trade or position is resolved.
    counts[BROKER_TOKENS_KEY] = fill(
        BROKER_TOKENS_KEY,
        "select broker, broker_token, array_agg(instrument_id::text order by instrument_id) "
        "from unified.broker_mappings where mapping_date = %(d)s group by broker, broker_token",
        lambda row: f"{row[0]}:{row[1]}",
        lambda row: list(row[2]),
    )
    # Securities by segment and symbol, for a broker that names an instrument by symbol rather than token. The
    # security identity index makes (exchange, segment, symbol) unique, and the segment carries the exchange.
    counts[INSTRUMENT_SYMBOLS_KEY] = fill(
        INSTRUMENT_SYMBOLS_KEY,
        f"select i.segment, upper(i.symbol), i.instrument_id::text from unified.instruments i "
        f"where i.shape = 'security' and i.symbol is not null and {mapped_on_date}",
        lambda row: f"{row[0]}:{row[1]}",
        lambda row: row[2],
    )

    meta = {"mapping_date": str(mapping_date), "instruments": counts[INSTRUMENTS_KEY],
            "broker_mappings": counts[BROKER_MAPPINGS_KEY], "broker_tokens": counts[BROKER_TOKENS_KEY],
            "instrument_symbols": counts[INSTRUMENT_SYMBOLS_KEY],
            "columns": {"instruments": INSTRUMENT_COLUMNS, "broker_mappings": MAPPING_COLUMNS},
            "written_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")}

    # Renaming onto an existing key frees the old value inline, which for hashes this size can stall Redis, so the old
    # hashes are moved aside and unlinked, which frees them in the background.
    existing = [key for key in keys if cache.exists(key)]
    pipeline = cache.pipeline(transaction=True)
    for key in existing:
        pipeline.rename(key, f"{key}:previous")
    for key in keys:
        pipeline.rename(staging[key], key)
    pipeline.set(META_KEY, json.dumps(meta))
    pipeline.unlink(*[f"{key}:previous" for key in keys])
    pipeline.execute()
    logger.info(f"Cached {mapping_date}: " + ", ".join(f"{count:,} in {key}" for key, count in counts.items()) + ".")
    return counts

def decide_contract_sizes(mapping_date, logger):
    """
    Decide the date's currency and commodity contract sizes, and say whether it worked.

    - `mapping_date` is the date to decide.
    - `logger` is where the summary and any failure are reported.
    """
    from stock_brokers.instruments.mapping.utilities.contract_sizes import ContractSizeResolver

    try:
        summary = ContractSizeResolver().run(mapping_date)
    except Exception as exception:
        logger.error(f"Could not decide contract sizes: {type(exception).__name__}: {exception}")
        return False
    totals = {}
    for (segment, status, tradeable), count in summary.items():
        totals[status] = totals.get(status, 0) + count
    logger.info(f"Contract sizes for {mapping_date}: {totals}")
    for (segment, status, tradeable), count in sorted(summary.items()):
        if status in ("conflict", "no_source") or (status == "single_source" and not tradeable):
            logger.warning(f"  {count} {segment} contract(s) are not tradeable: {status}")
    return True

def warm_catalogue(mapping_date, logger):
    """
    Warm the REST API's mapping cache for the date from the unified tables, and say whether it worked.

    - `mapping_date` is the date to warm.
    - `logger` is where a failure is reported.

    `unified:catalogue:` keys.
    """
    from stock_brokers.instruments.mapping.utilities.warm_cache import CacheWarmer

    try:
        CacheWarmer(mapping_date).run(clear=True)
    except (Exception, SystemExit) as exception:
        logger.error(f"Could not warm the REST API's catalogue cache: {type(exception).__name__}: {exception}")
        return False
    return True

def main():
    """Apply the tables, map the date into the unified tables, and cache it."""
    from stock_brokers.instruments.mapping.utilities.orchestrator import map_all
    from stock_brokers.instruments.mapping.utilities.segments import MAPPED_BROKERS
    from utilities.configurations import get_cache, get_logger, get_postgres

    parser = argparse.ArgumentParser(description="Map broker instrument snapshots into the unified tables and cache them.")
    parser.add_argument("brokers", nargs="*", metavar="BROKER", help="brokers to map. Every broker when omitted.")
    parser.add_argument("--date", help="the snapshot date to map, as YYYY-MM-DD. Today when omitted.")
    parser.add_argument("--skip-collisions", action="store_true",
                        help="do not merge stale duplicate instruments afterwards")
    parser.add_argument("--cache-only", action="store_true",
                        help="only rewrite the Redis cache for the date from the unified tables; no mapping")
    arguments = parser.parse_args()

    logger = get_logger("unified.map")
    unknown = [broker for broker in arguments.brokers if broker not in MAPPED_BROKERS]
    if unknown:
        logger.error(f"Unknown broker(s): {', '.join(unknown)}. Known: {', '.join(MAPPED_BROKERS)}")
        return 2
    try:
        mapping_date = datetime.strptime(arguments.date, "%Y-%m-%d").date() if arguments.date else date.today()
    except ValueError:
        logger.error(f"--date needs a date as YYYY-MM-DD, not {arguments.date!r}.")
        return 2

    if arguments.cache_only:
        try:
            cached = write_cache(get_cache(), get_postgres, mapping_date, logger)
        except Exception as exception:
            logger.error(f"Could not write the cache: {type(exception).__name__}: {exception}")
            return 1
        if cached is None:
            logger.error(f"Nothing is mapped on {mapping_date}, so the cache was left as it was.")
            return 1
        decide_contract_sizes(mapping_date, logger)
        warm_catalogue(mapping_date, logger)
        return 0

    try:
        apply_tables(logger)
    except Exception as exception:
        logger.error(f"Could not prepare the unified tables: {type(exception).__name__}: {exception}")
        return 1

    newest = newest_mapping_date(get_postgres)
    if newest is not None and mapping_date < newest:
        logger.error(f"{mapping_date} is older than {newest}, the newest date already mapped. Mapping an older date on "
                     f"top of newer data resolves it in the wrong order; a backfill has to start from empty tables.")
        return 2

    results = map_all(mapping_date, brokers=arguments.brokers or None, skip_collisions=arguments.skip_collisions)
    failures = [result["broker"] for result in results if result["error"] or result["row_errors"]]
    if not results:
        # The daily job expects today's snapshots; none at all usually means the downloads did not run.
        logger.error(f"No broker has instrument rows stored for {mapping_date}; nothing was mapped. "
                     f"Download the instruments first, with bin/<broker>/instruments/daily_feed.")
    if results:
        decide_contract_sizes(mapping_date, logger)

    try:
        cached = write_cache(get_cache(), get_postgres, mapping_date, logger)
        if cached is None:
            logger.warning(f"Nothing is mapped on {mapping_date}, so the cache was left as it was.")
    except Exception as exception:
        logger.error(f"Could not write the cache: {type(exception).__name__}: {exception}")
        return 1
    if cached is not None:
        warm_catalogue(mapping_date, logger)

    if failures:
        logger.error(f"{len(failures)} broker(s) failed or had rows that could not be mapped: {', '.join(failures)}")
        return 1
    return 0 if results else 1

if __name__ == "__main__":
    raise SystemExit(main())
