#!/usr/bin/env python3
"""
Cache the MongoDB `user_details`, `broker_details` and `exchange_details` collections in Redis, every minute.

    bin/unified/details
    bin/unified/details --once                           # copy once and exit
    redis-cli GET unified:details:exchanges

| collection | Redis key | served by |
| --- | --- | --- |
| `user_details` | `unified:details:users` | `GET /api/users/details` |
| `broker_details` | `unified:details:brokers` | `GET /api/brokers/details` |
| `exchange_details` | `unified:details:exchanges` | `GET /api/exchanges/details` |

Each value is the collection's documents as one JSON array, without `_id`, in MongoDB's natural order - exactly what the
REST API returned when it read the collection itself. An empty collection is cached as `[]`, so the API still answers
404 for it. Anything JSON cannot hold, such as a datetime, is written as its string.

MongoDB stays the store of record. The collections change only when `import-api-details` loads or re-copies them, so a
change reaches the cache within a minute of an import. The REST API reads the cache and falls back to MongoDB when a key
is missing, so it serves the same documents whether or not this is running.

The three keys are written together in one MULTI, so a reader never sees a new `exchange_details` beside an old
`broker_details`. When MongoDB cannot be read, nothing is written and the cached copies stay as they were, to be tried
again at the next minute.

Runs until Ctrl+C or SIGTERM. Exits 0 when stopped, or with `--once` when the copy succeeded, and 1 when a `--once`
copy failed. Reads only - it places no orders and never writes to MongoDB.
"""

import sys
import json
import signal
import argparse
import threading
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

DELAY_SECONDS = 60

# Each MongoDB collection and the Redis key its documents are cached in.
COLLECTION_KEYS = {
    "user_details": "unified:details:users",
    "broker_details": "unified:details:brokers",
    "exchange_details": "unified:details:exchanges",
}

def read_collections(mongo_db):
    """
    Every cached collection's documents, without `_id`, keyed by collection name.

    - `mongo_db` is the MongoDB database.
    """
    return {collection: list(mongo_db[collection].find({}, {"_id": 0})) for collection in COLLECTION_KEYS}

def write_cache(cache, documents):
    """
    Write every collection's documents to its key, all in one MULTI.

    - `cache` is the Redis client.
    - `documents` is the documents keyed by collection name, from `read_collections`.
    """
    pipeline = cache.pipeline(transaction=True)
    for collection, key in COLLECTION_KEYS.items():
        pipeline.set(key, json.dumps(documents[collection], default=str))
    pipeline.execute()

def copy_once(mongo_db, cache, logger):
    """
    Copy the collections into Redis once, and say whether it worked.

    - `mongo_db` is the MongoDB database.
    - `cache` is the Redis client.
    - `logger` is where the outcome is reported.
    """
    try:
        documents = read_collections(mongo_db)
        write_cache(cache, documents)
    except Exception as exception:
        logger.error(f"Could not cache the detail collections: {type(exception).__name__}: {exception}")
        return False
    logger.info("Cached " + ", ".join(f"{len(documents[collection])} {collection}" for collection in COLLECTION_KEYS))
    return True

def main():
    """Copy the detail collections into Redis every minute until stopped, or once with --once."""
    parser = argparse.ArgumentParser(description="Cache the MongoDB detail collections in Redis.")
    parser.add_argument("--once", action="store_true", help="copy once and exit")
    arguments = parser.parse_args()

    from utilities.configurations import get_cache, get_logger, get_mongo_db
    from utilities.poll_reporter import PollReporter

    logger = get_logger("unified.details")
    mongo_db, cache = get_mongo_db(), get_cache()
    if arguments.once:
        return 0 if copy_once(mongo_db, cache, logger) else 1

    # The same line every minute says nothing new; log changes, and an unchanged outcome once an hour.
    report = PollReporter(logger, interval=3600)
    stop = threading.Event()

    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Stopping.")
        stop.set()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    while not stop.is_set():
        copy_once(mongo_db, cache, report)
        stop.wait(DELAY_SECONDS)
    logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
