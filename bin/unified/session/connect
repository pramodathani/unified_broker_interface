#!/usr/bin/env python3
"""
Log in to the unified broker interface with its api key and secret, issue an access token, and record the session in
the Redis key `unified:session:status`.

    bin/unified/session/connect                                                                               # asks for the key and secret
    UNIFIED_BROKER_INTERFACE_API_KEY=... UNIFIED_BROKER_INTERFACE_API_SECRET=... bin/unified/session/connect
    bin/unified/session/connect --api-key <key>                                                               # asks for the secret only

    redis-cli GET unified:session:status

The equivalent of the REST API's `POST /api/session/connect`, without the API. The key and secret are checked against
the `api_key` and `api_secret` of the `unified_broker_interface` document in the MongoDB `settings` collection - the
same credentials the REST API takes as `api-key` and `api-secret` headers - compared in constant time.

**Where the key and secret come from.** `--api-key`, or `UNIFIED_BROKER_INTERFACE_API_KEY`, or a prompt; the secret from
`UNIFIED_BROKER_INTERFACE_API_SECRET` or a prompt that does not echo. There is deliberately no `--api-secret`: a secret on
the command line is visible to every user through the process list and stays in shell history. A systemd unit supplies
both through its environment.

**The token** is the REST API's: one application-wide UUID, valid for `UNIFIED_BROKER_INTERFACE_API_TOKEN_TTL_SECONDS`
(a day by default), stored as the REST API stores it - the `unified_broker_interface` document in the MongoDB
`last_login` collection, then mirrored into the Redis `last_login` hash, with the Redis copy cleared if that write fails
so a reader falls back to MongoDB. So the token this issues is accepted by the REST API too, and issuing one replaces the
token in force, ending any other session, exactly as a connect does.

`unified:session:status` holds one JSON object, replaced by each login and logout, in the shape the brokers' session keys
use, with the token's expiry beside it:

    {"status": "success", "access-token": "<token>", "last_login": "2026-09-14 08:30:02.123456", "expires_at": "2026-09-15 08:30:02.123456"}

The token and its expiry are printed. Wrong credentials change nothing - the session in force stays in force and its
status stays as it was - since a failed attempt says nothing about that session.

Exits 0 when a token was issued, 1 when the credentials are wrong, the settings document is missing or the token could
not be stored, and 2 when no key or secret was given.
"""

import os
import sys
import hmac
import json
import uuid
import getpass
import argparse
from datetime import datetime, timedelta
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

REDIS_KEY = "unified:session:status"

# The application's own documents in `settings` and `last_login`, and the Redis hash mirroring `last_login`.
APP_NAME = "unified_broker_interface"
LOGIN_COLLECTION = "last_login"
LOGIN_CACHE_KEY = "last_login"
TIME_FORMAT = "%Y-%m-%d %H:%M:%S.%f"

API_KEY_VARIABLE = "UNIFIED_BROKER_INTERFACE_API_KEY"
API_SECRET_VARIABLE = "UNIFIED_BROKER_INTERFACE_API_SECRET"

def matches(supplied, stored):
    """
    Whether a supplied credential equals the stored one, compared in constant time.

    - `supplied` is the value given, or None.
    - `stored` is the value from `settings`, or None.
    """
    if not supplied or not stored:
        return False
    return hmac.compare_digest(str(supplied).encode(), str(stored).encode())

def store_login(mongo_db, cache, document, logger):
    """
    Write the application's login document to MongoDB and then to Redis, clearing the Redis copy if that write fails.

    - `mongo_db` is the MongoDB database.
    - `cache` is the Redis client.
    - `document` is the login document.
    - `logger` is where a failed Redis write is reported.
    """
    mongo_db[LOGIN_COLLECTION].replace_one({"broker_name": APP_NAME}, document, upsert=True)
    try:
        cache.hset(LOGIN_CACHE_KEY, APP_NAME, json.dumps(document))
    except Exception as exception:
        logger.warning(f"Could not write the access token to Redis, clearing its copy: {exception}")
        try:
            cache.hdel(LOGIN_CACHE_KEY, APP_NAME)
        except Exception:
            pass

def credentials(arguments):
    """
    The api key and secret, from the argument or the environment, asking for whichever is missing.

    - `arguments` is the parsed command line.
    """
    api_key = arguments.api_key or os.environ.get(API_KEY_VARIABLE)
    api_secret = os.environ.get(API_SECRET_VARIABLE)
    if not api_key and sys.stdin.isatty():
        api_key = input("api key: ").strip()
    if not api_secret and sys.stdin.isatty():
        api_secret = getpass.getpass("api secret: ").strip()
    return api_key, api_secret

def main():
    """Check the api key and secret, issue an access token, and record the session."""
    parser = argparse.ArgumentParser(description="Log in to the unified broker interface and issue an access token.")
    parser.add_argument("--api-key", help=f"the api key; otherwise {API_KEY_VARIABLE} or a prompt")
    arguments = parser.parse_args()

    from utilities.configurations import api_configuration, get_cache, get_logger, get_mongo_db

    logger = get_logger("unified.connect")
    api_key, api_secret = credentials(arguments)
    if not api_key or not api_secret:
        logger.error(f"An api key and secret are needed: pass --api-key or set {API_KEY_VARIABLE}, and set "
                     f"{API_SECRET_VARIABLE}, or run it in a terminal to be asked.")
        return 2

    try:
        mongo_db, cache = get_mongo_db(), get_cache()
        settings = mongo_db["settings"].find_one({"broker_name": APP_NAME}, {"_id": 0})
        if not settings:
            logger.error(f"No {APP_NAME} document in the settings collection, so no credentials to check against.")
            return 1
        # Both compared even when the key already failed, so the time taken says nothing about which was wrong.
        key_matches = matches(api_key, settings.get("api_key"))
        secret_matches = matches(api_secret, settings.get("api_secret"))
        if not (key_matches and secret_matches):
            logger.error("Invalid api key or secret. The session in force is unchanged.")
            return 1

        now = datetime.now()
        document = {"broker_name": APP_NAME, "access_token": str(uuid.uuid4()), "last_login": now.strftime(TIME_FORMAT),
                    "expires_at": (now + timedelta(seconds=api_configuration["token_ttl_seconds"])).strftime(TIME_FORMAT)}
        store_login(mongo_db, cache, document, logger)
        cache.set(REDIS_KEY, json.dumps({"status": "success", "access-token": document["access_token"],
                                         "last_login": document["last_login"], "expires_at": document["expires_at"]}))
    except Exception as exception:
        logger.error(f"Could not issue an access token: {type(exception).__name__}: {exception}")
        return 1

    logger.info(f"Issued an access token, expiring {document['expires_at']}.")
    print(f"access-token: {document['access_token']}")
    print(f"expires_at: {document['expires_at']}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
