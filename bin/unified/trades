# Fyers' numeric segment codes, and Groww's and INDstocks' segment names, to the kind of instrument.
FYERS_SEGMENT_KINDS = {"10": "cash", "11": "derivative", "12": "currency", "20": "commodity"}
GROWW_SEGMENT_KINDS = {"CASH": "cash", "FNO": "derivative", "COMMODITY": "commodity"}
INDMONEY_SEGMENT_KINDS = {"EQUITY": "cash", "DERIVATIVE": "derivative"}

# Noren's exchange timestamp for a fill the exchange never timestamped.
NOREN_NO_EXCHANGE_TIME = "01-01-1980 00:00:00"

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def number(value, cast=float):
    """
    A broker's field as a number, or None when it is blank, a placeholder or not a number.

    - `value` is the field as the broker sent it.
    - `cast` is `float` or `int`.
    """
    if value is None or value == "" or value == "NA":
        return None
    try:
        return cast(float(value)) if cast is int else cast(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A broker's identifier or message as a string, or None when it is blank or zero."""
    if value is None or value in ("", 0, "0"):
        return None
    return str(value)

def first(row, *names):
    """The first of several fields a row carries a value for, or None."""
    for name in names:
        value = row.get(name)
        if value not in (None, ""):
            return value
    return None

def venue(value):
    """A broker's venue code as `(exchange, kind)`, or `(None, None)` when it is not one this knows."""
    return VENUES.get(str(value or "").strip().upper(), (None, None))

def canonical_exchange(value):
    """A broker's exchange, `NSE` or `nse_cm` or `BSE`, as the canonical `nse` or `bse`, or None."""
    lowered = str(value or "").strip().lower()
    for exchange in ("nse", "bse"):
        if lowered == exchange or lowered.startswith(f"{exchange}_"):
            return exchange
    return None

def trade(broker, exchange_code, trade_venue=None, **fields):
    """
    One trade with every field of the contract present, `value` worked out, and a private `venue` for resolving it.

    - `broker` is the broker name.
    - `exchange_code` is the broker's own exchange or segment code, answered as `exchange`.
    - `trade_venue` is a ready `(exchange, kind)` pair, or None to read one from `exchange_code`.
    - `fields` are the trade's other fields, already normalized.
    """
    row = {"broker": broker, "trade_id": None, "order_id": None, "exchange_order_id": None, "exchange_trade_id": None,
           "instrument_id": None, "instrument_token": None, "tradingsymbol": None, "exchange": exchange_code,
           "transaction_type": None, "product": None, "quantity": None, "price": None, "value": None,
           "trade_timestamp": None, "exchange_timestamp": None}
    row.update(fields)
    if row["quantity"] is not None and row["price"] is not None:
        row["value"] = round(row["quantity"] * row["price"], 2)
    row["venue"] = trade_venue if trade_venue is not None else venue(exchange_code)
    return row

def zerodha_trade(row):
    return trade("zerodha", row.get("exchange"),
                 trade_id=text(row.get("trade_id")), order_id=text(row.get("order_id")),
                 exchange_order_id=text(row.get("exchange_order_id")), instrument_token=text(row.get("instrument_token")),
                 tradingsymbol=row.get("tradingsymbol"),
                 transaction_type=normalize(row.get("transaction_type"), TRANSACTION_TYPES),
                 product=normalize(row.get("product"), PRODUCTS),
                 quantity=number(row.get("quantity"), int), price=number(row.get("average_price")),
                 trade_timestamp=row.get("fill_timestamp"), exchange_timestamp=row.get("exchange_timestamp"))

def dhan_trade(row):
    return trade("dhan", row.get("exchangeSegment"),
                 trade_id=text(row.get("exchangeTradeId")), order_id=text(row.get("orderId")),
                 exchange_order_id=text(row.get("exchangeOrderId")), exchange_trade_id=text(row.get("exchangeTradeId")),
                 instrument_token=text(row.get("securityId")), tradingsymbol=row.get("tradingSymbol"),
                 transaction_type=normalize(row.get("transactionType"), TRANSACTION_TYPES),
                 product=normalize(row.get("productType"), PRODUCTS),
                 quantity=number(row.get("tradedQuantity"), int), price=number(row.get("tradedPrice")),
                 trade_timestamp=row.get("createTime"), exchange_timestamp=row.get("exchangeTime"))

def noren_trade(broker):
    def build(row):
        exchange_time = row.get("exch_tm")
        return trade(broker, row.get("exch"),
                     trade_id=text(row.get("flid")), order_id=text(row.get("norenordno")),
                     exchange_order_id=text(row.get("exchordid")), exchange_trade_id=text(row.get("flid")),
                     instrument_token=text(row.get("token")), tradingsymbol=row.get("tsym"),
                     transaction_type=normalize(row.get("trantype"), TRANSACTION_TYPES),
                     product=normalize(row.get("prd"), PRODUCTS),
                     quantity=number(row.get("flqty"), int), price=number(row.get("flprc")),
                     trade_timestamp=row.get("fltm"),
                     exchange_timestamp=None if not exchange_time or exchange_time == NOREN_NO_EXCHANGE_TIME else exchange_time)
    return build

def fyers_trade(row):
    symbol = row.get("symbol")
    prefix = str(symbol or "").partition(":")[0]
    return trade("fyers", symbol.partition(":")[0] if symbol else None,
                 (prefix.lower() or None, FYERS_SEGMENT_KINDS.get(str(row.get("segment")))),
                 trade_id=text(row.get("tradeNumber")), order_id=text(row.get("orderNumber")),
                 exchange_order_id=text(row.get("exchangeOrderNo")), instrument_token=text(row.get("fyToken")),
                 tradingsymbol=symbol, transaction_type=normalize(row.get("side"), TRANSACTION_TYPES),
                 product=normalize(row.get("productType"), PRODUCTS),
                 quantity=number(row.get("tradedQty"), int), price=number(row.get("tradePrice")),
                 trade_timestamp=row.get("orderDateTime"))

def groww_trade(row):
    exchange = row.get("exchange")
    return trade("groww", exchange,
                 (canonical_exchange(exchange) or str(exchange or "").lower() or None,
                  GROWW_SEGMENT_KINDS.get(str(row.get("segment") or "").upper())),
                 trade_id=text(row.get("groww_trade_id")), order_id=text(row.get("groww_order_id")),
                 exchange_order_id=text(row.get("exchange_order_id")), exchange_trade_id=text(row.get("exchange_trade_id")),
