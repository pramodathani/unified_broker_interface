    bought = number(row.get("flBuyQty")) + number(row.get("cfBuyQty"))
    sold = number(row.get("flSellQty")) + number(row.get("cfSellQty"))
    return position(broker_token=row.get("tok"), exchange=exchange, kind=kind, symbol=row.get("trdSym"),
                    product_code=row.get("prod"), quantity=bought - sold,
                    buy_quantity=bought, buy_value=number(row.get("buyAmt")) + number(row.get("cfBuyAmt")),
                    sell_quantity=sold, sell_value=number(row.get("sellAmt")) + number(row.get("cfSellAmt")))

def wisdom_capital_position(row):
    exchange, kind = venue(row.get("ExchangeSegment"))
    return position(broker_token=row.get("ExchangeInstrumentId") or row.get("ExchangeInstrumentID"),
                    exchange=exchange, kind=kind, symbol=row.get("TradingSymbol") or row.get("Symbol"),
                    product_code=row.get("ProductType"), quantity=row.get("Quantity"),
                    buy_quantity=row.get("OpenBuyQuantity"), buy_value=row.get("BuyAmount"),
                    sell_quantity=row.get("OpenSellQuantity"), sell_value=row.get("SellAmount"),
                    realized=row.get("RealizedMTM"), unrealized=row.get("UnrealizedMTM"))

# Each broker's reader of one stored positions row, the entry's `data`.
NORMALIZERS = {"zerodha": zerodha_position, "dhan": dhan_position, "flattrade": noren_position, "shoonya": noren_position,
               "fyers": fyers_position, "groww": groww_position, "indmoney": indmoney_position, "kotak": kotak_position,
               "wisdom_capital": wisdom_capital_position}

# The brokers whose update stream sends a shape unlike their REST positions, read from the entry's normalized `position`.
STREAM_NORMALIZERS = {"fyers": fyers_stream_position, "groww": groww_stream_position}

def entry_position(broker, entry):
    """
    One stored hash entry as a position in the contract, or None when it cannot be read.

    - `broker` is the broker name.
    - `entry` is the decoded entry.
    """
    if not isinstance(entry, dict):
        return None
    if entry.get("source") == "websocket" and broker in STREAM_NORMALIZERS:
        return STREAM_NORMALIZERS[broker](entry["position"]) if isinstance(entry.get("position"), dict) else None
    return NORMALIZERS[broker](entry["data"]) if isinstance(entry.get("data"), dict) else None

def basis_of(broker, field):
    """
    The basis a hash field's position is on: `day` for Zerodha's and Wisdom Capital's `DAY:` fields, `net` otherwise.

    - `broker` is the broker name.
    - `field` is the hash field.
    """
    return "day" if broker in BASIS_BROKERS and str(field).startswith("DAY:") else "net"

def rounded(value):
    """A figure rounded to paise, or None."""
    return None if value is None else round(value, 2)

def emitted(rows, quotes):
    """
    One basis's merged rows as the positions the document answers with, sorted by symbol and product.

    - `rows` are the merged rows.
    - `quotes` are the quotes, keyed by instrument id.
    """
    positions = []
    for row in rows:
        identity = row["identity"]
        quote = quotes.get(identity["instrument_id"]) if identity else None
        if quote and quote.get("last_price") is not None:
            last_price, previous_close = quote["last_price"], quote.get("previous_close") or row["close_price"]
        else:
            last_price, previous_close = row["last_price"], row["close_price"]
        day_change = last_price - previous_close if last_price is not None and previous_close else None

        quantity, buy_quantity, sell_quantity = row["quantity"], row["buy_quantity"], row["sell_quantity"]
        strike = identity["strike_price"] if identity else None
        positions.append({
            "instrument_id": identity["instrument_id"] if identity else None,
            "symbol": (identity["symbol"] or identity["underlying_symbol"]) if identity else row["symbol"],
            "exchange": identity["exchange"] if identity else row["exchange"],
            "segment": identity["segment"] if identity else None,
            "expiry_date": (identity["expiry_date"] or None) if identity else None,
            "strike_price": float(strike) if strike is not None else None,
            "option_type": identity["option_type"] if identity else None,
            "product": row["product"],
            "quantity": round(quantity, 2),
            "buy": {
                "quantity": round(buy_quantity, 2),
                "average_price": round(row["buy_value"] / buy_quantity, 2) if buy_quantity else 0.0,
                "value": round(row["buy_value"], 2),
            },
            "sell": {
                "quantity": round(sell_quantity, 2),
                "average_price": round(row["sell_value"] / sell_quantity, 2) if sell_quantity else 0.0,
                "value": round(row["sell_value"], 2),
            },
            "average_price": round((row["buy_value"] - row["sell_value"]) / quantity, 2) if quantity else 0.0,
            "last_price": last_price,
            "pnl": {
                "realized": round(row["realized"], 2),
                "unrealized": round(row["unrealized"], 2),
                "total": round(row["realized"] + row["unrealized"], 2),
            },
            "day_change": rounded(day_change),
            "day_change_percentage": rounded(day_change / previous_close * 100) if day_change is not None else None,
        })
    positions.sort(key=lambda entry: (entry["symbol"] or "", entry["expiry_date"] or "", entry["strike_price"] or 0,
                                      entry["option_type"] or "", entry["product"] or ""))
    return positions

def position_update(broker, data):
    """
    A broker's position payload as `(position_key, entry)`, or None when it is not a position: the key the broker's script
    keys it by in `<broker>:portfolio:positions`, and the value it merges there, `{"source", "position", "data"}`.

    - `broker` is the broker name.
    - `data` is the payload from the broker's stream.
    """
    if broker == "fyers":
        key, normalized = fyers_position_key(data.get("symbol"), data.get("product_type")), fyers_position_from_update(data)
    elif broker == "kotak":
        key, normalized = kotak_position_key(data), kotak_normalized_position(data)
    elif broker == "groww":
        symbol = data.get("symbolData") or {}
        key = groww_position_field(symbol.get("exchange"), symbol.get("contractId") or symbol.get("displayName"),
                                   symbol.get("stocksProduct"))
        normalized = groww_position_from_update(data)
    elif broker == "wisdom_capital":
        key, normalized = wisdom_capital_position_field(data), wisdom_capital_position_from_row(data)
    else:
        return None
    return key and normalized and (key, {"source": "websocket", "position": normalized, "data": data})

def position_row(identity, contract):
    """
    One position as the row `emitted` reads, the way bin/unified/positions merges a lone position into one.

    - `identity` is the resolved instrument, or None.
    - `contract` is the position in the contract, from `entry_position`.
    """
    row = {"identity": identity, "symbol": contract["symbol"], "exchange": contract["exchange"],
           "product": contract["product"]}
    for field in ("quantity", "buy_quantity", "buy_value", "sell_quantity", "sell_value", "realized", "unrealized"):
        row[field] = 0.0 + contract[field]
    row["last_price"], row["close_price"] = contract["last_price"], contract["close_price"]
    return row

# ---- resolving to unified instruments -----------------------------------------------------------------------------------

class Resolver:
    """
    Resolves broker tokens and symbols to unified instruments from the Redis cache, remembering answers for one mapping date.
    """

    def __init__(self, cache):
        """
        - `cache` is the Redis client.
        """
        from stock_brokers.instruments.mapping.utilities.segments import (CANONICAL_EXCHANGES, CANONICAL_SEGMENTS,
                                                                          CASH_SEGMENTS, segments_of)
        self._cache = cache
        self._exchanges, self._segments_of = CANONICAL_EXCHANGES, segments_of
        # The bare segments each kind of venue trades, in the order a token's candidates are preferred.
        self._kind_segments = {
            "cash": CASH_SEGMENTS,
            "derivative": tuple(name for name, shape in CANONICAL_SEGMENTS
                                if shape in ("future", "option") and not name.startswith(("currency", "commodity"))),
            "currency": tuple(name for name, _ in CANONICAL_SEGMENTS if name.startswith("currenc")),
            "commodity": tuple(name for name, _ in CANONICAL_SEGMENTS if name.startswith("commodit")),
        }
        self._all_segments = tuple(name for name, _ in CANONICAL_SEGMENTS)
        self._mapping_date = None
        self._columns = None
        self._remembered = {}

    def venue_segments(self, exchange, kind):
        """The prefixed segments an instrument on a venue can be, in preference order."""
        return self._segments_of([exchange] if exchange else list(self._exchanges),
                                 self._kind_segments.get(kind, self._all_segments))

    def refresh(self):
        """Forget remembered answers when the cache has moved to another mapping date."""
        meta = json.loads(self._cache.get(META_KEY) or "null") or {}
        if meta.get("mapping_date") != self._mapping_date:
            self._mapping_date, self._columns, self._remembered = meta.get("mapping_date"), meta.get("columns"), {}

    def resolve(self, broker, token, symbol, exchange, kind):
        """
        The identity a token on a venue resolves to - or, with no token, a cash symbol - or None.

        - `broker` is the broker name.
        - `token` is the broker's token, or None.
        - `symbol` is the broker's trading symbol, or None.
        - `exchange` and `kind` are the venue.
        """
        if self._mapping_date is None:
            return None
        key = (broker, token, exchange, kind, None if token else symbol)
        if key not in self._remembered:
            self._remembered[key] = self._identity(broker, token, symbol, exchange, kind)
        return self._remembered[key]

    def _identity(self, broker, token, symbol, exchange, kind):
        segments = self.venue_segments(exchange, kind)
        if token:
            identifiers = json.loads(self._cache.hget(BROKER_TOKENS_KEY, f"{broker}:{token}") or "[]")
            order = {segment: position for position, segment in enumerate(segments)}
            candidates = [identity for identity in self._identities(identifiers) if identity["segment"] in order]
            if not candidates:
                return None
            return min(candidates, key=lambda identity: (order[identity["segment"]], identity["symbol"] is None,
                                                         identity["symbol"] or "", identity["instrument_id"]))
        if symbol and kind == "cash":
            for segment in segments:
                identifier = self._cache.hget(INSTRUMENT_SYMBOLS_KEY, f"{segment}:{str(symbol).upper()}")
                if identifier:
                    found = self._identities([json.loads(identifier)])
                    return found[0] if found else None
        return None

    def _identities(self, identifiers):
        """
        The cached instruments for some ids, as identities with `instrument_id`, `symbol`, `underlying_symbol`, `exchange`,
        `segment`, `expiry_date`, `strike_price` and `option_type`.
        """
        if not identifiers or not self._columns:
            return []
        position_of = {column: index for index, column in enumerate(self._columns["instruments"])}
        identities = []
        for identifier, value in zip(identifiers, self._cache.hmget(INSTRUMENTS_KEY, identifiers)):
            if value is None:
                continue
            instrument = json.loads(value)
            identity = {"instrument_id": identifier}
            for column in ("symbol", "underlying_symbol", "exchange", "segment", "expiry_date", "strike_price", "option_type"):
                identity[column] = instrument[position_of[column]]
            identities.append(identity)
        return identities

# ---- consuming the brokers' streams ---------------------------------------------------------------------------------------

def source_streams():
    """Every broker stream read, as `stream key -> (broker, kind, field)`."""
    streams = {f"{broker}:order-updates:stream": (broker, "order", "update") for broker in ORDER_BROKERS}
    streams.update({f"{broker}:positions_updates:stream": (broker, "position", "position") for broker in POSITION_BROKERS})
    return streams

def reset_epochs(now=None):
    """The epochs of the latest 06:00 IST, before which an update does not enter the hashes, and of the next one."""
    now = now or datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    latest = reset if reset <= now else reset - timedelta(days=1)
    return latest.timestamp(), int((latest + timedelta(days=1)).timestamp())

class UnifiedUpdates:
    """
    Reads the brokers' update streams as a consumer group and writes the unified streams and hashes, acknowledging after
    the write.
    """

    def __init__(self, cache, resolver, logger):
        """
        - `cache` is the Redis client.
        - `resolver` is the Resolver.
        - `logger` is where progress is reported.
        """
        self._cache = cache
        self._resolver = resolver
        self._logger = logger
        self._streams = source_streams()
        self.orders = 0
        self.positions = 0
        self.skipped = 0

    def ensure_groups(self):
        """Create the consumer group at the start of each stream, creating the stream too, unless it exists."""
        for stream in self._streams:
            try:
                self._cache.xgroup_create(stream, GROUP, id="0", mkstream=True)
                self._logger.info(f"Created consumer group {GROUP} on {stream}.")
            except Exception as exception:
                if "BUSYGROUP" not in str(exception):
                    raise

    def run(self, stop):
        """
        Consume until `stop` is set.

        - `stop` is a threading.Event.
        """
        backoff = MIN_BACKOFF_SECONDS
        pending_first = True
        while not stop.is_set():
            try:
                if pending_first:
                    # Reading pending entries always starts from the oldest unacknowledged one, so each read is written
                    # and acknowledged before the next rather than gathered, which would repeat them.
                    self.ensure_groups()
                    response = self._cache.xreadgroup(GROUP, CONSUMER, {stream: "0" for stream in self._streams},
                                                      count=ENTRIES_PER_READ)
                    if any(entries for _, entries in (response or [])):
                        self.process(response)
                    else:
                        pending_first = False
                else:
                    response = self._cache.xreadgroup(GROUP, CONSUMER, {stream: ">" for stream in self._streams},
                                                      count=ENTRIES_PER_READ, block=BLOCK_MILLISECONDS)
                    if response:
                        self.process(response)
                backoff = MIN_BACKOFF_SECONDS
            except Exception as exception:
                self._logger.error(f"Combining updates failed, retrying in {backoff} seconds: "
                                   f"{type(exception).__name__}: {exception}")
                pending_first = True
                stop.wait(backoff)
                backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info(f"Stopped. Wrote {self.orders} order and {self.positions} position update(s), "
                          f"skipped {self.skipped}.")

    def process(self, response):
        """
        Normalize, resolve and write one read's entries, then acknowledge them.

        - `response` is an XREADGROUP answer, a list of `(stream, [(id, fields), ...])`.
        """
        self._resolver.refresh()
        latest_reset, next_reset = reset_epochs()
        pipeline = self._cache.pipeline(transaction=False)
        acknowledged, orders, positions, skipped = {}, 0, 0, 0
        for stream, entries in response:
            stream = stream.decode() if isinstance(stream, bytes) else stream
            broker, kind, field = self._streams[stream]
            for entry_id, fields in entries:
                acknowledged.setdefault(stream, []).append(entry_id)
                written = self._write(pipeline, broker, kind, (fields or {}).get(field), latest_reset)
                if written == "order":
                    orders += 1
                elif written == "position":
                    positions += 1
                else:
                    skipped += 1
        if orders:
            pipeline.expireat(ORDERS_HASH_KEY, next_reset)
        if positions:
            pipeline.expireat(POSITIONS_HASH_KEY, next_reset)
        pipeline.execute()
        for stream, identifiers in acknowledged.items():
            self._cache.xack(stream, GROUP, *identifiers)
        self.orders, self.positions, self.skipped = self.orders + orders, self.positions + positions, self.skipped + skipped
        if orders or positions:
            self._logger.info(f"Wrote {orders} order and {positions} position update(s); skipped {skipped}.")

    def _write(self, pipeline, broker, kind, value, latest_reset):
        """
        Queue one entry's unified stream entry and hash field on the pipeline, answering what it was, or None to skip it.

        - `pipeline` is the Redis pipeline.
        - `broker` is the broker name.
        - `kind` is `order` or `position`.
        - `value` is the stream field's JSON, or None when trimmed.
        - `latest_reset` is the epoch before which an update does not enter the hash.
        """
        try:
            entry = json.loads(value)
            data = entry["data"]
            observed_at = received_epoch(entry.get("timestamp"))
            if not isinstance(data, dict):
                return None
            if kind == "order":
                found = order_update(broker, data, observed_at, entry.get("order"))
                if not found:
                    return None
                order, (exchange, venue_kind) = found
                identity = self._resolver.resolve(broker, order["instrument_token"], order["tradingsymbol"], exchange, venue_kind)
                record = {"broker": broker, **order, "instrument_id": identity["instrument_id"] if identity else None,
                          "observed_at": observed_at}
                payload = json.dumps(record)
                pipeline.xadd(ORDERS_STREAM_KEY, {"update": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
                if observed_at >= latest_reset:
                    pipeline.hset(ORDERS_HASH_KEY, f"{broker}:{order['order_id']}", payload)
                return "order"
            found = position_update(broker, data)
            if not found:
                return None
            position_key, merged_entry = found
            contract = entry_position(broker, merged_entry)
            if contract is None:
                return None
            identity = self._resolver.resolve(broker, contract["broker_token"], contract["symbol"], contract["exchange"],
                                              contract["kind"])
            # No quote is read: the last price and previous close are the ones the broker sent.
            unified, = emitted([position_row(identity, contract)], {})
            record = {"broker": broker, "position_key": position_key, "basis": basis_of(broker, position_key), **unified,
                      "observed_at": observed_at}
            payload = json.dumps(record)
            pipeline.xadd(POSITIONS_STREAM_KEY, {"position": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            if observed_at >= latest_reset:
                pipeline.hset(POSITIONS_HASH_KEY, f"{broker}:{position_key}", payload)
            return "position"
        except (TypeError, ValueError, KeyError, AttributeError):
            return None

def main():
    """Combine the brokers' order and position update streams until stopped."""
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("unified.order_updates")
    cache = get_cache()
    stop = threading.Event()

    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Finishing the read in hand, then stopping.")
        stop.set()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    logger.info(f"Combining {len(source_streams())} broker stream(s) into {ORDERS_STREAM_KEY} and {POSITIONS_STREAM_KEY}.")
    UnifiedUpdates(cache, Resolver(cache), logger).run(stop)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
