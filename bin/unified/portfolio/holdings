def number(value):
    """A broker's field as a float, or 0.0 when it is missing or not a number."""
    if value is None:
        return 0.0
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return 0.0
    return parsed if parsed == parsed else 0.0

def price(value):
    """A broker's price as a float, or None when it is missing, not a number, or zero - no listed security trades at zero."""
    parsed = number(value)
    return parsed if parsed else None

def canonical_exchange(value):
    """A broker's exchange, `NSE` or `nse_cm` or `BSE`, as the canonical `nse` or `bse`, or None."""
    lowered = str(value or "").strip().lower()
    for exchange in ("nse", "bse"):
        if lowered == exchange or lowered.startswith(f"{exchange}_"):
            return exchange
    return None

def holding(broker_token=None, exchange=None, isin=None, symbol=None, quantity=0.0, invested_value=0.0,
            collateral_quantity=0.0, last_price=None, close_price=None):
    """
    One holding at one broker, in the REST API's holding contract.

    - `broker_token` is the broker's own token, or None when it sends none.
    - `exchange` is the canonical exchange the token belongs to, or None when the broker does not say.
    - `isin`, `symbol` are the broker's ISIN and trading symbol, or None.
    - `quantity`, `invested_value`, `collateral_quantity` are everything held, what it cost, and what is pledged.
    - `last_price`, `close_price` are the broker's own last price and previous close, or None.
    """
    return {
        "broker_token": None if broker_token in (None, "", 0, "0") else str(broker_token),
        "exchange": exchange,
        "isin": isin or None,
        "symbol": symbol or None,
        "quantity": number(quantity),
        "invested_value": number(invested_value),
        "collateral_quantity": number(collateral_quantity),
        "last_price": price(last_price),
        "close_price": price(close_price),
    }

def zerodha_holdings(data):
    holdings = []
    for row in data if isinstance(data, list) else []:
        if not isinstance(row, dict):
            continue
        mtf = row.get("mtf") or {}
        settled = number(row.get("quantity")) + number(row.get("t1_quantity"))
        holdings.append(holding(
            broker_token=row.get("instrument_token"), exchange=canonical_exchange(row.get("exchange")), isin=row.get("isin"),
            symbol=row.get("tradingsymbol"), quantity=settled + number(mtf.get("quantity")),
            invested_value=settled * number(row.get("average_price")) + number(mtf.get("quantity")) * number(mtf.get("average_price")),
            collateral_quantity=row.get("collateral_quantity"), last_price=row.get("last_price"),
            close_price=row.get("close_price")))
    return holdings

def dhan_holdings(data):
    holdings = []
    for row in data if isinstance(data, list) else []:
        if not isinstance(row, dict):
            continue
        quantity = number(row.get("totalQty"))
        holdings.append(holding(
            broker_token=row.get("securityId"), exchange=canonical_exchange(row.get("exchange")), isin=row.get("isin"),
            symbol=row.get("tradingSymbol"), quantity=quantity, invested_value=quantity * number(row.get("avgCostPrice")),
            collateral_quantity=row.get("collateralQty"), last_price=row.get("lastTradedPrice")))
    return holdings

def noren_holdings(data):
    holdings = []
    for row in data if isinstance(data, list) else []:
        if not isinstance(row, dict):
