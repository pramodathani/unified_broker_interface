class Resolver:
    """
    Resolves holdings to unified instruments from the Redis cache, remembering answers for one mapping date.
    """

    def __init__(self, cache):
        """
        - `cache` is the Redis client.
        """
        from stock_brokers.instruments.mapping.utilities.segments import CASH_SEGMENTS, segments_of
        self._cache = cache
        self._cash_segments, self._segments_of = CASH_SEGMENTS, segments_of
        self._mapping_date = None
        self._columns = None
        self._remembered = {}

    def refresh(self):
        """Read the cache's mapping date, forgetting remembered answers when it has changed."""
        meta = json.loads(self._cache.get(META_KEY) or "null") or {}
        if meta.get("mapping_date") != self._mapping_date:
            self._mapping_date, self._columns, self._remembered = meta.get("mapping_date"), meta.get("columns"), {}

    def resolve(self, broker, entry):
        """
        The identity a holding resolves to - `instrument_id`, `exchange`, `segment`, `symbol` - or None.

        - `broker` is the broker name.
        - `entry` is the holding.
        """
        if self._mapping_date is None:
            return None
        key = (broker, entry["broker_token"], entry["exchange"], None if entry["broker_token"] else entry["symbol"])
        if key not in self._remembered:
            self._remembered[key] = self._identity(broker, *key[1:3], entry["symbol"])
        return self._remembered[key]

    def _identity(self, broker, token, exchange, symbol):
        segments = self._segments_of([exchange] if exchange else list(DEFAULT_EXCHANGES), self._cash_segments)
        if token:
            identifiers = json.loads(self._cache.hget(BROKER_TOKENS_KEY, f"{broker}:{token}") or "[]")
            order = {segment: position for position, segment in enumerate(segments)}
            # Candidates in the cache's tie-break order - symbol, then id - before the segment order decides.
            candidates = sorted((identity for identity in self._identities(identifiers) if identity["segment"] in order),
                                key=lambda identity: (identity["symbol"] is None, identity["symbol"] or "", identity["instrument_id"]))
            return min(candidates, key=lambda identity: order[identity["segment"]]) if candidates else None
        if symbol:
            for segment in segments:
                identifier = self._cache.hget(INSTRUMENT_SYMBOLS_KEY, f"{segment}:{str(symbol).upper()}")
                if identifier:
                    found = self._identities([json.loads(identifier)])
                    return found[0] if found else None
        return None

    def _identities(self, identifiers):
        """The cached instruments for some ids, as identities."""
        if not identifiers or not self._columns:
            return []
        position = {column: index for index, column in enumerate(self._columns["instruments"])}
        identities = []
        for identifier, value in zip(identifiers, self._cache.hmget(INSTRUMENTS_KEY, identifiers)):
            if value is None:
                continue
            instrument = json.loads(value)
            identities.append({"instrument_id": identifier, "exchange": instrument[position["exchange"]],
                               "segment": instrument[position["segment"]], "symbol": instrument[position["symbol"]]})
        return identities

# ---- session windows, as bin/unified/instruments/websocket_quotes carries them -------------------------------------------------------------

INDIA_OFFSET_SECONDS = 19800
SECONDS_PER_DAY = 86400
_EPOCH_WEEKDAY = 3
EQUITY, CURRENCY, COMMODITY = "equity", "currency", "commodity"
Session = namedtuple("Session", ["calendar", "opens", "evening_opens", "trading_close", "window_close"])

def _clock(hours, minutes=0, seconds=0):
    return hours * 3600 + minutes * 60 + seconds

EQUITY_SESSION = Session(EQUITY, _clock(9), None, _clock(15, 30), _clock(16))
CURRENCY_SESSION = Session(CURRENCY, _clock(9), None, _clock(17), _clock(17, 30))
COMMODITY_SESSION = Session(COMMODITY, _clock(9), _clock(17), _clock(23, 55), _clock(23, 59, 59))
NCDEX_SESSION = Session(COMMODITY, _clock(9), _clock(17), _clock(21), _clock(21, 30))
EVENING_CLOSED_GRACE_SECONDS = 1800

def session_for(segment):
    """The session window an instrument's ticks are accepted in, from its exchange-prefixed segment."""
    exchange, bare = split_segment_value(segment)
    if exchange == "ncdex":
        return NCDEX_SESSION
    if exchange == "mcx" or bare.startswith("commodit"):
        return COMMODITY_SESSION
    if bare.startswith("currenc"):
        return CURRENCY_SESSION
    return EQUITY_SESSION

def india_day_number(epoch):
    """The India day an instant falls on, as whole days since 1970-01-01."""
    return int((epoch + INDIA_OFFSET_SECONDS) // SECONDS_PER_DAY)

def india_date(epoch):
    """The India calendar date an instant falls on."""
    return date.fromordinal(date(1970, 1, 1).toordinal() + india_day_number(epoch))

def day_start_epoch(day_number):
    """The instant India midnight begins a day."""
    return day_number * SECONDS_PER_DAY - INDIA_OFFSET_SECONDS

def _seconds(text_value):
    return _clock(*[int(part) for part in str(text_value).split(":")])

def load_calendar(directory=CALENDAR_DIRECTORY):
    """
    The exchanges' closures and special sessions from the calendar files, as two dicts keyed (exchange, calendar).

    A missing directory leaves every weekday a trading day.
    """
    closures, special_sessions = {}, {}
    for path in sorted(Path(directory).glob("*.yaml")):
        document = yaml.safe_load(path.read_text()) or {}
        for exchange, calendars in (document.get("holidays") or {}).items():
            for calendar, entries in calendars.items():
                for entry in entries or []:
                    closures.setdefault((exchange, calendar), {})[entry["date"]] = entry["closed"]
        for entry in document.get("special_sessions") or []:
            window = (_seconds(entry["opens"]), _seconds(entry["closes"]))
            for exchange in entry["exchanges"]:
                for calendar in entry["calendars"]:
                    special_sessions.setdefault((exchange, calendar), {})[entry["date"]] = window
    return closures, special_sessions

class SessionGate:
    """
    Whether an instant is inside an instrument's window, worked out once per exchange, session and day.
    """

    def __init__(self, calendar=None):
        self._closures, self._special = calendar if calendar is not None else load_calendar()
        self._windows = {}

    def window(self, exchange, session, day_number):
        """The first and last accepted second after India midnight on a day, or None when the day is closed."""
        key = (exchange, session, day_number)
        if key in self._windows:
            return self._windows[key]
        day = date.fromordinal(date(1970, 1, 1).toordinal() + day_number)
        special = self._special.get((exchange, session.calendar), {}).get(day)
        if special is not None:
            window = special
        elif (day_number + _EPOCH_WEEKDAY) % 7 >= 5:
            window = None
        else:
            closed = self._closures.get((exchange, session.calendar), {}).get(day)
            if closed is None:
                window = (session.opens, session.window_close)
            elif closed == "morning" and session.evening_opens is not None:
                window = (session.evening_opens, session.window_close)
            elif closed == "evening" and session.evening_opens is not None:
                window = (session.opens, session.evening_opens + EVENING_CLOSED_GRACE_SECONDS)
            else:
                window = None
        if len(self._windows) > 4096:
            self._windows.clear()
        self._windows[key] = window
        return window

    def in_window(self, exchange, session, epoch):
        shifted = epoch + INDIA_OFFSET_SECONDS
        window = self.window(exchange, session, int(shifted // SECONDS_PER_DAY))
        return window is not None and window[0] <= shifted % SECONDS_PER_DAY <= window[1]

    def before_trading_close(self, session, epoch):
        return (epoch + INDIA_OFFSET_SECONDS) % SECONDS_PER_DAY < session.trading_close

    def window_end_epoch(self, exchange, session, epoch):
        day_number = india_day_number(epoch)
        window = self.window(exchange, session, day_number)
        return day_start_epoch(day_number) + (window[1] if window else session.window_close)

# ---- live quotes ------------------------------------------------------------------------------------------------------

def usable(quote, identity, now, gate):
    """
    Whether a cached quote may price a holding, by the rule the REST API's quote service serves its cache by.

    Not when marked stale; otherwise when received in the last five minutes, or when the instrument's trading window has
    closed since it was received and has not reopened - after the session the last quote stays right until the next one.

    - `quote` is the quote from `unified:quotes:live`.
    - `identity` is the holding's resolved instrument, carrying `exchange` and `segment`.
    - `now` is the current epoch.
    - `gate` is the SessionGate.
    """
    if quote.get("stale"):
        return False
    received_at = quote.get("received_at")
    if not received_at:
        return False
    if now - received_at <= FRESH_SECONDS:
        return True
    session = session_for(identity["segment"])
    exchange = identity["exchange"]
    return (gate.window_end_epoch(exchange, session, received_at) <= now
            and not gate.in_window(exchange, session, now))

def quotes_for(cache, rows, gate, now):
    """
    The usable live quote of every resolved row's instrument from `unified:quotes:live`, keyed by instrument id.

    - `cache` is the Redis client.
    - `rows` are the merged rows.
    - `gate` is the SessionGate.
    - `now` is the current epoch.
    """
    identities = {row["identity"]["instrument_id"]: row["identity"] for row in rows if row["identity"]}
    identifiers = sorted(identities)
    if not identifiers:
        return {}
    quotes = {}
    for identifier, raw in zip(identifiers, cache.hmget(QUOTES_KEY, identifiers)):
        try:
            quote = json.loads(raw) if raw else None
        except (TypeError, ValueError):
            quote = None
        if isinstance(quote, dict) and usable(quote, identities[identifier], now, gate):
            quotes[identifier] = quote
    return quotes

def rounded(value):
    """A figure rounded to paise, or None."""
    return None if value is None else round(value, 2)

def merged(read, resolver):
    """
    Every broker's holdings merged into one row per instrument.

    - `read` maps each readable broker to its holdings.
    - `resolver` is the Resolver.
    """
    rows, by_isin, by_instrument = [], {}, {}
    for broker in sorted(read):
        for entry in read[broker]:
            identity = resolver.resolve(broker, entry)
            instrument_id = identity["instrument_id"] if identity else None
            row = by_isin.get(entry["isin"]) if entry["isin"] else None
            if row is None and instrument_id:
                row = by_instrument.get(instrument_id)
            if row is None:
                row = {"identity": identity, "isin": entry["isin"], "symbol": entry["symbol"], "exchange": entry["exchange"],
                       "quantity": 0.0, "invested_value": 0.0, "collateral_quantity": 0.0, "last_price": None,
                       "close_price": None}
                rows.append(row)
            if entry["isin"]:
                by_isin.setdefault(entry["isin"], row)
                row["isin"] = row["isin"] or entry["isin"]
            if instrument_id:
                by_instrument.setdefault(instrument_id, row)
                row["identity"] = row["identity"] or identity
            row["symbol"] = row["symbol"] or entry["symbol"]
            row["exchange"] = row["exchange"] or entry["exchange"]
            row["quantity"] += entry["quantity"]
            row["invested_value"] += entry["invested_value"]
            row["collateral_quantity"] += entry["collateral_quantity"]
            # A price is the instrument's, whichever broker sent it, so the latest one read wins.
            row["last_price"] = entry["last_price"] if entry["last_price"] is not None else row["last_price"]
            row["close_price"] = entry["close_price"] if entry["close_price"] is not None else row["close_price"]
    return rows

def holdings_document(cache, resolver, now, gate):
    """
    Every broker's stored holdings as one document in the REST API's shape, priced from the live unified quotes.

    - `cache` is the Redis client.
    - `resolver` is the Resolver.
    - `now` is the current local time, for staleness and `as_of`.
    - `gate` is the SessionGate, for whether a quote is still usable.
    """
    read, statuses = {}, []
    for broker, raw in zip(BROKERS, cache.mget([f"{broker}:portfolio:holdings" for broker in BROKERS])):
        if raw is None:
            statuses.append({"broker": broker, "status": "missing", "as_of": None})
            continue
        try:
            stored = json.loads(raw)
        except (TypeError, ValueError):
            stored = None
        data = stored.get("data") if isinstance(stored, dict) else None
        stored_at = stored.get("timestamp") if isinstance(stored, dict) else None
        if not isinstance(data, DATA_TYPES.get(broker, list)):
            statuses.append({"broker": broker, "status": "unreadable", "as_of": stored_at})
            continue
        try:
            age = (now - datetime.strptime(stored_at, "%Y-%m-%d %H:%M:%S.%f")).total_seconds()
        except (TypeError, ValueError):
            age = None
        statuses.append({"broker": broker, "status": "stale" if age is None or age > STALE_SECONDS else "ok",
                         "as_of": stored_at})
        read[broker] = NORMALIZERS[broker](data)

    resolver.refresh()
    rows = merged(read, resolver)
    quotes = quotes_for(cache, rows, gate, now.timestamp())
    holdings, total_investment, total_current_value, total_unrealized_pnl = [], 0.0, 0.0, 0.0
    for row in rows:
        identity = row["identity"]
        # A row is priced by its quote, then the last price a broker sent, then a broker's previous close.
        quote = quotes.get(identity["instrument_id"]) if identity else None
        if quote and quote.get("last_price") is not None:
            last_price, previous_close = quote["last_price"], quote.get("previous_close") or row["close_price"]
        elif row["last_price"] is not None:
            last_price, previous_close = row["last_price"], row["close_price"]
        else:
            last_price, previous_close = row["close_price"], None
        quantity = row["quantity"]
        invested_value = round(row["invested_value"], 2)
        current_value = round(quantity * last_price, 2) if last_price is not None else None
        unrealized = round(current_value - invested_value, 2) if current_value is not None else None
        day_change = last_price - previous_close if last_price is not None and previous_close else None
        total_investment += invested_value
        if current_value is not None:
            total_current_value += current_value
            total_unrealized_pnl += unrealized
        holdings.append({
            "instrument_id": identity["instrument_id"] if identity else None,
            "isin": row["isin"],
            "symbol": identity["symbol"] if identity else row["symbol"],
            "exchange": identity["exchange"] if identity else row["exchange"],
            "segment": identity["segment"] if identity else None,
            "quantity": quantity,
            "average_price": round(row["invested_value"] / quantity, 2) if quantity else 0.0,
            "invested_value": invested_value,
            "last_price": last_price,
            "current_value": current_value,
            "pnl": {
                "unrealized": unrealized,
                "day_change": rounded(day_change),
                "day_change_percentage": rounded(day_change / previous_close * 100) if day_change is not None else None,
            },
            "collateral_quantity": round(row["collateral_quantity"], 2),
        })
    holdings.sort(key=lambda entry: entry["symbol"] or "")
    return {
        "holdings": holdings,
        "summary": {"holdings_count": len(holdings), "total_investment": round(total_investment, 2),
                    "total_current_value": round(total_current_value, 2),
                    "total_unrealized_pnl": round(total_unrealized_pnl, 2)},
        "brokers": statuses,
        "as_of": now.strftime("%Y-%m-%dT%H:%M:%S"),
    }

def main():
    """Write the unified holdings document to unified:portfolio:holdings every minute, until stopped."""
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("unified.holdings")
    cache = get_cache()
    resolver = Resolver(cache)
    gate = SessionGate()
    stop = threading.Event()

    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Stopping.")
        stop.set()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    while not stop.is_set():
        try:
            document = holdings_document(cache, resolver, datetime.now(), gate)
            cache.set(REDIS_KEY, json.dumps(document))
            not_ok = [f"{status['broker']} {status['status']}" for status in document["brokers"] if status["status"] != "ok"]
            logger.info(f"Wrote {document['summary']['holdings_count']} holding(s) to {REDIS_KEY}"
                        + (f"; {', '.join(not_ok)}" if not_ok else ""))
        except Exception as exception:
            logger.error(f"Could not combine the holdings: {type(exception).__name__}: {exception}")
        stop.wait(DELAY_SECONDS)
    logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
