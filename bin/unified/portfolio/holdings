            exchange="nse" if nse else "bse", isin=row.get("ISIN") or isin, symbol=row.get("Symbol"),
            quantity=quantity, invested_value=quantity * number(row.get("BuyAvgPrice")),
            collateral_quantity=row.get("CollateralQuantity") or row.get("PledgeQuantity")))
