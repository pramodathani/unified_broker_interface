def stoxkart_holdings(data):
    """Reads Stoxkart's stored holdings into holdings.

    A Stoxkart row carries the security's token on both exchanges, `nse_token` and `bse_token`, beside the `exchange` it is held on. The token of that exchange is used, or the other exchange's token when that one is blank.

    Args:
        data (object): The `data` of `stoxkart:portfolio:holdings`, a list of rows.

    Returns:
        list: The holdings, one per row.
    """
    holdings = []
    for row in data if isinstance(data, list) else []:
        if not isinstance(row, dict):
            continue
        exchange = canonical_exchange(row.get("exchange")) or "nse"
        nse_token = row.get("nse_token") or row.get("token")
        bse_token = row.get("bse_token")
        if exchange == "bse" and bse_token:
            broker_token = bse_token
            symbol = row.get("bse_symbol") or row.get("symbol")
        elif nse_token:
            broker_token = nse_token
            symbol = row.get("nse_symbol") or row.get("symbol")
            exchange = "nse"
        else:
            broker_token = bse_token
            symbol = row.get("bse_symbol") or row.get("symbol")
            exchange = "bse"
        quantity = number(row.get("quantity"))
        holdings.append(holding(
            broker_token=broker_token, exchange=exchange, isin=row.get("isin_code"), symbol=symbol,
            quantity=quantity, invested_value=quantity * number(row.get("average_price")),
            collateral_quantity=row.get("collateral_quantity"), last_price=row.get("last_trade_price")))
    return holdings

