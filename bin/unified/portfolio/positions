def number(value):
    """A broker's field as a float, or 0.0 when it is missing or not a number."""
    if value is None:
        return 0.0
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return 0.0
    return parsed if parsed == parsed else 0.0

def price(value):
    """A broker's price as a float, or None when it is missing, not a number, or zero - no listed security trades at zero."""
    parsed = number(value)
    return parsed if parsed else None

def canonical_exchange(value):
    """A broker's exchange, `NSE` or `nse_cm` or `BSE`, as the canonical `nse` or `bse`, or None."""
    lowered = str(value or "").strip().lower()
    for exchange in ("nse", "bse"):
        if lowered == exchange or lowered.startswith(f"{exchange}_"):
            return exchange
    return None

def venue(value):
    """A broker's venue code as `(exchange, kind)`, or `(None, None)` when it is not one this knows."""
    return VENUES.get(str(value or "").strip().upper(), (None, None))

def product(value):
    """A broker's product code as the product a position answers with, or the code lower-cased when it is not known."""
    code = str(value or "").strip()
    return PRODUCTS.get(code.upper().replace("-", ""), code.lower() or None)

def position(broker_token=None, exchange=None, kind=None, symbol=None, product_code=None, quantity=0.0,
             buy_quantity=0.0, buy_value=0.0, sell_quantity=0.0, sell_value=0.0, realized=0.0, unrealized=0.0,
             last_price=None, close_price=None):
    """
    One position at one broker, in the REST API's position contract.

    - `broker_token` is the broker's own token, or None when it sends none.
    - `exchange`, `kind` are the position's venue.
    - `symbol` is the broker's trading symbol, reported when the instrument does not resolve.
    - `product_code` is the broker's product code.
    - `quantity` is the signed net quantity; the buy and sell figures are totals; profits are the broker's own.
    - `last_price`, `close_price` are the broker's own last price and previous close, or None.
    """
    return {
        "broker_token": None if broker_token in (None, "", 0, "0") else str(broker_token),
        "exchange": exchange,
        "kind": kind,
        "symbol": symbol or None,
        "product": product(product_code),
        "quantity": number(quantity),
        "buy_quantity": number(buy_quantity),
        "buy_value": number(buy_value),
        "sell_quantity": number(sell_quantity),
        "sell_value": number(sell_value),
        "realized": number(realized),
        "unrealized": number(unrealized),
        "last_price": price(last_price),
        "close_price": price(close_price),
    }

def zerodha_position(row):
    exchange, kind = venue(row.get("exchange"))
    return position(broker_token=row.get("instrument_token"), exchange=exchange, kind=kind, symbol=row.get("tradingsymbol"),
                    product_code=row.get("product"), quantity=row.get("quantity"),
                    buy_quantity=row.get("buy_quantity"), buy_value=row.get("buy_value"),
                    sell_quantity=row.get("sell_quantity"), sell_value=row.get("sell_value"),
                    realized=row.get("realised"), unrealized=row.get("unrealised"),
                    last_price=row.get("last_price"), close_price=row.get("close_price"))

def dhan_position(row):
    exchange, kind = venue(row.get("exchangeSegment"))
    return position(broker_token=row.get("securityId"), exchange=exchange, kind=kind, symbol=row.get("tradingSymbol"),
                    product_code=row.get("productType"), quantity=row.get("netQty"),
                    buy_quantity=row.get("buyQty"), buy_value=number(row.get("buyQty")) * number(row.get("buyAvg")),
                    sell_quantity=row.get("sellQty"), sell_value=number(row.get("sellQty")) * number(row.get("sellAvg")),
                    realized=row.get("realizedProfit"), unrealized=row.get("unrealizedProfit"))

