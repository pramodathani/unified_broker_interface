    Args:
        row (dict): The entry's `data`, one row of Stoxkart's positions.

    Returns:
        dict: The position.
    """
    exchange, kind = venue(row.get("exchange"))
    return position(broker_token=row.get("token"), exchange=exchange, kind=kind, symbol=row.get("symbol"),
                    product_code=row.get("product_type"), quantity=row.get("net_quantity"),
