#!/usr/bin/env python3
"""
Poll the Zerodha user profile every minute and write it to the Redis key `zerodha:user:details`.

    bin/zerodha/user-profile
    redis-cli GET zerodha:user:details

Calls `GET https://api.kite.trade/user/profile` through `ZerodhaAPI`, which logs in first if the stored
session is dead. Each response - `timestamp`, `status`, `code` and Kite's profile under `data` (`user_id`,
`user_name`, `user_shortname`, `email`, `user_type`, `broker`, `exchanges`, `products`, `order_types`,
`meta`) - is written as one JSON string with SET, replacing the one before.

Runs until Ctrl+C. A dead session (`TokenException`) is logged in again before the next request; any
other failed poll is logged and leaves `zerodha:user:details` unchanged. Exits 1 when the first login, or
a login after the session died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

PROFILE_URL = "https://api.kite.trade/user/profile"
REDIS_KEY = "zerodha:user:details"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10

def is_authentication_error(exception):
    """Whether Kite refused the request because the session is dead."""
    return getattr(exception, 'code', None) == 'TokenException'

def main():
    """Fetch the profile and write it to zerodha:user:details every minute, until interrupted."""
    from stock_brokers.api.zerodha import ZerodhaAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("zerodha.user_profile")
    cache = get_cache()
    try:
        zerodha = ZerodhaAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                profile = zerodha.get(url=PROFILE_URL, timeout=TIMEOUT_SECONDS)
                cache.set(REDIS_KEY, json.dumps(profile))
                logger.info(f"Wrote the profile of {(profile.get('data') or {}).get('user_id')} to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Zerodha session expired, logging in again: {exception}")
                    zerodha = ZerodhaAPI()
                else:
                    logger.error(f"Profile poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
