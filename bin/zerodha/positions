#!/usr/bin/env python3
"""
Poll the Zerodha positions every half second and merge them into the Redis hash `zerodha:portfolio:positions`.

    bin/zerodha/positions
    redis-cli HGETALL zerodha:portfolio:positions
    redis-cli HGET zerodha:portfolio:positions NET:NSE:738561:CNC

Calls `GET https://api.kite.trade/portfolio/positions` through `ZerodhaAPI`, which logs in first if the stored session
is dead. Kite answers with two lists of the same rows: `net`, positions carried forward and taken today together, and
`day`, today's activity alone.

**One key for positions.** `zerodha:portfolio:positions` is a hash with one field per position in each list, keyed
`NET:exchange:instrument_token:product` or `DAY:exchange:instrument_token:product` - Kite holds one position per
instrument and product, reported once in each view. Every value is

    {"observed_at": <epoch>, "source": "rest", "position": <normalized position>, "data": <Kite's own row>}

with the same shape the brokers that also stream positions over a websocket use, so a reader handles every broker
alike. Kite streams no positions, so this poller is the one writer; the merge rule below is there so a second writer
could share the key. `position` has `id`, `instrument_token`, `tradingsymbol`, `exchange`, `segment`, `product`,
`quantity`, `buy_quantity`, `sell_quantity`, `buy_price`, `sell_price`, `buy_value`, `sell_value`, `average_price`,
`last_price`, `realized_pnl`, `unrealized_pnl`, `pnl`, `multiplier`, `lot_size`, `day_or_net` and `updated_at`:

| field | from Kite |
| --- | --- |
| `id` | `exchange:tradingsymbol` |
| `instrument_token`, `tradingsymbol`, `exchange` | `instrument_token`, `tradingsymbol`, `exchange` (`NSE`, `NFO`, `MCX`...) |
| `product` | `product` on the shared vocabulary (`CNC`, `MIS`, `NRML`...) |
| `quantity`, `buy_quantity`, `sell_quantity` | `quantity` (signed), `buy_quantity`, `sell_quantity` |
| `buy_price`, `sell_price`, `buy_value`, `sell_value` | `buy_price`, `sell_price`, `buy_value`, `sell_value` |
| `average_price`, `last_price` | `average_price`, `last_price` |
| `realized_pnl`, `unrealized_pnl`, `pnl` | `realised`, `unrealised`, `pnl` |
| `multiplier` | `multiplier` |
| `day_or_net` | `NET` or `DAY`, the list the row came from |

Kite sends no segment, lot size or update time on a position, so `segment`, `lot_size` and `updated_at` are null.

**Which write wins.** A row from this poller replaces an entry only when that entry was observed before this poll's
request was sent, so an entry from a newer writer is never overwritten by an older snapshot. The check and the write
run together in Redis, as one script. `observed_at` of a polled row is the moment its request was sent.

**Daily reset.** The hash expires at 06:00 IST, and every write moves that to the next 06:00. A position Kite stops
listing during the day is not removed before then. A flat account answers `{"net": [], "day": []}`, which writes
nothing.

Runs until Ctrl+C. A dead session (`TokenException`) is logged in again before the next request; any other failed poll
is logged and leaves the hash unchanged. Exits 1 when the first login, or a login after the session died, fails.
Reads only - it places no orders.
"""

import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

POSITIONS_URL = "https://api.kite.trade/portfolio/positions"
REDIS_KEY = "zerodha:portfolio:positions"
# When the book was last read successfully, epoch seconds, expiring with the hash. The hash alone cannot say so
# when the book is empty, since Redis keeps no empty hash.
POLLED_KEY = "zerodha:portfolio:positions:polled_at"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

# Kite's two views of the same positions, and what `day_or_net` calls each.
VIEWS = (("net", "NET"), ("day", "DAY"))

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

PRODUCTS = {
    "CNC": "CNC", "C": "CNC", "DELIVERY": "CNC", "CASH": "CNC",
    "MIS": "MIS", "I": "MIS", "INTRADAY": "MIS", "M": "NRML",
    "NRML": "NRML", "NORMAL": "NRML", "MARGIN": "NRML", "CARRYFORWARD": "NRML",
    "CO": "CO", "BO": "BO", "MTF": "MTF", "ARB": "ARB", "H": "CO", "B": "BO",
}

def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def position_key(row, day_or_net):
    """
    The hash field for a Kite position row, `DAY_OR_NET:exchange:instrument_token:product`, or None when it lacks one of them.

    - `row` is one row of Kite's `net` or `day` list.
    - `day_or_net` is `NET` or `DAY`.
    """
    parts = [text(row.get(field)) for field in ("exchange", "instrument_token", "product")] if isinstance(row, dict) else [None]
    return ":".join([day_or_net] + parts) if all(parts) else None

def position_from_row(row, day_or_net):
    """
    A Kite position row as a normalized position.

    - `row` is one row of Kite's `net` or `day` list.
    - `day_or_net` is `NET` or `DAY`.
    """
    exchange, symbol = text(row.get('exchange')), text(row.get('tradingsymbol'))
    return {
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('instrument_token')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "segment": None,
        "product": normalize(present(row.get('product')), PRODUCTS),
        "quantity": number(row.get('quantity'), int),
        "buy_quantity": number(row.get('buy_quantity'), int),
        "sell_quantity": number(row.get('sell_quantity'), int),
        "buy_price": number(row.get('buy_price')),
        "sell_price": number(row.get('sell_price')),
        "buy_value": number(row.get('buy_value')),
        "sell_value": number(row.get('sell_value')),
        "average_price": number(row.get('average_price')),
        "last_price": number(row.get('last_price')),
        "realized_pnl": number(row.get('realised')),
        "unrealized_pnl": number(row.get('unrealised')),
        "pnl": number(row.get('pnl')),
        "multiplier": number(row.get('multiplier')),
        "lot_size": None,
        "day_or_net": day_or_net,
        "updated_at": None,
    }

def is_authentication_error(exception):
    """Whether Kite refused the request because the session is dead."""
    return getattr(exception, 'code', None) == 'TokenException'

def main():
    """Fetch the positions and merge them into zerodha:portfolio:positions every half second, until interrupted."""
    from stock_brokers.api.zerodha import ZerodhaAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("zerodha.positions")
    report = PollReporter(logger)
    cache = get_cache()
    merge = cache.register_script(MERGE_SCRIPT)
    try:
        zerodha = ZerodhaAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                requested_at = time.time()
                response = zerodha.get(url=POSITIONS_URL, timeout=TIMEOUT_SECONDS)
                data = response.get('data') if isinstance(response.get('data'), dict) else {}
                arguments = [next_reset(), "rest", repr(requested_at)]
                counts = {}
                for view, day_or_net in VIEWS:
                    rows = data.get(view) if isinstance(data.get(view), list) else []
                    counts[view] = len(rows)
                    for row in rows:
                        field = position_key(row, day_or_net)
                        if field is not None:
                            arguments += [field, json.dumps({"observed_at": requested_at, "source": "rest",
                                                             "position": position_from_row(row, day_or_net), "data": row})]
                written = merge(keys=[REDIS_KEY], args=arguments)
                cache.set(POLLED_KEY, repr(requested_at), exat=arguments[0])
                report.info(f"Merged {written} of {counts['net']} net and {counts['day']} day position(s) into {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Zerodha session expired, logging in again: {exception}")
                    zerodha = ZerodhaAPI()
                else:
                    report.error(f"Positions poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
