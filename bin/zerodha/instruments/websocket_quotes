#!/usr/bin/env python3
"""
Stream Zerodha (Kite) market quotes over websockets into the Redis hash `zerodha:quotes:live`, and keep
streaming until stopped.

    bin/zerodha/instruments/websocket_quotes                         # today's whole instrument master over 24 websockets
    bin/zerodha/instruments/websocket_quotes --sockets 8
    bin/zerodha/instruments/websocket_quotes --tokens 738561,408065

    redis-cli HGET zerodha:quotes:live "NSE:RELIANCE"
    redis-cli HLEN zerodha:quotes:instruments

The connection, the login and the binary packet decoding for Kite's ticker at `wss://ws.kite.trade` are
`ZerodhaQuotesSocket` and `ZerodhaSession` in `stock_brokers/websockets/zerodha.py`, whose module docstring
describes the protocol. This script chooses the instruments, splits them across sockets, runs the sockets and
writes the ticks they decode to Redis, so it needs no other feed process or key.

**Instruments** are `--tokens` when given, otherwise every instrument in today's `zerodha:instruments:master`,
the hash `bin/zerodha/instruments/daily_feed` fills at 07:45 IST - 112,657 instruments on 2026-09-16, across NFO, NCO,
MCX, BSE, NSE, CDS, BFO, GLOBAL and NSEIX. Each is keyed by its Kite instrument token, the number in the
`instrument_token` column of Kite's instrument file, whose low byte names the exchange segment (738561 is NSE
RELIANCE), and is named `EXCHANGE:TRADINGSYMBOL` from the master's own row. When the master is empty, only
`--tokens` works, and those instruments are named from Kite's public instrument file instead.

**Sockets.** The instruments are sorted by token and split into `--sockets` parts of as near the same size as
they divide into, 24 parts by default, and each part is subscribed on its own websocket running on its own
thread. The first `count % sockets` parts carry one instrument more than the rest, so today's master splits
into one part of 4,695 and twenty-three of 4,694.

**This asks Kite for far more than Kite documents.** Kite documents three websockets per api_key, one of which
`bin/zerodha/orders/websocket_order_details` holds, and 3,000 instruments per websocket. Twenty-four sockets of about 4,700
instruments each exceeds both, so Kite is expected to refuse the connections past its limit; a refused socket
reconnects with backoff and leaves the others streaming rather than stopping the feed. The tick volume is also
far above what the feed was built for: `zerodha:quotes:stream` was raised from 100,000 entries to 1,000,000 on
2026-09-16 to give `bin/zerodha/instruments/store_quotes_to_db` ten times the room to catch up, which buys minutes rather than
hours at this subscription size. Nothing here is capped or budgeted: the script opens as many sockets as it is
asked for.

**Keys.**

- `zerodha:quotes:live`, a hash of the latest tick per instrument as JSON, keyed by the instrument's name from
  the master (`NSE:RELIANCE`), or by its token when the master does not name it. A tick is replaced as the next
  one arrives. It is not cleared at startup, so an instrument no longer subscribed keeps its last tick.
- `zerodha:quotes:instruments`, a hash of every subscribed token to its name, or to an empty string when
  unnamed. Replaced whole at startup, 5,000 fields at a time.
- `zerodha:quotes:stream`, a Redis Stream with every tick in arrival order as a `tick` field, which
  `bin/zerodha/instruments/store_quotes_to_db` writes to `zerodha.ticks`. Capped at about 1,000,000 entries, so ticks that arrive
  while the persister is down for long enough are trimmed before they are persisted.

A tick has `id`, `broker`, `instrument_token`, `exchange`, `mode`, `last_price`, `last_quantity`,
`average_price`, `volume`, `buy_quantity`, `sell_quantity`, `ohlc`, `change`, `oi`, `oi_day_high`,
`oi_day_low`, `last_trade_time`, `exchange_timestamp`, `depth` (five `buy` and `sell` levels of `quantity`,
`price` and `orders`) and `received_at`, with `None` for what Kite does not send. Prices are in rupees, and
`change` is the percentage change against `ohlc.close`; `stock_brokers/websockets/zerodha.py` says how they
are decoded.

**Sessions.** Every socket shares one `ZerodhaSession`. A refused token, or a socket failing to open six times
running, logs in again - one socket at a time, and only if no other socket or process already replaced the
token - before reconnecting. A reconnect otherwise backs off from 1 to 60 seconds.

Exits 0 when stopped with Ctrl+C or SIGTERM, 1 when a login fails or a socket still cannot open after logging
in again, and 2 when `--sockets` is below 1 or there is nothing to subscribe to. Reads only - it places no
orders.
"""

import sys
import csv
import json
import signal
import argparse
import threading
from io import StringIO
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

INSTRUMENTS_URL = "https://api.kite.trade/instruments"

LIVE_KEY = "zerodha:quotes:live"
INSTRUMENTS_KEY = "zerodha:quotes:instruments"
MASTER_KEY = "zerodha:instruments:master"
MASTER_META_KEY = "zerodha:instruments:meta"

# Every tick is also appended here for bin/zerodha/instruments/store_quotes_to_db, which reads it with a consumer group. The cap
# bounds Redis memory when the persister is down; ticks trimmed before it returns are not persisted.
STREAM_KEY = "zerodha:quotes:stream"
STREAM_MAX_LENGTH = 1000000

DEFAULT_SOCKETS = 24

FIELDS_PER_BATCH = 5000

class ZerodhaQuotesStore:
    """
    Where the quotes sockets' ticks are written: the live hash and the persistence stream.
    """

    def __init__(self, cache):
        """
        Keeps the Redis client the ticks are written to.

        Args:
            cache (redis.Redis): The Redis client.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache

    def write_ticks(self, ticks):
        """
        Writes one frame's ticks: the latest tick per instrument and every tick in arrival order, in one round trip.

        Args:
            ticks (list[dict]): The frame's ticks, in arrival order.

        Returns:
            None: This method returns nothing.
        """
        encoded = []
        for tick in ticks:
            encoded.append((tick["id"], json.dumps(tick)))
        pipeline = self._cache.pipeline(transaction=False)
        pipeline.hset(LIVE_KEY, mapping=dict(encoded))
        for _, payload in encoded:
            pipeline.xadd(STREAM_KEY, {"tick": payload}, maxlen=STREAM_MAX_LENGTH, approximate=True)
        pipeline.execute()

def master_instruments(cache, logger):
    """
    Today's instruments from `zerodha:instruments:master`, as a dict of instrument token text to name.

    The hash's field is the Kite instrument token and its value is the instrument's row as a JSON array, whose
    column order is in `zerodha:instruments:meta`. An instrument the row does not name, or a row that cannot be
    read, is mapped to an empty string, so every instrument in the master is still subscribed to.

    Args:
        cache (redis.Redis): The Redis client.
        logger (logging.Logger): Where a missing or unreadable master is reported.

    Returns:
        dict[str, str]: Each instrument token as text to `EXCHANGE:TRADINGSYMBOL`, or to an empty string when
        the master does not name it. Empty when the master has not been downloaded.
    """
    meta = cache.get(MASTER_META_KEY)
    try:
        columns = json.loads(meta).get('columns', []) if meta else []
    except (TypeError, json.JSONDecodeError):
        columns = []
    if 'tradingsymbol' in columns and 'exchange' in columns:
        symbol_index, exchange_index = columns.index('tradingsymbol'), columns.index('exchange')
    else:
        symbol_index, exchange_index = None, None
        logger.warning(f"{MASTER_META_KEY} does not say where the trading symbol and exchange are, so instruments "
                       f"are keyed by token.")

    names = {}
    for token, payload in cache.hscan_iter(MASTER_KEY, count=FIELDS_PER_BATCH):
        names[token] = ""
        if symbol_index is None:
            continue
        try:
            row = json.loads(payload)
        except (TypeError, json.JSONDecodeError):
            continue
        if row[exchange_index] and row[symbol_index]:
            names[token] = f"{row[exchange_index]}:{row[symbol_index]}"

    if names:
        download_date = json.loads(meta).get('download_date') if meta else None
        logger.info(f"Read {len(names)} instrument(s) from {MASTER_KEY}, downloaded {download_date}.")
    return names

def resolve_tokens(tokens, master, logger):
    """
    The Kite instrument tokens to subscribe to, as integers, in ascending order.

    Args:
        tokens (str | None): A comma separated list of instrument tokens from `--tokens`, or None for every
            instrument in today's master.
        master (dict[str, str]): Today's instruments from `master_instruments`.
        logger (logging.Logger): Where the resolution and any unusable token are reported.

    Returns:
        list[int]: The instrument tokens to subscribe to, de-duplicated and sorted.
    """
    if tokens:
        wanted, source = [token.strip() for token in tokens.split(",")], "--tokens"
    else:
        wanted, source = list(master), MASTER_KEY

    resolved = []
    for token in {str(token).strip() for token in wanted if str(token).strip()}:
        if token.isdigit():
            resolved.append(int(token))
        else:
            logger.warning(f"Skipping {token}: expected a Kite instrument token, a number such as 738561.")
    resolved.sort()
    logger.info(f"Subscribing to {len(resolved)} instrument(s) from {source}.")
    return resolved

def split_into_parts(tokens, parts):
    """
    The instrument tokens split into as many equal parts as there are websockets to carry them.

    The first `len(tokens) % parts` parts carry one instrument more than the others, which is as equal as a
    split can be when the count does not divide. A part that would be empty, because there are fewer
    instruments than parts, is left out rather than opening a websocket that subscribes to nothing.

    Args:
        tokens (list[int]): The instrument tokens to split.
        parts (int): How many parts to split them into.

    Returns:
        list[list[int]]: One list of instrument tokens per websocket.
    """
    size, remainder = divmod(len(tokens), parts)
    batches = []
    start = 0
    for index in range(parts):
        length = size + 1 if index < remainder else size
        if length == 0:
            continue
        batches.append(tokens[start:start + length])
        start += length
    return batches

def instrument_names(tokens, logger):
    """
    The names of the subscribed instruments from Kite's public instrument file, keyed by token as text.

    An unreachable file is reported and leaves every instrument unnamed rather than stopping the feed.

    - `tokens` is the list of subscribed tokens.
    - `logger` is where a failed download is reported.
    """
    import requests

    wanted = {str(token) for token in tokens}
    try:
        response = requests.get(INSTRUMENTS_URL, headers={"X-Kite-Version": "3"}, timeout=120)
        response.raise_for_status()
    except Exception as exception:
        logger.warning(f"Could not download Kite's instrument file, so instruments are keyed by token: {exception}")
        return {}

    return {row['instrument_token']: f"{row['exchange']}:{row['tradingsymbol']}"
            for row in csv.DictReader(StringIO(response.text)) if row.get('instrument_token') in wanted}

def write_subscribed_instruments(tokens, names, cache, logger):
    """
    Replace `zerodha:quotes:instruments` with every subscribed token and its name.

    The hash is written in batches, because a subscription covering the whole instrument master is more fields
    than belong in one Redis command.

    Args:
        tokens (list[int]): The subscribed instrument tokens.
        names (dict[str, str]): Each instrument token as text to its name.
        cache (redis.Redis): The Redis client.
        logger (logging.Logger): Where the write and any unnamed instruments are reported.

    Returns:
        None
    """
    cache.delete(INSTRUMENTS_KEY)
    for start in range(0, len(tokens), FIELDS_PER_BATCH):
        batch = tokens[start:start + FIELDS_PER_BATCH]
        cache.hset(INSTRUMENTS_KEY, mapping={str(token): names.get(str(token), "") for token in batch})
    logger.info(f"Wrote {len(tokens)} subscribed instrument(s) to {INSTRUMENTS_KEY}.")

    unnamed = [str(token) for token in tokens if not names.get(str(token))]
    if unnamed:
        logger.warning(f"{len(unnamed)} instrument(s) are unnamed and are keyed by token: "
                       f"{', '.join(unnamed[:20])}{' ...' if len(unnamed) > 20 else ''}")

def main():
    """Stream Zerodha quotes into zerodha:quotes:live until stopped."""
    parser = argparse.ArgumentParser(description="Stream Zerodha market quotes into zerodha:quotes:live until stopped.")
    parser.add_argument("--tokens", help="comma separated Kite instrument tokens, for example 738561,408065")
    parser.add_argument("--sockets", type=int, default=DEFAULT_SOCKETS,
                        help=f"websockets to split the instruments equally across, default {DEFAULT_SOCKETS}")
    arguments = parser.parse_args()

    from stock_brokers.websockets.zerodha import ZerodhaQuotesSocket, ZerodhaSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("zerodha.websocket_quotes")
    cache = get_cache()

    if arguments.sockets < 1:
        logger.error("--sockets must be at least 1.")
        return 2

    master = master_instruments(cache, logger)
    tokens = resolve_tokens(arguments.tokens, master, logger)
    if not tokens:
        logger.error(f"Nothing to subscribe to. Pass --tokens, or run bin/zerodha/instruments/daily_feed to fill {MASTER_KEY}.")
        return 2

    batches = split_into_parts(tokens, arguments.sockets)

    try:
        session = ZerodhaSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1

    names = {}
    for token in tokens:
        name = master.get(str(token), "")
        if name:
            names[str(token)] = name
    if not names:
        names = instrument_names(tokens, logger)
    write_subscribed_instruments(tokens, names, cache, logger)

    store = ZerodhaQuotesStore(cache)
    sockets = []
    for index, batch in enumerate(batches):
        sockets.append(ZerodhaQuotesSocket(f"socket_{index}", batch, names, session, store.write_ticks, logger))

    # Installed before the sockets start: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing anything.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the quotes feed.")
        for socket in sockets:
            socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    threads = [threading.Thread(target=socket.run_forever, name=f"zerodha_quotes_{socket.name}", daemon=True)
               for socket in sockets]
    logger.info(f"Starting {len(sockets)} websocket(s) for {len(tokens)} instrument(s).")
    for thread in threads:
        thread.start()

    # Block in the main thread so the signal handlers above can run.
    while any(thread.is_alive() for thread in threads):
        for thread in threads:
            thread.join(timeout=1)

    gave_up = [socket.name for socket in sockets if socket.gave_up]
    if gave_up:
        logger.error(f"Socket(s) {', '.join(gave_up)} gave up.")
        return 1
    logger.info("Quotes feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
