#!/usr/bin/env python3
"""
Poll the Zerodha holdings every minute and write them to the Redis key `zerodha:portfolio:holdings`.

    bin/zerodha/portfolio/holdings
    redis-cli GET zerodha:portfolio:holdings

Calls `GET https://api.kite.trade/portfolio/holdings` through `ZerodhaAPI`, which logs in first if the
stored session is dead. Each response - `timestamp`, `status`, `code` and Kite's holdings list under
`data`, one row per holding with `instrument_token`, `tradingsymbol`, `exchange`, `isin`, `quantity`,
`t1_quantity`, `mtf`, `average_price`, `last_price` and `close_price` - is written as one JSON string with
SET, replacing the one before. An account holding nothing is `[]`.

Runs until Ctrl+C. A dead session (`TokenException`) is logged in again before the next request; any
other failed poll is logged and leaves `zerodha:portfolio:holdings` unchanged. Exits 1 when the first
login, or a login after the session died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

HOLDINGS_URL = "https://api.kite.trade/portfolio/holdings"
REDIS_KEY = "zerodha:portfolio:holdings"
DELAY_SECONDS = 60
TIMEOUT_SECONDS = 10

def is_authentication_error(exception):
    """Whether Kite refused the request because the session is dead."""
    return getattr(exception, 'code', None) == 'TokenException'

def main():
    """Fetch the holdings and write them to zerodha:portfolio:holdings every minute, until interrupted."""
    from stock_brokers.api.zerodha import ZerodhaAPI
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("zerodha.holdings")
    cache = get_cache()
    try:
        zerodha = ZerodhaAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                holdings = zerodha.get(url=HOLDINGS_URL, timeout=TIMEOUT_SECONDS)
                cache.set(REDIS_KEY, json.dumps(holdings))
                data = holdings.get('data')
                logger.info(f"Wrote {len(data) if isinstance(data, list) else 0} holdings to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Zerodha session expired, logging in again: {exception}")
                    zerodha = ZerodhaAPI()
                else:
                    logger.error(f"Holdings poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
