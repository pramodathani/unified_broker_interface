#!/usr/bin/env python3
"""
Poll the Zerodha funds every half second and write them to the Redis key `zerodha:portfolio:funds`.

    bin/zerodha/portfolio/funds
    redis-cli GET zerodha:portfolio:funds

Calls `GET https://api.kite.trade/user/margins` through `ZerodhaAPI`, which logs in first if the stored
session is dead. Each response - `timestamp`, `status`, `code` and Kite's margins under `data`, an `equity`
and a `commodity` block, each with its own `net`, an `available` breakdown (cash, collateral, adhoc
margin, intraday pay-in) and a `utilised` breakdown (debits, SPAN, exposure, M2M, payout) - is written as
one JSON string with SET, replacing the one before.

Runs until Ctrl+C. A dead session (`TokenException`) is logged in again before the next request; any
other failed poll is logged and leaves `zerodha:portfolio:funds` unchanged. Exits 1 when the first login,
or a login after the session died, fails. Reads only - it places no orders.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

MARGINS_URL = "https://api.kite.trade/user/margins"
REDIS_KEY = "zerodha:portfolio:funds"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

def is_authentication_error(exception):
    """Whether Kite refused the request because the session is dead."""
    return getattr(exception, 'code', None) == 'TokenException'

def main():
    """Fetch the funds and write them to zerodha:portfolio:funds every half second, until interrupted."""
    from stock_brokers.api.zerodha import ZerodhaAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("zerodha.funds")
    report = PollReporter(logger)
    cache = get_cache()
    try:
        zerodha = ZerodhaAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                funds = zerodha.get(url=MARGINS_URL, timeout=TIMEOUT_SECONDS)
                cache.set(REDIS_KEY, json.dumps(funds))
                data = funds.get('data') or {}
                report.info(f"Wrote funds (equity net {(data.get('equity') or {}).get('net')}, "
                            f"commodity net {(data.get('commodity') or {}).get('net')}) to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Zerodha session expired, logging in again: {exception}")
                    zerodha = ZerodhaAPI()
                else:
                    report.error(f"Funds poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
