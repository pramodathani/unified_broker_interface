def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def kite_timestamp(value):
    """
    A Kite order time, India wall clock, as an aware ISO timestamp, or None.

    Kite sends `YYYY-MM-DD HH:MM:SS` with no offset; an ISO string that carries its own offset keeps it.

    - `value` is the time as Kite sent it.
    """
    value = present(value)
    if value is None:
        return None
    text = str(value).strip()
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            moment = datetime.strptime(text, fmt)
        except ValueError:
            continue
        return None if moment.year < 1971 else moment.replace(tzinfo=INDIA).isoformat()
    try:
        moment = datetime.fromisoformat(text)
    except ValueError:
        return None
    return (moment if moment.tzinfo else moment.replace(tzinfo=INDIA)).isoformat()

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_kite(row):
    """
    A Kite order - an order-book row or an order update's `data`, which are the same object - as a normalized order,
    or None when it has no order id.

    - `row` is the Kite order.
    """
    if not isinstance(row, dict) or text(row.get('order_id')) is None:
        return None
    exchange, symbol = text(row.get('exchange')), text(row.get('tradingsymbol'))
    return {
        "order_id": text(row.get('order_id')),
        "exchange_order_id": text(row.get('exchange_order_id')),
        "parent_order_id": text(row.get('parent_order_id')),
        "status": normalize(present(row.get('status')), STATUSES),
        "status_message": text(row.get('status_message')) or text(row.get('status_message_raw')),
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('instrument_token')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "transaction_type": normalize(present(row.get('transaction_type')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('product')), PRODUCTS),
        "order_type": normalize(present(row.get('order_type')), ORDER_TYPES),
        "validity": normalize(present(row.get('validity')), VALIDITIES),
        "quantity": number(row.get('quantity'), int),
        "filled_quantity": number(row.get('filled_quantity'), int),
        "pending_quantity": number(row.get('pending_quantity'), int),
        "cancelled_quantity": number(row.get('cancelled_quantity'), int),
        "disclosed_quantity": number(row.get('disclosed_quantity'), int),
        "price": number(row.get('price')),
        "trigger_price": number(row.get('trigger_price')),
        "average_price": number(row.get('average_price')),
        "order_timestamp": kite_timestamp(row.get('order_timestamp')),
        "exchange_timestamp": kite_timestamp(row.get('exchange_timestamp')) or kite_timestamp(row.get('exchange_update_timestamp')),
        "tag": text(row.get('tag')),
    }

class OrderUpdatesSocket:
    """
    A Kite ticker websocket subscribed to nothing, carrying the account's order updates, until stopped.
    """

    def __init__(self, cache, logger):
        """
        Construct ZerodhaAPI, which logs in when the stored session is dead.

        - `cache` is the Redis client.
        - `logger` is where the connection reports.
        """
        from stock_brokers.api.zerodha import ZerodhaAPI

        self._api_class = ZerodhaAPI
        self._zerodha = ZerodhaAPI()
        self._cache = cache
        self._merge = cache.register_script(MERGE_SCRIPT)
        self._logger = logger
        self._stop = threading.Event()
        self._ws = None
        self._token = None
        self._opened = False
        self._authentication_rejected = False
        self.gave_up = False

    def close(self):
        """Close the websocket and stop reconnecting."""
        self._stop.set()
        if self._ws is not None:
            self._ws.close()

    def run_forever(self):
        """Connect, and reconnect with backoff, until closed or unable to recover."""
        backoff = MIN_BACKOFF_SECONDS
        failed_connects = 0
        logged_in_again = False
        while not self._stop.is_set():
            self._opened = False
            self._authentication_rejected = False
            try:
                self._connect()
            except Exception as exception:
                self._logger.error(f"Order updates connection failed: {type(exception).__name__}: {exception}")
            if self._stop.is_set():
                break

            if self._opened and not self._authentication_rejected:
                failed_connects, logged_in_again, backoff = 0, False, MIN_BACKOFF_SECONDS
            else:
                failed_connects += 1

            if self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS:
                if logged_in_again and (self._authentication_rejected or failed_connects >= MAX_FAILED_CONNECTS):
                    self.gave_up = True
                    self._logger.error("Order updates are still refused after logging in again. Giving up.")
                    break
                try:
                    # A dead session: log in again before connecting again, unless another process already has.
                    login = self._zerodha._current_login() or {}
                    if login.get('access_token') == self._token:
                        self._logger.warning("Logging in to Zerodha again.")
                        self._zerodha = self._api_class()
                except Exception as exception:
                    self.gave_up = True
                    self._logger.error(f"Could not log in to Zerodha again: {type(exception).__name__}: {exception}")
                    break
                failed_connects, logged_in_again = 0, True

            self._logger.warning(f"Order updates disconnected. Reconnecting in {backoff} seconds.")
            self._stop.wait(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF_SECONDS)
        self._logger.info("Order updates socket stopped.")

    def _connect(self):
        """Open the websocket with the token in force now and block until it closes."""
        import websocket

        login = self._zerodha._current_login() or {}
        self._token = login.get('access_token')
        url = f"{FEED_URL}/?api_key={self._zerodha._settings.get('api_key')}&access_token={self._token}"
        self._ws = websocket.WebSocketApp(url, on_open=self._on_open, on_message=self._on_message,
                                          on_error=self._on_error, on_close=self._on_close)
        self._ws.run_forever(ping_interval=PING_INTERVAL_SECONDS, ping_timeout=PING_TIMEOUT_SECONDS)

    def _on_open(self, ws):
        """Subscribe to nothing: without a subscription Kite pushes order updates and no market data."""
        self._opened = True
        self._logger.info("Order updates socket opened. Waiting for order updates.")

    def _on_error(self, ws, error):
        if getattr(error, 'status_code', None) in AUTHENTICATION_STATUSES:
            self._authentication_rejected = True
        self._logger.error(f"Order updates error: {error}")

    def _on_close(self, ws, status_code, message):
        self._logger.info(f"Order updates socket closed with status {status_code}: {message}")

    def _on_message(self, ws, message):
        """Merge each order update into the orders hash, keyed by order id, and append it to the stream."""
        if isinstance(message, (bytes, bytearray)):
            # Market data, which this socket never subscribed to.
            return

        try:
            payload = json.loads(message)
        except (TypeError, json.JSONDecodeError):
            self._logger.debug(f"Ignoring a frame that is not JSON: {str(message)[:160]}")
            return

        received_at = datetime.now()
        received = received_at.strftime("%Y-%m-%d %H:%M:%S.%f")
        observed_at = received_at.timestamp()
        merged, appended = [], []
        for entry in (payload if isinstance(payload, list) else [payload]):
            if not isinstance(entry, dict):
                continue
            data = entry.get('data')
            order = order_from_kite(data) if entry.get('type') == ORDER else None
            if order is not None:
                merged += [order["order_id"], json.dumps({"observed_at": observed_at, "source": "websocket",
                                                          "order": order, "data": data})]
                appended.append(json.dumps({'timestamp': received, 'data': data}))
            elif entry.get('type') == 'error':
                self._logger.error(f"Kite reported an error: {entry.get('data')}")
            else:
                self._logger.info(f"Ignoring a message of type {entry.get('type')!r}: {json.dumps(entry)[:200]}")
        if merged:
            # The hash keeps each order's latest state; the stream keeps every transition, even two of one order in the
            # same message, in the shape bin/zerodha/persist_orders reads.
            self._merge(keys=[ORDERS_KEY], args=[next_reset(), "websocket", repr(observed_at)] + merged)
            pipeline = self._cache.pipeline(transaction=False)
            for update in appended:
                pipeline.xadd(STREAM_KEY, {"update": update}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()
            self._logger.info(f"Merged {len(appended)} order update(s) into {ORDERS_KEY}: {', '.join(merged[0::2])}")

def main():
    """Stream Zerodha order updates into zerodha:orders:orders until stopped."""
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("zerodha.order_updates")
    try:
        socket = OrderUpdatesSocket(get_cache(), logger)
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1

    # Installed before the thread starts: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing the connection.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the order updates feed.")
        socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    thread = threading.Thread(target=socket.run_forever, name="zerodha_order_updates", daemon=True)
    logger.info("Starting the order updates feed.")
    thread.start()

    # Block in the main thread so the signal handlers above can run.
    while thread.is_alive():
        thread.join(timeout=1)

    if socket.gave_up:
        return 1
    logger.info("Order updates feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
