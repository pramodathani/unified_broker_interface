#!/usr/bin/env python3
"""
Poll the day's Zerodha trade book every half second and write it to the Redis key `zerodha:orders:trades`.

    bin/zerodha/orders/api_trade_details
    redis-cli GET zerodha:orders:trades

Calls `GET https://api.kite.trade/trades` through `ZerodhaAPI`, which logs in first if the stored session
is dead. Each response - `timestamp`, `status`, `code` and Kite's trade list under `data`, one row per fill
with `trade_id`, `order_id`, `exchange_order_id`, `tradingsymbol`, `exchange`, `transaction_type`,
`product`, `quantity`, `average_price`, `fill_timestamp` and `exchange_timestamp` - is written as one JSON
string with SET, replacing the one before. An empty book is `[]`.

Runs until Ctrl+C. A dead session (`TokenException`) is logged in again before the next request; any
other failed poll is logged and leaves `zerodha:orders:trades` unchanged. Exits 1 when the first login, or
a login after the session died, fails. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import time
from pathlib import Path

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

TRADES_URL = "https://api.kite.trade/trades"
REDIS_KEY = "zerodha:orders:trades"
DELAY_SECONDS = 0.5
TIMEOUT_SECONDS = 10

def is_authentication_error(exception):
    """Whether Kite refused the request because the session is dead."""
    return getattr(exception, 'code', None) == 'TokenException'

def main():
    """Fetch the trade book and write it to zerodha:orders:trades every half second, until interrupted."""
    from stock_brokers.api.zerodha import ZerodhaAPI
    from utilities.configurations import get_cache, get_logger
    from utilities.poll_reporter import PollReporter

    logger = get_logger("zerodha.api_trade_details")
    report = PollReporter(logger)
    cache = get_cache()
    try:
        zerodha = ZerodhaAPI()
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1

    try:
        while True:
            try:
                trades = zerodha.get(url=TRADES_URL, timeout=TIMEOUT_SECONDS)
                cache.set(REDIS_KEY, json.dumps(trades))
                data = trades.get('data')
                report.info(f"Wrote {len(data) if isinstance(data, list) else 0} trades to {REDIS_KEY}")
            except Exception as exception:
                if is_authentication_error(exception):
                    # A dead session: log in again before sending anything more.
                    logger.warning(f"Zerodha session expired, logging in again: {exception}")
                    zerodha = ZerodhaAPI()
                else:
                    report.error(f"Trades poll failed: {type(exception).__name__}: {exception}")
            time.sleep(DELAY_SECONDS)
    except KeyboardInterrupt:
        logger.info("Stopped")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
