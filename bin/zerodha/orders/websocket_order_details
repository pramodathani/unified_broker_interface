#!/usr/bin/env python3
"""
Stream Zerodha (Kite) order updates over a websocket and merge them into the Redis hash `zerodha:orders:orders`, and
keep streaming until stopped.

    bin/zerodha/orders/websocket_order_details
    redis-cli HGETALL zerodha:orders:orders
    redis-cli HGET zerodha:orders:orders <order id>

The connection and the login are `ZerodhaOrderUpdatesSocket` and `ZerodhaSession` in
`stock_brokers/websockets/zerodha.py`, whose module docstring describes the protocol. This script runs the
socket and turns the orders it hands over into the Redis writes below, so it needs no other feed process or
key.

**The stream.** Kite has no separate order endpoint: order updates arrive as JSON *text* messages on the same
ticker socket that carries market data as binary. The socket subscribes to no instruments, so the only traffic
on it is order updates. It holds one of the three connections Kite allows per api_key, which is why
`bin/zerodha/instruments/websocket_quotes` uses at most two. Every change to an order in the account arrives as
`{"type": "order", "data": {...}}`, the data being Kite's order
postback: `order_id`, `exchange_order_id`, `parent_order_id`, `status`, `status_message`, `tradingsymbol`,
`exchange`, `instrument_token`, `transaction_type`, `order_type`, `product`, `validity`, `variety`,
`quantity`, `filled_quantity`, `pending_quantity`, `cancelled_quantity`, `price`, `trigger_price`,
`average_price`, `order_timestamp`, `exchange_timestamp`, `tag` and more.

**The key.** `zerodha:orders:orders` is the one hash for Zerodha's orders, keyed by `order_id` and shared with
`bin/zerodha/orders/api_order_details`, which merges the polled order book into it. Each update is written as
`{"observed_at": <epoch received>, "source": "websocket", "order": <normalized order>, "data": <data>}`, with Kite's
order exactly as sent in `data`. Kite's postback is the same object as an order-book row, so `order` is built by the
same function the poller uses - see `bin/zerodha/orders/api_order_details` for its fields. A websocket update always replaces its
order's entry; a polled row replaces it only when the entry was observed before the poll's request was sent. The hash
expires at 06:00 IST, moved to the next 06:00 by every write.

**The persistence stream.** Every update is also appended, in arrival order, to the Redis Stream
`zerodha:order-updates:stream` as an `update` field holding the same JSON, which `bin/zerodha/orders/store_orders_to_db`
writes to `zerodha.order_updates` - so the history the hash overwrites is kept there. Capped at about 20,000
entries.

**Positions.** Kite streams no position or holding updates, so there is no positions key. A text message of
any type other than `order` is logged, so one appearing would be noticed, and so is an order update without an
order id; binary frames are market data this socket never subscribed to and are ignored.

**Sessions.** The token is read afresh on every connect, so a login made by any process is picked up. A refused
token, or a socket failing to open six times running, logs in again before reconnecting - once, and only if no
other process already replaced the token, since Kite issues one token per session and every login invalidates
the last. A reconnect otherwise backs off from 1 to 60 seconds. Updates arrive only when an order changes, so a
quiet socket is not a broken one.

Exits 0 when stopped with Ctrl+C or SIGTERM, and 1 when a login fails or the socket is still refused after
logging in again. Reads only - it never places, modifies or cancels an order.
"""

import sys
import json
import signal
import threading
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# Run under the project's virtual environment, and put the project on sys.path. See
# utilities/bootstrap.py for why the check is sys.prefix rather than the interpreter path.
sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
from utilities.bootstrap import run_under_venv

PROJECT_ROOT = run_under_venv(__file__)

ORDERS_KEY = "zerodha:orders:orders"

# Every update is also appended here for bin/zerodha/orders/store_orders_to_db, which reads it with a consumer group.
STREAM_KEY = "zerodha:order-updates:stream"
STREAM_MAX_LENGTH = 20000

INDIA = ZoneInfo("Asia/Kolkata")
RESET_HOUR = 6

# Merges entries into a hash. KEYS[1] is the hash; ARGV is the expiry epoch, the source, the observed-at epoch, then
# field and value pairs. A "rest" value replaces an entry only when the entry was observed before ARGV[3]; any other
# source always replaces. A key of another type - the order book stored whole before this hash - is replaced.
MERGE_SCRIPT = """
local kind = redis.call('TYPE', KEYS[1])
if type(kind) == 'table' then kind = kind['ok'] end
if kind ~= 'hash' and kind ~= 'none' then redis.call('DEL', KEYS[1]) end
local written = 0
for i = 4, #ARGV, 2 do
    local replace = true
    if ARGV[2] == 'rest' then
        local current = redis.call('HGET', KEYS[1], ARGV[i])
        if current then
            local ok, decoded = pcall(cjson.decode, current)
            if ok and type(decoded) == 'table' and tonumber(decoded['observed_at'])
                    and tonumber(decoded['observed_at']) >= tonumber(ARGV[3]) then
                replace = false
            end
        end
    end
    if replace then
        redis.call('HSET', KEYS[1], ARGV[i], ARGV[i + 1])
        written = written + 1
    end
end
if #ARGV >= 4 then redis.call('EXPIREAT', KEYS[1], ARGV[1]) end
return written
"""

# The shared vocabulary: each broker's spelling of an order's side, product, type, validity and status mapped onto
# one set. Keys are compared uppercased with underscores levelled to spaces.
