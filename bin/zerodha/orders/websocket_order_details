def normalize(value, mapping):
    """
    A broker's term on the shared vocabulary, or the term uppercased when the vocabulary does not know it.

    - `value` is the broker's term.
    - `mapping` is one of the vocabulary tables.
    """
    if value is None or value == "":
        return None
    key = str(value).strip().upper().replace("_", " ")
    if key in mapping:
        return mapping[key]
    collapsed = " ".join(key.split())
    return mapping.get(collapsed, collapsed)

def present(value):
    """A value, or None for blanks and `NA` placeholders."""
    return None if value is None or str(value).strip() in ("", "NA") else value

def number(value, cast=float):
    """
    A value as a number, or None when it is missing or not numeric.

    - `value` is the raw field value.
    - `cast` is the number type.
    """
    value = present(value)
    try:
        return None if value is None else int(float(value)) if cast is int else float(value)
    except (TypeError, ValueError):
        return None

def text(value):
    """A value as a string, or None when it is missing."""
    value = present(value)
    return None if value is None else str(value)

def kite_timestamp(value):
    """
    A Kite order time, India wall clock, as an aware ISO timestamp, or None.

    Kite sends `YYYY-MM-DD HH:MM:SS` with no offset; an ISO string that carries its own offset keeps it.

    - `value` is the time as Kite sent it.
    """
    value = present(value)
    if value is None:
        return None
    text = str(value).strip()
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            moment = datetime.strptime(text, fmt)
        except ValueError:
            continue
        return None if moment.year < 1971 else moment.replace(tzinfo=INDIA).isoformat()
    try:
        moment = datetime.fromisoformat(text)
    except ValueError:
        return None
    return (moment if moment.tzinfo else moment.replace(tzinfo=INDIA)).isoformat()

def next_reset():
    """The epoch of the next 06:00 IST, when the merged hash expires."""
    now = datetime.now(INDIA)
    reset = now.replace(hour=RESET_HOUR, minute=0, second=0, microsecond=0)
    return int((reset if reset > now else reset + timedelta(days=1)).timestamp())

def order_from_kite(row):
    """
    A Kite order - an order-book row or an order update's `data`, which are the same object - as a normalized order,
    or None when it has no order id.

    - `row` is the Kite order.
    """
    if not isinstance(row, dict) or text(row.get('order_id')) is None:
        return None
    exchange, symbol = text(row.get('exchange')), text(row.get('tradingsymbol'))
    return {
        "order_id": text(row.get('order_id')),
        "exchange_order_id": text(row.get('exchange_order_id')),
        "parent_order_id": text(row.get('parent_order_id')),
        "status": normalize(present(row.get('status')), STATUSES),
        "status_message": text(row.get('status_message')) or text(row.get('status_message_raw')),
        "id": f"{exchange}:{symbol}" if exchange and symbol else symbol,
        "instrument_token": text(row.get('instrument_token')),
        "tradingsymbol": symbol,
        "exchange": exchange,
        "transaction_type": normalize(present(row.get('transaction_type')), TRANSACTION_TYPES),
        "product": normalize(present(row.get('product')), PRODUCTS),
        "order_type": normalize(present(row.get('order_type')), ORDER_TYPES),
        "validity": normalize(present(row.get('validity')), VALIDITIES),
        "quantity": number(row.get('quantity'), int),
        "filled_quantity": number(row.get('filled_quantity'), int),
        "pending_quantity": number(row.get('pending_quantity'), int),
        "cancelled_quantity": number(row.get('cancelled_quantity'), int),
        "disclosed_quantity": number(row.get('disclosed_quantity'), int),
        "price": number(row.get('price')),
        "trigger_price": number(row.get('trigger_price')),
        "average_price": number(row.get('average_price')),
        "order_timestamp": kite_timestamp(row.get('order_timestamp')),
        "exchange_timestamp": kite_timestamp(row.get('exchange_timestamp')) or kite_timestamp(row.get('exchange_update_timestamp')),
        "tag": text(row.get('tag')),
    }

class ZerodhaOrderUpdatesStore:
    """
    Where the order updates socket's orders are written: the merged orders hash and the persistence stream.
    """

    def __init__(self, cache, logger):
        """
        Registers the merge script on the Redis client the updates are written to.

        Args:
            cache (redis.Redis): The Redis client.
            logger (logging.Logger): Where writes and skipped updates are reported.

        Returns:
            None: This method returns nothing.
        """
        self._cache = cache
        self._merge = cache.register_script(MERGE_SCRIPT)
        self._logger = logger

    def write_updates(self, orders, received_at):
        """
        Merges one message's orders into the orders hash, keyed by order id, and appends each to the stream.

        The hash keeps each order's latest state.
        The stream keeps every transition, even two of one order in the same message, in the shape `bin/zerodha/orders/store_orders_to_db` reads.

        Args:
            orders (list): The message's orders, exactly as Kite sent them.
            received_at (datetime): When the message was received, as a naive India wall clock time.

        Returns:
            None: This method returns nothing.
        """
        received = received_at.strftime("%Y-%m-%d %H:%M:%S.%f")
        observed_at = received_at.timestamp()
        merged = []
        appended = []
        for data in orders:
            order = order_from_kite(data)
            if order is None:
                self._logger.info(f"Ignoring an order update without an order id: {json.dumps(data)[:200]}")
                continue
            merged.append(order["order_id"])
            merged.append(json.dumps({"observed_at": observed_at, "source": "websocket", "order": order, "data": data}))
            appended.append(json.dumps({"timestamp": received, "data": data}))
        if merged:
            self._merge(keys=[ORDERS_KEY], args=[next_reset(), "websocket", repr(observed_at)] + merged)
            pipeline = self._cache.pipeline(transaction=False)
            for update in appended:
                pipeline.xadd(STREAM_KEY, {"update": update}, maxlen=STREAM_MAX_LENGTH, approximate=True)
            pipeline.execute()
            self._logger.info(f"Merged {len(appended)} order update(s) into {ORDERS_KEY}: {', '.join(merged[0::2])}")

def main():
    """Stream Zerodha order updates into zerodha:orders:orders until stopped."""
    from stock_brokers.websockets.zerodha import ZerodhaOrderUpdatesSocket, ZerodhaSession
    from utilities.configurations import get_cache, get_logger

    logger = get_logger("zerodha.websocket_order_details")
    try:
        session = ZerodhaSession(logger)
    except Exception as exception:
        logger.error(f"Could not log in to Zerodha: {type(exception).__name__}: {exception}")
        return 1
    store = ZerodhaOrderUpdatesStore(get_cache(), logger)
    socket = ZerodhaOrderUpdatesSocket(session, store.write_updates, logger)

    # Installed before the thread starts: systemd stops a unit with SIGTERM, and the default action would kill
    # the process without closing the connection.
    def _handle_signal(signal_number, frame):
        logger.info(f"Received signal {signal_number}. Closing the order updates feed.")
        socket.close()

    for signal_number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signal_number, _handle_signal)

    thread = threading.Thread(target=socket.run_forever, name="zerodha_order_updates", daemon=True)
    logger.info("Starting the order updates feed.")
    thread.start()

    # Block in the main thread so the signal handlers above can run.
    while thread.is_alive():
        thread.join(timeout=1)

    if socket.gave_up:
        return 1
    logger.info("Order updates feed stopped.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
